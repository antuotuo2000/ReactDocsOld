#!/bin/bash
# 双击启动：自动定位同级 docs 文件夹，立即刷新一次并进入实时监听模式
cd "$(dirname "$0")" || exit 1
printf "\033]0;王安安的数据中心 - 实时目录监听\007"
echo "=========================================================="
echo "  王安安的数据中心 · 本地目录实时监听同步已启动"
echo "  往 docs/ 里拖入、修改或删除报告后会自动重写 index.html"
echo "  关闭此窗口或按 Ctrl+C 即可停止监听"
echo "=========================================================="
python3 "./sync_docs_index.py" --watch --notify
