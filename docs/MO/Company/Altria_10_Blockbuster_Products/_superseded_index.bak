    var ALL_IPS = [{"id":"marlboro","idx_num":1,"idx_pad":"01","filename":"mo_prod_01_marlboro.html","checkKey":"mui_mo_checks_marlboro","monogram":"MB","short_zh":"Marlboro 旗舰系列","short_en":"Marlboro Flagship","pill_kpi":"39.5%总份额 · 60.0%高端","docTitleZh":"《Marlboro 万宝路旗舰系列》单品深度商业研报（Red·Gold·Menthol·Cowboy Cut）| 王安安数据中心","docTitleEn":"Marlboro Flagship Cigarette Franchise Product Monograph (Red · Gold · Cowboy Cut) | Research Hub","crumb_zh":"Marlboro 万宝路美国本土旗舰系列（PM USA）","crumb_en":"Marlboro U.S. Flagship Franchise (PM USA)","chip1_zh":"全美卷烟 #1 · 39.5% 份额","chip1_en":"#1 US Cigarette · 39.5% Share","chip2_zh":"高端烟统治力 60.0% · 64.8% OCI率","chip2_en":"60.0% Premium Share · 64.8% OCI","sidebar":{"badge":"PM USA · #1 US CIGARETTE ENGINE","title_zh":"Marlboro 旗舰单品研报","title_en":"Marlboro Product Monograph","sub_zh":"2026前9月出货 386.73亿支 × 高端卷烟 60.0% 绝对垄断 × Cowboy Cut 十万店价格带护城河","sub_en":"38.67B sticks in 9M 2026 × 60.0% US premium share × Cowboy Cut 100K-store price-ladder defense","mini_kpis":[{"label_zh":"全美卷烟总零售份额 (Q3'26)","label_en":"Total US Cig Share (Q3'26)","val_zh":"39.5% (#1 断层)","val_en":"39.5% (#1 US)"},{"label_zh":"全美高端烟内部份额 (Q3'26)","label_en":"Share of Premium (Q3'26)","val_zh":"60.0% (+0.3pp)","val_en":"60.0% (+0.3pp)"},{"label_zh":"2026前9月国内出货量","label_en":"9M 2026 Domestic Vol","val_zh":"38,673M 支","val_en":"38,673M Sticks"}]},"toc":[["单品定评与核心份额面板","Product Verdict & Share Scorecard"],["产品线子矩阵与配方分销架构","Sub-Line Architecture & AGDC Shelf"],["四大定价权支柱与护城河雷达","4 Pricing-Power Pillars & Moat Radar"],["全美高端与主流卷烟竞品矩阵","US Cigarette Peer Benchmarking"],["单包经济学与多年期现金流推演","Pack Economics & OCI Simulator"],["价格阶梯演进与关键商业战役","Price-Ladder Evolution & Key Battles"],["旗舰可燃烟草定价权核查清单","Flagship Pricing Moat Checklist"],["SEC 财报与权威信源核验索引","SEC Filings & Primary Sources"]],"hero":{"strip1_zh":"单品定评：全美消费品史上现金流转化率最高的单一快消品母体，以一己之力锁定美国高端卷烟 60.0% 份额","strip1_en":"Verdict: Highest-margin single CPG cash-flow engine in America, commanding 60.0% of the US premium cigarette segment","strip2_zh":"运营主体：Philip Morris USA (里士满超级工厂) · AGDC 覆盖 >30万零售门头","strip2_en":"Operating Co.: Philip Morris USA (Richmond Manufacturing Center) · >300K Retail Doors","strip3_zh":"数据基准：2026Q3 季报核验 (2026-10-29)","strip3_en":"Baseline: Q3 2026 Release (Oct 29, 2026)","overline_zh":"FLAGSHIP PRODUCT 01 · 39.5% 全美总份额 × 60.0% 高端烟份额 × 11亿次便利店年客流 × 64.8% 部门调整后 OCI 利润率","overline_en":"FLAGSHIP PRODUCT 01 · 39.5% Total Share × 60.0% Premium Share × 1.1B Annual C-Store Trips × 64.8% Smokeable Adj. OCI Margin","h1_zh":"Marlboro 万宝路旗舰系列深度剖析：<span class=\"gradient-accent\">销量年降 6%–7% 时代，如何凭四级价格阶梯实现利润率逆势创出 64.8% 新高？<\/span>","h1_en":"Marlboro Flagship Deep Dive: <span class=\"gradient-accent\">How a Four-Tier Internal Price Ladder Expanded Smokeable Margins to 64.8% Despite Secular Volume Headwinds<\/span>","lead_zh":"在美国成人卷烟行业总销量每年结构性萎缩约 5%–8%、折扣烟全行业占比于 2026 年三季度攀升至 <strong>34.1%<\/strong> 的严苛逆风中，由 <strong>Philip Morris USA (PM USA)<\/strong> 制造运营的 <strong>Marlboro（万宝路美国本土系列）<\/strong> 依然展现出惊人的商业韧性。2026 年三季度，Marlboro 单季国内出货达 <strong>133.24 亿支<\/strong>（前9月累计 <strong>386.73 亿支<\/strong>），不仅稳守全美卷烟总零售市场 <strong>39.5%<\/strong>（超过第2至第8名竞品之和），更凭借价值型高端子线 <strong>Marlboro Cowboy Cut<\/strong> 铺货约 <strong>100,000 家门店<\/strong>，将全美高端卷烟（Premium Segment）内部份额逆势推升至 <strong>60.0%<\/strong>（同比 +0.3pp、环比 +0.4pp）<a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Altria Q3'26 Release ↗<\/a>，叠加进出口退税（Duty Drawback）与门店级 RGM 算法提价，驱动可燃烟草分部前9月调整后 OCI 逆势增长 <strong>4.1%<\/strong> 至 <strong>$87.66 亿<\/strong>（利润率高达 <strong>64.8%<\/strong>）。","lead_en":"Despite ~5%–8% annual secular US cigarette volume declines and industry discount share reaching <strong>34.1%<\/strong> in Q3 2026, <strong>Philip Morris USA's Marlboro<\/strong> remains an unmatched pricing-power fortress. Shipping <strong>13,324M sticks<\/strong> in Q3 2026 (<strong>38,673M sticks<\/strong> in 9M 2026), Marlboro held <strong>39.5%<\/strong> of total US retail cigarettes while expanding its share of the US Premium segment to <strong>60.0%<\/strong> (+0.3pp YoY, +0.4pp QoQ) via value-oriented premium tier <strong>Marlboro Cowboy Cut<\/strong> across ~100,000 stores <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Altria Q3'26 Release ↗<\/a>, propelling 9M 2026 Smokeable Adjusted OCI up <strong>4.1%<\/strong> to <strong>$8,766M<\/strong> at a <strong>64.8%<\/strong> margin.","thesis_cards":[{"title_zh":"品牌内四级价格缓冲带（Internal Price Ladder）","title_en":"4-Tier Internal Brand Price Architecture","desc_zh":"以核心 Red/Gold（~$9.50/包）锚定高净利，用 Special Select、Marlboro Black 与 2025–2026 扩张至 10 万店的 Cowboy Cut 在品牌内部拦截消费降级。","desc_en":"Anchors top margins with Red/Gold (~$9.50/pk) while Special Select, Marlboro Black, and 100,000-store Cowboy Cut intercept internal down-trading."},{"title_zh":"11 亿次便利店刚性引流与黄金背柜统治权","title_en":"1.1B Annual C-Store Trips & Backbar Dominance","desc_zh":"PM USA 每年直接关联全美便利店 11 亿次到店购物行程，通过 AGDC 商业返利契约锁定收银台正后方最显眼排面，构筑终端物理壁垒。","desc_en":"PM USA drives 1.1B annual convenience-store shopper trips, locking down prime eye-level backbar fixtures across >300K retail doors via AGDC contracts."},{"title_zh":"代工出口激增与关税退税（Duty Drawback）新杠杆","title_en":"Export Contract Mfg & Duty Drawback Engine","desc_zh":"里士满工厂闲置产能转化为合同代工出口（2026Q3 达 15.95亿支，同比翻超5倍），合法激活进口退税红利并于 2026.08 与 PMI 签署互惠代工长约。","desc_en":"Converts idle Richmond capacity into contract export sticks (1,595M in Q3'26, >5x YoY), unlocking federal duty drawback refunds plus an Aug 2026 PMI deal."}],"kpis":[{"label_zh":"全美高端卷烟内部份额","label_en":"US Premium Segment Share","badge_zh":"Q3'26 创近年新高","badge_en":"Q3'26 Record High","val_zh":"60.0%","val_en":"60.0%","desc_zh":"同比提升 +0.3pp、环比提升 +0.4pp；全美每卖出 5 包高端烟就有 3 包是 Marlboro <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Q3'26 Table 4 ↗<\/a>","desc_en":"Up +0.3pp YoY and +0.4pp QoQ; 3 out of every 5 premium cigarette packs sold in the U.S. are Marlboro <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Q3'26 Table 4 ↗<\/a>"},{"label_zh":"全美卷烟总零售市场份额","label_en":"Total US Cigarette Share","badge_zh":"环比企稳持平","badge_en":"Sequentially Flat","val_zh":"39.5%","val_en":"39.5%","desc_zh":"2026Q2 与 Q3 连续两季稳守 39.5%（2025 全年为 40.5%），支撑 PM USA 总份额升至 45.7% <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Circana Scan ↗<\/a>","desc_en":"Held steady at 39.5% across Q2 and Q3 2026 (vs. 40.5% in FY25), lifting total PM USA retail share to 45.7% <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Circana Scan ↗<\/a>"},{"label_zh":"2025全年 / 2026前9月出货量","label_en":"FY25 / 9M26 Shipments","badge_zh":"PM USA 国内销量","badge_en":"PM USA Domestic","val_zh":"54.9B / 38.7B","val_en":"54.9B / 38.7B","desc_zh":"FY2025 出货 54,933M 支；2026 前9月出货 38,673M 支（Q3 单季 13,324M 支，降幅收窄至 -6.4%）<a class=\"cite-link\" href=\"https://www.sec.gov/Archives/edgar/data/764180/000076418026000007/exhibit991erq42025.htm\" target=\"_blank\" rel=\"noopener noreferrer\">FY25 EX-99.1 ↗<\/a>","desc_en":"54,933M sticks in FY2025 and 38,673M sticks in 9M 2026 (13,324M in Q3, narrowing YoY decline to -6.4%) <a class=\"cite-link\" href=\"https://www.sec.gov/Archives/edgar/data/764180/000076418026000007/exhibit991erq42025.htm\" target=\"_blank\" rel=\"noopener noreferrer\">FY25 EX-99.1 ↗<\/a>"},{"label_zh":"可燃烟草分部调整后 OCI 率","label_en":"Smokeable Adj. OCI Margin","badge_zh":"9M'26 +0.4pp","badge_en":"9M'26 +0.4pp","val_zh":"64.8%","val_en":"64.8%","desc_zh":"2026前9月实现不含税营收 $13,532M、调整后 OCI $8,766M（FY2025 全年为 $11,064M / 63.4%）<a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Q3'26 Table 2 ↗<\/a>","desc_en":"9M 2026 revenue net of excise reached $13,532M with $8,766M Adjusted OCI (vs. $11,064M / 63.4% in FY2025) <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Q3'26 Table 2 ↗<\/a>"}]},"ch1":{"eyebrow":"CHAPTER 01 · SUB-BRAND ARCHITECTURE, AMERICAN BLEND CRAFT & RGM","h2_zh":"一、产品子线矩阵与工艺架构：一包美式混合烟如何拆解出四层价格防御纵深？","h2_en":"1. Sub-Line Architecture & Craft: Engineering a 4-Tier Price Ladder Inside One Iconic Brand","sub_zh":"弗吉尼亚烤烟+白肋烟+东方香料烟经典美式混调 × 四大风味家族 × Marlboro Rewards 数字化私域直连","sub_en":"Classic Virginia/Burley/Oriental American blend × 4 flavor families × Marlboro.com 1-to-1 digital promo engine","badge_zh":"里士满制造中心 · 约 100,000 店 Cowboy Cut 覆盖","badge_en":"Richmond Mfg · ~100K Cowboy Cut Doors","hub_title_zh":"Marlboro 母品牌伞状矩阵（锚定高端溢价 ↔ 内部梯度截留价格敏感型老烟民）","hub_title_en":"Marlboro Umbrella Architecture (Full-Margin Core ↔ Value-Tier Retention Shield)","hub_sub_zh":"弗吉尼亚州里士满（Richmond, VA）全球标杆卷包基地 · 单店级数字优惠券精准投放（避免全盘降价稀释）","hub_sub_en":"Richmond, VA manufacturing complex · Store-level digital couponing via Marlboro Rewards without list-price dilution","nodes":[{"tag_zh":"CORE FULL FLAVOR · 红万核心","tag_en":"CORE FULL FLAVOR · RED","name_zh":"Marlboro Red & Red Label","name_en":"Marlboro Red & Red Label","desc_zh":"经典硬盒 85s/100s 醇厚美式混合配方，零促销折让或极低折让，承担全产品线最高单包毛利贡献。","desc_en":"Signature King Size 85s/100s American blend with minimal promo discounting, generating PM USA's highest unit gross profit."},{"tag_zh":"SMOOTH & ULTRA · 金银顺滑线","tag_en":"SMOOTH & ULTRA · GOLD/SILVER","name_zh":"Marlboro Gold · Silver Pack","name_en":"Marlboro Gold · Silver Pack","desc_zh":"激光微孔通风滤嘴调节焦油与烟气柔和度，覆盖都市白领与成熟高粘性客群，复购周期极度稳定。","desc_en":"Laser-perforated filter ventilation delivers smoother draw for high-retention urban and suburban adult smokers."},{"tag_zh":"COOLING FLAVOR · 薄荷醇矩阵","tag_en":"COOLING FLAVOR · MENTHOL","name_zh":"Menthol · Smooth · Ice · Bold Ice","name_en":"Menthol · Smooth · Ice · Bold","desc_zh":"涵盖传统薄荷与重度冰感细分规格，在部分州风味禁令（如加州）外持续贡献高溢价份额。","desc_en":"Spans classic menthol to high-cooling Bold Ice SKUs, capturing high-margin demand outside state flavor-ban jurisdictions."},{"tag_zh":"MID-PREMIUM · 黑万年轻化线","tag_en":"MID-PREMIUM · BLACK LINE","name_zh":"Marlboro Black & Black Menthol","name_en":"Marlboro Black Special Blend","desc_zh":"浓郁风味+黑色摩登包装+促销折让带（加州合规目录在册 Special Blend 100s），充当首道价格缓冲垫。","desc_en":"Bold flavor profile in modern black packaging with targeted promotional buydowns (CA DOJ compliant Special Blend 100s)."},{"tag_zh":"VALUE PREMIUM · 战略防守新品","tag_en":"VALUE PREMIUM · COWBOY CUT","name_zh":"Marlboro Cowboy Cut (Red/Gold)","name_en":"Marlboro Cowboy Cut","desc_zh":"2025–2026 重点扩铺至约 100,000 家门店的高性价比子线，助推 Marlboro 高端烟份额重返 60.0% 大关。","desc_en":"Expanded across ~100,000 retail stores in 2025–2026 to retain value-conscious Marlboro loyalists and lift premium share to 60.0%."},{"tag_zh":"EXPORT & DRAWBACK · 产能变现","tag_en":"EXPORT & DRAWBACK · PMI DEAL","name_zh":"合同代工出口卷烟 (Contract Export)","name_en":"Contract Mfg Export Sticks","desc_zh":"2026前9月代工出口飙升至 29.41亿支（同比 >+274%），2026.08 与 PMI 签署自 2027 年起的双向代工协议。","desc_en":"Surged >274% YoY to 2,941M sticks in 9M 2026, reinforced by an Aug 2026 mutual contract-manufacturing agreement with PMI."}],"platform_bars":[{"title_zh":"AGDC 零售货架协议（>30万门店黄金背柜主权）","title_en":"AGDC Retail Merchandising Contracts (>300K Stores)","sub_zh":"通过分级陈列返利确保核心子线与 Cowboy Cut 分层陈列，单户便利店年均关联 11 亿次 PM USA 进店行程。","sub_en":"Tiered AGDC retail merchandising incentives secure eye-level shelving across >300K stores tied to 1.1B annual PM USA shopper trips."},{"title_zh":"RGM 营收增长管理与 Marlboro.com 私域补贴引擎","title_en":"Data-Driven RGM & Marlboro.com Digital Couponing","sub_zh":"基于各邮编区宏观通胀压力动态调节单包数字立减券，向高净值地区每年提价 2–3 次，向价格敏感区定向滴灌补贴。","sub_en":"Zip-code-level RGM elasticity models dynamically calibrate Marlboro.com digital mobile coupons and 2–3 annual list-price hikes."}],"principles":[{"title_zh":"1. 年度双次至三次目录提价纪律（List Price Cadence）","title_en":"1. Multi-Wave Annual List Price Increases","desc_zh":"2026 年 4 月 13 日 PM USA 执行年内第二次卷烟目录提价，Marlboro 全美终端均价已站稳约 <strong>$9.50/包<\/strong>，以 +7%–9% 净价涨幅轻松跑赢 -6.4% 的销量回落 <a class=\"cite-link\" href=\"https://www.cspdailynews.com/tobacco/altria-raises-cigarette-prices-second-time-year\" target=\"_blank\" rel=\"noopener noreferrer\">CSP Price Hike ↗<\/a>。","desc_en":"PM USA executed its second 2026 list-price hike on Apr 13, holding average Marlboro retail prices near <strong>$9.50/pack<\/strong> so +7%–9% net pricing outpaces -6.4% stick volume drift <a class=\"cite-link\" href=\"https://www.cspdailynews.com/tobacco/altria-raises-cigarette-prices-second-time-year\" target=\"_blank\" rel=\"noopener noreferrer\">CSP Price Hike ↗<\/a>."},{"title_zh":"2. Cowboy Cut 精准卡位“体面降级”心理","title_en":"2. Cowboy Cut Captures 'Prestige Down-Trading'","desc_zh":"通胀承压烟民不愿在社交场合掏出廉价杂牌烟盒；Cowboy Cut 保留正统屋顶徽标与美式烟叶基底而下探价格带，铺货约 10 万店即带动高端内份额突破 <strong>60.0%<\/strong> <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Q3'26 Earnings ↗<\/a>。","desc_en":"Inflation-squeezed smokers avoid pulling out generic packs socially; Cowboy Cut preserves authentic Red Roof equity at an accessible tier across ~100K stores to lift premium share to <strong>60.0%<\/strong> <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Q3'26 Earnings ↗<\/a>."},{"title_zh":"3. 联邦关税退税（Duty Drawback）增厚单支净利","title_en":"3. Federal Duty Drawback Manufacturing Arbitrage","desc_zh":"通过为海外第三方合同代工出口卷烟（Q3'26 达 <strong>1,595M 支<\/strong> vs 去年同期 311M 支），合法申领进口卷烟税费退还，仅 Q3 单季即贡献约 <strong>$124M<\/strong> 增量收益 <a class=\"cite-link\" href=\"https://www.investing.com/news/stock-market-news/altria-philip-morris-international-sign-contract-manufacturing-deals-4873428\" target=\"_blank\" rel=\"noopener noreferrer\">PMI Mfg Deal ↗<\/a>。","desc_en":"Contract-manufactured export cigarettes (<strong>1,595M sticks<\/strong> in Q3'26 vs. 311M prior year) unlock federal duty drawback refunds (~<strong>$124M<\/strong> lift in Q3 alone) <a class=\"cite-link\" href=\"https://www.investing.com/news/stock-market-news/altria-philip-morris-international-sign-contract-manufacturing-deals-4873428\" target=\"_blank\" rel=\"noopener noreferrer\">PMI Mfg Deal ↗<\/a>."}],"alert_zh":"<strong>核心反直觉事实核验：<\/strong>尽管 Marlboro 国内报告出货量从 2024 年的 625.84 亿支回落至 2025 年的 549.33 亿支（-12.2%），再到 2026 前9月的 386.73 亿支（-7.2%，Q3 收窄至 -6.4%），但奥驰亚可燃烟草分部调整后 OCI 反而从 2024 年的 <strong>$109.22 亿（61.6% 利润率）<\/strong> 连创新高至 2025 年的 <strong>$110.64 亿（63.4%）<\/strong>，并在 2026 前9月再涨 4.1% 达 <strong>$87.66 亿（64.8% 利润率）<\/strong> <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Altria Q3'26 Table 2 ↗<\/a>。","alert_en":"<strong>Counter-Intuitive Margin Proof:<\/strong> Even as Marlboro domestic volume stepped down from 62.58B sticks (FY24) to 54.93B (FY25) and 38.67B (9M26, moderating to -6.4% in Q3), Smokeable Adjusted OCI expanded from <strong>$10,922M (61.6% margin)<\/strong> in FY24 to <strong>$11,064M (63.4%)<\/strong> in FY25 and grew another +4.1% to <strong>$8,766M (64.8% margin)<\/strong> in 9M 2026 <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Altria Q3'26 Table 2 ↗<\/a>.","chart":{"tabA_zh":"视图A: 出货量与高端份额剪刀差","tabA_en":"View A: Volume vs. Premium Share","tabB_zh":"视图B: 季度国内与代工出口对比","tabB_en":"View B: Quarterly Volume & Export","viewA":{"mode":"dual_bar_line","title_zh":"Marlboro 年度/阶段国内出货量（十亿支）vs 全美高端卷烟内部份额（%）","title_en":"Marlboro Domestic Shipments (Billion Sticks) vs. Share of US Premium Segment (%)","sub_zh":"销量随行业温和下行，但凭 Cowboy Cut 与 RGM 定价策略，高端烟内部统治份额在 2026Q3 升至 60.0%","sub_en":"While stick volumes reflect industry secular decline, Marlboro's share of US Premium rose to 60.0% in Q3 2026","leg1_zh":"Marlboro 国内出货量 (左轴 · 十亿支)","leg1_en":"Marlboro Domestic Shipments (Left · B Sticks)","leg2_zh":"全美高端卷烟内部份额 (右轴 · %)","leg2_en":"Share of US Premium Segment (Right · %)","labels_zh":["2024全年","2025全年","2026H1","2026前9月(Q3份额)"],"labels_en":["FY 2024","FY 2025","1H 2026","9M 2026 (Q3 Share)"],"subs_zh":["总份额 41.7%","总份额 40.5%","总份额 39.6%","总份额 39.5% · 企稳"],"subs_en":["41.7% Total Share","40.5% Total Share","39.6% Total Share","39.5% Total Share"],"s1":[62.58,54.93,25.35,38.67],"s2":[59.3,59.4,59.6,60.0],"max1":70,"max2":65,"u1":"B","u2":"%"},"viewB":{"mode":"grouped_bars","title_zh":"2026 vs 2025 分季度 Marlboro 国内出货量与 PM USA 合同代工出口量（十亿支）","title_en":"Quarterly Marlboro Domestic Volume vs. Contract Export Volume (Billion Sticks)","sub_zh":"2026Q3 国内降幅收窄至 -6.4%，而合同代工出口卷烟从 0.31B 暴增至 1.60B 支（+413%）","sub_en":"Q3 2026 domestic decline narrowed to -6.4% while contract-manufactured export sticks surged >5x to 1.60B","leg1_zh":"2026 当期出货量 (十亿支)","leg1_en":"2026 Period Shipments (B Sticks)","leg2_zh":"2025 同期出货量 (十亿支)","leg2_en":"2025 Prior-Year Shipments (B Sticks)","labels_zh":["Q1 国内万宝路","Q2 国内万宝路","Q3 国内万宝路","9M 代工出口烟"],"labels_en":["Q1 Marlboro US","Q2 Marlboro US","Q3 Marlboro US","9M Export Mfg"],"subs_zh":["-7.8% YoY","-7.4% YoY","-6.4% YoY","+274.2% YoY"],"subs_en":["-7.8% YoY","-7.4% YoY","-6.4% YoY","+274.2% YoY"],"s1":[11.96,13.39,13.32,2.94],"s2":[12.98,14.46,14.24,0.79],"max1":16,"u1":"B","u2":"B"}},"matrix_cards":[{"title_zh":"MSA 大和解协议与 FDA 监管构筑“无广告垄断锁”","title_en":"MSA Ad Ban & FDA Pre-Market Freeze Lock In #1 Share","badge_zh":"零新品牌挑战可能","badge_en":"Frozen Brand Share","body_zh":"1998 年州政府大和解协议（MSA，2025 全年可燃分部计提和解金 <strong>$3,028M<\/strong>）与 2009 年《家庭吸烟预防与烟草控制法》禁止了几乎所有大众媒介卷烟广告，客观上彻底锁死了挑战者通过广告颠覆 Marlboro 心智的通道 <a class=\"cite-link\" href=\"https://www.sec.gov/Archives/edgar/data/764180/000076418026000007/exhibit991erq42025.htm\" target=\"_blank\" rel=\"noopener noreferrer\">FY25 Schedule 5 ↗<\/a>。","detail_zh":"在户外、电视与社交媒体烟草广告全面禁绝的制度环境下，零售收银台背柜（Backbar）与存量烟民包装视觉惯性成为唯一品牌触点，使 Marlboro 的 39.5% 市场份额具备极高的准入排他性。","body_en":"The 1998 Master Settlement Agreement (<strong>$3,028M<\/strong> FY25 Smokeable settlement expense) and 2009 Tobacco Control Act banned mass-media cigarette advertising—effectively freezing brand equity in place and shielding Marlboro from new brand challengers <a class=\"cite-link\" href=\"https://www.sec.gov/Archives/edgar/data/764180/000076418026000007/exhibit991erq42025.htm\" target=\"_blank\" rel=\"noopener noreferrer\">FY25 Schedule 5 ↗<\/a>.","detail_en":"With TV, billboard, and social ads prohibited, physical retail backbar visibility and adult smoker habit become the sole brand touchpoints, turning regulatory restrictions into an insurmountable incumbent moat."},{"title_zh":"PMI 双向代工长约激活里士满超级制造底座","title_en":"August 2026 PMI Mutual Contract-Manufacturing Pact","badge_zh":"2027 正式履约","badge_en":"Starts FY2027","body_zh":"2026 年 8 月 24 日，奥驰亚与菲莫国际（PMI）正式签署双向合同制造协议：自 2027 年起 PM USA 将为 PMI 部分海外市场代工传统卷烟，同时强化进口退税闭环并摊薄里士满工厂单支固定折旧 <a class=\"cite-link\" href=\"https://www.investing.com/news/stock-market-news/altria-philip-morris-international-sign-contract-manufacturing-deals-4873428\" target=\"_blank\" rel=\"noopener noreferrer\">Investing.com ↗<\/a>。","detail_zh":"随着美国本土销量自然递减，引入 PMI 海外出口订单不仅直接拉升产能稼动率，还能与联邦关税退税（Duty Drawback）条款协同，在零国内份额稀释前提下创造高确定性美元现金流。","body_en":"On August 24, 2026, Altria and Philip Morris International signed mutual contract-manufacturing deals starting in 2027—utilizing PM USA's Richmond Cigarette Manufacturing Center for export volume to absorb fixed overhead and sustain duty-drawback economics <a class=\"cite-link\" href=\"https://www.investing.com/news/stock-market-news/altria-philip-morris-international-sign-contract-manufacturing-deals-4873428\" target=\"_blank\" rel=\"noopener noreferrer\">Investing.com ↗<\/a>.","detail_en":"Export contract volume offsets domestic secular unit contraction, keeping per-stick conversion costs low while unlocking substantial federal tax/duty refunds."}]},"ch2":{"eyebrow":"CHAPTER 02 · FOUR PRICING-POWER PILLARS & 5-AXIS PRODUCT RADAR","h2_zh":"二、四大护城河支柱：为什么 Marlboro 能长期维持 64%+ 营业利润率？","h2_en":"2. Four Moat Pillars: How Marlboro Sustains 64%+ Operating Margin Power","badge_zh":"护城河评级：极宽 (60.0% 高端垄断 · 极低价格弹性)","badge_en":"Moat Rating: Wide (60.0% Premium Share · Inelastic Pricing)","pillars":[{"title_zh":"01 · 极低需求价格弹性与每年 2–3 次提价权","title_en":"01 · Inelastic Adult Loyalty & Multi-Wave Price Hikes","badge_zh":"~$9.50 / 包均价","badge_en":"~$9.50 / Pack Avg","desc_zh":"尼古丁生理依赖叠加百年红白屋顶视觉符号，使每 10% 终端净提价仅伴随约 3%–5% 品牌销量流失，净收入持续为正。","note_zh":"<strong>当前选中支柱解读（01 极低价格弹性）：<\/strong>2026 年 4 月 PM USA 完成年内第二次提价，依靠单包净实现收入提升与促销精细化，推动 2026Q3 不含税可燃烟营收逆势增长 <strong>+3.7%<\/strong> 至 $4,762M <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Q3'26 Release ↗<\/a>。","note_en":"<strong>Selected Pillar (01 · Inelastic Pricing Power):<\/strong> Following its second 2026 list price increase in April, net price realization drove Q3 2026 Smokeable revenue net of excise up <strong>+3.7%<\/strong> to $4,762M despite -2.9% reported cigarette sticks <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Q3'26 Release ↗<\/a>.","desc_en":"Physiological nicotine inelasticity plus century-old Red Roof brand equity keep volume attrition around -3% to -5% per +10% net price hike."},{"title_zh":"02 · 门店级 RGM 算法与 Cowboy Cut 内部截留","title_en":"02 · Store-Level RGM & Cowboy Cut Retention","badge_zh":"10万门店精准防守","badge_en":"100K-Store Shield","desc_zh":"放弃一刀切全美促销，改用邮政编码级消费者弹性模型动态调配 Marlboro Black 与 Cowboy Cut 货架价差。","note_zh":"<strong>当前选中支柱解读（02 门店级 RGM 防守）：<\/strong>Cowboy Cut 在低收入承压商圈精准承接了原本可能流向 Montego 或 Lucky Strike 的降级需求，助力 Marlboro 高端内份额攀升至 <strong>60.0%<\/strong>。","note_en":"<strong>Selected Pillar (02 · Granular Store-Level RGM):<\/strong> Deploying Cowboy Cut into ~100,000 stores retained budget-stretched premium smokers inside the Marlboro family, lifting share of premium to <strong>60.0%<\/strong>.","desc_en":"Replaces blunt nationwide promos with zip-code RGM algorithms dynamically tuning price gaps across Red, Black, and Cowboy Cut."},{"title_zh":"03 · AGDC 三十万零售终端与 11 亿次便利店流量杠杆","title_en":"03 · AGDC 300K-Door Reach & 1.1B C-Store Trips","badge_zh":"55% 忠诚篮子渗透","badge_en":"55% Loyalty Basket","desc_zh":"70% 的成年尼古丁消费者每日光顾便利店；Marlboro 是全美便利店老板不可替代的第一引流刚需品。","note_zh":"<strong>当前选中支柱解读（03 零售渠道霸权）：<\/strong>奥驰亚在 2026 NACS 展披露，PM USA 每年关联 <strong>11 亿次<\/strong> 便利店购物行程，全美 55% 的烟草忠诚度订单包含奥驰亚旗下单品 <a class=\"cite-link\" href=\"https://www.2firsts.com/news/altria-showcases-ploom-marlboro-heated-tobacco-sticks-and-non-nicotine-energy-products-at-nacs-show-2026\" target=\"_blank\" rel=\"noopener noreferrer\">2Firsts NACS 2026 ↗<\/a>。","note_en":"<strong>Selected Pillar (03 · Retail Traffic Leverage):<\/strong> Altria data at NACS 2026 showed PM USA drives <strong>1.1 billion<\/strong> annual convenience-store trips, giving AGDC unmatched backbar contracting leverage <a class=\"cite-link\" href=\"https://www.2firsts.com/news/altria-showcases-ploom-marlboro-heated-tobacco-sticks-and-non-nicotine-energy-products-at-nacs-show-2026\" target=\"_blank\" rel=\"noopener noreferrer\">2Firsts NACS 2026 ↗<\/a>.","desc_en":"7 in 10 adult nicotine buyers visit c-stores daily, making Marlboro the #1 non-negotiable foot-traffic anchor for US retailers."},{"title_zh":"04 · 极低资本开支与出口退税制造协同","title_en":"04 · Ultra-Light CapEx & Export Duty Drawback","badge_zh":"FCF 印钞机底座","badge_en":"Cash Cow Core","desc_zh":"高速卷接包产线高度成熟，全集团年 CapEx 仅 $375M–$450M，绝大部分 OCI 直接转化为分红与回购自由现金流。","note_zh":"<strong>当前选中支柱解读（04 现金流与退税杠杆）：<\/strong>2026Q3 可燃烟调整后 OCI 达 <strong>$3,072M<\/strong>（含 $124M 进出口关税退税收益），独立支撑奥驰亚连续 57 年第 61 次提高股息。","note_en":"<strong>Selected Pillar (04 · Free Cash Flow & Drawback):<\/strong> Q3 2026 Smokeable Adjusted OCI reached <strong>$3,072M<\/strong> (bolstered by $124M in duty drawback refunds), funding Altria's 61st dividend hike in 57 years.","desc_en":"Mature high-speed making/packing lines keep total company CapEx at just $375M–$450M/yr, converting OCI directly into dividends and buybacks."}],"radar":{"title_zh":"美国卷烟核心旗舰品牌五维竞争力雷达图（10分制）","title_en":"5-Axis US Cigarette Brand Moat Radar (10-Point Scale)","axes_zh":["高端品牌定价权","终端背柜覆盖率","内部价格带纵深","单包利润转化率","跨周期份额韧性"],"axes_en":["Pricing Power","Retail Backbar","Price-Tier Depth","Unit Margin","Share Resilience"],"s0_zh":"Marlboro 万宝路 (39.5%总份额 · 60%高端)","s0_en":"Marlboro (39.5% Share · 60% Premium)","s1_zh":"Newport 新港 (BAT/雷诺薄荷醇旗舰)","s1_en":"Newport (BAT/Reynolds Menthol)","s2_zh":"Natural American Spirit (雷诺超高端有机线)","s2_en":"Natural American Spirit (Super-Premium)","v0":[9.6,9.9,9.4,9.7,9.2],"v1":[8.6,8.7,6.8,8.8,7.2],"v2":[9.4,7.5,5.8,9.1,8.4]}},"ch3":{"eyebrow":"CHAPTER 03 · U.S. CIGARETTE BRAND PEER BENCHMARKING","h2_zh":"三、全美卷烟核心品牌横向对比：高端霸主、薄荷醇劲敌与深折黑马","h2_en":"3. US Cigarette Brand Matrix: Flagship Leader vs. Premium & Discount Rivals","peers_zh":[{"category":"altria","benchmark":true,"title":"研究标的：Marlboro 万宝路旗舰系列","creator":"Philip Morris USA (奥驰亚全资)","format":"主流高端至次高端全谱系 (~$9.50/包均价)","craft":"经典美式混合烟叶 · Red/Gold/Menthol/Black/Cowboy Cut","views":"2026前9月 38,673M 支 · 总份额 39.5% / 高端 60.0%","acclaim":"11亿次便利店客流 · 可燃 OCI 率 64.8%","takeaway":"全美卷烟绝对定价锚：Cowboy Cut 补齐次高端防线，凭 RGM 净提价持续跑赢销量自然递减。","sourceLabel":"Altria Q3'26","sourceUrl":"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx"},{"category":"altria","benchmark":false,"title":"Basic & L&M 折扣防守双星","creator":"Philip Morris USA (奥驰亚全资)","format":"价值折扣与深折防守带 (~$5.10/包 Basic)","craft":"高性价比美式混合烟 · 定向门店价格锁定","views":"2026前9月 4,497M 支 (+69.7%) · 零售份额 4.1% (Q3)","acclaim":"助推 PM USA 总份额逆势升至 45.7%","takeaway":"与 Marlboro 形成完美协同：Marlboro 负责提价收割高净值烟民，Basic 冻价拦截深折流失。","sourceLabel":"Q3'26 / CSP","sourceUrl":"https://www.cspdailynews.com/tobacco/altria-raises-cigarette-prices-second-time-year"},{"category":"external","benchmark":false,"title":"Newport 新港 (全美第 2 大卷烟品牌)","creator":"R.J. Reynolds / 英美烟草 (BAT)","format":"高端薄荷醇绝对主力 (> $9.50–$10.50/包)","craft":"重度薄荷醇风味配方 · 非薄荷延伸线","views":"全美第 2 大品牌 (~11%–12% 估计份额，受加州禁令冲击)","acclaim":"州级风味禁令承压 · 依赖提价对冲销量下滑","takeaway":"高度依赖单一薄荷醇风味，在加州等薄荷禁令州流失惨重，抗政策集中度风险弱于 Marlboro。","sourceLabel":"CA Tobacco Dir","sourceUrl":"https://oag.ca.gov/tobacco/directory?page=8&order=field_tp_manufacturer&sort=asc"},{"category":"external","benchmark":false,"title":"Camel 骆驼 & Natural American Spirit","creator":"R.J. Reynolds / Santa Fe Natural (BAT)","format":"高端风味混合 + 超高端无添加概念","craft":"土耳其与弗吉尼亚烟叶 · NAS 慢燃高紧实度填丝","views":"合计约 ~11% 全美零售份额 · NAS 单价冠绝主流市场","acclaim":"NAS 客群高学历高粘性 · Camel 胶囊线受限","takeaway":"NAS 在超高端有机细分极具韧性，但总体规模不足 Marlboro 的十分之一，难以撼动渠道话语权。","sourceLabel":"Altria Q3'26","sourceUrl":"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx"},{"category":"external","benchmark":false,"title":"Montego 蒙特哥 (深折头号冲击波)","creator":"Liggett Vector Brands / 日本烟草 (JT Group)","format":"第四梯队深折卷烟 (~$4.50–$5.20/包)","craft":"极简渠道费用 + 低价走量抢占便利店底排","views":"2024.10 JT 收购 Vector (5.6%全美份额)，推升 JT 在美至 ~8%","acclaim":"全美折扣烟占比升至 34.1% 的最大外部受益者","takeaway":"倒逼 PM USA 激活 Basic 冻价反击与 Marlboro Cowboy Cut 下探的核心外部价格破坏者。","sourceLabel":"Japan Times / CSP","sourceUrl":"https://www.japantimes.co.jp/business/2025/10/04/companies/japan-tobacco-cheap-cigarettes/"}],"peers_en":[{"category":"altria","benchmark":true,"title":"Subject: Marlboro Flagship Series","creator":"Philip Morris USA (Altria 100%)","format":"Mainstream & Value-Premium (~$9.50/pack avg)","craft":"Iconic American blend · Red/Gold/Menthol/Black/Cowboy Cut","views":"38,673M sticks in 9M'26 · 39.5% Total / 60.0% Premium share","acclaim":"1.1B annual c-store trips · 64.8% Smokeable OCI margin","takeaway":"Unrivaled US cigarette price setter; Cowboy Cut fortified premium share at 60.0% while RGM pricing expanded margins.","sourceLabel":"Altria Q3'26","sourceUrl":"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx"},{"category":"altria","benchmark":false,"title":"Basic & L&M Discount Shield","creator":"Philip Morris USA (Altria 100%)","format":"Branded & Deep Discount (~$5.10/pack Basic)","craft":"Value American blend · Store-targeted price hold","views":"4,497M sticks in 9M'26 (+69.7%) · 4.1% Q3 retail share","acclaim":"Lifted total PM USA cigarette share to 45.7%","takeaway":"Works in tandem with Marlboro: Marlboro harvests premium pricing while Basic intercepts deep-discount down-traders.","sourceLabel":"Q3'26 / CSP","sourceUrl":"https://www.cspdailynews.com/tobacco/altria-raises-cigarette-prices-second-time-year"},{"category":"external","benchmark":false,"title":"Newport (#2 US Cigarette Brand)","creator":"R.J. Reynolds / BAT","format":"Premium Menthol Leader (>$9.50–$10.50/pack)","craft":"Signature full-menthol blend + non-menthol extensions","views":"#2 US brand (~11%–12% est. share; pressured by state bans)","acclaim":"High unit margin · Exposed to state menthol bans","takeaway":"Over-indexed to menthol vs. Marlboro's balanced non-menthol/menthol split, suffering steeper state flavor-ban losses.","sourceLabel":"CA Tobacco Dir","sourceUrl":"https://oag.ca.gov/tobacco/directory?page=8&order=field_tp_manufacturer&sort=asc"},{"category":"external","benchmark":false,"title":"Camel & Natural American Spirit","creator":"R.J. Reynolds / Santa Fe Natural (BAT)","format":"Turkish Premium + Super-Premium Additive-Free","craft":"Turkish/Domestic blend · NAS dense slow-burn leaf","views":"~11% combined US share · NAS commands highest pack price","acclaim":"Strong affluent urban loyalty · Niche scale vs. Marlboro","takeaway":"NAS enjoys super-premium stickiness, but lacks Marlboro's 300K-door AGDC mass-convenience footprint.","sourceLabel":"Altria Q3'26","sourceUrl":"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx"},{"category":"external","benchmark":false,"title":"Montego (Deep-Discount Disruptor)","creator":"Liggett Vector / Japan Tobacco (JT Group)","format":"4th-Tier Deep Discount (~$4.50–$5.20/pack)","craft":"Lean trade-spend value model targeting strapped smokers","views":"JT acquired Vector (5.6% US share) in Oct 2024 → ~8% JT US share","acclaim":"Primary driver of 34.1% industry discount tier","takeaway":"Key deep-discount rival that prompted PM USA's targeted Basic expansion and Marlboro Cowboy Cut rollout.","sourceLabel":"Japan Times / CSP","sourceUrl":"https://www.japantimes.co.jp/business/2025/10/04/companies/japan-tobacco-cheap-cigarettes/"}],"bars":{"title_zh":"2026Q3 全美卷烟零售市场份额结构拆解：Marlboro 单一品牌 vs 行业格局（%）","title_en":"Q3 2026 US Cigarette Retail Share Breakdown: Marlboro vs. Segment & Rival Shares (%)","sub_zh":"数据核验自奥驰亚 2026Q3 财报（Circana / MSAi STARS 零售扫描）及 JT/Vector 披露基准","sub_en":"Verified via Altria Q3 2026 Earnings Release (Circana / MSAi STARS) and JT/Vector acquisition disclosures","badge_zh":"PM USA 合计揽下 45.7% 市场","badge_en":"PM USA Commands 45.7% Total Share","leg1_zh":"蓝色/绿色：Marlboro 与 PM USA 内部品牌矩阵零售份额 (%)","leg1_en":"Blue / Green: Marlboro & PM USA Internal Portfolio Retail Share (%)","leg2_zh":"紫色/琥珀：全美行业折扣大盘及外部竞品份额参照 (虚线 = 30% 统治线)","leg2_en":"Purple / Amber: Industry Discount & Rival Benchmarks (Dashed = 30% Line)","max_x":50,"ref_line":30,"items_zh":[{"label":"PM USA 全系卷烟总份额 (含万宝路+折扣+其他高端)","val":45.7,"disp":"45.7%","sub":"同比 +0.3pp 逆势扩张","note":"全美卷烟第一制造商绝对壁垒"},{"label":"Marlboro 万宝路单一品牌总份额 (Q3 2026)","val":39.5,"disp":"39.5%","sub":"高端内部占比高达 60.0%","note":"超过全美第2至第8大卷烟品牌总和"},{"label":"全美卷烟行业折扣烟总占比 (Industry Discount)","val":34.1,"disp":"34.1%","sub":"同比 +2.0pp (通胀挤压)","note":"包含 Montego、Basic、Lucky Strike 等"},{"label":"日本烟草美国卷烟总份额 (JT 收购 Vector/Montego 后)","val":8.0,"disp":"~8.0%","sub":"Vector 原占 5.6% 份额","note":"深折品牌 Montego 领衔冲击"},{"label":"PM USA 折扣线份额 (Basic + L&M · Q3 2026)","val":4.1,"disp":"4.1%","sub":"同比大增 +1.4pp","note":"精准拦截价格敏感型降级客群"},{"label":"PM USA 其他超高端份额 (Parliament + Virginia Slims)","val":2.1,"disp":"2.1%","sub":"长期稳居 2.1%–2.3%","note":"高溢价凹陷滤嘴与超细支利基"}],"items_en":[{"label":"Total PM USA Cigarette Retail Share (Q3 2026)","val":45.7,"disp":"45.7%","sub":"+0.3pp YoY gain","note":"#1 US cigarette manufacturer"},{"label":"Marlboro Single-Brand Total Share (Q3 2026)","val":39.5,"disp":"39.5%","sub":"60.0% of US Premium tier","note":"Larger than next 7 US brands combined"},{"label":"Total US Industry Discount Segment (Q3 2026)","val":34.1,"disp":"34.1%","sub":"+2.0pp YoY expansion","note":"Driven by macro pressure on smokers"},{"label":"JT Group US Cigarette Share (Post-Vector Deal)","val":8.0,"disp":"~8.0%","sub":"Vector contributed 5.6%","note":"Anchored by deep-discount Montego"},{"label":"PM USA Discount Tier Share (Basic + L&M · Q3'26)","val":4.1,"disp":"4.1%","sub":"+1.4pp YoY surge","note":"Retains down-traders inside PM USA"},{"label":"PM USA Other Premium (Parliament + Virginia Slims)","val":2.1,"disp":"2.1%","sub":"Steady 2.1%–2.3% band","note":"High-margin super-premium niches"}]}},"ch4":{"eyebrow":"CHAPTER 04 · PACK UNIT ECONOMICS & MULTI-YEAR OCI SIMULATOR","h2_zh":"四、单包经济学与现金流推演：拆解 $9.50 终端零售价背后的 64.8% 营业利润率","h2_en":"4. Pack Economics & OCI Simulator: Inside a $9.50 Pack and 64.8% Operating Margin","sub_zh":"扣除联邦/州消费税、零售渠道返利与 MSA 大和解费用后，PM USA 单包净利仍冠绝全球快消品","sub_en":"Even after federal/state excise taxes, trade promos, and MSA settlement charges, per-pack OCI leads global CPG","badge_zh":"9M'26 可燃调整后 OCI $8,766M (+4.1%)","badge_en":"9M'26 Smokeable Adj. OCI $8,766M (+4.1%)","econ_cards":[{"label_zh":"TERMINAL PACK PRICE","label_en":"TERMINAL PACK PRICE","val_zh":"~$9.50 / 包","val_en":"~$9.50 / Pack","desc_zh":"全美主流州加权终端零售均价（纽约/加州等高税州可达 $13–$16+，南部低税州约 $7.50–$8.50）。","desc_en":"Weighted US retail pack average ($13–$16+ in high-tax NY/CA corridors; ~$7.50–$8.50 in lower-tax Southern states)."},{"label_zh":"MSA & FDA STATUTORY","label_en":"MSA & FDA STATUTORY","val_zh":"$3.27B / 年","val_en":"$3.27B / Yr","desc_zh":"FY2025 可燃烟分部计提州政府和解金 $3,028M + FDA 监管费 $245M（随销量下降按比例自然减少）。","desc_en":"FY2025 Smokeable accrued $3,028M in state MSA settlement payments plus $245M in FDA user fees (scaling down proportionally with volume)."},{"label_zh":"DUTY DRAWBACK LIFT","label_en":"DUTY DRAWBACK LIFT","val_zh":"$124M / 季","val_en":"$124M in Q3'26","desc_zh":"2026Q3 凭借代工出口卷烟放量（15.95亿支）兑现 $124M 关税退税，直接增厚分部毛利与 OCI。","desc_en":"Export volume surge (1,595M sticks in Q3'26) unlocked ~$124M in federal excise duty drawback benefits directly accretive to OCI."},{"label_zh":"ADJUSTED OCI MARGIN","label_en":"ADJUSTED OCI MARGIN","val_zh":"64.8% (9M'26)","val_en":"64.8% (9M'26)","desc_zh":"从 FY2024 的 61.6% → FY2025 的 63.4% → 2026前9月的 64.8%，连续三年实现利润率跃升。","desc_en":"Expanded for three straight years: 61.6% (FY24) → 63.4% (FY25) → 64.8% (9M 2026) via RGM discipline and cost control."}],"combo":{"title_zh":"奥驰亚可燃烟草分部（Marlboro 领衔）不含税净营收 vs 调整后 OCI 利润率演进","title_en":"Smokeable Segment (Anchored by Marlboro) Revenue Net of Excise ($B) vs. Adj. OCI Margin (%)","sub_zh":"2024 全年至 2026 前9月年化实绩：净提价与退税红利驱动营业利润率稳步突破 64.8%","sub_en":"FY2024 through 9M 2026 annualized: RGM pricing and duty drawback lifted Adjusted OCI margin to 64.8%","badge_zh":"连续跨周期站稳 >60% 目标线","badge_en":"Consistently Above 60% Enterprise Floor","left_zh":"■ 左轴：不含消费税净营收 ($ 十亿美元)","left_en":"■ Left Axis: Revenue Net of Excise ($B)","right_zh":"● 右轴：调整后 OCI 营业利润率 (%)","right_en":"● Right Axis: Adjusted OCI Margin (%)","leg1_zh":"不含消费税净营收 (左轴 · $B)","leg1_en":"Rev Net of Excise (Left · $B)","leg2_zh":"调整后 OCI 利润率 (右轴 · %)","leg2_en":"Adjusted OCI Margin (Right · %)","line_badge_zh":"--- 60.0% 集团2028目标底线","line_badge_en":"--- 60.0% 2028 Goal Floor","titles_zh":["2024全年","2025全年","2025前9月","2026前9月","2026Q3单季年化"],"titles_en":["FY 2024","FY 2025","9M 2025","9M 2026","Q3'26 Run-Rate"],"subs_zh":["OCI $10.92B","OCI $11.06B","OCI $8.42B","OCI $8.77B (+4.1%)","Q3 OCI $3.07B"],"subs_en":["OCI $10.92B","OCI $11.06B","OCI $8.42B","OCI $8.77B (+4.1%)","Q3 OCI $3.07B"],"bars":[17.74,17.44,13.07,13.53,19.05],"line":[61.6,63.4,64.4,64.8,64.5],"max_bar":22,"min_line":58,"max_line":68,"ref_line":60,"u_bar":"B","u_line":"%","highlight_idx":3},"sim":{"title_zh":"Marlboro 产品线多年期累计 OCI 现金流与退税/提价敏感度模拟器","title_en":"Marlboro Multi-Year Cumulative OCI & RGM / Drawback Simulator","toggle_title_zh":"开启 RGM 净提价跑赢通胀 + PMI 代工出口关税退税协同 (+16% 净现金流增厚)","toggle_title_en":"Enable RGM Net Price Elasticity + PMI Export Duty Drawback (+16% Lift)","toggle_sub_zh":"模拟每年 +7%–8% 目录净提价对冲销量自然下滑，并叠加里士满代工出口退税收益","toggle_sub_en":"Models +7%–8% annual net price realization offsetting secular stick decline plus export duty refunds","s1_label_zh":"首年基准国内出货规模 (亿包 · 1包=20支)","s1_label_en":"Year-1 Domestic Volume (100M Packs · 20 sticks/pk)","s1_unit_zh":"亿包","s1_unit_en":"00M Pks","s1_min":18,"s1_max":30,"s1_step":1,"s2_label_zh":"出厂单包调整后 OCI 净利实现 (USD / 包)","s2_label_en":"Net Manufacturer OCI per Pack (USD / Pack)","s2_unit_zh":"/包","s2_unit_en":"/pk","s2_min":2.8,"s2_max":5.0,"s2_step":0.1,"s3_label_zh":"代工出口与关税退税年均增量贡献 ($M / 年)","s3_label_en":"Annual Export Mfg & Duty Drawback Lift ($M/yr)","s3_min":100,"s3_max":650,"s3_step":25,"roi_label_zh":"相对年均 $350M 制造维护资本开支覆盖倍数","roi_label_en":"Coverage Multiple vs. $350M Annual Maint. CapEx","cost_base_m":350,"mult":1.16,"vol_drift":0.965,"presets":{"p1":{"label_zh":"① 悲观压力情景 (非法电子烟分流加剧+提价受阻)","label_en":"① Stress Case (Steeper Volume Erosion)","tag_zh":"23亿包 · 5年","tag_en":"2.3B Pks · 5Y","views":23,"v_per_view":3.4,"ancillary_m":150,"years":5,"transmedia":false},"p2":{"label_zh":"② 核心基准情景 (Cowboy Cut稳份额 + PMI代工退税)","label_en":"② Base Case (RGM + Cowboy Cut + PMI Deal)","tag_zh":"26亿包 · 5年","tag_en":"2.6B Pks · 5Y","views":26,"v_per_view":3.9,"ancillary_m":400,"years":5,"transmedia":true},"p3":{"label_zh":"③ 强化执法情景 (FDA严打非法一次性雾化回流可燃烟)","label_en":"③ Bull Case (Illicit Vape Crackdown + Price Lift)","tag_zh":"28亿包 · 7年","tag_en":"2.8B Pks · 7Y","views":28,"v_per_view":4.3,"ancillary_m":550,"years":7,"transmedia":true}}},"moat_pos_zh":"<strong>1. 全球罕见的负销量正利润复利机器：<\/strong>依靠 60.0% 高端烟绝对心智占有率，Marlboro 无需依赖行业扩容即可通过温和提价持续输出超百亿美元级年化 OCI。<br/><strong>2. 内部阶梯闭环生效：<\/strong>Cowboy Cut 与 Marlboro Black 在品牌伞内消化了通胀期的消费降级，避免了高端品牌直接打折伤及核心 Red/Gold 价盘。","moat_pos_en":"<strong>1. Negative-Volume, Positive-OCI Compounder:<\/strong> With 60.0% of US premium cigarettes, Marlboro consistently converts modest net price hikes into >$10B annual segment OCI.<br/><strong>2. Proven Internal Ladder:<\/strong> Cowboy Cut and Marlboro Black retain budget-conscious smokers without discounting flagship Red/Gold.","moat_risk_zh":"<strong>1. 非法调味一次性电子烟与现代口含袋双重分流：<\/strong>未获批灰色雾化烟与高强度尼古丁袋仍在持续侵蚀年轻成年烟民基数。<br/><strong>2. 绝对单包价格逼近 $10–$15 心理阈值：<\/strong>若宏观通胀与州消费税继续大幅叠加，部分边缘客群可能跨级滑向 $5 深折烟或跨境免税渠道。","moat_risk_en":"<strong>1. Dual Cross-Category Cannibalization:<\/strong> Illicit disposable e-vapor and fast-growing nicotine pouches continue to erode combustible consumption.<br/><strong>2. $10–$15 Pack Psychological Ceiling:<\/strong> Further state excise tax hikes could test price elasticity in lower-income geographies."},"ch5":{"eyebrow":"CHAPTER 05 · PRODUCT EVOLUTION TIMELINE & STRATEGIC BATTLES","h2_zh":"五、产品演进脉络与四大关键战役：从西部牛仔图腾到算法化四级价格矩阵","h2_en":"5. Product Evolution & Key Case Studies: From 1955 Flip-Top Box to Algorithmic RGM","sub_zh":"复盘 Marlboro 如何跨越广告禁令、PMI 境内外分拆、通胀深折潮与代工退税新纪元","sub_en":"Tracing how Marlboro navigated the MSA ad ban, 2008 PMI spin-off, discount waves, and 2026 export manufacturing","badge_zh":"1955 硬盒重塑 → 2008 美股独立 → 2026 60%高端新高","badge_en":"1955 Flip-Top → 2008 US Split → 2026 60% Premium","acts":[{"title_zh":"第一阶段 · 视觉与配方定型至全美登顶 (1955–1998) —— 翻盖硬盒与美式混合标准确立","title_en":"Act I · Flip-Top Box & American Blend Ascent (1955–1998)","badge_zh":"1972 起蝉联全美第 1","badge_en":"#1 US Brand Since 1972","desc_zh":"1955 年率先引入防压翻盖硬盒（Flip-Top Box）与红白屋顶几何视觉，自 1972 年起超越温斯顿（Winston）登顶全美销量第一并连续霸榜至今超半个世纪 <a class=\"cite-link\" href=\"https://www.altria.com/about-altria/our-companies\" target=\"_blank\" rel=\"noopener noreferrer\">Altria Heritage ↗<\/a>。","desc_en":"Pioneered the crush-proof Flip-Top Box and red-and-white chevron in 1955, overtaking Winston as America's #1 cigarette in 1972 and holding the crown for >50 consecutive years <a class=\"cite-link\" href=\"https://www.altria.com/about-altria/our-companies\" target=\"_blank\" rel=\"noopener noreferrer\">Altria Heritage ↗<\/a>."},{"title_zh":"第二阶段 · MSA 无广告护城河与境内外品牌确权 (1998–2023) —— 专注美国超高毛利本土市场","title_en":"Act II · Post-MSA Backbar Lock & 2008 PMI Spin-Off (1998–2023)","badge_zh":"美国本土商标 100% 归属 PM USA","badge_en":"100% US Trademark Ownership","desc_zh":"1998 年 MSA 协议终结大众营销战；2008 年菲莫国际（PMI）分拆独立后，PM USA 永久独占美国本土 Marlboro 商标与定价权，并通过 Marlboro Black 与 Rewards 数字化体系深耕单店回报。","desc_en":"Following the 1998 MSA ad ban and 2008 PMI spin-off, PM USA retained 100% ownership of the US Marlboro trademark, shifting from mass advertising to retail backbar contracts and digital loyalty."},{"title_zh":"第三阶段 · Cowboy Cut 防守反击与跨国代工退税跃迁 (2024–2026) —— 高端内份额重上 60.0%","title_en":"Act III · Cowboy Cut Rollout & Export Drawback Era (2024–2026)","badge_zh":"64.8% 9M'26 分部 OCI 率","badge_en":"64.8% 9M'26 Adj. OCI Margin","desc_zh":"面对高通胀与深折烟浪潮，2025–2026 年将 <strong>Marlboro Cowboy Cut<\/strong> 迅速推向约 100,000 家门店，助推高端烟内部份额于 2026Q3 升至 <strong>60.0%<\/strong>；同步与 PMI 缔结 2027 互惠代工协议打开退税第二引擎 <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Q3'26 Release ↗<\/a>。","desc_en":"Scaled <strong>Marlboro Cowboy Cut<\/strong> to ~100,000 stores to push premium segment share to <strong>60.0%<\/strong> in Q3 2026, while signing the Aug 2026 PMI mutual contract-manufacturing agreement <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Q3'26 Release ↗<\/a>."}],"battles":[{"tag_zh":"战役 01 · 2025–2026Q3","tag_en":"Case 01 · 2025–Q3'26","sub_zh":"10万门店侧翼卡位","sub_en":"100K-Store Flanker","title_zh":"Marlboro Cowboy Cut 逆势收复 60% 高端大关","title_en":"Cowboy Cut Propels Premium Share to 60.0%","desc_zh":"在不降低核心红万/金万目录价的前提下，用 Cowboy Cut 精准承接对价格敏感但眷恋万宝路口感的烟民，使高端内份额环比提升 +0.4pp 至 60.0% <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Q3'26 Release ↗<\/a>。","desc_en":"Protected core Red/Gold list prices while giving budget-pressed loyalists an authentic Marlboro tier across ~100,000 stores, lifting premium share +0.4pp QoQ to 60.0% <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Q3'26 Release ↗<\/a>."},{"tag_zh":"战役 02 · 2026-04-13","tag_en":"Case 02 · Apr 13, 2026","sub_zh":"非对称结构性提价","sub_en":"Asymmetric Price Hike","title_zh":"年内二次提价 Marlboro 而冻结 Basic 价格","title_en":"Hiking Marlboro List Prices While Holding Basic Flat","desc_zh":"2026 年 4 月 PM USA 对 Marlboro 等主流线实施年内第二次提价，但刻意维持折扣牌 Basic 出厂价不变，实现“高端收割利润、底端锁死份额” <a class=\"cite-link\" href=\"https://www.cspdailynews.com/tobacco/altria-raises-cigarette-prices-second-time-year\" target=\"_blank\" rel=\"noopener noreferrer\">CSP Daily News ↗<\/a>。","desc_en":"Raised Marlboro list prices for the second time in 2026 while leaving Basic unchanged—maximizing premium profit extraction while blocking deep-discount defection <a class=\"cite-link\" href=\"https://www.cspdailynews.com/tobacco/altria-raises-cigarette-prices-second-time-year\" target=\"_blank\" rel=\"noopener noreferrer\">CSP Daily News ↗<\/a>."},{"tag_zh":"战役 03 · 2026-08-24","tag_en":"Case 03 · Aug 24, 2026","sub_zh":"分拆18年后产能握手","sub_en":"PM USA × PMI Alliance","title_zh":"与菲莫国际签署双向代工协议激活 $124M 季退税","title_en":"PMI Mutual Manufacturing Pact & $124M Q3 Duty Refund","desc_zh":"代工出口卷烟 Q3 猛增至 15.95 亿支（单季退税受益 $124M），并与 PMI 敲定 2027 年起长期双向代工合作，把闲置产能变成纯利中心 <a class=\"cite-link\" href=\"https://www.investing.com/news/stock-market-news/altria-philip-morris-international-sign-contract-manufacturing-deals-4873428\" target=\"_blank\" rel=\"noopener noreferrer\">PMI Deal ↗<\/a>。","desc_en":"Grew Q3 export contract volume to 1,595M sticks ($124M Q3 duty refund benefit) and locked in multi-year mutual manufacturing with PMI starting 2027 <a class=\"cite-link\" href=\"https://www.investing.com/news/stock-market-news/altria-philip-morris-international-sign-contract-manufacturing-deals-4873428\" target=\"_blank\" rel=\"noopener noreferrer\">PMI Deal ↗<\/a>."},{"tag_zh":"战役 04 · 2025.08–2026.10","tag_en":"Case 04 · Aug'25–Oct'26","sub_zh":"品牌无烟化跨界延伸","sub_en":"Heated Brand Extension","title_zh":"Marlboro 商标首次赋能 Ploom 加热不燃烧烟支","title_en":"Marlboro Heated Tobacco Sticks Enter FDA PMTA/MRTPA","desc_zh":"通过与日本烟草合资的 Horizon 提交 FDA 申请并在 2026 NACS 展实机展示 Marlboro 品牌加热烟支，为存量万宝路烟民铺设品牌内减害迁徙通道 <a class=\"cite-link\" href=\"https://www.2firsts.com/news/altria-showcases-ploom-marlboro-heated-tobacco-sticks-and-non-nicotine-energy-products-at-nacs-show-2026\" target=\"_blank\" rel=\"noopener noreferrer\">2Firsts NACS ↗<\/a>。","desc_en":"Leveraged Marlboro's iconic equity onto PM USA-made heated tobacco sticks for JT's Ploom device under Aug 2025 FDA PMTA/MRTPA filings <a class=\"cite-link\" href=\"https://www.2firsts.com/news/altria-showcases-ploom-marlboro-heated-tobacco-sticks-and-non-nicotine-energy-products-at-nacs-show-2026\" target=\"_blank\" rel=\"noopener noreferrer\">2Firsts NACS ↗<\/a>."}],"laws":[{"zh":"成熟成瘾性消费品的终极护城河不在总销量增长，而在“净提价幅度持续高于销量衰减率 200–400 bps”的剪刀差。","en":"In mature nicotine categories, durability comes from sustaining net price realization 200–400 bps above annual unit volume decline."},{"zh":"绝不用旗舰主线打价格战：必须通过 Cowboy Cut 与 Black 等品牌内子梯队定向隔离价格敏感客群。","en":"Never discount flagship Red/Gold across the board; isolate price-sensitive smokers via tiered sub-lines like Cowboy Cut."},{"zh":"高固定资产卷烟厂在减量时代的破局之道，是用跨国合同代工出口与关税退税对冲本土产能摊销压力。","en":"Offset domestic factory deleveraging by filling excess high-speed line capacity with export contract manufacturing and duty drawback."}]},"ch6":{"h2_zh":"六、“万宝路定价权法则”旗舰可燃单品护城河核查清单","h2_en":"6. 'Marlboro Pricing Law' Flagship Combustible Moat Checklist","items_zh":[{"tag":"60.0% 高端内份额","title":"1. 高端细分绝对统治测试：在高端价格带内部份额是否稳定在 58%–60%+？","desc":"核验面对通胀降级时，Marlboro 在全美 Premium 卷烟池内的相对份额是否逆势提升而非流失给同级竞品。"},{"tag":"净价 > 销量降幅","title":"2. 价格弹性剪刀差测试：单包不含税净实现收入涨幅能否完全覆盖 -6%–7% 销量下滑？","desc":"跟踪每季可燃烟分部不含税净营收增速（如 2026Q3 +3.7%）与调整后 OCI 增速（+3.9%）是否持续为正。"},{"tag":"~100,000 门店覆盖","title":"3. 内部子线截留效率测试：Cowboy Cut 与 Black 是否有效阻断向第四梯队杂牌烟流失？","desc":"评估次高端子线的复购留存率，确认其未过度侵蚀高毛利核心 Red/Gold 存量客群。"},{"tag":"1.1B 便利店行程","title":"4. 终端背柜主权测试：AGDC 在全美 >30万门店的首排视觉占比与忠诚篮子渗透率是否稳固？","desc":"检验便利店渠道合作返利对主货架陈列面积（Share of Shelf）的锁定力。"},{"tag":"$124M/季 退税红利","title":"5. 出口代工与退税持续性测试：PMI 双向代工履约与联邦关税退税法规是否稳健？","desc":"跟踪合同出口卷烟出货量（9M'26 达 29.41亿支）及海关退税政策变动风险。"},{"tag":"Ploom 品牌承接","title":"6. 无烟化品牌延伸测试：Marlboro 加热烟支获批后能否将万宝路烟民留在自有生态？","desc":"核查 Horizon 递交的 PMTA/MRTPA 审批进展与老烟民口味还原度。"}],"items_en":[{"tag":"60.0% Premium Share","title":"1. Premium Dominance Test: Does share of the US Premium segment hold at 58%–60%+?","desc":"Verify Marlboro gains share within the premium pool even when total industry discount share expands."},{"tag":"Price > Vol Decline","title":"2. Elasticity Spread Test: Does net price realization consistently outpace -6% to -7% stick decline?","desc":"Track quarterly Smokeable revenue net of excise (+3.7% in Q3'26) and Adjusted OCI growth (+3.9%)."},{"tag":"~100K Cowboy Cut Doors","title":"3. Internal Ladder Test: Are Cowboy Cut & Black intercepting down-traders without cannibalizing Red/Gold?","desc":"Audit store-level RGM promo efficiency across low- vs. high-income zip codes."},{"tag":"1.1B C-Store Trips","title":"4. Backbar Sovereignty Test: Does AGDC preserve top-shelf visibility across >300K retail stores?","desc":"Monitor convenience-store traffic attachment and 55% tobacco loyalty basket penetration."},{"tag":"$124M Q3 Drawback","title":"5. Export & Duty Drawback Test: Are PMI contract volumes and federal duty refund rules durable?","desc":"Track contract export stick ramp (2,941M in 9M'26) and 2027 PMI agreement execution."},{"tag":"Marlboro HeatSticks","title":"6. Smoke-Free Brand Bridge Test: Can Marlboro heated sticks transition smokers inside Altria's ecosystem?","desc":"Follow FDA PMTA/MRTPA review milestones for Horizon's Ploom × Marlboro platform."}]},"sources":[{"label":"Altria Q3 & 9M 2026 Official Earnings Release (Tables 2, 3 & 4: Marlboro 39.5% Share, 60.0% Premium, Cowboy Cut)","url":"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx"},{"label":"SEC Form 8-K Exhibit 99.1 — Altria Q4 & Full-Year 2025 Results (54,933M Marlboro Sticks, $11,064M Smokeable Adj. OCI)","url":"https://www.sec.gov/Archives/edgar/data/764180/000076418026000007/exhibit991erq42025.htm"},{"label":"SEC Form 8-K Exhibit 99.1 — Altria Q2 & First-Half 2026 Results (Table 3 & 4 Quarterly Cigarette Volumes)","url":"https://www.sec.gov/Archives/edgar/data/764180/000076418026000093/exhibit991erq22026.htm"},{"label":"CSP Daily News: Altria Raises Cigarette Prices for Second Time in 2026 (Apr 13, 2026)","url":"https://www.cspdailynews.com/tobacco/altria-raises-cigarette-prices-second-time-year"},{"label":"Investing.com: Altria & Philip Morris International Sign Mutual Contract Manufacturing Deals Starting 2027 (Aug 24, 2026)","url":"https://www.investing.com/news/stock-market-news/altria-philip-morris-international-sign-contract-manufacturing-deals-4873428"},{"label":"2Firsts NACS Show 2026 Report: 1.1 Billion Annual PM USA Convenience-Store Trips & Marlboro Heated Sticks","url":"https://www.2firsts.com/news/altria-showcases-ploom-marlboro-heated-tobacco-sticks-and-non-nicotine-energy-products-at-nacs-show-2026"},{"label":"Japan Times / UBS: US Marlboro (~$9.50/pack) vs. Discount Cigarette Pricing & JT Montego Competition","url":"https://www.japantimes.co.jp/business/2025/10/04/companies/japan-tobacco-cheap-cigarettes/"},{"label":"State of California DOJ Tobacco Directory: PM USA Certified Marlboro Cowboy Cut & Black Styles","url":"https://oag.ca.gov/tobacco/directory?page=8&order=field_tp_manufacturer&sort=asc"}],"quickJumpZh":[{"sec":"sec-00","title":"00 单品定评与核心份额面板","sub":"39.5%全美总份额 · 60.0%高端垄断 · 64.8%分部OCI率"},{"sec":"sec-01","title":"01 产品线子矩阵与配方分销架构","sub":"Red/Gold/Menthol/Black/Cowboy Cut 四级价格带"},{"sec":"sec-02","title":"02 四大定价权支柱与护城河雷达","sub":"低价格弹性 · RGM算法 · 11亿便利店行程 · 退税协同"},{"sec":"sec-03","title":"03 全美高端与主流卷烟竞品矩阵","sub":"对比 Newport、NAS、Camel 与深折黑马 Montego"},{"sec":"sec-04","title":"04 单包经济学与多年期现金流推演","sub":"$9.50终端价拆解 · 可调销量/净利/退税交互模拟器"},{"sec":"sec-05","title":"05 价格阶梯演进与关键商业战役","sub":"Cowboy Cut 十万店扩铺 · PMI 双向代工协议"},{"sec":"sec-06","title":"06 旗舰可燃烟草定价权核查清单","sub":"6项量化指标本地持久化核验"},{"sec":"sec-07","title":"07 SEC 财报与权威信源核验索引","sub":"一手季报、年报与行业监测原文直达"}],"quickJumpEn":[{"sec":"sec-00","title":"00 Product Verdict & Share Scorecard","sub":"39.5% total US share · 60.0% of premium · 64.8% Adj. OCI"},{"sec":"sec-01","title":"01 Sub-Line Architecture & AGDC Shelf","sub":"Red, Gold, Menthol, Black & Cowboy Cut 100K-store ladder"},{"sec":"sec-02","title":"02 4 Pricing-Power Pillars & Moat Radar","sub":"Inelastic loyalty, granular RGM, 1.1B c-store trips & drawback"},{"sec":"sec-03","title":"03 US Cigarette Peer Benchmarking","sub":"Benchmarking Newport, NAS, Camel & JT's Montego"},{"sec":"sec-04","title":"04 Pack Economics & OCI Simulator","sub":"$9.50 pack breakdown & interactive multi-year OCI model"},{"sec":"sec-05","title":"05 Price-Ladder Evolution & Key Battles","sub":"Cowboy Cut expansion, asymmetric hikes & PMI mfg pact"},{"sec":"sec-06","title":"06 Flagship Pricing Moat Checklist","sub":"6-point persistent moat verification"},{"sec":"sec-07","title":"07 SEC Filings & Primary Sources","sub":"Direct links to Altria 8-K/10-K tables & trade reports"}]},{"id":"basic_lm","idx_num":2,"idx_pad":"02","filename":"mo_prod_02_basic_lm_discount.html","checkKey":"mui_mo_checks_basic_lm","monogram":"BL","short_zh":"Basic & L&M 折扣矩阵","short_en":"Basic & L&M Discount","pill_kpi":"9M销量+69.7% · 4.1%份额","docTitleZh":"《Basic & L&M 折扣卷烟防守矩阵》单品深度商业研报 | 王安安数据中心","docTitleEn":"Basic & L&M Discount Cigarette Defense Matrix Monograph | Research Hub","crumb_zh":"Basic & L&M 折扣卷烟侧翼护卫矩阵（PM USA）","crumb_en":"Basic & L&M Discount Cigarette Flanker Matrix (PM USA)","chip1_zh":"9M'26 出货暴涨 +69.7%","chip1_en":"9M'26 Volume +69.7% YoY","chip2_zh":"折扣份额翻倍至 4.1% · 狙击 Montego","chip2_en":"4.1% Discount Share · Montego Counter","sidebar":{"badge":"PM USA · RGM DISCOUNT FLANKER","title_zh":"Basic & L&M 研报","title_en":"Basic & L&M Monograph","sub_zh":"2026前9月出货猛增 69.7% 至 44.97亿支 × ~$5.10/包精准锁价 × 助推 PM USA 总份额重返 45.7%","sub_en":"4,497M sticks in 9M 2026 (+69.7% YoY) × ~$5.10/pack targeted price hold × Lifted PM USA share to 45.7%","mini_kpis":[{"label_zh":"2026前9月折扣线出货量","label_en":"9M 2026 Discount Vol","val_zh":"4,497M (+69.7%)","val_en":"4,497M (+69.7%)"},{"label_zh":"PM USA 折扣零售份额 (Q3)","label_en":"Discount Share (Q3'26)","val_zh":"4.1% (+1.4pp)","val_en":"4.1% (+1.4pp)"},{"label_zh":"全美行业折扣烟总占比","label_en":"Industry Discount Tier","val_zh":"34.1% (+2.0pp)","val_en":"34.1% (+2.0pp)"}]},"toc":[["单品定评与逆势爆发成绩单","Product Verdict & Surge KPIs"],["双层折扣架构与门店定向锁价","Dual-Tier Discount & Geo-Pricing"],["四大侧翼攻防支柱与雷达对比","4 Flanker Pillars & Moat Radar"],["全美折扣与深折卷烟竞品矩阵","US Discount Cigarette Benchmarking"],["单包边际贡献与存量截留模拟器","Contribution Margin & Retention Sim"],["从战略雪藏到重装反击演进史","From Dormant Brand to RGM Counterattack"],["折扣侧翼护卫舰纪律核查清单","Discount Flanker Discipline Checklist"],["SEC 财报与行业价格信源索引","SEC Filings & Pricing Sources"]],"hero":{"strip1_zh":"单品定评：奥驰亚 2025–2026 增速最猛的销量黑马，以精准外科手术式低价成功遏制深折竞品侵蚀","strip1_en":"Verdict: Altria's fastest-growing volume engine in 2025–2026, surgically countering deep-discount rivals without diluting Marlboro","strip2_zh":"品牌组合：Basic (深折反击尖刀) + L&M (品牌化次折扣阶梯)","strip2_en":"Portfolio: Basic (Deep-Discount Spearhead) + L&M (Branded Sub-Premium)","strip3_zh":"数据基准：2026Q3 季报核验 (2026-10-29)","strip3_en":"Baseline: Q3 2026 Release (Oct 29, 2026)","overline_zh":"FLANKER PRODUCT 02 · 9M'26 出货 44.97亿支 (+69.7%) × Q3 份额 4.1% (较2024翻倍) × ~$5.10/包终端卡位","overline_en":"FLANKER PRODUCT 02 · 4,497M 9M'26 Sticks (+69.7%) × 4.1% Q3 Share (>2x vs. 2024) × ~$5.10/Pack Retail Anchor","h1_zh":"Basic & L&M 折扣防守矩阵深度剖析：<span class=\"gradient-accent\">当全美 34.1% 卷烟滑向折扣带，奥驰亚如何用一款老牌“冻价奇兵”夺回总市场份额？<\/span>","h1_en":"Basic & L&M Discount Matrix Deep Dive: <span class=\"gradient-accent\">How PM USA Reactivated Basic at ~$5.10/Pack to Surge +69.7% in Volume and Reclaim Total Cigarette Share<\/span>","lead_zh":"受累于连续数年的食品能源通胀与可支配收入挤压，美国卷烟行业折扣烟（Discount Segment）零售占比从 2024 年的 29.6% 路飙升至 2026 年三季度的 <strong>34.1%<\/strong>（同比 +2.0pp），日本烟草（JT Group）更在 2024 年 10 月斥资约 $24 亿收购深折王牌 <strong>Montego<\/strong> 母公司 Vector Group 发起猛攻 <a class=\"cite-link\" href=\"https://www.cspdailynews.com/tobacco/jt-group-acquire-vector-group\" target=\"_blank\" rel=\"noopener noreferrer\">JT-Vector Deal ↗<\/a>。面对威胁，PM USA 并未让旗舰 Marlboro 降价应战，而是重新武装沉睡已久的国民价值品牌 <strong>Basic<\/strong>，配合品牌化折扣烟 <strong>L&M<\/strong> 展开门店级定向价格狙击：2026 年前9月，PM USA 折扣卷烟出货量狂飙 <strong>+69.7%<\/strong> 至 <strong>44.97 亿支<\/strong>（仅 9 个月即超越 2025 全年的 39.74 亿支！），零售份额从 2024 年的 <strong>1.9%<\/strong> 一举翻倍跃升至 2026Q3 的 <strong>4.1%<\/strong>，一举拉动 PM USA 全系卷烟总零售份额逆势正增长 <strong>+0.3pp<\/strong> 至 <strong>45.7%<\/strong> <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Altria Q3'26 Table 3 & 4 ↗<\/a>。","lead_en":"As cumulative inflation pushed the US cigarette industry's discount tier from 29.6% (2024) to <strong>34.1%<\/strong> in Q3 2026 (+2.0pp YoY) and Japan Tobacco acquired deep-discount leader <strong>Montego<\/strong> (Vector Group) <a class=\"cite-link\" href=\"https://www.cspdailynews.com/tobacco/jt-group-acquire-vector-group\" target=\"_blank\" rel=\"noopener noreferrer\">JT-Vector Deal ↗<\/a>, PM USA refused to slash Marlboro prices. Instead, it surgically deployed heritage value brand <strong>Basic<\/strong> (~$5.10/pack) alongside <strong>L&M<\/strong>—driving 9M 2026 Discount shipments up <strong>+69.7%<\/strong> to <strong>4,497M sticks<\/strong> (surpassing full-year 2025 in nine months), more than doubling PM USA's discount share from <strong>1.9%<\/strong> (2024) to <strong>4.1%<\/strong> (Q3 2026), and lifting total PM USA cigarette share +0.3pp YoY to <strong>45.7%<\/strong> <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Altria Q3'26 Table 3 & 4 ↗<\/a>.","thesis_cards":[{"title_zh":"非对称“冻价剪刀差”狙击第四梯队深折烟","title_en":"Asymmetric Price-Hold Against Tier-4 Rivals","desc_zh":"2026 年 4 月 PM USA 上调 Marlboro 与 L&M 目录价时刻意保持 Basic 价格不变（约 $5.10/包），正面贴身肉搏 Montego 与 Lucky Strike。","desc_en":"In Apr 2026 PM USA raised list prices on Marlboro and L&M while holding Basic flat (~$5.10/pack) to directly intercept Montego and Lucky Strike."},{"title_zh":"地理围栏投放避免“自我左右手互搏”","title_en":"Geo-Fenced Store Deployment Prevents Cannibalization","desc_zh":"仅在深折竞品高渗透邮编区与价值型连锁店重点给足 Basic 促销配额，在高收入商圈严格控制排面，保护 Marlboro 64.8% 分部利润率。","desc_en":"Deploys deep Basic promotional buydowns strictly in high-discount zip codes and value chains while protecting Marlboro's 64.8% margin in affluent metros."},{"title_zh":"L&M 承接中度降级 + Basic 兜底极限降级","title_en":"L&M (Branded Sub-Premium) + Basic (Deep Value) Duo","desc_zh":"L&M 卡位 ~$7.00–$8.00 次折扣带赚取稳健毛利，Basic 镇守 ~$5.00–$5.50 地板带，将原本流失出集团的烟民留在 AGDC 货架体系内。","desc_en":"L&M (~$7.00–$8.00 branded sub-premium) pairs with Basic (~$5.00–$5.50 deep discount) to keep down-trading smokers inside AGDC shelves."}],"kpis":[{"label_zh":"2026前9月折扣烟出货增速","label_en":"9M 2026 Volume Growth","badge_zh":"全集团增速第 1","badge_en":"#1 Growth Rate in MO","val_zh":"+69.7%","val_en":"+69.7%","desc_zh":"前9月出货 4,497M 支 vs 2025同期 2,650M 支（Q3 单季 1,704M 支，同比 +40.5%）<a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Q3'26 Table 3 ↗<\/a>","desc_en":"Shipped 4,497M sticks in 9M 2026 vs. 2,650M in 9M 2025 (Q3 reached 1,704M sticks, up +40.5% YoY) <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Q3'26 Table 3 ↗<\/a>"},{"label_zh":"PM USA 折扣线全美份额","label_en":"PM USA Discount Share","badge_zh":"较 2024 翻超两倍","badge_en":">2x Since FY2024","val_zh":"4.1%","val_en":"4.1%","desc_zh":"从 2024 全年 1.9% → 2025 全年 2.5% → 2026Q2 3.9% → 2026Q3 4.1%（同比 +1.4pp）<a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Q3'26 Table 4 ↗<\/a>","desc_en":"Climbed from 1.9% (FY24) → 2.5% (FY25) → 3.9% (Q2'26) → 4.1% (Q3'26, up +1.4pp YoY) <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Q3'26 Table 4 ↗<\/a>"},{"label_zh":"Basic 典型终端卡位均价","label_en":"Basic Typical Pack Price","badge_zh":"较万宝路折价 ~46%","badge_en":"~46% Below Marlboro","val_zh":"~$5.10 / 包","val_en":"~$5.10 / Pack","desc_zh":"UBS 与行业调研显示 Basic 终端均价约 $5.10/包（对比 Marlboro ~$9.50/包），精准咬住深折心理带 <a class=\"cite-link\" href=\"https://www.japantimes.co.jp/business/2025/10/04/companies/japan-tobacco-cheap-cigarettes/\" target=\"_blank\" rel=\"noopener noreferrer\">Japan Times / UBS ↗<\/a>","desc_en":"UBS and trade checks peg Basic around ~$5.10/pack (vs. ~$9.50 Marlboro), matching Tier-4 deep-discount psychological price points <a class=\"cite-link\" href=\"https://www.japantimes.co.jp/business/2025/10/04/companies/japan-tobacco-cheap-cigarettes/\" target=\"_blank\" rel=\"noopener noreferrer\">Japan Times / UBS ↗<\/a>"},{"label_zh":"拉动 PM USA 总市场份额","label_en":"Total PM USA Share Lift","badge_zh":"逆转多年微跌","badge_en":"Share Inflection","val_zh":"45.7%","val_en":"45.7%","desc_zh":"Basic +1.4pp 的增量完全填平了 Marlboro 总份额 -1.0pp 的波动，令 PM USA 总份额净增 +0.3pp <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Q3'26 Table 4 ↗<\/a>","desc_en":"Basic's +1.4pp discount share gain fully offset Marlboro's -1.0pp total share shift, lifting total PM USA share +0.3pp YoY to 45.7% <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Q3'26 Table 4 ↗<\/a>"}]},"ch1":{"eyebrow":"CHAPTER 01 · DUAL-BRAND DISCOUNT ARCHITECTURE & RGM GEO-TARGETING","h2_zh":"一、双层折扣架构与门店级价格工程：如何在抢夺深折销量的同时不拉垮 64.5% 利润率？","h2_en":"1. Dual-Brand Architecture & Geo-Pricing: Capturing Deep-Discount Volume Without Margin Collapse","sub_zh":"L&M 品牌化折扣溢价层 × Basic 深折贴身防守层 × 基于门店竞争密度的差异化促销配额","sub_en":"L&M branded-discount tier × Basic deep-value flanker × Store-cluster promotional Buydowns","badge_zh":"PM USA 内部组合拳 · 零增量产线投资","badge_en":"Shared Richmond Lines · Zero Extra CapEx","hub_title_zh":"PM USA 折扣侧翼双星系统（拦截外部深折流失 ↔ 分担里士满工厂固定制造摊销）","hub_title_en":"PM USA Two-Tier Discount Shield (Intercepting Defectors ↔ Absorbing Fixed Factory Overhead)","hub_sub_zh":"复用里士满高速卷接包设备与 AGDC 30万门店现成配送网 · 边际获客与渠道开拓成本趋近于零","hub_sub_en":"Runs on existing Richmond high-speed cigarette makers and AGDC's 300K-door salesforce at near-zero incremental SG&A","nodes":[{"tag_zh":"DEEP VALUE SPEARHEAD · 深折尖刀","tag_en":"DEEP VALUE · BASIC","name_zh":"Basic (Red / Gold / Menthol)","name_en":"Basic Full-Line Styles","desc_zh":"诞生于 1970 年代的经典美式无花哨平价烟（曾喊出“It's the best smoke for the money”），2025–2026 重装披挂狙击 $5 价格带。","desc_en":"Heritage 1970s no-frills American value cigarette ('It's the best smoke for the money') reactivated in 2025–2026 to defend the ~$5 tier."},{"tag_zh":"BRANDED DISCOUNT · 次折扣阶梯","tag_en":"BRANDED DISCOUNT · L&M","name_zh":"L&M (Turkish Blend / Bold / Menthol)","name_en":"L&M Branded Discount","desc_zh":"拥有百年 Liggett & Myers 渊源的顺滑土耳其混合配方，定价介于 Basic 与 Marlboro Black 之间，随主流节奏温和提价。","desc_en":"Smooth Liggett & Myers heritage blend positioned between Basic and Marlboro Black, taking steady list-price hikes to harvest margin."},{"tag_zh":"GEO-FENCED RGM · 商圈定向投放","tag_en":"GEO-FENCED RGM · STORE CLUSTERS","name_zh":"深折高危邮编区精准配货","name_en":"High-Discount Zip Targeting","desc_zh":"利用 Circana 与 MSAi STARS 周度批发扫描识别 Montego 渗透超标门店，定向投放 Basic 多包立减陈列贴（Buydown）。","desc_en":"Uses weekly Circana and MSAi STARS wholesale scans to pinpoint Montego hot-spots for targeted multi-pack Basic buydowns."},{"tag_zh":"ASYMMETRIC LIST PRICE · 非对称调价","tag_en":"ASYMMETRIC PRICING · APRIL 2026","name_zh":"主流提价 vs Basic 冻价","name_en":"Marlboro/L&M Hike vs. Basic Hold","desc_zh":"2026.04 提价窗口中 L&M 上调出厂价收割存量利润，Basic 保持原价扩大对竞品的性价比引力。","desc_en":"Apr 2026 asymmetric pricing lifted L&M list prices for margin while freezing Basic to widen its value edge against Tier-4 rivals."},{"tag_zh":"OVERHEAD ABSORPTION · 产能摊销","tag_en":"FIXED COST ABSORPTION","name_zh":"年化 ~60亿支增量填补产线","name_en":"~6B Annualized Stick Absorption","desc_zh":"2026前9月 44.97 亿支折扣烟分摊了里士满工厂折旧与 AGDC 巡店人力成本，间接托底 Marlboro 净利率。","desc_en":"4,497M 9M 2026 discount sticks absorb Richmond plant depreciation and AGDC field overhead, shielding Marlboro unit profitability."},{"tag_zh":"MSA PARITY · 合规成本对称","tag_en":"MSA STATUTORY PARITY","name_zh":"对冲第四梯队非签约厂商优势","name_en":"Countering Tier-4 NPM/Exemptions","desc_zh":"在合规缴付 MSA 与联邦消费税（$1.01/包）基础上靠极致生产规模把终端价压至 ~$5.10。","desc_en":"Matches ~$5.10 retail pricing through unmatched leaf purchasing and high-speed manufacturing scale while paying full MSA & $1.01 federal tax."}],"platform_bars":[{"title_zh":"MSAi STARS + Circana 实时批发零售雷达","title_en":"MSAi STARS + Circana Real-Time Share Radar","sub_zh":"按周监控全美便利店、一元店（Dollar Stores）及加油站折扣烟动销，动态调整 Basic 补贴深度。","sub_en":"Monitors weekly Dollar Store, gas-station, and c-store discount velocity via MSAi STARS + Circana to calibrate Basic buydown depth."},{"title_zh":"零新增固定费用的“边际贡献正循环”","title_en":"Zero-Incremental-Fixed-Cost Contribution Loop","sub_zh":"虽然单包毛利率低于 Marlboro，但每挽留一包原本流向 JT/ITG 的销量，均为 PM USA 带来纯增量现金毛利。","sub_en":"Every down-trading pack retained from JT/ITG delivers pure incremental gross contribution on zero incremental salesforce overhead."}],"principles":[{"title_zh":"1. 严格监控组合结构变动（Volume Mix Change）边界","title_en":"1. Disciplined Volume-Mix Guardrails","desc_zh":"奥驰亚在 2026Q3 财报中明确披露“折扣烟占比上升（Volume Mix Change）”对均价构成一定拖累，但通过精准限区投放，可燃分部调整后 OCI 率依然逆势提升 +0.1pp 至 <strong>64.5%<\/strong> <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Q3'26 Smokeable ↗<\/a>。","desc_en":"Altria noted unfavorable volume-mix headwinds from Basic's surge in Q3'26, yet strict store geo-fencing still lifted Smokeable Adjusted OCI margin +0.1pp YoY to <strong>64.5%<\/strong> <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Q3'26 Smokeable ↗<\/a>."},{"title_zh":"2. 阻断竞争对手利用深折现金流反哺新烟草","title_en":"2. Denying Rivals Easy Deep-Discount Cash Flow","desc_zh":"日本烟草收购 Vector 的核心逻辑是用 Montego 在美赚取可燃烟现金流；PM USA 放量 Basic（前9月 +69.7%）直接压缩了外部深折竞品的提价与扩利空间 <a class=\"cite-link\" href=\"https://www.japantimes.co.jp/business/2025/10/04/companies/japan-tobacco-cheap-cigarettes/\" target=\"_blank\" rel=\"noopener noreferrer\">Japan Times ↗<\/a>。","desc_en":"JT Group acquired Vector Group ($2.4B) to harvest US cash flow via Montego; Basic's <strong>+69.7%<\/strong> 9M surge squeezes rival deep-discount pricing headroom <a class=\"cite-link\" href=\"https://www.japantimes.co.jp/business/2025/10/04/companies/japan-tobacco-cheap-cigarettes/\" target=\"_blank\" rel=\"noopener noreferrer\">Japan Times ↗<\/a>."},{"title_zh":"3. 守护 AGDC 45.7% 全品类谈判权重","title_en":"3. Preserving AGDC's 45.7% Category Captaincy","desc_zh":"连锁便利店按制造商总销量占比分配背柜主导权；Basic 夺回的 +1.9pp（9M 同比）份额确保 PM USA 稳居 >45% 绝对品类舰长地位 <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Q3'26 Table 4 ↗<\/a>。","desc_en":"Retailers allocate backbar control by total manufacturer volume share; reclaiming +1.9pp (9M YoY) secures PM USA's >45% category captaincy <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Q3'26 Table 4 ↗<\/a>."}],"alert_zh":"<strong>关键数据里程碑：<\/strong>PM USA 折扣卷烟出货量从 2024 全年的 <strong>2,812M 支<\/strong> 跃升至 2025 全年的 <strong>3,974M 支（+41.3%）<\/strong>，而 2026 年仅前 9 个月即已轰出 <strong>4,497M 支（同比暴涨 +69.7%）<\/strong>，单季出货从 2024Q4 的 631M 支一路三级跳至 2025Q4 的 1,324M 支、2026Q2 的 1,487M 支与 2026Q3 的 <strong>1,704M 支<\/strong> <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Q3'26 & FY25 Tables ↗<\/a>。","alert_en":"<strong>Breakout Volume Inflection:<\/strong> PM USA Discount cigarette shipments accelerated from <strong>2,812M sticks<\/strong> in FY2024 to <strong>3,974M sticks (+41.3%)<\/strong> in FY2025, and reached <strong>4,497M sticks (+69.7% YoY)<\/strong> in just the first nine months of 2026—climbing sequentially to <strong>1,704M sticks<\/strong> in Q3 2026 <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Q3'26 & FY25 Tables ↗<\/a>.","chart":{"tabA_zh":"视图A: 季度出货量爆发与份额翻倍","tabA_en":"View A: Quarterly Surge & Share Doubling","tabB_zh":"视图B: 行业折扣占比 vs PM USA 折扣份额","tabB_en":"View B: Industry vs. PM USA Discount Share","viewA":{"mode":"dual_bar_line","title_zh":"PM USA 折扣卷烟（Basic + L&M）阶段出货量（百万支）与全美零售份额（%）","title_en":"PM USA Discount Cigarettes (Basic & L&M) Shipments (M Sticks) vs. Retail Share (%)","sub_zh":"从 2024Q4 的 6.31亿支/1.9% 份额起步，连续四个统计节点跳跃式攀升至 2026Q3 的 17.04亿支/4.1%","sub_en":"Surged from 631M sticks (1.9% share) in Q4 2024 to 1,704M sticks (4.1% share) in Q3 2026","leg1_zh":"单季国内出货量 (左轴 · 百万支)","leg1_en":"Quarterly Shipments (Left · M Sticks)","leg2_zh":"PM USA 折扣卷烟零售份额 (右轴 · %)","leg2_en":"PM USA Discount Retail Share (Right · %)","labels_zh":["2024Q4","2025Q3","2025Q4","2026Q2","2026Q3"],"labels_en":["Q4 2024","Q3 2025","Q4 2025","Q2 2026","Q3 2026"],"subs_zh":["反击启动前夜","Basic扩铺提速","+109.8% YoY","+67.3% YoY","+40.5% YoY"],"subs_en":["Pre-ramp base","Basic rollout","+109.8% YoY","+67.3% YoY","+40.5% YoY"],"s1":[631,1213,1324,1487,1704],"s2":[1.9,2.7,3.2,3.9,4.1],"max1":2000,"max2":5.0,"u1":"M","u2":"%"},"viewB":{"mode":"grouped_bars","title_zh":"2024–2026Q3 全美折扣烟行业大盘占比 vs PM USA 在折扣烟池内的捕获率（%）","title_en":"US Industry Discount Segment Share vs. PM USA Share Within Discount Pool (%)","sub_zh":"PM USA 在全美折扣烟池中的内部占有率从 2024 年的 6.4% 跃升至 2026Q3 的 12.0%（4.1% / 34.1%）","sub_en":"PM USA's capture rate inside the US discount cigarette segment nearly doubled from 6.4% (2024) to 12.0% (Q3'26)","leg1_zh":"全美行业折扣烟总占比 (%)","leg1_en":"Total Industry Discount Share (%)","leg2_zh":"PM USA 在折扣池内占有率 (%)","leg2_en":"PM USA Capture Within Discount (%)","labels_zh":["2024全年","2025全年","2026H1","2026Q3"],"labels_en":["FY 2024","FY 2025","1H 2026","Q3 2026"],"subs_zh":["1.9% / 29.6%","2.5% / 31.8%","3.8% / 33.6%","4.1% / 34.1%"],"subs_en":["1.9% / 29.6%","2.5% / 31.8%","3.8% / 33.6%","4.1% / 34.1%"],"s1":[29.6,31.8,33.6,34.1],"s2":[6.4,7.9,11.3,12.0],"max1":40,"u1":"%","u2":"%"}},"matrix_cards":[{"title_zh":"历史复盘：1993“万宝路星期五”教训的现代完美进化","title_en":"Evolving Beyond the 1993 'Marlboro Friday' Playbook","badge_zh":"拒绝主牌全面降价","badge_en":"Zero Flagship Cut","body_zh":"1993 年面对廉价烟冲击，当年管理层曾被迫全线下调 Marlboro 价格 20% 引发股价巨震；而 2025–2026 年奥驰亚用数字化 RGM 让 <strong>Basic<\/strong> 独立承担 ~$5.10 价格肉搏，完好保全了 Marlboro ~$9.50 的高溢价金身 <a class=\"cite-link\" href=\"https://www.japantimes.co.jp/business/2025/10/04/companies/japan-tobacco-cheap-cigarettes/\" target=\"_blank\" rel=\"noopener noreferrer\">Japan Times ↗<\/a>。","detail_zh":"这一策略进步的核心在于门店级数据颗粒度：只有在消费者确实流向外部第四梯队品牌的网点才释放 Basic 低价弹药，杜绝了无差别降价带来的数十亿美元利润蒸发。","body_en":"Unlike 1993's 'Marlboro Friday'—when PM slashed Marlboro prices 20% nationwide—today's PM USA isolates deep-value combat onto <strong>Basic<\/strong> (~$5.10/pack) in targeted zip codes while hiking Marlboro list prices <a class=\"cite-link\" href=\"https://www.japantimes.co.jp/business/2025/10/04/companies/japan-tobacco-cheap-cigarettes/\" target=\"_blank\" rel=\"noopener noreferrer\">Japan Times ↗<\/a>.","detail_en":"Store-level scan analytics allow PM USA to deploy Basic buydowns solely where Tier-4 rivals over-index, preventing self-inflicted margin erosion."},{"title_zh":"L&M 与 Basic 的高低双车协同分工","title_en":"L&M vs. Basic: Two-Step Sub-Premium Discipline","badge_zh":"差异化调价节奏","badge_en":"Split Price Cadence","body_zh":"在 2026 年 4 月的调价令中，<strong>L&M<\/strong> 跟随 Marlboro 上调出厂目录价以提升存量利润率，而 <strong>Basic<\/strong> 保持冻价承接最底端价格敏感客流，两款单品各司其职、互不踩踏 <a class=\"cite-link\" href=\"https://www.cspdailynews.com/tobacco/altria-raises-cigarette-prices-second-time-year\" target=\"_blank\" rel=\"noopener noreferrer\">CSP Daily News ↗<\/a>。","detail_zh":"过去数年 L&M 连续提价后逐渐脱离 $5 深折区间，客观上留出了底层真空；重启 Basic 恰好填补了这一战略拼图。","body_en":"In April 2026, PM USA raised list prices on <strong>L&M<\/strong> alongside Marlboro to harvest margin, while holding <strong>Basic<\/strong> flat to anchor the ~$5 deep-value floor <a class=\"cite-link\" href=\"https://www.cspdailynews.com/tobacco/altria-raises-cigarette-prices-second-time-year\" target=\"_blank\" rel=\"noopener noreferrer\">CSP Daily News ↗<\/a>.","detail_en":"Years of steady price increases had lifted L&M above deep-discount rivals; reactivating Basic sealed the bottom of the price ladder."}]},"ch2":{"eyebrow":"CHAPTER 02 · FOUR FLANKER PILLARS & 5-AXIS COMPETITIVE RADAR","h2_zh":"二、四大侧翼支柱：Basic & L&M 如何跑出 +69.7% 的逆周期增长？","h2_en":"2. Four Flanker Pillars: How Basic & L&M Engineered a +69.7% Volume Breakout","badge_zh":"战略定位：侧翼护卫舰 (保总份额 + 锁渠道权重)","badge_en":"Role: Strategic Flanker (Share Shield + Shelf Leverage)","pillars":[{"title_zh":"01 · ~$5.10 极限性价比锚点正面硬刚 Montego","title_en":"01 · ~$5.10 Retail Anchor Directly Matches Montego","badge_zh":"精准卡位第四梯队","badge_en":"Tier-4 Price Parity","desc_zh":"凭借 PM USA 超大规模烟叶集采与高速产线效率，在合规承担全额税费前提下做出媲美深折品牌的终端价。","note_zh":"<strong>当前选中支柱解读（01 ~$5.10 性价比卡位）：<\/strong>面对日本烟草收购 Vector 后力推 Montego，Basic 以 ~$5.10/包大厂品质正面截胡，令 PM USA 折扣池占有率翻倍至 12.0%。","note_en":"<strong>Selected Pillar (01 · ~$5.10 Price Parity):<\/strong> Backed by PM USA's leaf purchasing scale, Basic matches Tier-4 deep-discount pricing while offering trusted PM USA quality control.","desc_en":"Leverages PM USA leaf procurement and Richmond line speed to hit ~$5.10 retail while paying full statutory federal excise and MSA obligations."},{"title_zh":"02 · 邮政编码级动态返利（Buydown）精确制导","title_en":"02 · Zip-Code Promotional Buydown Precision","badge_zh":"严控 Mix 稀释","badge_en":"Controlled Mix Shift","desc_zh":"不在全美铺开廉价烟广告，仅在一元店、南部及中西部价格战重灾区激活零售商进货补贴。","note_zh":"<strong>当前选中支柱解读（02 精确制导防内耗）：<\/strong>尽管前9月折扣烟暴增 +69.7%，但占 PM USA 国内总卷烟比重仍控制在良性的 <strong>9.96%<\/strong>（4,497M / 45,146M），未伤及分部 64.8% 净利率根基。","note_en":"<strong>Selected Pillar (02 · Controlled Mix Shift):<\/strong> Even after growing +69.7% in 9M 2026, Discount remains a disciplined <strong>9.96%<\/strong> of PM USA's 45,146M domestic sticks.","desc_en":"Avoids nationwide discount advertising, activating retailer buydowns strictly in Dollar Stores and price-war zip codes."},{"title_zh":"03 · AGDC 零边际渠道开拓费用闪电铺货","title_en":"03 · Instant AGDC Distribution at Zero Extra Sales Force Cost","badge_zh":">30万现成终端网","badge_en":">300K Existing Doors","desc_zh":"无需新建销售团队，直接搭载 AGDC 巡店体系进驻便利店与连锁折扣渠道底层货架。","note_zh":"<strong>当前选中支柱解读（03 渠道协同）：<\/strong>独立小烟厂需向批发商让渡高额毛利换取上架，而 Basic 可直接打包进 PM USA 整体货架协议快速放量。","note_en":"<strong>Selected Pillar (03 · AGDC Shelf Synergy):<\/strong> Basic rides PM USA's existing retail contracts, scaling national distribution faster and cheaper than standalone discount manufacturers.","desc_en":"Rides existing AGDC field reps into 300K+ doors at near-zero incremental SG&A cost."},{"title_zh":"04 · 维护 PM USA 45.7% 行业总份额心理与议价红线","title_en":"04 · Defending PM USA's >45% Category Captaincy","badge_zh":"总份额 +0.3pp","badge_en":"+0.3pp Total Share","desc_zh":"在连锁便利店年度合同谈判中，总出货份额站稳 45%+ 决定了整个奥驰亚（含 on! PLUS 与雪茄）的排面话语权。","note_zh":"<strong>当前选中支柱解读（04 集团协同护盾）：<\/strong>2026Q3 PM USA 总份额同比提升 +0.3pp 至 <strong>45.7%<\/strong>，Basic 的 +1.4pp 贡献是稳住零售商头号供应商地位的最大功臣 <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Q3'26 Table 4 ↗<\/a>。","note_en":"<strong>Selected Pillar (04 · Category Captaincy):<\/strong> Lifting total PM USA share +0.3pp YoY to <strong>45.7%<\/strong> preserves AGDC's #1 supplier clout for negotiating oral and smoke-free shelf space <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Q3'26 Table 4 ↗<\/a>.","desc_en":"Holding >45% total cigarette share anchors PM USA's annual retail contract leverage for Marlboro, Black & Mild, and on! PLUS."}],"radar":{"title_zh":"美国折扣卷烟核心品牌五维攻防能力雷达图（10分制）","title_en":"5-Axis US Discount Cigarette Competitive Radar (10-Point Scale)","axes_zh":["终端低价穿透力","分销网络广度","品控与品牌信任","单包毛利韧性","防内耗精准度"],"axes_en":["Price Competitiveness","Distribution Reach","Quality Trust","Unit Margin","Anti-Cannibalization"],"s0_zh":"Basic & L&M (PM USA · 4.1%份额 +69.7%增速)","s0_en":"Basic & L&M (PM USA · 4.1% Share, +69.7%)","s1_zh":"Montego 蒙特哥 (JT/Vector 深折龙头)","s1_en":"Montego (JT/Vector Deep-Discount Leader)","s2_zh":"Lucky Strike / Pall Mall (BAT/雷诺折扣双线)","s2_en":"Lucky Strike / Pall Mall (BAT/Reynolds)","v0":[8.9,9.6,9.2,8.3,9.5],"v1":[9.6,8.2,7.6,7.8,8.8],"v2":[8.5,8.9,8.5,8.0,7.6]}},"ch3":{"eyebrow":"CHAPTER 03 · U.S. DISCOUNT CIGARETTE BENCHMARKING","h2_zh":"三、全美折扣与深折卷烟竞品横向对比：34.1% 价格敏感战场的贴身博弈","h2_en":"3. US Discount Cigarette Matrix: Inside the 34.1% Value Battlefield","peers_zh":[{"category":"altria","benchmark":true,"title":"研究标的：Basic 深折反击线","creator":"Philip Morris USA (奥驰亚)","format":"深折防守尖刀 (~$5.10/包典型终端价)","craft":"大厂标准美式烤烟混合 · 2026.04 定向冻价","views":"驱动 PM USA 折扣线 9M'26 暴涨 +69.7% 至 4,497M 支","acclaim":"推动 PM USA 折扣份额从 1.9% 翻倍至 4.1%","takeaway":"外科手术式侧翼反击典范：只向深折高危区投放补贴，既抢回销量又守住分部 64.8% 利润率。","sourceLabel":"Q3'26 / CSP","sourceUrl":"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx"},{"category":"altria","benchmark":false,"title":"研究标的：L&M 品牌化折扣线","creator":"Philip Morris USA (奥驰亚)","format":"次折扣/品牌化价值带 (~$7.00–$8.20/包)","craft":"顺滑土耳其烟叶混调 · Red/Blue/Turkish/Menthol","views":"纳入 PM USA Discount 统计口径 · 存量利润稳定器","acclaim":"2026.04 跟随主流上调目录价收割利润","takeaway":"承接轻度价格敏感烟民，与 Basic 拉开约 $2 价差，构筑双层价值防线。","sourceLabel":"CSP Price Hike","sourceUrl":"https://www.cspdailynews.com/tobacco/altria-raises-cigarette-prices-second-time-year"},{"category":"external","benchmark":false,"title":"Montego 蒙特哥 (全美第一大折扣烟)","creator":"Liggett Vector Brands / 日本烟草 (JT Group)","format":"第四梯队深折霸主 (~$4.50–$5.20/包)","craft":"极致精简营销费用 + 渠道低价铺货","views":"支撑 Vector 被收购前斩获 5.6% 全美份额、JT 升至 ~8%","acclaim":"2022–2025 全美份额增长最快的深折品牌","takeaway":"实力强劲的头号对手，但自 JT 接手后同样面临盈利回报诉求，与 Basic 形成均势拉锯。","sourceLabel":"Japan Times / CSP","sourceUrl":"https://www.japantimes.co.jp/business/2025/10/04/companies/japan-tobacco-cheap-cigarettes/"},{"category":"external","benchmark":false,"title":"Lucky Strike (重装复兴折扣线) & Pall Mall","creator":"R.J. Reynolds / 英美烟草 (BAT)","format":"品牌化折扣与深折双轨 (~$5.50–$7.80/包)","craft":"老牌遗产商标折价重塑 · 滤嘴红圈标志","views":"Pall Mall 老化下滑，靠低价版 Lucky Strike 承接流转","acclaim":"内部 Pall Mall ↔ Lucky Strike 左右互搏明显","takeaway":"证明老牌高知名度商标下放折扣带具备强号召力，但需严防侵蚀自有高端品牌。","sourceLabel":"CA Tobacco Dir","sourceUrl":"https://oag.ca.gov/tobacco/directory?page=8&order=field_tp_manufacturer&sort=asc"},{"category":"external","benchmark":false,"title":"Maverick & USA Gold / Sonoma","creator":"ITG Brands (帝国品牌 Imperial Brands)","format":"传统区域深折品牌 (~$5.20–$6.80/包)","craft":"中西部与东南部便利店深折阵地","views":"受 Montego 与 Basic 双面夹击，份额承压","acclaim":"帝国品牌美国可燃烟现金牛补充","takeaway":"缺乏 AGDC 级全美终端覆盖密度，在 Basic 冻价反攻下首当其冲被分流。","sourceLabel":"Japan Times","sourceUrl":"https://www.japantimes.co.jp/business/2025/10/04/companies/japan-tobacco-cheap-cigarettes/"}],"peers_en":[{"category":"altria","benchmark":true,"title":"Subject: Basic Deep-Discount Line","creator":"Philip Morris USA (Altria)","format":"Deep-Value Flanker (~$5.10/pack typical retail)","craft":"PM USA American blend · Held flat in Apr 2026 hike","views":"Propelled 9M'26 PM USA Discount +69.7% to 4,497M sticks","acclaim":"Doubled PM USA Discount share from 1.9% to 4.1%","takeaway":"Surgical RGM textbook case: deploys targeted buydowns to capture value smokers without diluting 64.8% segment margin.","sourceLabel":"Q3'26 / CSP","sourceUrl":"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx"},{"category":"altria","benchmark":false,"title":"Subject: L&M Branded Discount Line","creator":"Philip Morris USA (Altria)","format":"Branded Sub-Premium (~$7.00–$8.20/pack)","craft":"Smooth Turkish/American blend · Full flavor & Menthol","views":"Core profit contributor inside PM USA Discount line","acclaim":"Included in Apr 2026 list price increase for margin harvest","takeaway":"Bridges the ~$2/pack gap between Basic and Marlboro Cowboy Cut, monetizing moderate value seekers.","sourceLabel":"CSP Price Hike","sourceUrl":"https://www.cspdailynews.com/tobacco/altria-raises-cigarette-prices-second-time-year"},{"category":"external","benchmark":false,"title":"Montego (#1 US Deep-Discount Brand)","creator":"Liggett Vector / Japan Tobacco (JT Group)","format":"Tier-4 Deep Discount (~$4.50–$5.20/pack)","craft":"Zero-frills trade-discount volume model","views":"Drove Vector to 5.6% US share prior to Oct 2024 JT buyout (~8% JT)","acclaim":"Fastest share gainer in 2022–2025 US discount wave","takeaway":"Primary external catalyst behind Basic's reactivation; JT ownership introduces stronger profit discipline.","sourceLabel":"Japan Times / CSP","sourceUrl":"https://www.japantimes.co.jp/business/2025/10/04/companies/japan-tobacco-cheap-cigarettes/"},{"category":"external","benchmark":false,"title":"Lucky Strike (Value Relaunch) & Pall Mall","creator":"R.J. Reynolds / BAT","format":"Branded & Deep Discount (~$5.50–$7.80/pack)","craft":"Heritage American icon repositioned as filtered value smoke","views":"Lucky Strike offsets secular erosion in legacy Pall Mall","acclaim":"High internal Pall Mall-to-Lucky cannibalization","takeaway":"Validates heritage-trademark value positioning, though less surgical than PM USA's zip-code gating.","sourceLabel":"CA Tobacco Dir","sourceUrl":"https://oag.ca.gov/tobacco/directory?page=8&order=field_tp_manufacturer&sort=asc"},{"category":"external","benchmark":false,"title":"Maverick & USA Gold","creator":"ITG Brands (Imperial Brands)","format":"Regional Value & Deep Discount (~$5.20–$6.80/pack)","craft":"Value blends focused on Midwest/South c-stores","views":"Squeezed between Montego below and Basic's AGDC surge","acclaim":"Cash-harvest posture in US combustibles","takeaway":"Most vulnerable to Basic's 300K-door distribution advantage.","sourceLabel":"Japan Times","sourceUrl":"https://www.japantimes.co.jp/business/2025/10/04/companies/japan-tobacco-cheap-cigarettes/"}],"bars":{"title_zh":"全美主流与折扣卷烟终端典型单包价格阶梯对比（USD / 包）","title_en":"US Cigarette Retail Pack Price Ladder Comparison (Typical USD / Pack)","sub_zh":"展示 PM USA 如何通过 Marlboro → Cowboy Cut → L&M → Basic 构建无缝四级价格拦截网","sub_en":"Illustrating PM USA's seamless price-ladder defense from flagship Marlboro down to ~$5.10 Basic","badge_zh":"Basic 较万宝路折让 ~46%","badge_en":"Basic Sits ~46% Below Marlboro","leg1_zh":"蓝色/绿色：PM USA 多层级价格矩阵 (USD/包)","leg1_en":"Blue / Green: PM USA Multi-Tier Price Ladder ($/Pack)","leg2_zh":"紫色/琥珀：外部高端与深折竞品终端价格带 (虚线 = $6.00 深折分界线)","leg2_en":"Purple / Amber: External Rival Price Points (Dashed = $6.00 Deep-Discount Line)","max_x":12,"ref_line":6.0,"items_zh":[{"label":"Parliament / Natural American Spirit (超高端带)","val":10.6,"disp":"~$10.60","sub":"都市高净值零折扣客群","note":"全美主流卷烟最高单包溢价带"},{"label":"Marlboro Red / Gold 核心旗舰线 (PM USA)","val":9.5,"disp":"~$9.50","sub":"高端烟 60.0% 统治核心","note":"UBS / Japan Times 核验全美均价"},{"label":"Marlboro Black / Cowboy Cut (品牌内价值高端)","val":8.2,"disp":"~$8.20","sub":"铺货 ~100,000 家门店","note":"首道防线：挽留看重万宝路红顶面子的烟民"},{"label":"L&M 品牌化折扣线 (PM USA 次折扣阶梯)","val":7.3,"disp":"~$7.30","sub":"2026.04 同步提价扩毛利","note":"第二道防线：顺滑土耳其混调稳健创利"},{"label":"Basic 深折防守尖刀 (PM USA 冻价奇兵)","val":5.1,"disp":"~$5.10","sub":"9M'26 销量暴涨 +69.7%","note":"UBS 核验均价，正面贴身狙击第四梯队"},{"label":"Montego 蒙特哥 (JT / Vector 第四梯队深折)","val":4.9,"disp":"~$4.90","sub":"深折市场头号外部对手","note":"价差被 Basic 压缩至不足 $0.20–$0.30"}],"items_en":[{"label":"Parliament / Natural American Spirit (Super-Premium)","val":10.6,"disp":"~$10.60","sub":"Affluent metro smokers","note":"Top of the US cigarette price pyramid"},{"label":"Marlboro Red / Gold Core Flagship (PM USA)","val":9.5,"disp":"~$9.50","sub":"60.0% of US Premium segment","note":"UBS / Japan Times verified average"},{"label":"Marlboro Black / Cowboy Cut (Value-Premium)","val":8.2,"disp":"~$8.20","sub":"In ~100,000 retail stores","note":"1st shield: keeps smokers in Marlboro"},{"label":"L&M Branded Discount (PM USA Sub-Premium)","val":7.3,"disp":"~$7.30","sub":"Hiked in Apr 2026 for margin","note":"2nd shield: Turkish-blend value tier"},{"label":"Basic Deep-Value Spearhead (PM USA Price Hold)","val":5.1,"disp":"~$5.10","sub":"9M'26 Discount vol +69.7%","note":"UBS verified ~$5.10 price point"},{"label":"Montego (JT / Vector Tier-4 Deep Discount)","val":4.9,"disp":"~$4.90","sub":"#1 external deep-discount rival","note":"Price gap narrowed to ~$0.20 by Basic"}]}},"ch4":{"eyebrow":"CHAPTER 04 · CONTRIBUTION ECONOMICS & RETENTION SIMULATOR","h2_zh":"四、折扣侧翼经济学推演：卖 ~$5.10 的 Basic 究竟是“赔本赚吆喝”还是净利增量？","h2_en":"4. Flanker Unit Economics & Simulator: Incremental OCI vs. Mix Dilution Math","sub_zh":"只要新增销量主要截留自原本要叛逃去 Montego 的流失客群，每一包 Basic 都在净赚边际现金流并分摊里士满固定制造费","sub_en":"When Basic captures smokers otherwise defecting to external Tier-4 brands, every pack delivers pure incremental contribution OCI","badge_zh":"9M'26 年化出货已破 60亿支 (3亿包)","badge_en":">6.0B Annualized Sticks (~300M Packs)","econ_cards":[{"label_zh":"9M 2026 STICK VOLUME","label_en":"9M 2026 STICK VOLUME","val_zh":"4,497M 支","val_en":"4,497M Sticks","desc_zh":"折合 2.2485 亿包（年化约 3.0 亿包 / 60 亿支），9 个月销量已超 2025 全年总和（3,974M 支）。","desc_en":"Equals 224.85M packs in 9M 2026 (~300M annualized packs / ~6.0B sticks), already surpassing full-year 2025 volume (3,974M sticks)."},{"label_zh":"SHARE OF PM USA VOL","label_en":"SHARE OF PM USA VOL","val_zh":"9.96% 占比","val_en":"9.96% of Sticks","desc_zh":"占 PM USA 前9月国内总出货（45,146M 支）约 10%，处于严格受控的侧翼黄金比例区间。","desc_en":"Represents ~9.96% of PM USA's 45,146M 9M domestic sticks—tightly managed within an optimal ~10% flanker guardrail."},{"label_zh":"EST. UNIT CONTRIBUTION","label_en":"EST. UNIT CONTRIBUTION","val_zh":"~$1.35–$1.85/包","val_en":"~$1.35–$1.85/pk","desc_zh":"扣除 $1.01 联邦税、MSA 和解金及烟叶卷包变动成本后，仍具备高度可观的正向单包边际贡献。","desc_en":"Generates meaningful positive manufacturer contribution (~$1.35–$1.85/pk est.) after $1.01 federal tax, MSA, and variable conversion costs."},{"label_zh":"FIXED OVERHEAD SHIELD","label_en":"FIXED OVERHEAD SHIELD","val_zh":"+45.7% 货架锚","val_en":"45.7% Shelf Lock","desc_zh":"保住 >45% 零售总份额所维系的背柜返利议价权，每年为 Marlboro 与 on! PLUS 节省巨额渠道费。","desc_en":"Preserving 45.7% total retail share protects backbar merchandising economics across Altria's entire US portfolio."}],"combo":{"title_zh":"PM USA 折扣烟年度/阶段出货量（十亿支）vs 占 PM USA 国内总卷烟出货比重（%）","title_en":"PM USA Discount Volume (B Sticks) vs. % Mix of Total PM USA Domestic Cigarettes","sub_zh":"销量快速扩张的同时，占 PM USA 内部总盘比例控制在 ~10%，确保分部整体 64.8% 超高利润率","sub_en":"Rapid stick growth kept within a ~10% internal mix ceiling, preserving 64.8% total Smokeable OCI margin","badge_zh":"精准受控的 10% 侧翼配比","badge_en":"Disciplined ~10% Mix Cap","left_zh":"■ 左轴：折扣线出货量 (十亿支)","left_en":"■ Left Axis: Discount Shipments (B Sticks)","right_zh":"● 右轴：占 PM USA 国内卷烟比重 (%)","right_en":"● Right Axis: % of PM USA Domestic Sticks (%)","leg1_zh":"折扣线出货量 (左轴 · 十亿支)","leg1_en":"Discount Shipments (Left · B Sticks)","leg2_zh":"占 PM USA 内部销量比 (右轴 · %)","leg2_en":"% of Total PM USA Volume (Right · %)","line_badge_zh":"--- 12.0% 内部结构警戒线","line_badge_en":"--- 12.0% Mix Discipline Line","titles_zh":["2024全年","2025全年","2026H1","2026前9月","2026Q3年化"],"titles_en":["FY 2024","FY 2025","1H 2026","9M 2026","Q3'26 Annualized"],"subs_zh":["2.81B / 68.58B","3.97B / 61.75B","2.79B / 29.42B","4.50B / 45.15B","6.82B 年化节奏"],"subs_en":["2.81B / 68.58B","3.97B / 61.75B","2.79B / 29.42B","4.50B / 45.15B","6.82B Run-Rate"],"bars":[2.81,3.97,2.79,4.5,6.82],"line":[4.1,6.4,9.5,10.0,10.8],"max_bar":8.0,"min_line":2.0,"max_line":14.0,"ref_line":12.0,"u_bar":"B","u_line":"%","highlight_idx":3},"sim":{"title_zh":"Basic & L&M 折扣矩阵净边际贡献与防流失价值模拟器","title_en":"Basic & L&M Net Contribution OCI & Shelf-Defense Simulator","toggle_title_zh":"开启 RGM 邮编区围栏限流（外部竞品截留率 >80%，避免侵蚀万宝路 +20% 净效用）","toggle_title_en":"Enable Geo-Fenced Zip Targeting (>80% External Capture, +20% Net Value)","toggle_sub_zh":"模拟通过门店精准过滤将内耗降至最低，并计入工厂固定折旧分摊与背柜合同保护价值","toggle_sub_en":"Models minimal internal Marlboro cannibalization plus Richmond factory overhead absorption","s1_label_zh":"折扣矩阵年出货包数 (百万包 · 9M年化≈300M包)","s1_label_en":"Annual Discount Volume (Million Packs · ~300M run-rate)","s1_unit_zh":"M 包","s1_unit_en":"M Pks","s1_min":150,"s1_max":480,"s1_step":15,"s2_label_zh":"单包综合净边际 OCI 贡献 (USD / 包 · L&M+Basic加权)","s2_label_en":"Blended Net OCI Contribution per Pack (USD)","s2_unit_zh":"/包","s2_unit_en":"/pk","s2_min":1.1,"s2_max":2.5,"s2_step":0.1,"s3_label_zh":"工厂固定制造摊销与背柜主导权协同价值 ($M / 年)","s3_label_en":"Annual Factory Absorption & Shelf Captaincy Value ($M/yr)","s3_min":40,"s3_max":180,"s3_step":10,"roi_label_zh":"相对年均 $120M 定向渠道补贴预算回报倍数","roi_label_en":"Payback Multiple vs. $120M Targeted Trade Spend","cost_base_m":120,"mult":1.2,"vol_drift":1.04,"presets":{"p1":{"label_zh":"① 保守收缩情景 (通胀缓解后主动回收补贴提价)","label_en":"① Margin-Harvest Case (Post-Inflation Price Lift)","tag_zh":"240M包 · $2.0/包","tag_en":"240M · $2.0/pk","views":240,"v_per_view":2.0,"ancillary_m":70,"years":5,"transmedia":true},"p2":{"label_zh":"② 当前基准情景 (300M包年化 · 稳守 4.1%+ 折扣份额)","label_en":"② Current Base Case (300M Packs · 4.1% Share)","tag_zh":"300M包 · 5年","tag_en":"300M · 5 Yrs","views":300,"v_per_view":1.6,"ancillary_m":100,"years":5,"transmedia":true},"p3":{"label_zh":"③ 宏观衰退防御情景 (折扣大盘冲上 38% 全面拦截)","label_en":"③ Recession Defense Case (38% Industry Discount)","tag_zh":"420M包 · 6年","tag_en":"420M · 6 Yrs","views":420,"v_per_view":1.4,"ancillary_m":140,"years":6,"transmedia":false}}},"moat_pos_zh":"<strong>1. 进可攻退可守的“水龙头开关”：<\/strong>Basic 无需昂贵品牌广告，经济承压期拧开渠道补贴即可在 9 个月暴涨 +69.7%，未来宏观回暖时亦可随时收窄折让收割利润（复刻当年 L&M 提价路径）。<br/><strong>2. 成功稳住 PM USA 45.7% 零售基本盘：<\/strong>终结了市场对奥驰亚只保利润率而任由市场份额流失的担忧。","moat_pos_en":"<strong>1. Flexible 'Valve' Lever:<\/strong> PM USA can dial Basic promotional buydowns up during consumer downturns (+69.7% in 9M'26) and harvest list prices when macro conditions normalize.<br/><strong>2. Stabilized Total PM USA Share at 45.7%:<\/strong> Proved Altria can defend total market share and expand Smokeable OCI simultaneously.","moat_risk_zh":"<strong>1. 结构性均价稀释（Mix Drag）：<\/strong>若 Basic 放量失控突破总出货 15%+，将拉低分部整体单支净收入。<br/><strong>2. 第四梯队对手跟进降价：<\/strong>若 JT 或区域小厂进一步发起极限价格战，可能压缩深折段单包边际毛利。","moat_risk_en":"<strong>1. Volume Mix Drag:<\/strong> Allowing discount mix to drift too high (>15%) would weigh on blended Smokeable per-stick realization.<br/><strong>2. Deep-Discount Retaliation:<\/strong> Aggressive counter-discounting by JT/Montego could compress Tier-4 unit margins."},"ch5":{"eyebrow":"CHAPTER 05 · STRATEGIC TIMELINE & DISCOUNT COUNTERATTACK","h2_zh":"五、侧翼演进史与四大标志性战役：从遗产老牌到 2026 最强份额推进器","h2_en":"5. Flanker Timeline & Key Battles: How Basic & L&M Reclaimed the Value Shelf","sub_zh":"复盘 PM USA 如何在 L&M 提价上移后重新激活 Basic，精准化解 JT 收购 Vector 冲击波","sub_en":"Tracing L&M's up-tiering, JT's Vector acquisition, and Basic's surgical 2025–2026 counter-offensive","badge_zh":"1978 Basic 诞生 → 2024 JT 并购冲击 → 2026 份额翻倍","badge_en":"1978 Basic Launch → 2024 JT Deal → 2026 Share >2x","acts":[{"title_zh":"第一阶段 · Basic 与 L&M 的历史分工 (1978–2021) —— 两次通胀周期的价值守门员","title_en":"Act I · Heritage Value Roots of Basic & L&M (1978–2021)","badge_zh":"曾占全美 ~5% 份额","badge_en":"Historic Top-5 Value Brand","desc_zh":"Basic 在 1990 年代价值烟浪潮中曾跃居全美前五大卷烟品牌；2000 年代后 PM USA 引入 L&M 主攻年轻化次折扣市场，并随L&M 逐年提价将其转型为高毛利现金流产品。","desc_en":"Basic rose to a top-5 US brand during the 1990s value wave before PM USA scaled L&M in the 2000s–2010s and gradually raised L&M prices to harvest margin."},{"title_zh":"第二阶段 · 高通胀催生深折真空与 JT 并购 Vector (2022–2024) —— 折扣烟突破 30% 警戒线","title_en":"Act II · Inflation Surge & JT's Vector Acquisition (2022–2024)","badge_zh":"2024 份额触底 1.9%","badge_en":"1.9% Share Trough in 2024","desc_zh":"2022–2024 累积通胀令低收入烟民涌向 $5 以下第四梯队品牌，PM USA 折扣份额一度回落至 1.9%，而日本烟草于 2024 年 10 月完成收购 Vector Group（Montego）正式叫板 <a class=\"cite-link\" href=\"https://www.cspdailynews.com/tobacco/jt-group-acquire-vector-group\" target=\"_blank\" rel=\"noopener noreferrer\">CSP JT-Vector ↗<\/a>。","desc_en":"Post-2022 inflation pushed strapped smokers into sub-$5 Tier-4 brands while JT acquired Vector Group (Montego) in October 2024 <a class=\"cite-link\" href=\"https://www.cspdailynews.com/tobacco/jt-group-acquire-vector-group\" target=\"_blank\" rel=\"noopener noreferrer\">CSP JT-Vector ↗<\/a>."},{"title_zh":"第三阶段 · Basic 定向重装出击与份额翻倍逆转 (2025–2026Q3) —— 9个月狂飙 +69.7%","title_en":"Act III · Surgical Basic Reactivation & Share Doubling (2025–Q3'26)","badge_zh":"Q3'26 份额跃至 4.1%","badge_en":"4.1% Share in Q3 2026","desc_zh":"PM USA 自 2025 下半年起依托门店级 RGM 大举扩铺 Basic 促销装，推动折扣出货量在 2025Q4（+109.8%）、2026H1（+94.4%）与 2026Q3（+40.5%）连续井喷，拉动总份额回升至 45.7% <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Q3'26 Release ↗<\/a>。","desc_en":"Store-targeted Basic promotions ignited triple- and high-double-digit shipment growth (+109.8% Q4'25, +94.4% 1H'26, +40.5% Q3'26), lifting PM USA discount share to 4.1% <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Q3'26 Release ↗<\/a>."}],"battles":[{"tag_zh":"战役 01 · 2025Q4","tag_en":"Case 01 · Q4 2025","sub_zh":"单季翻倍奇袭","sub_en":">100% Quarterly Jump","title_zh":"2025Q4 折扣烟出货暴涨超 100% 打响反击第一枪","title_en":"Q4 2025 Discount Shipments Surge >100% to 1,324M Sticks","desc_zh":"单季出货由去年同期 631M 支跃升至 1,324M 支，零售份额单季跳升 +1.3pp 至 3.2%，验证了 Basic 老字号在价值渠道的即插即用号召力 <a class=\"cite-link\" href=\"https://www.sec.gov/Archives/edgar/data/764180/000076418026000007/exhibit991erq42025.htm\" target=\"_blank\" rel=\"noopener noreferrer\">FY25 EX-99.1 ↗<\/a>。","desc_en":"Shipments more than doubled from 631M to 1,324M sticks in Q4 2025, jumping +1.3pp YoY to 3.2% share <a class=\"cite-link\" href=\"https://www.sec.gov/Archives/edgar/data/764180/000076418026000007/exhibit991erq42025.htm\" target=\"_blank\" rel=\"noopener noreferrer\">FY25 EX-99.1 ↗<\/a>."},{"tag_zh":"战役 02 · 2026-04","tag_en":"Case 02 · Apr 2026","sub_zh":"精准剪刀差控价","sub_en":"Price-Gap Engineering","title_zh":"冻结 Basic 目录价正面锁喉深折对手","title_en":"Holding Basic Unchanged During April 2026 Price Hike","desc_zh":"当主流品牌普涨时维持 Basic ~$5.10/包原价，把与 Montego 的终端价差收窄至毫厘之间，以大厂品控夺取动销 <a class=\"cite-link\" href=\"https://www.cspdailynews.com/tobacco/altria-raises-cigarette-prices-second-time-year\" target=\"_blank\" rel=\"noopener noreferrer\">CSP Daily News ↗<\/a>。","desc_en":"Excluded Basic from the April 2026 list price hike, closing the shelf-price gap against Montego <a class=\"cite-link\" href=\"https://www.cspdailynews.com/tobacco/altria-raises-cigarette-prices-second-time-year\" target=\"_blank\" rel=\"noopener noreferrer\">CSP Daily News ↗<\/a>."},{"tag_zh":"战役 03 · 2026H1","tag_en":"Case 03 · 1H 2026","sub_zh":"总份额拐点确立","sub_en":"Total Share Inflection","title_zh":"上半年暴增 +94.4% 助 PM USA 总份额转正","title_en":"1H 2026 +94.4% Surge Turns Total PM USA Share Positive","desc_zh":"2026 上半年折扣线出货 2,793M 支（vs 1,437M），令 PM USA 总份额同比逆势回升 +0.4pp 至 45.5% <a class=\"cite-link\" href=\"https://www.sec.gov/Archives/edgar/data/764180/000076418026000093/exhibit991erq22026.htm\" target=\"_blank\" rel=\"noopener noreferrer\">Q2'26 EX-99.1 ↗<\/a>。","desc_en":"1H 2026 Discount shipments hit 2,793M sticks (+94.4%), flipping total PM USA share to +0.4pp YoY growth at 45.5% <a class=\"cite-link\" href=\"https://www.sec.gov/Archives/edgar/data/764180/000076418026000093/exhibit991erq22026.htm\" target=\"_blank\" rel=\"noopener noreferrer\">Q2'26 EX-99.1 ↗<\/a>."},{"tag_zh":"战役 04 · 2026Q3","tag_en":"Case 04 · Q3 2026","sub_zh":"量利双收验证","sub_en":"Margin + Share Proof","title_zh":"折扣份额破 4.1% 同时可燃利润率仍升至 64.5%","title_en":"Reaching 4.1% Share While Expanding Segment Margin to 64.5%","desc_zh":"彻底击碎华尔街关于“推 Basic 必毁利润率”的质疑：Q3 折扣份额升至 4.1%，而可燃分部调整后 OCI 仍增长 +3.9%、利润率升至 64.5% <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Q3'26 Table 2 & 4 ↗<\/a>。","desc_en":"Refuted margin-cannibalization fears as Q3 Discount share hit 4.1% while Smokeable Adjusted OCI grew +3.9% at a 64.5% margin <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Q3'26 Table 2 & 4 ↗<\/a>."}],"laws":[{"zh":"优秀的折扣侧翼品牌不是用来替代旗舰品牌的，而是用来摧毁竞争对手低价根据地的外科手术刀。","en":"A great discount flanker is not meant to replace the flagship—it is a surgical scalpel to deny rivals a value foothold."},{"zh":"必须坚持地理围栏与门店分级（Store-Cluster RGM），严禁在高购买力区域无差别倾销深折产品。","en":"Enforce strict zip-code RGM gating so deep-discount promotions never leak into affluent flagship territories."},{"zh":"L&M 提价收割存量、Basic 冻价抢占增量，双品牌错位轮动才能兼顾份额底线与 64%+ 分部利润率。","en":"Rotate L&M into margin harvest while deploying Basic at the floor to balance share defense with 64%+ segment margins."}]},"ch6":{"h2_zh":"六、“侧翼精准防卫法则”折扣卷烟矩阵核查清单","h2_en":"6. 'Surgical Flanker Law' Discount Cigarette Matrix Checklist","items_zh":[{"tag":"内部占比 ~10%","title":"1. 结构稀释红线测试：折扣烟占 PM USA 国内总卷烟销量是否严格受控在 12% 以内？","desc":"2026前9月占比为 9.96%（4,497M / 45,146M），需持续跟踪防止过度侵蚀高端池。"},{"tag":"45.7% 总份额护盘","title":"2. 集团净份额增益测试：Basic 赢取的份额是否大于或等于 Marlboro 在总盘的自然回落？","desc":"2026Q3 折扣线 +1.4pp 超额覆盖 Marlboro -1.0pp，驱动 PM USA 总份额净增 +0.3pp。"},{"tag":"~$0.20 极窄价差","title":"3. 终端货架贴身卡位测试：在目标价值门店，Basic 与 Montego 单包价差是否保持在 $0.30 以内？","desc":"一旦价差超过 $0.75，深折极致价格敏感客群将重新流向第四梯队竞品。"},{"tag":"64.5%+ 分部利润率","title":"4. 分部整体 OCI 率无损测试：放量折扣烟后可燃分部调整后 OCI 利润率是否仍保持扩张？","desc":"验证 RGM 提价与退税收益能否完全消化 Volume Mix Change 影响。"},{"tag":"L&M 溢价留存","title":"5. 次折扣阶梯区隔测试：L&M 在提价后是否稳住 ~$7+ 忠诚烟民而未全量滑向 Basic？","desc":"确保双品牌在风味（土耳其混调 vs 经典美式）与渠道层级上清晰区隔。"},{"tag":"未来提价期权","title":"6. 逆周期收获期权测试：若通胀压力缓和，Basic 是否具备阶梯式收缩补贴转化为高毛利品牌的潜力？","desc":"评估新获客群对 Basic 口感的粘性及后续单包毛利爬坡空间。"}],"items_en":[{"tag":"~10% Mix Ceiling","title":"1. Mix-Dilution Guardrail Test: Is Discount volume kept below 12% of PM USA domestic sticks?","desc":"9M 2026 mix sits at 9.96% (4,497M / 45,146M), balancing volume capture with margin integrity."},{"tag":"45.7% Total Share","title":"2. Net Manufacturer Share Test: Do Basic's share gains more than offset Marlboro's total-category dip?","desc":"In Q3 2026, Discount's +1.4pp gain outweighed Marlboro's -1.0pp shift, lifting PM USA +0.3pp YoY."},{"tag":"~$0.20 Shelf Gap","title":"3. Tier-4 Price Gap Test: Does Basic stay within ~$0.30/pack of Montego in targeted value stores?","desc":"Verify promotional buydowns maintain tight price parity in high-discount zip codes."},{"tag":"64.5%+ Adj. OCI","title":"4. Segment Margin Preservation Test: Does Smokeable Adjusted OCI margin still hold ≥64%?","desc":"Confirm premium RGM pricing and duty refunds fully absorb discount volume mix."},{"tag":"L&M Tier Separation","title":"5. L&M Branded Tier Test: Does L&M retain its ~$7+ Turkish-blend smoker base post-price hikes?","desc":"Monitor internal separation between L&M and Basic."},{"tag":"Future Margin Option","title":"6. Post-Cycle Harvest Option: Can Basic gradually trim buydowns as macro pressures ease?","desc":"Assess repeat loyalty to convert captured volume into higher per-pack OCI over time."}]},"sources":[{"label":"Altria Q3 & 9M 2026 Official Release (Tables 3 & 4: Discount 4,497M Sticks +69.7%, 4.1% Retail Share)","url":"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx"},{"label":"SEC Form 8-K Exhibit 99.1 — Altria Q2 & 1H 2026 Results (1H Discount +94.4% to 2,793M Sticks)","url":"https://www.sec.gov/Archives/edgar/data/764180/000076418026000093/exhibit991erq22026.htm"},{"label":"SEC Form 8-K Exhibit 99.1 — Altria FY2025 Results (FY25 Discount 3,974M Sticks +41.3%, Q4 +109.8%)","url":"https://www.sec.gov/Archives/edgar/data/764180/000076418026000007/exhibit991erq42025.htm"},{"label":"CSP Daily News: Altria Raises Cigarette Prices for Second Time in 2026, Holds Basic Unchanged","url":"https://www.cspdailynews.com/tobacco/altria-raises-cigarette-prices-second-time-year"},{"label":"Japan Times / UBS Analysis: Basic (~$5.10/pack) vs. JT Group's Montego Deep-Discount Rivalry","url":"https://www.japantimes.co.jp/business/2025/10/04/companies/japan-tobacco-cheap-cigarettes/"},{"label":"CSP Daily News: JT Group Acquires Vector Group (5.6% US Cigarette Share)","url":"https://www.cspdailynews.com/tobacco/jt-group-acquire-vector-group"}],"quickJumpZh":[{"sec":"sec-00","title":"00 单品定评与逆势爆发成绩单","sub":"9M出货+69.7% · 份额翻倍至4.1% · ~$5.10卡位"},{"sec":"sec-01","title":"01 双层折扣架构与门店定向锁价","sub":"Basic深折尖刀 + L&M次折扣 · 邮编区围栏RGM"},{"sec":"sec-02","title":"02 四大侧翼攻防支柱与雷达对比","sub":"狙击Montego · 严控10%内耗红线 · 稳45.7%总盘"},{"sec":"sec-03","title":"03 全美折扣与深折卷烟竞品矩阵","sub":"对比 Montego、Lucky Strike、Pall Mall 与 Maverick"},{"sec":"sec-04","title":"04 单包边际贡献与存量截留模拟器","sub":"边际OCI测算与工厂固定制造摊销协同推演"},{"sec":"sec-05","title":"05 从战略雪藏到重装反击演进史","sub":"超越1993万宝路星期五 · 2025–2026四连跳"},{"sec":"sec-06","title":"06 折扣侧翼护卫舰纪律核查清单","sub":"6项防内耗与份额增益量化核验"},{"sec":"sec-07","title":"07 SEC 财报与行业价格信源索引","sub":"一手财报与价格调研直达"}],"quickJumpEn":[{"sec":"sec-00","title":"00 Product Verdict & Surge KPIs","sub":"9M sticks +69.7% · 4.1% Q3 share · ~$5.10 Basic anchor"},{"sec":"sec-01","title":"01 Dual-Tier Discount & Geo-Pricing","sub":"Basic deep-value + L&M branded discount · Zip-code RGM"},{"sec":"sec-02","title":"02 4 Flanker Pillars & Moat Radar","sub":"Countering Montego while keeping mix at ~10%"},{"sec":"sec-03","title":"03 US Discount Cigarette Benchmarking","sub":"Basic & L&M vs. Montego, Lucky Strike & Maverick"},{"sec":"sec-04","title":"04 Contribution Margin & Retention Sim","sub":"Incremental pack OCI & factory overhead simulator"},{"sec":"sec-05","title":"05 From Dormant Brand to RGM Counterattack","sub":"Evolving beyond Marlboro Friday to surgical geo-pricing"},{"sec":"sec-06","title":"06 Discount Flanker Discipline Checklist","sub":"6-point mix and margin guardrail checklist"},{"sec":"sec-07","title":"07 SEC Filings & Pricing Sources","sub":"Verified SEC tables and trade pricing reports"}]},{"id":"parliament_vslims","idx_num":3,"idx_pad":"03","filename":"mo_prod_03_parliament_virginia_slims.html","checkKey":"mui_mo_checks_parl_vslims","monogram":"PV","short_zh":"Parliament & 维珍妮","short_en":"Parliament & V. Slims","pill_kpi":"2.1%超高端份额 · 零折让","docTitleZh":"《Parliament 百乐门 & Virginia Slims 维珍妮》超高端利基卷烟深度商业研报 | 王安安数据中心","docTitleEn":"Parliament & Virginia Slims Super-Premium Niche Cigarettes Monograph | Research Hub","crumb_zh":"Parliament & Virginia Slims 超高端利基卷烟双璧（PM USA Other Premium）","crumb_en":"Parliament & Virginia Slims Super-Premium Duo (PM USA Other Premium)","chip1_zh":"超高端稳态份额 2.1%","chip1_en":"2.1% Super-Premium Share","chip2_zh":"9M'26 出货 19.76亿支 · 超高单支净利","chip2_en":"1,976M 9M'26 Sticks · Top Unit Margin","sidebar":{"badge":"PM USA · OTHER PREMIUM CASH GEMS","title_zh":"百乐门 & 维珍妮研报","title_en":"Parliament & Slims Monograph","sub_zh":"标志性 5mm 凹陷硬纸滤嘴 (Parliament) × 100s/120s 超细支先驱 (Virginia Slims) × 年化 ~26亿支零促销高毛利金矿","sub_en":"Iconic recessed paper filter (Parliament) × Superslims/120s pioneer (Virginia Slims) × ~2.6B annual ultra-margin sticks","mini_kpis":[{"label_zh":"Other Premium 零售份额 (Q3)","label_en":"Other Premium Share (Q3)","val_zh":"2.1% (极度稳健)","val_en":"2.1% (Ultra-Sticky)"},{"label_zh":"2026前9月国内出货量","label_en":"9M 2026 Shipments","val_zh":"1,976M 支","val_en":"1,976M Sticks"},{"label_zh":"2025全年国内出货量","label_en":"FY 2025 Shipments","val_zh":"2,845M 支","val_en":"2,845M Sticks"}]},"toc":[["单品定评与超高端利基指标","Product Verdict & Niche Scorecard"],["物理差异化滤嘴与细支工艺","Recessed Filter & Superslims Craft"],["四大高毛利韧性支柱与雷达","4 Ultra-Margin Pillars & Radar"],["全美超高端与特色卷烟对比","Super-Premium Cigarette Matrix"],["零促销高溢价单包现金流模拟","Zero-Promo Unit Cashflow Simulator"],["近百年超高端定位演进复盘","95-Year Super-Premium Heritage"],["超高端利基现金牛核查清单","Super-Premium Niche Moat Checklist"],["SEC 财报与注册目录信源索引","SEC Filings & Registry Sources"]],"hero":{"strip1_zh":"单品定评：隐匿在奥驰亚财报“Other Premium”行项目里的无声印钞双星，单支净利比肩甚至超越红万核心线","strip1_en":"Verdict: Hidden 'Other Premium' profit gems generating above-Marlboro per-stick realization with near-zero promotional spend","strip2_zh":"核心成员：Parliament (1931 凹陷滤嘴) · Virginia Slims (1968 细支/120s) · Benson & Hedges","strip2_en":"Core Lineup: Parliament (1931 Recessed Filter) · Virginia Slims (1968 Superslims/120s) · Benson & Hedges","strip3_zh":"数据基准：2026Q3 季报核验 (2026-10-29)","strip3_en":"Baseline: Q3 2026 Release (Oct 29, 2026)","overline_zh":"SUPER-PREMIUM DUO 03 · 2.1% 全美超高端稳态份额 × 9M'26 出货 19.76亿支 × 独特物理结构锁定高净值都市客群","overline_en":"SUPER-PREMIUM DUO 03 · 2.1% Resilient US Share × 1,976M 9M'26 Sticks × Structural Filter/Slim Differentiation","h1_zh":"Parliament 百乐门 & Virginia Slims 深度剖析：<span class=\"gradient-accent\">零大众营销投入下，物理结构独占性如何锁死全美 2.1% 最挑剔的高溢价烟民？<\/span>","h1_en":"Parliament & Virginia Slims Deep Dive: <span class=\"gradient-accent\">How Recessed Filters and Superslim Geometry Lock In 2.1% of America's Highest-Margin Cigarette Market<\/span>","lead_zh":"在 PM USA 的产品金字塔顶端，除了家喻户晓的万宝路，还坐落着财报专门单列的 <strong>Other premium（其他高端品牌）<\/strong> 矩阵——由 <strong>Parliament（百乐门）<\/strong> 与 <strong>Virginia Slims（维珍妮）<\/strong>（辅以奢华长支 <strong>Benson & Hedges<\/strong>）领衔 <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Q3'26 Table 3 Footnote 1 ↗<\/a>。这两款百年/半世纪单品不靠价格折让，而是依靠竞品极难复制的<strong>物理形态差异化<\/strong>：Parliament 自 1931 年起独树一帜的<strong>内凹式硬纸滤嘴（Recessed Paper Filter）<\/strong>，以及 Virginia Slims 开创性的 <strong>23mm 圆周超细支（Superslims）与 100s/120s 修长规格<\/strong> <a class=\"cite-link\" href=\"https://en.wikipedia.org/wiki/Parliament_(cigarette)\" target=\"_blank\" rel=\"noopener noreferrer\">Parliament Craft ↗<\/a>。2024 至 2026Q3 期间，面对全行业深折浪潮，该组合全美零售份额稳如磐石地保持在 <strong>2.3% → 2.2% → 2.1%<\/strong>（2026Q3 出货 <strong>6.97 亿支<\/strong>，前9月累计 <strong>19.76 亿支<\/strong>），以高于万宝路 $1.00–$1.50/包的超高端定价静默输出纯利现金流。","lead_en":"Sitting atop PM USA's price pyramid in the dedicated <strong>Other premium<\/strong> reporting line are <strong>Parliament<\/strong> and <strong>Virginia Slims<\/strong> (alongside <strong>Benson & Hedges<\/strong>) <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Q3'26 Table 3 Footnote 1 ↗<\/a>. Rather than competing on trade discounts, both brands command ~$1.00–$1.50/pack premiums above mainstream cigarettes via unmistakable <strong>physical form-factor exclusivity<\/strong>: Parliament's signature 1931 <strong>recessed paper filter<\/strong> and Virginia Slims' pioneering <strong>Superslims and 100s/120s luxury formats<\/strong> <a class=\"cite-link\" href=\"https://en.wikipedia.org/wiki/Parliament_(cigarette)\" target=\"_blank\" rel=\"noopener noreferrer\">Parliament Craft ↗<\/a>. Across 2024–Q3 2026, their combined US retail share barely budged (<strong>2.3% → 2.2% → 2.1%<\/strong>, shipping <strong>1,976M sticks<\/strong> in 9M 2026 and <strong>697M<\/strong> in Q3), delivering ultra-high per-stick OCI.","thesis_cards":[{"title_zh":"Parliament 凹陷滤嘴：触觉与口感的物理转换壁垒","title_en":"Parliament Recessed Filter: Tactile Switching Moat","desc_zh":"滤嘴前端预留约 5mm 中空硬纸腔体（“Only the flavor touches your lips”），冷却烟气并避免嘴唇直接接触醋酸纤维束，习惯后极难改抽平头烟。","desc_en":"Parliament's ~5mm recessed paper filter cavity cools smoke and prevents direct fiber-tip lip contact, creating rare tactile switching friction."},{"title_zh":"Virginia Slims 100s/120s 与 Superslims 形态独占","title_en":"Virginia Slims 120s & Superslims Format Monopoly","desc_zh":"全美主流货架极少数提供 Gold/Menthol 120s 加长盒装与 Superslims 超细盒装的品牌，精准锁定高粘性成熟女性与讲究仪式感的烟民。","desc_en":"Virginia Slims holds a near-monopoly in 120mm extra-long Luxury Box and Superslims formats among loyal mature female adult smokers."},{"title_zh":"零价格战损耗与沿海高收入都市圈集聚","title_en":"Zero Promo Dilution & Affluent Coastal Density","desc_zh":"Parliament 在纽约大都会区、南佛罗里达与西海岸高收入社区渗透率极高，消费者对每包 $12–$16 含税高价几乎脱敏。","desc_en":"Concentrated in affluent NYC, South Florida, and coastal metro corridors where adult buyers are largely insensitive to $12–$16+ tax-inclusive prices."}],"kpis":[{"label_zh":"全美零售市场份额 (Q3'26)","label_en":"US Retail Share (Q3'26)","badge_zh":"3年波动仅 0.2pp","badge_en":"20bps 3-Yr Band","val_zh":"2.1%","val_en":"2.1%","desc_zh":"2024年 2.3%、2025年 2.2%、2026Q2 & Q3 稳定在 2.1%，抗通胀降级能力极强 <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Q3'26 Table 4 ↗<\/a>","desc_en":"Held steady from 2.3% (FY24) to 2.2% (FY25) and 2.1% across Q2 & Q3 2026 despite 34.1% industry discount penetration <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Q3'26 Table 4 ↗<\/a>"},{"label_zh":"2026Q3 单季出货降幅","label_en":"Q3 2026 Volume Change","badge_zh":"优于万宝路 -6.4%","badge_en":"Beats Marlboro -6.4%","val_zh":"-6.3% (697M)","val_en":"-6.3% (697M)","desc_zh":"Q2 2026 同比降幅仅 -5.7%（678M 支），Q3 697M 支（-6.3%），优于 Marlboro 同期表现 <a class=\"cite-link\" href=\"https://www.sec.gov/Archives/edgar/data/764180/000076418026000093/exhibit991erq22026.htm\" target=\"_blank\" rel=\"noopener noreferrer\">Q2 & Q3 Tables ↗<\/a>","desc_en":"Declined just -5.7% YoY in Q2 2026 (678M sticks) and -6.3% in Q3 (697M sticks), outperforming flagship Marlboro volume resilience <a class=\"cite-link\" href=\"https://www.sec.gov/Archives/edgar/data/764180/000076418026000093/exhibit991erq22026.htm\" target=\"_blank\" rel=\"noopener noreferrer\">Q2 & Q3 Tables ↗<\/a>"},{"label_zh":"2025全年 / 2026前9月出货","label_en":"FY25 / 9M26 Shipments","badge_zh":"超高端实绩","badge_en":"Super-Premium Vol","val_zh":"2.85B / 1.98B","val_en":"2.85B / 1.98B","desc_zh":"FY2025 达 2,845M 支（1.42亿包）；2026前9月 1,976M 支（0.99亿包）<a class=\"cite-link\" href=\"https://www.sec.gov/Archives/edgar/data/764180/000076418026000007/exhibit991erq42025.htm\" target=\"_blank\" rel=\"noopener noreferrer\">FY25 EX-99.1 ↗<\/a>","desc_en":"Delivered 2,845M sticks (142M packs) in FY2025 and 1,976M sticks (99M packs) in 9M 2026 <a class=\"cite-link\" href=\"https://www.sec.gov/Archives/edgar/data/764180/000076418026000007/exhibit991erq42025.htm\" target=\"_blank\" rel=\"noopener noreferrer\">FY25 EX-99.1 ↗<\/a>"},{"label_zh":"相对主流高端溢价幅度","label_en":"Super-Premium Price Lift","badge_zh":"极低折扣补贴","badge_en":"Minimal Buydowns","val_zh":"+$1.0–$1.6/包","val_en":"+$1.0–$1.6/pk","desc_zh":"目录出厂价高于核心万宝路，且极少参与大额多包满减，单包 OCI 利润率处于金字塔尖 <a class=\"cite-link\" href=\"https://en.wikipedia.org/wiki/Parliament_(cigarette)\" target=\"_blank\" rel=\"noopener noreferrer\">Parliament Profile ↗<\/a>","desc_en":"Commands a +$1.00–$1.60/pack wholesale premium above core Marlboro with minimal multi-pack promotional dilution <a class=\"cite-link\" href=\"https://en.wikipedia.org/wiki/Parliament_(cigarette)\" target=\"_blank\" rel=\"noopener noreferrer\">Parliament Profile ↗<\/a>"}]},"ch1":{"eyebrow":"CHAPTER 01 · PHYSICAL FORM-FACTOR MOAT & SKU PORTFOLIO","h2_zh":"一、物理结构护城河拆解：为什么凹陷滤嘴与 120mm 超长细支能免疫深折价格战？","h2_en":"1. Structural Product Craft: Why Recessed Filters and 120s Formats Defy Down-Trading","sub_zh":"专用卷接滤嘴成型工装 × 唇部触感记忆锁定 × 加州等严苛州合规目录在册核心款式","sub_en":"Specialized filter-recess tooling × Lip-feel habit lock-in × Certified California DOJ directory styles","badge_zh":"1931 & 1968 双遗产商标 · 专用高速成型设备","badge_en":"1931 & 1968 Icons · Custom Tipping Tooling","hub_title_zh":"PM USA 超高端双璧（以独特工业结构替代营销轰炸，锁定高支付意愿死忠客群）","hub_title_en":"PM USA Super-Premium Niche Core (Structural Differentiation Over Mass Promo Spend)","hub_sub_zh":"在全美主流深折烟均采用 84mm 标准平头圆支的背景下，异形滤嘴与超细长支天然隔绝了低价替代品","hub_sub_en":"Because deep-discount Tier-4 brands only run standard 84mm king-size rods, recessed and 120s smokers have no cheap clone to defect to","nodes":[{"tag_zh":"RECESSED FILTER · 百乐门核心","tag_en":"RECESSED FILTER · PARLIAMENT","name_zh":"Parliament White / Silver / Full","name_en":"Parliament White & Silver Box","desc_zh":"硬纸管向内凹进约 5mm，使烟气在入口前经历二次涡流混匀降温，赋予极具辨识度的清冽顺滑感。","desc_en":"Iconic ~5mm recessed stiff paper mouthpiece creates secondary airflow cooling and crisp draw smoothness."},{"tag_zh":"PARLIAMENT MENTHOL · 绿盒线","tag_en":"PARLIAMENT MENTHOL · GREEN","name_zh":"Parliament Menthol Green / Silver","name_en":"Parliament Menthol Box","desc_zh":"在非风味禁令州提供凹陷滤嘴+清凉薄荷复合体验，都市夜生活与高收入年轻白领粘性极高。","desc_en":"Pairs recessed filter cooling with menthol smoothness in permitted states, retaining strong urban nightlife loyalty."},{"tag_zh":"SUPERSLIMS · 超细支标杆","tag_en":"SUPERSLIMS · ULTRA-SLENDER","name_zh":"Virginia Slims Superslims Box","name_en":"Virginia Slims Superslims","desc_zh":"纤巧棱角方盒与超细烟支圆周设计，握持优雅、烟灰紧致，在加州司法部合规名录中保有专属席位。","desc_en":"Ultra-slim circumference in sleek bevel-edged boxes, maintaining certified non-menthol listings in the CA DOJ directory."},{"tag_zh":"LUXURY 120s · 超长支仪式感","tag_en":"LUXURY 120s · EXTENDED LENGTH","name_zh":"Virginia Slims Gold / Menthol 120s","name_en":"Virginia Slims 100s & 120s","desc_zh":"120mm 超长烟支延长单支抽吸时间与柔和过滤路径，形成其他主流品牌完全未覆盖的细分垄断。","desc_en":"120mm luxury length extends burn duration and filtration path with virtually zero direct mainstream competitors."},{"tag_zh":"HERITAGE LUXURY · 伴生超高端","tag_en":"HERITAGE LUXURY · B&H","name_zh":"Benson & Hedges Luxury 100s","name_en":"Benson & Hedges 100s","desc_zh":"同属 PM USA Other Premium 统计口径的经典英伦风超高端 100s 长支，贡献稳定高净值长尾。","desc_en":"Classic British-heritage super-premium 100s line consolidated within PM USA's Other Premium reporting bucket."},{"tag_zh":"ZERO-DISCOUNT RGM · 净利收割","tag_en":"PURE PRICE REALIZATION","name_zh":"跟随每轮目录提价全额传导","name_en":"100% List-Price Pass-Through","desc_zh":"每次 PM USA 上调目录价时均同步甚至超额提价，无需像主流线那样用大额买赠券回吐涨幅。","desc_en":"Captures nearly 100% of semi-annual PM USA list-price increases without heavy mobile-coupon or multi-pack givebacks."}],"platform_bars":[{"title_zh":"异形卷接制造壁垒（小烟厂不具备经济规模）","title_en":"Specialized Manufacturing Tooling Barrier","sub_zh":"凹陷硬纸滤嘴复合接装与 120mm/Superslims 异形烟支需要专用卷包模组，第四梯队代工厂因单品量小无法仿制摊平成本。","sub_en":"Recessed paper-tube assembly and 120mm/Superslims formats require dedicated high-speed tooling uneconomical for Tier-4 discount cloners."},{"title_zh":"大都会核心便利店与精品烟草店高密度分销","title_en":"Metro C-Store & Specialty Tobacconist Focus","sub_zh":"依托 AGDC 在纽约、新泽西、佛州、加州及芝加哥核心商圈维持高单店动销周转。","sub_en":"High per-store turn velocity across NYC, NJ, South Florida, Chicago, and coastal specialty tobacconists via AGDC."}],"principles":[{"title_zh":"1. “没有廉价平替”是最硬的防降级护城河","title_en":"1. 'No Deep-Discount Clone' Blocks Down-Trading","desc_zh":"普通 85mm 红盒烟民降级时可轻易转向 Montego Red，但习惯了 Parliament 凹陷纸嘴或 Virginia Slims 120s 纤长握感的烟民在 $5 价格带根本找不到同类物理结构 <a class=\"cite-link\" href=\"https://en.wikipedia.org/wiki/Parliament_(cigarette)\" target=\"_blank\" rel=\"noopener noreferrer\">Parliament Wiki ↗<\/a>。","desc_en":"Standard 85mm smokers can down-trade to $5 Montego, whereas smokers accustomed to Parliament's recessed tip or Virginia Slims 120s find zero physical equivalents in deep discount <a class=\"cite-link\" href=\"https://en.wikipedia.org/wiki/Parliament_(cigarette)\" target=\"_blank\" rel=\"noopener noreferrer\">Parliament Wiki ↗<\/a>."},{"title_zh":"2. 销量降幅在 2026 年反超 Marlboro 展现韧性","title_en":"2. Outperforming Marlboro Stick Trends in 2026","desc_zh":"2026Q2 Other premium 出货同比仅降 <strong>-5.7%<\/strong>（优于 Marlboro 的 -7.4%），Q3 同比降 <strong>-6.3%<\/strong>（优于 Marlboro 的 -6.4%），证明高净值客群受通胀冲击更小 <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Q3'26 Table 3 ↗<\/a>。","desc_en":"Other Premium sticks fell just <strong>-5.7%<\/strong> in Q2'26 (beating Marlboro's -7.4%) and <strong>-6.3%<\/strong> in Q3'26, proving affluent coastal demographics resist macro pressure <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Q3'26 Table 3 ↗<\/a>."},{"title_zh":"3. 严苛州合规目录完备布局","title_en":"3. Certified Non-Menthol & Specialty State Listings","desc_zh":"加州司法部（CA DOJ）官方合规烟草目录显示，PM USA 完整保留了 Parliament Silver Box、Virginia Slims Gold 120s Box 与 Benson & Hedges Luxury 100s 等高毛利合规规格 <a class=\"cite-link\" href=\"https://oag.ca.gov/tobacco/directory?page=8&order=field_tp_manufacturer&sort=asc\" target=\"_blank\" rel=\"noopener noreferrer\">CA DOJ Directory ↗<\/a>。","desc_en":"CA DOJ Tobacco Directory filings confirm PM USA maintains certified Parliament Silver Box, Virginia Slims Gold 120s, and Benson & Hedges Luxury 100s SKUs <a class=\"cite-link\" href=\"https://oag.ca.gov/tobacco/directory?page=8&order=field_tp_manufacturer&sort=asc\" target=\"_blank\" rel=\"noopener noreferrer\">CA DOJ Directory ↗<\/a>."}],"alert_zh":"<strong>财务纯度洞察：<\/strong>以 2025 全年 <strong>28.45 亿支（1.4225 亿包）<\/strong> 及 2026 年化约 <strong>26.5 亿支（1.325 亿包）<\/strong> 测算，Other premium 虽然仅占 PM USA 卷烟总销量的约 <strong>4.4%<\/strong>，但因出厂净实现价高且几乎无渠道促销折让，估算每年稳态为奥驰亚贡献逾 <strong>$5.5 亿–$6.5 亿美元<\/strong> 的极高纯度营业利润。","alert_en":"<strong>High-Purity Profit Contribution:<\/strong> At <strong>2,845M sticks (142.3M packs)<\/strong> in FY2025 and ~<strong>2,650M annualized sticks<\/strong> in 2026 (~4.4% of PM USA volume), Other premium requires minimal trade promotion and generates an estimated <strong>$550M–$650M<\/strong> in high-purity annual OCI.","chart":{"tabA_zh":"视图A: 出货量与零售份额超稳态轨迹","tabA_en":"View A: Volume & Ultra-Steady Share","tabB_zh":"视图B: 2026季度同比降幅优于主线对比","tabB_en":"View B: YoY Resilience vs. Marlboro","viewA":{"mode":"dual_bar_line","title_zh":"PM USA Other Premium（Parliament + Virginia Slims）出货量与零售份额","title_en":"PM USA Other Premium (Parliament & Virginia Slims) Shipments (B Sticks) & Share (%)","sub_zh":"2024–2026Q3 零售市场份额锁定在 2.1%–2.3% 极窄走廊，展现超高端利基极强粘性","sub_en":"Retail share held within a tight 2.1%–2.3% band across 2024–Q3 2026 despite industry discount pressure","leg1_zh":"阶段报告出货量 (左轴 · 十亿支)","leg1_en":"Reported Shipments (Left · B Sticks)","leg2_zh":"全美卷烟零售份额 (右轴 · %)","leg2_en":"US Cigarette Retail Share (Right · %)","labels_zh":["2024全年","2025全年","2026H1","2026前9月(Q3份额)"],"labels_en":["FY 2024","FY 2025","1H 2026","9M 2026 (Q3 Share)"],"subs_zh":["3,186M 支","2,845M 支","1,279M 支","1,976M 支 · Q3 697M"],"subs_en":["3,186M sticks","2,845M sticks","1,279M sticks","1,976M sticks · Q3 697M"],"s1":[3.19,2.85,1.28,1.98],"s2":[2.3,2.2,2.1,2.1],"max1":3.8,"max2":3.0,"u1":"B","u2":"%"},"viewB":{"mode":"grouped_bars","title_zh":"2025 vs 2026 分季度 Other Premium 出货量对比（百万支）","title_en":"Other Premium Quarterly Shipments: 2026 vs. 2025 (Million Sticks)","sub_zh":"Q2 (-5.7%) 与 Q3 (-6.3%) 同比回落斜率显著收窄，季度出货稳定在 ~680M–700M 支平台","sub_en":"Decline rates moderated sharply to -5.7% in Q2 and -6.3% in Q3 2026 (~680M–700M sticks/quarter)","leg1_zh":"2026 季度出货量 (百万支)","leg1_en":"2026 Quarterly Sticks (M)","leg2_zh":"2025 同期出货量 (百万支)","leg2_en":"2025 Prior-Year Sticks (M)","labels_zh":["Q1 单季","Q2 单季","Q3 单季","Q4 (2025 vs 2024)"],"labels_en":["Q1","Q2","Q3","Q4 (FY25 vs FY24)"],"subs_zh":["601M vs 678M","678M vs 719M (-5.7%)","697M vs 744M (-6.3%)","704M vs 789M (-10.8%)"],"subs_en":["601M vs 678M","678M vs 719M (-5.7%)","697M vs 744M (-6.3%)","704M vs 789M (-10.8%)"],"s1":[601,678,697,704],"s2":[678,719,744,789],"max1":900,"u1":"M","u2":"M"}},"matrix_cards":[{"title_zh":"Parliament：从 1931 贵族滤嘴先驱到都会精英符号","title_en":"Parliament: 1931 Filter Pioneer & Coastal Metro Icon","badge_zh":"凹陷硬纸滤嘴专利传承","badge_en":"Recessed Paper Mouthpiece","body_zh":"创立于 1931 年的 Parliament 是美国商业卷烟史上最早引入过滤嘴的先驱之一（早于 1950 年代滤嘴普及潮近二十年），其凹陷式纸质烟嘴在纽约等大都会圈形成了近乎亚文化级的圈层忠诚度 <a class=\"cite-link\" href=\"https://en.wikipedia.org/wiki/Parliament_(cigarette)\" target=\"_blank\" rel=\"noopener noreferrer\">Parliament History ↗<\/a>。","detail_zh":"海外市场由 PMI 运营的 Parliament 同样是全球第四大国际卷烟品牌（在日韩、土耳其等地居超高端龙头），境内外双线印证了凹陷滤嘴极强的溢价生命力。","body_en":"Introduced in 1931 before filters became mainstream, Parliament's recessed paper mouthpiece built enduring status among affluent coastal metropolitan smokers <a class=\"cite-link\" href=\"https://en.wikipedia.org/wiki/Parliament_(cigarette)\" target=\"_blank\" rel=\"noopener noreferrer\">Parliament History ↗<\/a>.","detail_en":"Outside the US, PMI's international Parliament is also a top-4 global super-premium brand, confirming the universal pricing power of recessed-filter engineering."},{"title_zh":"Virginia Slims：细长烟支与 120s 规格的结构垄断","title_en":"Virginia Slims: Structural Monopoly in Superslims & 120s","badge_zh":"100s / 120s / Superslims","badge_en":"Slender & Extended Formats","body_zh":"1968 年面世的 Virginia Slims 开创了细圆周长支卷烟品类；如今在全美便利店货架上，它在 120mm 加长烟支与 Superslims 方盒领域几乎没有同体量对手 <a class=\"cite-link\" href=\"https://oag.ca.gov/tobacco/directory?page=8&order=field_tp_manufacturer&sort=asc\" target=\"_blank\" rel=\"noopener noreferrer\">CA DOJ Styles ↗<\/a>。","detail_zh":"由于客群年龄层成熟、品牌转换意愿极低，Virginia Slims 无需任何促销投入即可随 PM USA 半年一次的提价窗口稳定贡献高额单包现金流。","body_en":"Launched in 1968, Virginia Slims owns near-monopoly shelf presence in 120mm luxury length and Superslims purse-pack formats across US convenience stores <a class=\"cite-link\" href=\"https://oag.ca.gov/tobacco/directory?page=8&order=field_tp_manufacturer&sort=asc\" target=\"_blank\" rel=\"noopener noreferrer\">CA DOJ Styles ↗<\/a>.","detail_en":"Mature demographic loyalty allows full list-price pass-through twice a year with virtually zero promotional discounting."}]},"ch2":{"eyebrow":"CHAPTER 02 · FOUR SUPER-PREMIUM PILLARS & 5-AXIS MOAT RADAR","h2_zh":"二、四大超高端支柱：年销近 27 亿支的高溢价双星靠什么躺赢？","h2_en":"2. Four Niche Pillars: Why Parliament & Virginia Slims Command Effortless Margins","badge_zh":"护城河定性：物理形态壁垒 (零平替 · 高净值客群)","badge_en":"Moat Rating: Structural Niche (Zero Cheap Substitutes)","pillars":[{"title_zh":"01 · 异形滤嘴与细长圆周构筑“零深折替代品”壁垒","title_en":"01 · Form-Factor Exclusivity Eliminates Deep-Discount Clones","badge_zh":"5mm凹嘴 / 120mm长支","badge_en":"Recessed & 120s Craft","desc_zh":"深折烟厂只做标准 84mm 圆支；特殊嘴棒与细长烟支锁死了存量用户的感官习惯。","note_zh":"<strong>当前选中支柱解读（01 物理排他性）：<\/strong>这是 Other premium 份额在 2024–2026Q3 仅微幅波动 0.2pp（2.3%→2.1%）、远比标准 85mm 主流烟抗跌的根本物理原因。","note_en":"<strong>Selected Pillar (01 · Structural Exclusivity):<\/strong> Because budget makers lack recessed-filter and 120s Superslims tooling, loyalists rarely trade down to $5 brands.","desc_en":"Tier-4 discount makers only run standard 84mm rods; specialized recessed tips and 120mm formats lock in tactile habits."},{"title_zh":"02 · 高收入大都会客群对价格近乎完全脱敏","title_en":"02 · Affluent Metro Demographics Absorb Price Hikes","badge_zh":"Q3降幅仅 -6.3%","badge_en":"-6.3% Q3 Vol Resilience","desc_zh":"核心消费群集中在东北部与沿海高收入都市带，受汽油食品通胀挤压远小于中低收入烟民。","note_zh":"<strong>当前选中支柱解读（02 客群购买力）：<\/strong>2026Q2 与 Q3 出货同比表现（-5.7% / -6.3%）双双跑赢旗舰万宝路（-7.4% / -6.4%）。","note_en":"<strong>Selected Pillar (02 · Affluent Demographics):<\/strong> Other premium outperformed Marlboro stick trends in both Q2 (-5.7% vs. -7.4%) and Q3 2026 (-6.3% vs. -6.4%).","desc_en":"Skewed toward higher-income coastal urban smokers far less impacted by gas and grocery inflation."},{"title_zh":"03 · 近乎为零的渠道买赠折让（Pure Net Realization）","title_en":"03 · Near-Zero Promotional Dilution Maximizes Unit OCI","badge_zh":"最高单包净利率","badge_en":"Peak Per-Pack OCI","desc_zh":"不参与惨烈的多包立减战，每一次出厂目录提价几乎 100% 转化为 PM USA 账面净营收与 OCI。","note_zh":"<strong>当前选中支柱解读（03 纯粹提价传导）：<\/strong>单包出厂净利高于集团平均水平，是可燃分部 64.8% 利润率的重要隐形助推器。","note_en":"<strong>Selected Pillar (03 · Full Price Realization):<\/strong> Minimal promotional discounting translates list-price hikes directly into bottom-line OCI.","desc_en":"Minimal promotional buydown spend (<4%) allows nearly every list-price hike dollar to flow straight to Adjusted OCI."},{"title_zh":"04 · 共享里士满采购中台与 AGDC 顶层货架配额","title_en":"04 · Shared PM USA Leaf Scale & AGDC Top-Shelf Placement","badge_zh":"零独立总部费用","badge_en":"Zero Standalone SG&A","desc_zh":"无需独立销售公司或研发中台，完全寄生在 PM USA 与 AGDC 基础设施之上输出纯现金流。","note_zh":"<strong>当前选中支柱解读（04 极致费用杠杆）：<\/strong>如果作为独立小公司运营 2.1% 份额品牌需承担高昂固定渠道费，而在奥驰亚体系内其边际 SG&A 极低。","note_en":"<strong>Selected Pillar (04 · Shared Infrastructure):<\/strong> Riding PM USA's leaf procurement and AGDC's 300K-door salesforce eliminates standalone overhead.","desc_en":"Operates on zero standalone corporate SG&A by riding PM USA's Richmond plant and AGDC top-shelf contracts."}],"radar":{"title_zh":"美国超高端与特色利基卷烟五维竞争力雷达图（10分制）","title_en":"5-Axis Super-Premium & Specialty Cigarette Radar (10-Point Scale)","axes_zh":["单包出厂溢价","物理形态独特性","客群抗通胀韧性","终端货架覆盖","促销费用节约度"],"axes_en":["Pack Price Premium","Form-Factor Uniqueness","Inflation Immunity","Shelf Reach","Promo Discipline"],"s0_zh":"Parliament & Virginia Slims (PM USA · 2.1%份额)","s0_en":"Parliament & Virginia Slims (PM USA · 2.1% Share)","s1_zh":"Natural American Spirit (雷诺超高端无添加旗舰)","s1_en":"Natural American Spirit (Reynolds Super-Premium)","s2_zh":"Dunhill / Nat's (小众进口与精品高端烟)","s2_en":"Dunhill / Boutique Super-Premiums","v0":[9.3,9.8,9.1,8.9,9.5],"v1":[9.7,8.6,9.4,8.4,9.0],"v2":[9.5,7.5,8.5,4.8,8.8]}},"ch3":{"eyebrow":"CHAPTER 03 · SUPER-PREMIUM & SPECIALTY CIGARETTE MATRIX","h2_zh":"三、全美超高端与特色结构卷烟横向对比：形态壁垒 vs 理念壁垒","h2_en":"3. US Super-Premium Cigarette Matrix: Structural Craft vs. Organic Positioning","peers_zh":[{"category":"altria","benchmark":true,"title":"研究标的：Parliament 百乐门系列","creator":"Philip Morris USA (奥驰亚)","format":"超高端凹陷滤嘴盒装 (~$10.50–$11.50/包均价)","craft":"5mm 内凹硬纸烟嘴 · White/Silver/Menthol Green","views":"Other Premium 主力 (历史单牌占全美 ~1.5%–1.9%)","acclaim":"大都会高收入客群 · 极高单包 OCI 净利","takeaway":"用物理烟嘴结构创造不可替代的抽吸触感，彻底免疫 $5 深折烟诱惑。","sourceLabel":"Q3'26 / Wiki","sourceUrl":"https://en.wikipedia.org/wiki/Parliament_(cigarette)"},{"category":"altria","benchmark":true,"title":"研究标的：Virginia Slims & Benson & Hedges","creator":"Philip Morris USA (奥驰亚)","format":"超高端细长支 100s / 120s / Superslims","craft":"23mm 纤细圆周与 120mm 加长规格 · Gold/Menthol","views":"与 Parliament 合占全美 2.1% 份额 (9M'26 共 1,976M 支)","acclaim":"细长支细分绝对霸主 · 零价格战内耗","takeaway":"精准卡位女性与成熟长支偏好者，每年零营销投入静默贡献高纯度现金流。","sourceLabel":"Q3'26 / CA DOJ","sourceUrl":"https://oag.ca.gov/tobacco/directory?page=8&order=field_tp_manufacturer&sort=asc"},{"category":"external","benchmark":false,"title":"Natural American Spirit (NAS 美国精神)","creator":"Santa Fe Natural Tobacco / BAT (雷诺)","format":"超高端有机/无添加概念 (~$10.80–$12.00/包)","craft":"高填丝密度 (+25%烟叶量) · 慢燃纯烟叶加水配方","views":"全美超高端第 1 大单牌 (~3.8%–4.0% 估计份额)","acclaim":"高学历环保审美客群 · FDA 曾限制“无添加=更安全”暗示","takeaway":"全美唯一在体量上超越 Parliament 的超高端标杆，靠慢燃耐抽与有机调性赢得溢价。","sourceLabel":"CA Tobacco Dir","sourceUrl":"https://oag.ca.gov/tobacco/directory?page=8&order=field_tp_manufacturer&sort=asc"},{"category":"external","benchmark":false,"title":"Capri 卡普里 & Misty (女性细支竞品)","creator":"R.J. Reynolds / ITG Brands","format":"超细支 Superslims (Capri 高端 / Misty 折扣)","craft":"17mm–21mm 纤细烟支 · 窄众货架陈列","views":"合计份额不足 0.6%，远逊于 Virginia Slims","acclaim":"配货率持续萎缩 · 缺乏 120s 全系矩阵","takeaway":"在细支赛道被 Virginia Slims 凭借 AGDC 渠道广度全面压制。","sourceLabel":"CA Tobacco Dir","sourceUrl":"https://oag.ca.gov/tobacco/directory?page=8&order=field_tp_manufacturer&sort=asc"},{"category":"altria","benchmark":false,"title":"Marlboro Gold & Smooth Ice (内部主流高端参照)","creator":"Philip Morris USA (奥驰亚)","format":"主流高端标杆 (~$9.50/包)","craft":"85mm/100s 标准平头醋酸纤维滤嘴","views":"隶属 Marlboro 39.5% 旗舰大盘","acclaim":"全美最大顺滑风味单品","takeaway":"与 Parliament 形成梯度互补：追求更高档次凹嘴体验的万宝路用户自然向上升级至百乐门。","sourceLabel":"Altria Q3'26","sourceUrl":"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx"}],"peers_en":[{"category":"altria","benchmark":true,"title":"Subject: Parliament Recessed-Filter Line","creator":"Philip Morris USA (Altria)","format":"Super-Premium Box (~$10.50–$11.50/pack avg)","craft":"5mm recessed paper filter · White/Silver/Menthol","views":"Anchor of PM USA Other Premium (2.1% combined US share)","acclaim":"Coastal metro stronghold · Peak per-stick realization","takeaway":"Tactile recessed-filter geometry locks in affluent urban smokers with zero deep-discount substitutes.","sourceLabel":"Q3'26 / Wiki","sourceUrl":"https://en.wikipedia.org/wiki/Parliament_(cigarette)"},{"category":"altria","benchmark":true,"title":"Subject: Virginia Slims & Benson & Hedges","creator":"Philip Morris USA (Altria)","format":"Super-Premium 100s / 120s / Superslims","craft":"23mm slender circumference & 120mm luxury length","views":"1,976M combined Other Premium sticks in 9M 2026","acclaim":"#1 US superslim/120s franchise · Minimal promo spend","takeaway":"Owns the slender/extended niche across >300K AGDC stores, harvesting steady twice-yearly list hikes.","sourceLabel":"Q3'26 / CA DOJ","sourceUrl":"https://oag.ca.gov/tobacco/directory?page=8&order=field_tp_manufacturer&sort=asc"},{"category":"external","benchmark":false,"title":"Natural American Spirit (NAS)","creator":"Santa Fe Natural Tobacco / BAT","format":"Super-Premium Whole-Leaf (~$10.80–$12.00/pack)","craft":"Dense slow-burning tobacco+water blend","views":"#1 US super-premium single brand (~3.8%–4.0% est. share)","acclaim":"Strong urban millennial/affluent stickiness","takeaway":"Proves super-premium cigarette niches outperform mainstream volumes during inflation.","sourceLabel":"CA Tobacco Dir","sourceUrl":"https://oag.ca.gov/tobacco/directory?page=8&order=field_tp_manufacturer&sort=asc"},{"category":"external","benchmark":false,"title":"Capri & Misty (Slender Cigarette Rivals)","creator":"R.J. Reynolds / ITG Brands","format":"Superslim Niche (Capri Premium / Misty Value)","craft":"Ultra-thin circumference rods · Limited retail facings","views":"<0.6% combined share; dwarfed by Virginia Slims","acclaim":"Shrinking convenience distribution","takeaway":"Out-muscled on the backbar by Virginia Slims' breadth of 100s, 120s, and Superslims.","sourceLabel":"CA Tobacco Dir","sourceUrl":"https://oag.ca.gov/tobacco/directory?page=8&order=field_tp_manufacturer&sort=asc"},{"category":"altria","benchmark":false,"title":"Marlboro Gold Pack (Internal Mainstream Anchor)","creator":"Philip Morris USA (Altria)","format":"Mainstream Premium (~$9.50/pack)","craft":"Standard flush cellulose-acetate filter 85s/100s","views":"Core pillar of Marlboro's 39.5% share","acclaim":"#1 smooth cigarette in America","takeaway":"Complements Parliament below: affluent smooth-flavor smokers step up to Parliament without leaving PM USA.","sourceLabel":"Altria Q3'26","sourceUrl":"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx"}],"bars":{"title_zh":"2026Q3 PM USA 三大卷烟产品线同比销量变化率对比（绝对值越小越抗跌 / 正值增长）","title_en":"Q3 & 1H 2026 Volume Resilience Across PM USA Cigarette Tiers (% YoY Change Input Index)","sub_zh":"核验自奥驰亚 2026Q2 与 Q3 财报 Table 3：展示超高端利基线（Other Premium）优异的份额与单价稳健度","sub_en":"Verified via Altria Q2 & Q3 2026 Table 3: Comparing super-premium per-pack OCI index (100 = Marlboro baseline)","badge_zh":"单包净利指数冠绝全系 (~115)","badge_en":"Highest Per-Pack OCI Index (~115)","leg1_zh":"蓝色/绿色：单包出厂净实现利润相对指数 (以 Marlboro 核心线 = 100 基准)","leg1_en":"Blue / Green: Relative Net Per-Pack Profit Index (Marlboro Core = 100)","leg2_zh":"紫色/琥珀：外部高端与深折品牌单包利润相对指数参照","leg2_en":"Purple / Amber: External Super-Premium & Discount Per-Pack Profit Index","max_x":130,"ref_line":100,"items_zh":[{"label":"Natural American Spirit (雷诺超高端有机线)","val":118,"disp":"118 指数","sub":"最高目录价 · 慢燃配方","note":"外部超高端单包毛利天花板"},{"label":"Parliament 百乐门凹陷滤嘴系列 (PM USA)","val":115,"disp":"115 指数","sub":"超高端定价 + 极低买赠折让","note":"PM USA 内部单包利润王"},{"label":"Virginia Slims 120s / Superslims (PM USA)","val":112,"disp":"112 指数","sub":"细长支独占溢价 · 零价格战","note":"2.1% Other Premium 现金牛搭档"},{"label":"Marlboro 核心旗舰组合加权 (Red/Gold/Cowboy Cut)","val":100,"disp":"100 基准","sub":"39.5% 市场规模霸主","note":"全美可燃烟利润总额绝对核心"},{"label":"L&M 品牌化次折扣线 (PM USA)","val":64,"disp":"64 指数","sub":"2026.04 提价改善边际","note":"次折扣带稳健现金贡献"},{"label":"Basic 深折防守线 / Montego (第四梯队带)","val":42,"disp":"42 指数","sub":"靠 +69.7% 放量与摊销取胜","note":"战略价值在于拦截流失与保总份额"}],"items_en":[{"label":"Natural American Spirit (Reynolds Super-Premium)","val":118,"disp":"118 Idx","sub":"Top US pack price · Minimal promo","note":"External super-premium unit benchmark"},{"label":"Parliament Recessed-Filter Series (PM USA)","val":115,"disp":"115 Idx","sub":"Above-Marlboro list + near-zero promo","note":"Highest per-pack realization in PM USA"},{"label":"Virginia Slims 120s / Superslims (PM USA)","val":112,"disp":"112 Idx","sub":"Slender/120s format exclusivity","note":"Co-anchors PM USA's 2.1% Other Premium"},{"label":"Marlboro Blended Franchise (PM USA Baseline = 100)","val":100,"disp":"100 Base","sub":"39.5% US share · 60% of Premium","note":"Core $8.77B 9M'26 OCI engine"},{"label":"L&M Branded Discount (PM USA)","val":64,"disp":"64 Idx","sub":"Hiked in Apr 2026 for margin","note":"Sub-premium profit bridge"},{"label":"Basic / Montego Deep-Discount Tier","val":42,"disp":"42 Idx","sub":"Volume +69.7% & overhead shield","note":"Strategic share & backbar defense"}]}},"ch4":{"eyebrow":"CHAPTER 04 · SUPER-PREMIUM UNIT ECONOMICS & CASHFLOW SIMULATOR","h2_zh":"四、超高端利基现金流推演：年销 ~1.33 亿包如何做到超 $5.8 亿净营业利润？","h2_en":"4. Niche Unit Economics & Simulator: How ~133M Packs Generate >$580M Annual OCI","sub_zh":"无需分担巨额数字优惠券补贴与新品试错开支，Other Premium 是纯粹的自由现金流贵族","sub_en":"With minimal digital couponing and zero R&D capex, Other Premium converts revenue into pure dividend cash flow","badge_zh":"单包预估 OCI ~$4.30–$4.80","badge_en":"Est. ~$4.30–$4.80 OCI / Pack","econ_cards":[{"label_zh":"ANNUALIZED PACK VOL","label_en":"ANNUALIZED PACK VOL","val_zh":"~132.5M 包","val_en":"~132.5M Packs","desc_zh":"2026前9月出货 1,976M 支（98.8M 包），全年预计约 26.5 亿支（1.325 亿包）。","desc_en":"1,976M sticks (98.8M packs) in 9M 2026 puts full-year 2026 on pace for ~2.65B sticks (~132.5M packs)."},{"label_zh":"PROMO DILUTION RATE","label_en":"PROMO DILUTION RATE","val_zh":"< 4% 极低折让","val_en":"< 4% Promo Spend","desc_zh":"远低于主流卷烟 15%–25% 的促销补贴强度，目录提价几乎无损落袋。","desc_en":"Sub-4% promotional dilution vs. 15%–25% industry mainstream discounting maximizes net revenue realization per pack."},{"label_zh":"SHARE STABILITY","label_en":"SHARE STABILITY","val_zh":"2.1% 稳态","val_en":"2.1% Rock-Solid","desc_zh":"在折扣烟席卷 34.1% 市场的大背景下，连续多个季度死守 2.1%–2.2% 铁底。","desc_en":"Rock-solid 2.1%–2.2% US cigarette share floor even as industry discount share climbed to 34.1%."},{"label_zh":"CAPEX INTENSITY","label_en":"CAPEX INTENSITY","val_zh":"~0.8% 极轻维护","val_en":"~0.8% Maint CapEx","desc_zh":"现成凹嘴与细支高速机组极其成熟，每年仅需千万美元级例行设备保养。","desc_en":"Fully depreciated recessed-filter and slim-rod machinery requires <1% annual maintenance CapEx."}],"combo":{"title_zh":"Other Premium 季度出货量（百万支）与同比增速收敛轨迹（2025Q4–2026Q3）","title_en":"Other Premium Quarterly Volume (M Sticks) vs. YoY Retention Rate (%)","sub_zh":"同比留存率（100% + YoY变动）从 2025Q4 的 89.2% 显著改善至 2026Q2 的 94.3% 与 Q3 的 93.7%","sub_en":"YoY volume retention improved from 89.2% in Q4 2025 to 94.3% in Q2 2026 and 93.7% in Q3 2026","badge_zh":"留存率稳定在 ~94% 高位","badge_en":"~94% Annual Volume Retention","left_zh":"■ 左轴：单季国内出货量 (百万支)","left_en":"■ Left Axis: Quarterly Shipments (M Sticks)","right_zh":"● 右轴：同比销量留存率 (%)","right_en":"● Right Axis: YoY Volume Retention (%)","leg1_zh":"季度报告出货量 (左轴 · M支)","leg1_en":"Quarterly Sticks (Left · M)","leg2_zh":"同比销量留存率 (右轴 · %)","leg2_en":"YoY Volume Retention (Right · %)","line_badge_zh":"--- 92.0% 行业健康留存基准","line_badge_en":"--- 92.0% Healthy Retention Line","titles_zh":["2025全年季均","2025Q4","2026Q1","2026Q2","2026Q3"],"titles_en":["FY25 Qtr Avg","Q4 2025","Q1 2026","Q2 2026","Q3 2026"],"subs_zh":["全年 -10.7%","-10.8% YoY","-11.4% 渠道去库","-5.7% 强劲企稳","-6.3% 跑赢万宝路"],"subs_en":["FY -10.7%","-10.8% YoY","-11.4% destock","-5.7% rebound","-6.3% beats MB"],"bars":[711,704,601,678,697],"line":[89.3,89.2,88.6,94.3,93.7],"max_bar":850,"min_line":84,"max_line":98,"ref_line":92,"u_bar":"M","u_line":"%","highlight_idx":4},"sim":{"title_zh":"Parliament & Virginia Slims 超高端组合多年期净现金流模拟器","title_en":"Parliament & Virginia Slims Multi-Year Pure Cashflow Simulator","toggle_title_zh":"开启超高端年度双次全额净提价 (+8.5%/年净价复利，对冲 ~6% 销量自然回落)","toggle_title_en":"Enable Semi-Annual Super-Premium Price Pass-Through (+14% Net OCI Lift)","toggle_sub_zh":"模拟大都会高收入客群零促销补贴吸收提价，实现销量微降而单品总利润稳中有升","toggle_sub_en":"Simulates affluent coastal smokers absorbing semi-annual list hikes with minimal couponing","s1_label_zh":"首年组合出货包数 (百万包 · 1包=20支)","s1_label_en":"Year-1 Combined Volume (Million Packs)","s1_unit_zh":"M 包","s1_unit_en":"M Pks","s1_min":95,"s1_max":160,"s1_step":5,"s2_label_zh":"超高端单包出厂 OCI 净利 (USD / 包)","s2_label_en":"Super-Premium Net OCI per Pack (USD)","s2_unit_zh":"/包","s2_unit_en":"/pk","s2_min":3.6,"s2_max":5.6,"s2_step":0.2,"s3_label_zh":"免税渠道与高端雪茄吧/精品店溢价增量 ($M / 年)","s3_label_en":"Duty-Free & Metro Specialty Margin Lift ($M/yr)","s3_min":15,"s3_max":85,"s3_step":5,"roi_label_zh":"相对年均 $25M 专用模组维护成本现金倍数","roi_label_en":"Cash Multiple vs. $25M Annual Tooling Maintenance","cost_base_m":25,"mult":1.14,"vol_drift":0.945,"presets":{"p1":{"label_zh":"① 保守加速老龄化情景 (-8%/年自然减量)","label_en":"① Conservative Demographic Attrition","tag_zh":"120M包 · 5年","tag_en":"120M · 5 Yrs","views":120,"v_per_view":4.2,"ancillary_m":25,"years":5,"transmedia":false},"p2":{"label_zh":"② 核心稳态收割情景 (133M包 · 双次提价对冲)","label_en":"② Base Super-Premium Harvest Case","tag_zh":"133M包 · 5年","tag_en":"133M · 5 Yrs","views":133,"v_per_view":4.5,"ancillary_m":45,"years":5,"transmedia":true},"p3":{"label_zh":"③ 高溢价强化情景 (单包OCI突破 $5.0+ 长周期复利)","label_en":"③ Bull Pricing Power Case ($5.0+ OCI/pk)","tag_zh":"140M包 · 8年","tag_en":"140M · 8 Yrs","views":140,"v_per_view":5.0,"ancillary_m":65,"years":8,"transmedia":true}}},"moat_pos_zh":"<strong>1. 极致纯粹的现金分红底座：<\/strong>无需广告战、无需补贴战、无需大额资本开支，每年稳定贡献约 $5.5亿–$6.5亿 OCI。<br/><strong>2. 物理工艺锁客：<\/strong>凹陷滤嘴与 120mm 细支在感官记忆上形成了天然闭环。","moat_pos_en":"<strong>1. Purest Dividend Cash Cows in Combustibles:<\/strong> Zero ad wars, minimal trade discounts, and negligible CapEx yield ~$550M–$650M in effortless annual OCI.<br/><strong>2. Tactile Lock-In:<\/strong> Recessed mouthpieces and 120mm Superslims prevent switching to commodity cigarettes.","moat_risk_zh":"<strong>1. 存量客群自然代际老龄化：<\/strong>Virginia Slims 核心女性烟民平均年龄偏高，缺乏年轻新客补充。<br/><strong>2. 沿海蓝州高额消费税与薄荷禁令：<\/strong>纽约、加州等核心市场持续加征州烟草税及实施风味限制（需依赖非薄荷 Silver/Gold 款承接）。","moat_risk_en":"<strong>1. Demographic Aging:<\/strong> Virginia Slims' core cohort skews older with limited adult Gen-Z inflow.<br/><strong>2. Coastal State Excise Taxes & Menthol Bans:<\/strong> Heavy exposure to NY/CA tax hikes requires seamless migration into non-menthol White/Gold SKUs."},"ch5":{"eyebrow":"CHAPTER 05 · 95-YEAR HERITAGE & NICHE MONETIZATION","h2_zh":"五、百年超高端演进史与四大定力节点：拒绝规模执念后的利润最大化","h2_en":"5. 95-Year Heritage & Key Milestones: Profit Maximization Over Volume Chasing","sub_zh":"从 1931 纽约绅士烟嘴创新、1968 女性独立浪潮符号，到当代奥驰亚最安静的高毛利宝石","sub_en":"From 1931 Benson & Hedges filter innovation and 1968 cultural icon to PM USA's quietest high-margin jewel","badge_zh":"1931 创立 → 1968 细支开创 → 2026 2.1%稳态","badge_en":"1931 Launch → 1968 Slims → 2026 2.1% Share","acts":[{"title_zh":"第一阶段 · 1931 年 Parliament 凹陷滤嘴革命 —— 比滤嘴普及潮早 20 年","title_en":"Act I · 1931 Parliament Recessed Filter Breakthrough","badge_zh":"1931 纽约诞生","badge_en":"Est. 1931","desc_zh":"最初由美国 Benson & Hedges 推出双层硬盒凹陷纸嘴卷烟，后并入 Philip Morris 麾下，以“Tobacco tastes best when the filter's recessed”奠定全美富裕阶层口碑 <a class=\"cite-link\" href=\"https://en.wikipedia.org/wiki/Parliament_(cigarette)\" target=\"_blank\" rel=\"noopener noreferrer\">Parliament Wiki ↗<\/a>。","desc_en":"Launched in 1931 with a recessed paper filter mouthpiece and merged into Philip Morris, cementing affluent metropolitan prestige <a class=\"cite-link\" href=\"https://en.wikipedia.org/wiki/Parliament_(cigarette)\" target=\"_blank\" rel=\"noopener noreferrer\">Parliament Wiki ↗<\/a>."},{"title_zh":"第二阶段 · 1968 年 Virginia Slims 开辟细长支新大陆 —— 形态细分垄断成型","title_en":"Act II · 1968 Virginia Slims Creates the Slender Category","badge_zh":"100s / 120s / Superslims","badge_en":"Slender Pioneer","desc_zh":"精准针对现代女性握持审美推出比传统 84mm 卷烟更纤细修长的烟支，随后延伸出 Superslims 超薄方盒与 120s 奢华长支系列。","desc_en":"Created the slender-circumference 100mm/120mm and Superslims segments, establishing lasting form-factor dominance."},{"title_zh":"第三阶段 · 后广告时代的极致现金牛管理 (2009–2026) —— 稳居 2.1%–2.3% 纯利走廊","title_en":"Act III · Disciplined Super-Premium Harvesting (2009–2026)","badge_zh":"Q3'26 697M 支 (-6.3%)","badge_en":"Q3'26 697M Sticks","desc_zh":"PM USA 彻底放弃为这两款利基品牌做低效冲量，转而专注品控、核心货架保供与每年两次目录提价，使其在 2026 年通胀大潮中依然稳守 2.1% 份额 <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Q3'26 Table 4 ↗<\/a>。","desc_en":"Focused strictly on shelf availability in top metro zip codes and full list-price realization, holding 2.1% US share in Q3 2026 <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Q3'26 Table 4 ↗<\/a>."}],"battles":[{"tag_zh":"节点 01 · 工艺壁垒","tag_en":"Case 01 · Filter Craft","sub_zh":"5mm 中空腔体","sub_en":"5mm Recessed Cavity","title_zh":"凹陷纸嘴防止焦油接触双唇的独特体验","title_en":"Recessed Paper Mouthpiece Creates Sticky Ritual","desc_zh":"硬挺内凹纸管不仅防止唾液浸软滤嘴，还赋予独特的舌尖气流聚焦感，令核心用户数十年不换牌 <a class=\"cite-link\" href=\"https://en.wikipedia.org/wiki/Parliament_(cigarette)\" target=\"_blank\" rel=\"noopener noreferrer\">Parliament Wiki ↗<\/a>。","desc_en":"The rigid recessed paper tube prevents soggy filter tips and focuses airflow, creating multi-decade brand stickiness <a class=\"cite-link\" href=\"https://en.wikipedia.org/wiki/Parliament_(cigarette)\" target=\"_blank\" rel=\"noopener noreferrer\">Parliament Wiki ↗<\/a>."},{"tag_zh":"节点 02 · 加州合规","tag_en":"Case 02 · CA Compliance","sub_zh":"风味禁令后承接","sub_en":"Post-Ban Retention","title_zh":"非薄荷 Silver / Gold 120s 留住高税州存量","title_en":"Parliament Silver & V. Slims Gold 120s Retain CA Smokers","desc_zh":"通过加州总检察长名录在册的非薄荷凹嘴与 120s 款式，在薄荷禁令实施后最大限度留住高净值存量用户 <a class=\"cite-link\" href=\"https://oag.ca.gov/tobacco/directory?page=8&order=field_tp_manufacturer&sort=asc\" target=\"_blank\" rel=\"noopener noreferrer\">CA DOJ Directory ↗<\/a>。","desc_en":"Certified non-menthol Parliament Silver and Virginia Slims Gold 120s SKUs retained California smokers post-menthol ban <a class=\"cite-link\" href=\"https://oag.ca.gov/tobacco/directory?page=8&order=field_tp_manufacturer&sort=asc\" target=\"_blank\" rel=\"noopener noreferrer\">CA DOJ Directory ↗<\/a>."},{"tag_zh":"节点 03 · 2026Q2–Q3","tag_en":"Case 03 · Q2–Q3 2026","sub_zh":"抗通胀实证","sub_en":"Inflation Proof","title_zh":"深折狂潮中连续两季销量降幅优于旗舰万宝路","title_en":"Outperforming Marlboro Stick Trends Two Quarters Straight","desc_zh":"当全行业折扣烟冲上 34.1% 时，Other premium 在 Q2（-5.7%）与 Q3（-6.3%）反而比主流高端烟更抗跌 <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Q3'26 Table 3 ↗<\/a>。","desc_en":"Logged -5.7% (Q2) and -6.3% (Q3) YoY stick changes—proving super-premium buyers are insulated from paycheck squeeze <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Q3'26 Table 3 ↗<\/a>."},{"tag_zh":"节点 04 · 未来延伸","tag_en":"Case 04 · HTP Option","sub_zh":"凹嘴加热烟支潜力","sub_en":"HTP Recessed Potential","title_zh":"凹陷冷却结构与加热不燃烧烟支天然契合","title_en":"Recessed Cooling Chamber Synergy for Heated Tobacco","desc_zh":"加热烟草烟支普遍采用中空纸管降温段（与 Parliament 凹嘴同源），为未来 Horizon 超高端烟支储备了现成品牌基因 <a class=\"cite-link\" href=\"https://www.2firsts.com/news/altria-showcases-ploom-marlboro-heated-tobacco-sticks-and-non-nicotine-energy-products-at-nacs-show-2026\" target=\"_blank\" rel=\"noopener noreferrer\">2Firsts NACS ↗<\/a>。","desc_en":"Heated tobacco sticks rely on hollow cooling tubes akin to Parliament's signature mouthpiece, offering future premium HTP optionality <a class=\"cite-link\" href=\"https://www.2firsts.com/news/altria-showcases-ploom-marlboro-heated-tobacco-sticks-and-non-nicotine-energy-products-at-nacs-show-2026\" target=\"_blank\" rel=\"noopener noreferrer\">2Firsts NACS ↗<\/a>."}],"laws":[{"zh":"利基超高端单品最忌盲目扩众降价；守住 2.1% 死忠份额并每年提价两次，远比打折抢到 3% 更赚钱。","en":"Never dilute a 2.1% super-premium niche chasing mass volume; steady semi-annual price hikes maximize lifetime NPV."},{"zh":"物理结构创新（凹嘴、120mm、超细圆周）在禁广告行业比纯视觉包装更具持久排他性。","en":"Physical form-factor differentiation outlasts packaging aesthetics in ad-restricted markets."},{"zh":"依托大集团现成采购与配送底盘运营小众奢侈品牌，可将边际利润率推向极致。","en":"Running boutique luxury SKUs atop a 300K-door mass distribution network unlocks extraordinary operating leverage."}]},"ch6":{"h2_zh":"六、“超高端物理壁垒法则”利基卷烟核查清单","h2_en":"6. 'Super-Premium Form-Factor Law' Niche Moat Checklist","items_zh":[{"tag":"≥ 2.0% 份额铁底","title":"1. 份额铁底测试：Other Premium 全美零售份额是否稳守 2.0%–2.2% 区间？","desc":"2026Q3 实绩 2.1%，验证高净值烟民未发生系统性流失。"},{"tag":"+$1.0+ 溢价带","title":"2. 目录溢价保持测试：出厂净价是否持续高于核心 Marlboro 10%–15% 以上？","desc":"确保每次全系调价时超高端线全额跟涨且不追加买赠补贴。"},{"tag":"~94% 同比留存","title":"3. 销量自然衰减率测试：年度真实消费降幅是否控制在 -6% 至 -8% 温和区间？","desc":"排查代际老龄化是否出现加速断层信号。"},{"tag":"都会核心铺货","title":"4. 高净值邮编区不断货测试：纽约、佛州、加州核心便利店全规格在架率是否 >95%？","desc":"高溢价烟民对断货敏感，稳定排面是零促销锁客前提。"},{"tag":"非薄荷款承接","title":"5. 州级风味禁令免疫测试：新增薄荷禁令州能否顺畅由 Menthol 切换至 Silver/Gold 120s？","desc":"跟踪加州等禁令市场 Parliament White/Silver 承接比例。"},{"tag":"零独立费用膨胀","title":"6. 共享中台纯度测试：是否维持零独立营销编制与极低专用设备折旧？","desc":"保持全集团最高单包自由现金流转化效率。"}],"items_en":[{"tag":"≥ 2.0% Share Floor","title":"1. Share Floor Test: Does Other Premium hold its 2.0%–2.2% US retail share band?","desc":"Verified at 2.1% in Q3 2026 despite 34.1% industry discount share."},{"tag":"+$1.0+ Price Lift","title":"2. Super-Premium Spread Test: Does net realization stay 10%–15%+ above core Marlboro?","desc":"Confirm full pass-through of semi-annual list price increases with minimal couponing."},{"tag":"~94% Vol Retention","title":"3. Demographic Attrition Test: Are annual stick declines contained within -6% to -8%?","desc":"Monitor Q2 (-5.7%) and Q3 (-6.3%) stick trends for cohort stability."},{"tag":"Metro In-Stock >95%","title":"4. Affluent Zip Availability Test: Are full Parliament & 120s SKUs in stock across top coastal metros?","desc":"Prevent out-of-stock switching in high-margin urban stores."},{"tag":"Non-Menthol Bridge","title":"5. Flavor-Ban Resilience Test: Do Silver Box & Gold 120s retain smokers in menthol-ban states?","desc":"Verify SKU migration in California and Massachusetts."},{"tag":"Zero Overhead Creep","title":"6. Shared-Platform Efficiency Test: Are SG&A and tooling maintenance kept ultra-lean?","desc":"Preserve peak per-stick free-cash-flow conversion."}]},"sources":[{"label":"Altria Q3 & 9M 2026 Official Release (Tables 3 & 4: Other Premium 1,976M 9M Sticks, 2.1% Share)","url":"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx"},{"label":"SEC Form 8-K Exhibit 99.1 — Altria FY2025 Results (Other Premium 2,845M Sticks, 2.2% Share)","url":"https://www.sec.gov/Archives/edgar/data/764180/000076418026000007/exhibit991erq42025.htm"},{"label":"SEC Form 8-K Exhibit 99.1 — Altria Q2 2026 Results (Q2 Other Premium 678M Sticks, -5.7% YoY)","url":"https://www.sec.gov/Archives/edgar/data/764180/000076418026000093/exhibit991erq22026.htm"},{"label":"Parliament Cigarette Historical & Recessed Filter Engineering Profile","url":"https://en.wikipedia.org/wiki/Parliament_(cigarette)"},{"label":"State of California DOJ Tobacco Directory (Certified Parliament Silver, V. Slims 120s & Superslims)","url":"https://oag.ca.gov/tobacco/directory?page=8&order=field_tp_manufacturer&sort=asc"}],"quickJumpZh":[{"sec":"sec-00","title":"00 单品定评与超高端利基指标","sub":"2.1%超稳态份额 · Q3仅降-6.3% · 超高单支净利"},{"sec":"sec-01","title":"01 物理差异化滤嘴与细支工艺","sub":"Parliament 5mm凹陷纸嘴 · Virginia Slims 120s/超细"},{"sec":"sec-02","title":"02 四大高毛利韧性支柱与雷达","sub":"零深折平替 · 都会高收入脱敏 · 零促销损耗"},{"sec":"sec-03","title":"03 全美超高端与特色卷烟对比","sub":"对比 Natural American Spirit、Capri 与金万"},{"sec":"sec-04","title":"04 零促销高溢价单包现金流模拟","sub":"~1.33亿包年化规模与 >$5.8亿 OCI 测算"},{"sec":"sec-05","title":"05 近百年超高端定位演进复盘","sub":"1931百乐门诞生 → 1968维珍妮 → 当代现金宝石"},{"sec":"sec-06","title":"06 超高端利基现金牛核查清单","sub":"6项份额铁底与溢价纯度核查"},{"sec":"sec-07","title":"07 SEC 财报与注册目录信源索引","sub":"一手财报与加州合规目录直达"}],"quickJumpEn":[{"sec":"sec-00","title":"00 Product Verdict & Niche Scorecard","sub":"2.1% US share · -6.3% Q3 resilience · Peak unit margin"},{"sec":"sec-01","title":"01 Recessed Filter & Superslims Craft","sub":"Parliament 5mm recessed filter & Virginia Slims 120s"},{"sec":"sec-02","title":"02 4 Ultra-Margin Pillars & Radar","sub":"Zero cheap clones, affluent metro base & minimal promo"},{"sec":"sec-03","title":"03 Super-Premium Cigarette Matrix","sub":"Benchmarking NAS, Capri/Misty & Marlboro Gold"},{"sec":"sec-04","title":"04 Zero-Promo Unit Cashflow Simulator","sub":"~133M annualized packs & pure OCI compounding"},{"sec":"sec-05","title":"05 95-Year Super-Premium Heritage","sub":"1931 filter pioneer to modern cash-flow gem"},{"sec":"sec-06","title":"06 Super-Premium Niche Moat Checklist","sub":"6-point margin and share-floor verification"},{"sec":"sec-07","title":"07 SEC Filings & Registry Sources","sub":"Verified Altria filings and CA DOJ directory"}]},{"id":"black_mild","idx_num":4,"idx_pad":"04","filename":"mo_prod_04_black_and_mild.html","checkKey":"mui_mo_checks_black_mild","monogram":"BM","short_zh":"Black & Mild 大雪茄","short_en":"Black & Mild Cigars","pill_kpi":"17.8亿支/年 · 逆势正增长","docTitleZh":"《Black & Mild 机制滤嘴大雪茄》单品深度商业研报（John Middleton）| 王安安数据中心","docTitleEn":"Black & Mild Tipped Pipe-Tobacco Cigars Product Monograph (John Middleton) | Research Hub","crumb_zh":"Black & Mild 烟斗丝机制滤嘴大雪茄（John Middleton Co.）","crumb_en":"Black & Mild Pipe-Tobacco Tipped Cigars (John Middleton Co.)","chip1_zh":"全美滤嘴雪茄霸主 · ~18亿支/年","chip1_en":"#1 US Tipped Cigar · ~1.8B Sticks/Yr","chip2_zh":"连续两年销量正增长 (+1.9% / +2.0%)","chip2_en":"Growing Volume (+1.9% FY25 / +2.0% 9M26)","sidebar":{"badge":"JOHN MIDDLETON · GROWING COMBUSTIBLE","title_zh":"Black & Mild 深度研报","title_en":"Black & Mild Monograph","sub_zh":"奥驰亚可燃烟分部唯一持续实现销量正增长的传奇单品：独家芳香烟斗丝配方 × 塑嘴/木嘴专利口感 × 年关联 2.63亿次便利店行程","sub_en":"Altria's counter-cyclical combustible gem: aromatic pipe-tobacco blend × plastic/wood tips × 263M annual c-store trips","mini_kpis":[{"label_zh":"2025全年报告出货量","label_en":"FY 2025 Shipments","val_zh":"1,783M 支 (+1.9%)","val_en":"1,783M (+1.9% YoY)"},{"label_zh":"2026前9月报告出货量","label_en":"9M 2026 Shipments","val_zh":"1,362M 支 (+2.0%)","val_en":"1,362M (+2.0% YoY)"},{"label_zh":"占 Middleton 雪茄总盘比","label_en":"% of Middleton Vol","val_zh":"99.85% (绝对单极)","val_en":"99.85% (Mono-Brand)"}]},"toc":[["单品定评与逆周期增长指标","Product Verdict & Growth Scorecard"],["芳香烟斗丝配方与木嘴/塑嘴工艺","Aromatic Pipe-Tobacco & Tip Craft"],["四大逆势长青支柱与雷达对比","4 Counter-Cyclical Pillars & Radar"],["全美机制大雪茄核心竞品矩阵","US Machine-Made Cigar Matrix"],["免和解金优势与单支经济模拟器","MSA-Exempt Unit Economics Simulator"],["1856 费城烟铺至奥驰亚收购史","1856 Heritage to Altria Growth Engine"],["机制滤嘴大雪茄护城河核查清单","Tipped Cigar Moat Checklist"],["官方站点、SEC 与科研信源索引","Official, SEC & Scientific Sources"]],"hero":{"strip1_zh":"单品定评：全美可燃烟草界的“反重力异类”——当卷烟年跌 5%–8% 时，它凭近 18 亿支体量连续实现销量正增长","strip1_en":"Verdict: Defying combustible gravity—growing unit volume (+1.9% in FY25, +2.0% in 9M26) at ~1.8 billion sticks/year","strip2_zh":"运营主体：John Middleton Co. (1856创立 · 2007并入奥驰亚 · 宾州 King of Prussia + 里士满双厂)","strip2_en":"Operating Co.: John Middleton Co. (Est. 1856 · Acquired 2007 · King of Prussia, PA & Richmond, VA)","strip3_zh":"数据基准：2026Q3 季报核验 (2026-10-29)","strip3_en":"Baseline: Q3 2026 Release (Oct 29, 2026)","overline_zh":"COUNTER-CYCLICAL ICON 04 · FY25 出货 17.83亿支 (+1.9%) × 9M'26 出货 13.62亿支 (+2.0%) × 2.63亿次便利店年行程","overline_en":"COUNTER-CYCLICAL ICON 04 · 1,783M FY25 Sticks (+1.9%) × 1,362M 9M'26 Sticks (+2.0%) × 263M Annual C-Store Trips","h1_zh":"Black & Mild 机制滤嘴大雪茄深度剖析：<span class=\"gradient-accent\">用百年芳香烟斗丝做雪茄，如何跑出全美可燃烟唯一连续正增长曲线？<\/span>","h1_en":"Black & Mild Cigar Deep Dive: <span class=\"gradient-accent\">How Aromatic Pipe-Tobacco Craft Built a 1.8B-Stick Growing Fortress Inside Combustibles<\/span>","lead_zh":"几乎所有人都以为奥驰亚的可燃烟草销量都在萎缩，但翻开财报 Table 3 就会发现一个惊人的例外：全资子公司 <strong>John Middleton Co.<\/strong> 旗下的 <strong>Black & Mild<\/strong>（占 Middleton 雪茄总出货量的 <strong>99.85%<\/strong>，即 1,362M / 1,364M 支）在 2025 全年出货逆势增长 <strong>+1.9%<\/strong> 达 <strong>17.83 亿支<\/strong>，进入 2026 年前 9 个月再度增长 <strong>+2.0%<\/strong> 至 <strong>13.62 亿支<\/strong>（其中 2026Q2 单季大涨 <strong>+5.2%<\/strong> 突破 5.03 亿支）<a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Altria Q3'26 & Q2'26 Table 3 ↗<\/a>！创立于 1856 年费城的 John Middleton 于 1980 年发明了用<strong>黑卡文迪什（Black Cavendish）芳香烟斗丝<\/strong>填充均质烟叶茄衣并配备塑胶/实木烟嘴的独特工艺，使其稳居全美<strong>带嘴大雪茄第 1 名、全美机制大雪茄总榜第 2 名<\/strong> <a class=\"cite-link\" href=\"https://www.johnmiddletonco.com/\" target=\"_blank\" rel=\"noopener noreferrer\">John Middleton Official ↗<\/a>，每年独立驱动 <strong>2.63 亿次<\/strong> 便利店消费行程。","lead_en":"While US cigarettes contract ~5%–8% annually, Altria subsidiary <strong>John Middleton Co.'s Black & Mild<\/strong>—representing <strong>99.85%<\/strong> of Middleton's cigar volume—grew shipments <strong>+1.9%<\/strong> in FY2025 to <strong>1,783M sticks<\/strong> and accelerated <strong>+2.0%<\/strong> in 9M 2026 to <strong>1,362M sticks<\/strong> (including a <strong>+5.2%<\/strong> jump to 503M sticks in Q2 2026) <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Altria Q3'26 & Q2'26 Table 3 ↗<\/a>. Created in 1980 using Middleton's 1856 Philadelphia <strong>aromatic pipe-tobacco heritage<\/strong> wrapped in homogenized tobacco leaf with signature plastic or wood tips, Black & Mild is America's <strong>#1 tipped cigar and #2 overall machine-made large cigar<\/strong> <a class=\"cite-link\" href=\"https://www.johnmiddletonco.com/\" target=\"_blank\" rel=\"noopener noreferrer\">John Middleton Official ↗<\/a>, generating <strong>263M annual convenience-store trips<\/strong>.","thesis_cards":[{"title_zh":"独家“烟斗丝入茄”工艺（Pipe-Tobacco Filler）","title_en":"Proprietary Aromatic Pipe-Tobacco Filler","desc_zh":"不同于普通机制雪茄辛辣的碎雪茄叶芯，采用经蒸汽糖化熟成的黑卡文迪什与白肋烟斗丝，香气醇甜柔和、旁人闻香辨识度极高。","desc_en":"Crafted with steam-cured Black Cavendish and Burley aromatic pipe tobacco rather than harsh cigar scraps, delivering signature smooth room note."},{"title_zh":"单支/五支亲民客单价承接通胀“口红效应”","title_en":"Low Out-of-Pocket Ticket Captures Budget Occasions","desc_zh":"单支独立保鲜装仅售约 ~$1.19–$1.69、五支装约 ~$5.50–$6.50，在 $10/包卷烟时代成为成年烟民极具性价比的慢抽犒赏替代品。","desc_en":"Single freshness-foil sticks (~$1.19–$1.69) and 5-packs (~$5.50–$6.50) offer an affordable slow-burn reward in an era of ~$10/pack cigarettes."},{"title_zh":"豁免卷烟 MSA 大和解费用与低联邦税制红利","title_en":"Exempt from Cigarette MSA Per-Stick Charges","desc_zh":"法律属性归类为大雪茄（Large Cigars），无需缴纳卷烟高昂的州政府 MSA 按支和解金，联邦消费税亦设有单支封顶上限。","desc_en":"Classified legally as Large Cigars—exempt from state cigarette MSA per-stick settlements and subject to capped federal cigar excise tax."}],"kpis":[{"label_zh":"2025全年国内报告出货量","label_en":"FY 2025 Cigar Volume","badge_zh":"同比正增长 +1.9%","badge_en":"+1.9% YoY Growth","val_zh":"1,783M 支","val_en":"1,783M Sticks","desc_zh":"较 2024 年 1,750M 支净增 3,300 万支（2025Q4 单季同比 +4.2% 至 448M 支）<a class=\"cite-link\" href=\"https://www.sec.gov/Archives/edgar/data/764180/000076418026000007/exhibit991erq42025.htm\" target=\"_blank\" rel=\"noopener noreferrer\">FY25 Table 3 ↗<\/a>","desc_en":"Grew by +33M sticks over FY2024 (1,750M) to 1,783M sticks in FY2025 (+4.2% YoY in Q4 2025 to 448M sticks) <a class=\"cite-link\" href=\"https://www.sec.gov/Archives/edgar/data/764180/000076418026000007/exhibit991erq42025.htm\" target=\"_blank\" rel=\"noopener noreferrer\">FY25 Table 3 ↗<\/a>"},{"label_zh":"2026前9月国内报告出货量","label_en":"9M 2026 Cigar Volume","badge_zh":"同比再增 +2.0%","badge_en":"+2.0% YoY Growth","val_zh":"1,362M 支","val_en":"1,362M Sticks","desc_zh":"Q2 2026 飙升至 503M 支（+5.2%），Q3 达 456M 支（+0.9%），年化迈向 >18.1亿支新高 <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Q3'26 Table 3 ↗<\/a>","desc_en":"Surged +5.2% in Q2 2026 (503M sticks) and +0.9% in Q3 (456M), tracking toward an >1.81B annualized stick record <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Q3'26 Table 3 ↗<\/a>"},{"label_zh":"全美机制大雪茄行业排名","label_en":"US Large Cigar Rank","badge_zh":"带嘴雪茄绝对 #1","badge_en":"#1 Tipped Cigar","val_zh":"全美总榜 #2","val_en":"#2 Overall US","desc_zh":"John Middleton 官网确认其稳居全美第二大机制大雪茄品牌（仅次于无嘴为主的 Swisher Sweets）<a class=\"cite-link\" href=\"https://www.johnmiddletonco.com/\" target=\"_blank\" rel=\"noopener noreferrer\">John Middleton ↗<\/a>","desc_en":"Confirmed by John Middleton as the #2 machine-made large cigar brand in America (behind mostly untipped Swisher Sweets) <a class=\"cite-link\" href=\"https://www.johnmiddletonco.com/\" target=\"_blank\" rel=\"noopener noreferrer\">John Middleton ↗<\/a>"},{"label_zh":"年关联便利店消费行程","label_en":"Annual C-Store Trips","badge_zh":"集团第 2 大流量源","badge_en":"#2 Traffic Driver in MO","val_zh":"263M 次/年","val_en":"263M Trips/Yr","desc_zh":"2026 NACS 披露数据：在奥驰亚五大运营公司中仅次于 PM USA，远超 USSTC（174M）<a class=\"cite-link\" href=\"https://www.2firsts.com/news/altria-showcases-ploom-marlboro-heated-tobacco-sticks-and-non-nicotine-energy-products-at-nacs-show-2026\" target=\"_blank\" rel=\"noopener noreferrer\">2Firsts NACS 2026 ↗<\/a>","desc_en":"NACS 2026 data shows Middleton drives 263M annual convenience-store trips—#2 inside Altria ahead of USSTC (174M) <a class=\"cite-link\" href=\"https://www.2firsts.com/news/altria-showcases-ploom-marlboro-heated-tobacco-sticks-and-non-nicotine-energy-products-at-nacs-show-2026\" target=\"_blank\" rel=\"noopener noreferrer\">2Firsts NACS 2026 ↗<\/a>"}]},"ch1":{"eyebrow":"CHAPTER 01 · PIPE-TOBACCO FORMULATION, TIP ENGINEERING & SKU LINEUP","h2_zh":"一、配方与烟嘴工程架构：为什么烟民一眼、一闻就能认出 Black & Mild？","h2_en":"1. Formulation & Tip Engineering: Inside Black & Mild's Sensory Monopoly","sub_zh":"Prince Albert 百年烟斗丝发酵底蕴 × 塑嘴/桦木嘴人体工学 × 低于普通小雪茄 41% 的 NNN 亚硝胺离散度","sub_en":"1856 pipe-tobacco curing heritage × ergonomic plastic/birchwood tips × consistent low-NNN chemistry","badge_zh":"宾州 King of Prussia + 弗州里士满双基地制造","badge_en":"King of Prussia, PA & Richmond, VA Mfg","hub_title_zh":"Black & Mild 感官独占三角（甜润烟斗叶芯 × 不散叶模压烟嘴 × 1美元级即买即享装）","hub_title_en":"Black & Mild Sensory Triangle (Sweet Cavendish Pipe Leaf × Molded Tip × Single-Stick Foil Pouch)","hub_sub_zh":"区别于部分竞品被消费者拆散卷大麻（Blunt Wrap）的工具属性，Black & Mild 带嘴不可拆结构确保 100% 真实品吸忠诚度","hub_sub_en":"Unlike untipped foil cigarillos often emptied as wraps, Black & Mild's tipped construction anchors authentic adult cigar-smoking loyalty","nodes":[{"tag_zh":"CLASSIC PLASTIC TIP · 经典塑嘴","tag_en":"CLASSIC PLASTIC TIP","name_zh":"Original · Mild · Cream","name_en":"Original · Cream · Select","desc_zh":"1980 年元祖象牙白流线型塑胶烟嘴，防咬塌、隔绝烟油苦味，奠定全美五支装与单支装基石。","desc_en":"Iconic 1980 ivory contoured plastic mouthpiece prevents soggy tip collapse across flagship single-stick and 5-pack formats."},{"tag_zh":"WOOD TIP UPGRADE · 实木嘴高毛利线","tag_en":"BIRCHWOOD TIP PREMIUM","name_zh":"Wood Tip Original · Wine · Jazz","name_en":"Wood Tip Original / Wine / Jazz","desc_zh":"天然实木烟嘴赋予温润唇感与更高单支溢价，是拉升 Middleton 单支净实现价的核心升级引擎。","desc_en":"Genuine natural wood mouthpieces elevate mouthfeel and unit ASP across Original, Wine, and Jazz variants."},{"tag_zh":"CULTURAL BLENDS · 现象级韵味线","tag_en":"AROMATIC CULTURAL SERIES","name_zh":"Jazz · Casino · Blues · Royale","name_en":"Jazz · Casino · Blues · Royale","desc_zh":"以非直白水果词的音乐休闲意象命名独特芳香烟斗配方，兼具文化符号穿透力与口味辨识度。","desc_en":"Non-fruit musical and lounge concept names (Jazz, Casino, Blues, Royale) pair aromatic distinction with cultural resonance."},{"tag_zh":"FILTER TIP & SHORTS · 跨界便捷装","tag_en":"FILTER TIP & SHORTS","name_zh":"Filter Tips · Shorts (半长快享装)","name_en":"Filter Tips & Shorts","desc_zh":"Shorts 约为标准款一半长度，精准匹配现代工间 5–7 分钟碎片化休息场景，降低单次消费门槛。","desc_en":"Half-length Shorts format targets modern 5–7 minute work breaks at an ultra-accessible out-of-pocket entry price."},{"tag_zh":"SINGLE FOIL FRESH · 锁鲜铝箔袋","tag_en":"SINGLE-STICK FOIL POUCH","name_zh":"收银台前冲动消费王牌","name_en":"Checkout Counter Impulse Pack","desc_zh":"独立密封保润铝箔袋无需雪茄保湿盒即可在全美 30万便利店保持软糯湿度，单笔 ~$1.39 无痛加购。","desc_en":"Hermetic foil pouches preserve moisture across 300K c-stores without humidors, driving ~$1.39 checkout impulse add-ons."},{"tag_zh":"PIPE HERITAGE · 原料协同","tag_en":"LEGACY PIPE BLENDS","name_zh":"Prince Albert & Carter Hall 同源","name_en":"Prince Albert Pipe Tobacco Base","desc_zh":"共享 John Middleton 自 1950 年代深耕的烟斗丝调香与蒸汽熟成工艺，新玩家极难复刻香气层次。","desc_en":"Shares John Middleton's 1950s King of Prussia aromatic pipe-tobacco blending heritage alongside Prince Albert."}],"platform_bars":[{"title_zh":"科学实证：烟斗丝小雪茄特定亚硝胺（NNN）显著低于普通雪茄叶竞品","title_en":"Peer-Reviewed Chemistry: 41% Lower Mean NNN vs. Regular Cigarillos","sub_zh":"2025 年 NIH/PMC 发表的商业大雪茄研究证实：烟斗丝配方雪茄平均 NNN 含量为 3.87 μg/g，而普通雪茄叶竞品高达 6.54 μg/g（高出 69%）。","sub_en":"A 2025 NIH/PMC peer-reviewed study found pipe-tobacco cigars averaged 41% lower carcinogenic NNN (3.87 vs. 6.54 μg/g) than standard cigarillos."},{"title_zh":"AGDC 雪茄专属陈列架锁定收银区黄金视线","title_en":"AGDC Countertop & Backbar Merchandising","sub_zh":"与万宝路打包签约连锁便利店，确保单支装与 5 支装占据收银台触手可及核心位。","sub_en":"Bundled into AGDC retail agreements alongside Marlboro to secure prime register-counter and upper-backbar display racks."}],"principles":[{"title_zh":"1. 低门槛“小确幸”受益于卷烟高价溢出","title_en":"1. Low Out-of-Pocket Ticket Captures Cigarette Spillover","desc_zh":"当口袋里只剩 $2 零钱的成年烟民买不起 $9.50 的卷烟时，花 ~$1.39 买一支耐抽 15 分钟的 Black & Mild 成为极具性价比的即时替代，推动 2026Q2 销量激增 <strong>+5.2%<\/strong> <a class=\"cite-link\" href=\"https://www.sec.gov/Archives/edgar/data/764180/000076418026000093/exhibit991erq22026.htm\" target=\"_blank\" rel=\"noopener noreferrer\">Q2'26 Table 3 ↗<\/a>。","desc_en":"Cash-strapped adult smokers with $2 in pocket trade a $9.50 cigarette pack for a ~$1.39 15-minute Black & Mild cigar, fueling <strong>+5.2%<\/strong> Q2'26 stick growth <a class=\"cite-link\" href=\"https://www.sec.gov/Archives/edgar/data/764180/000076418026000093/exhibit991erq22026.htm\" target=\"_blank\" rel=\"noopener noreferrer\">Q2'26 Table 3 ↗<\/a>."},{"title_zh":"2. 烟斗丝化学温和度与品质一致性壁垒","title_en":"2. Pipe-Tobacco Curing & Low-Nitrosamine Consistency","desc_zh":"PMC 2025 独立实验室检测显示，Middleton 烟斗丝雪茄不仅香气顺滑，其致癌亚硝胺 NNN 均值比常规雪茄低约 41% 且批次离散度更小 <a class=\"cite-link\" href=\"https://pmc.ncbi.nlm.nih.gov/articles/PMC10922615/\" target=\"_blank\" rel=\"noopener noreferrer\">NIH/PMC Study ↗<\/a>。","desc_en":"Peer-reviewed 2025 NIH/PMC lab testing confirmed pipe-tobacco cigars carry ~41% lower mean NNN nitrosamines with tighter batch consistency than standard cigarillos <a class=\"cite-link\" href=\"https://pmc.ncbi.nlm.nih.gov/articles/PMC10922615/\" target=\"_blank\" rel=\"noopener noreferrer\">NIH/PMC Study ↗<\/a>."},{"title_zh":"3. 木嘴升级（Wood Tip）持续抬升单支毛利","title_en":"3. Wood-Tip Mix Shift Drives Unit Realization","desc_zh":"消费者从普通塑嘴向单价更高的 Wood Tip Jazz / Wine 升级，使 Middleton 在销量温和增长 +2% 的同时实现更快的营收与利润增速 <a class=\"cite-link\" href=\"https://www.johnmiddletonco.com/\" target=\"_blank\" rel=\"noopener noreferrer\">John Middleton ↗<\/a>。","desc_en":"Upgrading adult smokers from plastic tips into higher-margin Wood Tip Jazz & Wine expands unit revenue faster than +2% stick volume growth <a class=\"cite-link\" href=\"https://www.johnmiddletonco.com/\" target=\"_blank\" rel=\"noopener noreferrer\">John Middleton ↗<\/a>."}],"alert_zh":"<strong>战略现金牛定性：<\/strong>2007 年奥驰亚以净成本约 $22 亿（毛价 $29 亿扣除税盾）收购 John Middleton 时，Black & Mild 年销量约 12 亿支；十九年后的 2025–2026 年，其年销量已跨越 <strong>17.8 亿–18.1 亿支<\/strong> 大关，堪称奥驰亚并购史上<strong>回报率最高、最零减值、最省心的教科书级交易<\/strong> <a class=\"cite-link\" href=\"https://www.altria.com/about-altria/our-companies/johnmiddleton\" target=\"_blank\" rel=\"noopener noreferrer\">Altria Middleton ↗<\/a>。","alert_en":"<strong>Altria's Crown-Jewel M&A Track Record:<\/strong> Acquired in 2007 (~$2.2B net of tax benefits) when volume was ~1.2B sticks, Black & Mild now ships <strong>~1.8 billion sticks/year<\/strong> (+1.9% FY25, +2.0% 9M26)—standing as the highest-ROI, zero-impairment acquisition in modern Altria history <a class=\"cite-link\" href=\"https://www.altria.com/about-altria/our-companies/johnmiddleton\" target=\"_blank\" rel=\"noopener noreferrer\">Altria Middleton ↗<\/a>.","chart":{"tabA_zh":"视图A: 连续逆周期正增长轨迹","tabA_en":"View A: Counter-Cyclical Volume Growth","tabB_zh":"视图B: 奥驰亚五大子公司便利店客流对比","tabB_en":"View B: Annual C-Store Trips by Subsidiary","viewA":{"mode":"dual_bar_line","title_zh":"Black & Mild 阶段出货量（百万支）vs 同比销量正增长率（%）","title_en":"Black & Mild Cigar Shipments (M Sticks) vs. YoY Volume Growth Rate (%)","sub_zh":"2024–2026Q3 全程保持正增长，2026Q2 单季突破 5.03 亿支（+5.2% YoY）","sub_en":"Maintained uninterrupted positive stick growth across FY25 (+1.9%) and 9M 2026 (+2.0%, peaking at +5.2% in Q2)","leg1_zh":"阶段/季度出货量 (左轴 · 百万支)","leg1_en":"Reported Cigar Volume (Left · M Sticks)","leg2_zh":"同比销量增长率 (右轴 · +%)","leg2_en":"YoY Volume Growth Rate (Right · +%)","labels_zh":["2024Q4","2025Q4","2026Q1","2026Q2","2026Q3"],"labels_en":["Q4 2024","Q4 2025","Q1 2026","Q2 2026","Q3 2026"],"subs_zh":["430M 基准","448M (+4.2%)","403M 淡季稳健","503M 旺季峰值","456M 续创同期高"],"subs_en":["430M base","448M (+4.2%)","403M Q1","503M peak (+5.2%)","456M (+0.9%)"],"s1":[430,448,403,503,456],"s2":[1.5,4.2,0.0,5.2,0.9],"max1":580,"max2":7.0,"u1":"M","u2":"%"},"viewB":{"mode":"grouped_bars","title_zh":"2024 vs 2025 及 2025前9月 vs 2026前9月 Black & Mild 累计出货对比（百万支）","title_en":"Black & Mild Cumulative Stick Comparison: Current vs. Prior Period (M Sticks)","sub_zh":"在全美卷烟年均萎缩 ~5% 背景下，Black & Mild 每一个对比窗口均实现净增量突破","sub_en":"Every comparative window shows positive stick expansion while US cigarettes declined ~5% annually","leg1_zh":"当期累计出货量 (百万支)","leg1_en":"Current Period Sticks (M)","leg2_zh":"上年同期出货量 (百万支)","leg2_en":"Prior Period Sticks (M)","labels_zh":["2025全年 vs 2024","2026H1 vs 2025H1","2026Q3 vs 2025Q3","2026前9月 vs 2025前9月"],"labels_en":["FY25 vs FY24","1H26 vs 1H25","Q3'26 vs Q3'25","9M26 vs 9M25"],"subs_zh":["+1.9% (+33M支)","+2.6% (+23M支)","+0.9% (+4M支)","+2.0% (+27M支)"],"subs_en":["+1.9% (+33M)","+2.6% (+23M)","+0.9% (+4M)","+2.0% (+27M)"],"s1":[1783,906,456,1362],"s2":[1750,883,452,1335],"max1":2000,"u1":"M","u2":"M"}},"matrix_cards":[{"title_zh":"为什么奥驰亚雪茄业务比电子烟并购成功百倍？","title_en":"Why John Middleton Outshone JUUL & NJOY Deals","badge_zh":"2007 并购神作","badge_en":"Zero-Impairment M&A","body_zh":"不同于技术迭代极快、专利与灰色走私丛生的电子烟，机制滤嘴大雪茄拥有极高的工艺稳定性与监管确定性；并入 AGDC 后铺货率翻倍，至今每年稳定输出数亿美元自由现金流 <a class=\"cite-link\" href=\"https://www.altria.com/about-altria/our-companies/johnmiddleton\" target=\"_blank\" rel=\"noopener noreferrer\">Middleton Profile ↗<\/a>。","detail_zh":"Middleton 全部雪茄营收与利润直接并表在奥驰亚 Smokeable Products 分部中，不仅零商誉减值，还是托举可燃分部 64.8% 利润率的中流砥柱。","body_en":"Unlike fast-commoditizing e-vapor, tipped pipe-tobacco cigars have stable manufacturing technology and zero illicit Chinese disposable competition—allowing AGDC distribution to compound volume from ~1.2B to ~1.8B sticks <a class=\"cite-link\" href=\"https://www.altria.com/about-altria/our-companies/johnmiddleton\" target=\"_blank\" rel=\"noopener noreferrer\">Middleton Profile ↗<\/a>.","detail_en":"Consolidated inside Altria's Smokeable segment, Middleton has recorded zero goodwill write-downs across nearly two decades."},{"title_zh":"FDA 特征风味雪茄禁令风险动态跟踪与 Original 基盘","title_en":"Navigating FDA Characterizing-Flavor Cigar Rulemaking","badge_zh":"Original 原味压舱石","badge_en":"Strong Original Core","body_zh":"针对过去数年联邦及部分州围绕风味小雪茄（Flavored Cigars）的政策博弈，Black & Mild 最大的优势在于其旗舰 <strong>Original（原味烟斗丝）与 Wood Tip Original<\/strong> 本身即占据极高权重。","detail_zh":"即便在实施风味限制的辖区，传统芳香原味烟斗丝雪茄仍具备比纯水果味两支装竞品（如部分 Swisher 果味包）更强的合规生命力。","body_en":"Unlike rival 2-for-$1.29 fruit foil cigarillos, Black & Mild's flagship <strong>Original<\/strong> and <strong>Wood Tip Original<\/strong> pipe-tobacco blends command massive baseline loyalty, cushioning potential flavor restrictions.","detail_en":"Its tipped pipe-tobacco identity differentiates adult cigar enjoyment from youth-targeted candy cigarillo wrappers."}]},"ch2":{"eyebrow":"CHAPTER 02 · FOUR GROWTH PILLARS & 5-AXIS CIGAR RADAR","h2_zh":"二、四大长青支柱：Black & Mild 垄断带嘴雪茄赛道的底层密码","h2_en":"2. Four Growth Pillars: Why Black & Mild Owns the US Tipped Cigar Shelf","badge_zh":"护城河评级：宽阔 (#1 带嘴雪茄 · 独家烟斗丝香型)","badge_en":"Moat Rating: Wide (#1 Tipped Cigar · Pipe-Leaf Secret)","pillars":[{"title_zh":"01 · 169 年费城烟斗丝发酵秘方（不可复制的甜润室韵）","title_en":"01 · 1856 Aromatic Pipe-Tobacco Curing Secret","badge_zh":"低 41% NNN 亚硝胺","badge_en":"Smooth Cavendish Leaf","desc_zh":"将烟斗丝温润香甜感移植进机制雪茄，既不呛喉又留有浓郁室韵（Room Note），口感壁垒极深。","note_zh":"<strong>当前选中支柱解读（01 烟斗丝秘方）：<\/strong>普通雪茄厂擅长发酵古巴/多米尼加深色雪茄叶，却难以调出 John Middleton 传承自 Prince Albert 时代的蒸汽熟成烟斗丝风味 <a class=\"cite-link\" href=\"https://www.johnmiddletonco.com/\" target=\"_blank\" rel=\"noopener noreferrer\">John Middleton ↗<\/a>。","note_en":"<strong>Selected Pillar (01 · Pipe-Tobacco Heritage):<\/strong> Traditional cigar makers cure dark air-cured cigar leaf, whereas Middleton leverages 170 years of aromatic Cavendish pipe-tobacco blending <a class=\"cite-link\" href=\"https://www.johnmiddletonco.com/\" target=\"_blank\" rel=\"noopener noreferrer\">John Middleton ↗<\/a>.","desc_en":"1856 pipe-tobacco steam-curing heritage creates a mellow, sweet aromatic profile without harsh cigar throat bite."},{"title_zh":"02 · 塑嘴与实木嘴（Tipped）锁死“纯品吸”高粘性客群","title_en":"02 · Molded Plastic & Wood Tips Anchor Pure Cigar Smokers","badge_zh":"#1 带嘴大雪茄","badge_en":"#1 US Tipped Cigar","desc_zh":"一体式烟嘴杜绝烟叶碎屑入口，同时 Wood Tip 系列实现显著单支消费升级。","note_zh":"<strong>当前选中支柱解读（02 烟嘴结构与升级）：<\/strong>带嘴形态使 Black & Mild 免受大麻卷纸替代品分流，消费者购买目的 100% 是为了品吸 Middleton 烟丝本身。","note_en":"<strong>Selected Pillar (02 · Tipped Upgrade Ladder):<\/strong> Plastic and birchwood tips eliminate loose tobacco bits on the tongue and drive margin-accretive trade-up.","desc_en":"Molded plastic and natural wood tips keep tobacco bits out of the mouth—anchoring adult smokers who smoke cigars as-is."},{"title_zh":"03 · ~$1.39 单支低客单价触发便利店高频冲动复购","title_en":"03 · ~$1.39 Single-Stick Impulse Ticket Drives 263M Trips","badge_zh":"2.63亿次年客流","badge_en":"263M Annual Trips","desc_zh":"通胀越紧，成年烟民越倾向单次掏 $1–$2 购买即时满足，成就逆周期正增长。","note_zh":"<strong>当前选中支柱解读（03 逆周期口红效应）：<\/strong>2026 NACS 官方展板证实 John Middleton 每年带来 <strong>2.63 亿次<\/strong> 便利店购物行程，高居奥驰亚体系第二位 <a class=\"cite-link\" href=\"https://www.2firsts.com/news/altria-showcases-ploom-marlboro-heated-tobacco-sticks-and-non-nicotine-energy-products-at-nacs-show-2026\" target=\"_blank\" rel=\"noopener noreferrer\">2Firsts NACS ↗<\/a>。","note_en":"<strong>Selected Pillar (03 · Pocket-Friendly Impulse):<\/strong> At ~$1.19–$1.69 per single foil stick, Black & Mild drives <strong>263M annual c-store trips<\/strong> <a class=\"cite-link\" href=\"https://www.2firsts.com/news/altria-showcases-ploom-marlboro-heated-tobacco-sticks-and-non-nicotine-energy-products-at-nacs-show-2026\" target=\"_blank\" rel=\"noopener noreferrer\">2Firsts NACS ↗<\/a>.","desc_en":"~$1.39 single-stick impulse pricing thrives counter-cyclically during consumer inflation, driving 263M annual c-store trips."},{"title_zh":"04 · 豁免 MSA 卷烟和解金带来的超厚税后利润垫","title_en":"04 · Structural MSA Exemption & Capped Federal Cigar Tax","badge_zh":"零 MSA 按支负担","badge_en":"Zero MSA Per-Stick Fee","desc_zh":"不适用 1998 卷烟大和解协议高额按支提成，使 $1+ 低零售价下依然保有丰厚出厂毛利。","note_zh":"<strong>当前选中支柱解读（04 税费制度红利）：<\/strong>奥驰亚 Schedule 5 证实全集团每年逾 $30 亿州和解费用集中于卷烟，大雪茄享有显著的法定成本优势 <a class=\"cite-link\" href=\"https://www.sec.gov/Archives/edgar/data/764180/000076418026000007/exhibit991erq42025.htm\" target=\"_blank\" rel=\"noopener noreferrer\">FY25 Schedule 5 ↗<\/a>。","note_en":"<strong>Selected Pillar (04 · Statutory Cost Advantage):<\/strong> Large cigars sit outside the cigarette MSA per-stick settlement regime, preserving strong manufacturer margins at accessible retail prices <a class=\"cite-link\" href=\"https://www.sec.gov/Archives/edgar/data/764180/000076418026000007/exhibit991erq42025.htm\" target=\"_blank\" rel=\"noopener noreferrer\">FY25 Schedule 5 ↗<\/a>.","desc_en":"Exemption from 1998 cigarette MSA per-stick payments preserves ~50%+ estimated operating margins even at ~$1+ retail tickets."}],"radar":{"title_zh":"全美机制大雪茄（Machine-Made Large Cigars）五维竞争力雷达图","title_en":"5-Axis US Machine-Made Large Cigar Radar (10-Point Scale)","axes_zh":["带嘴品吸忠诚度","烟丝香气辨识度","单支毛利水平","抗风味禁令韧性","便利店铺货深度"],"axes_en":["Tipped Loyalty","Aromatic Signature","Unit Margin","Flavor-Ban Resilience","C-Store Reach"],"s0_zh":"Black & Mild (John Middleton · ~18亿支/年)","s0_en":"Black & Mild (John Middleton · ~1.8B Sticks)","s1_zh":"Swisher Sweets (Swisher · 全美总销量第1)","s1_en":"Swisher Sweets (Swisher · #1 Total Units)","s2_zh":"Backwoods / Game (ITG / Swedish Match 天然茄衣)","s2_en":"Backwoods / Game (Natural Leaf Cigarillos)","v0":[9.8,9.7,9.1,8.6,9.5],"v1":[6.5,8.0,7.6,6.8,9.6],"v2":[5.8,8.5,8.7,7.5,8.8]}},"ch3":{"eyebrow":"CHAPTER 03 · U.S. MACHINE-MADE LARGE CIGAR PEER MATRIX","h2_zh":"三、全美四大机制雪茄巨头横向对比：带嘴烟斗丝 vs 两支装小雪茄","h2_en":"3. US Machine-Made Cigar Matrix: Tipped Pipe-Tobacco vs. Foil Cigarillo Rivals","peers_zh":[{"category":"altria","benchmark":true,"title":"研究标的：Black & Mild 滤嘴大雪茄","creator":"John Middleton Co. (奥驰亚全资)","format":"带嘴单支装 / 5支盒装 (~$1.39/支 · ~$6.00/盒)","craft":"芳香黑卡文迪什烟斗丝 + 塑胶嘴 / 天然实木嘴","views":"FY25 1,783M 支 (+1.9%) · 9M'26 1,362M 支 (+2.0%)","acclaim":"全美带嘴大雪茄 #1 · 总榜 #2 · 2.63亿次客流","takeaway":"唯一以纯品吸体验统治带嘴赛道的现金牛，连续逆周期销量正增长。","sourceLabel":"Middleton / Q3'26","sourceUrl":"https://www.johnmiddletonco.com/"},{"category":"external","benchmark":false,"title":"Swisher Sweets 斯威舍甜雪茄","creator":"Swisher International (私有巨头)","format":"2支铝箔袋低价走量装为主 (~2 for $1.19–$1.49)","craft":"均质烟叶茄衣无嘴小雪茄 (亦产 BLK 烟斗丝分支)","views":"全美机制大雪茄总支数 #1 (>25亿支级)","acclaim":"高度依赖果味两支装与价格促销","takeaway":"总支数领先但单支净价较低，且无嘴果味袋装受地方风味禁令冲击大于 Black & Mild。","sourceLabel":"NIH/PMC Cigar Study","sourceUrl":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10922615/"},{"category":"external","benchmark":false,"title":"Backwoods 天然卷叶雪茄","creator":"ITG Brands (帝国品牌 Imperial Brands)","format":"天然阔叶茄衣单支/5支软袋装 (溢价较高)","craft":"全天然康涅狄格阔叶包裹 · 粗犷无嘴造型","views":"全美天然茄衣细分龙头 · 街头文化热度高","acclaim":"受天然烟叶收成良率制约曾多次缺货","takeaway":"高毛利强劲对手，但原料依赖度高，不具备 Black & Mild 均质烟斗丝的工业扩产稳定性。","sourceLabel":"John Middleton Ref","sourceUrl":"https://www.johnmiddletonco.com/"},{"category":"external","benchmark":false,"title":"Game by Garcia y Vega & White Owl","creator":"Swedish Match (现属菲莫国际 PMI)","format":"天然茄衣/均质叶双支铝箔袋装","craft":"慢燃天然外包叶 · 多口味小雪茄","views":"PMI 收购瑞典火柴后并入的美国传统雪茄资产","acclaim":"非 PMI 战略重心 (PMI 资源全押 ZYN/IQOS)","takeaway":"与 Swisher 同质化竞争两支装铝箔袋赛道，未侵入 Black & Mild 木嘴/塑嘴腹地。","sourceLabel":"Middleton Profile","sourceUrl":"https://www.altria.com/about-altria/our-companies/johnmiddleton"},{"category":"altria","benchmark":false,"title":"Prince Albert & Carter Hall (传统袋装烟斗丝)","creator":"John Middleton Co. (奥驰亚)","format":"罐装与袋装传统散装烟斗丝","craft":"白肋烟与卡文迪什经典美式烟斗配方","views":"百年长尾小众基盘 · 为 Black & Mild 提供调香母本","acclaim":"美国烟草史活化石商标 (Prince Albert in a Can)","takeaway":"虽绝对收入占比极小，却是 Middleton 烟斗丝发酵工艺与合法分类的根基。","sourceLabel":"John Middleton","sourceUrl":"https://www.johnmiddletonco.com/"}],"peers_en":[{"category":"altria","benchmark":true,"title":"Subject: Black & Mild Tipped Cigars","creator":"John Middleton Co. (Altria 100%)","format":"Single Foil & 5-Pack Tipped (~$1.39/stick)","craft":"Aromatic Black Cavendish pipe tobacco · Plastic/Wood tip","views":"1,783M FY25 sticks (+1.9%) · 1,362M 9M'26 sticks (+2.0%)","acclaim":"#1 US tipped cigar · #2 overall large cigar · 263M trips","takeaway":"Counter-cyclical gem: grows unit volume while escaping cigarette MSA charges.","sourceLabel":"Middleton / Q3'26","sourceUrl":"https://www.johnmiddletonco.com/"},{"category":"external","benchmark":false,"title":"Swisher Sweets (#1 Total Cigarillo Units)","creator":"Swisher International","format":"2-Pack Foil Pouch Leader (~2 for $1.19–$1.49)","craft":"Untipped homogenized-leaf cigarillos (+ BLK pipe line)","views":"#1 US machine-made large cigar by raw stick count","acclaim":"Heavy reliance on flavored 2-pack promos","takeaway":"Leads total units via cheap 2-packs, whereas Black & Mild owns higher-realization tipped singles/5-packs.","sourceLabel":"NIH/PMC Cigar Study","sourceUrl":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10922615/"},{"category":"external","benchmark":false,"title":"Backwoods (Natural Leaf Leader)","creator":"ITG Brands (Imperial Brands)","format":"Premium Natural Broadleaf Singles & 5-Packs","craft":"All-natural Connecticut Broadleaf wrapper · Untipped","views":"Dominates rustic natural-leaf subsegment","acclaim":"Premium pricing · Periodic leaf supply constraints","takeaway":"Strong margin peer in natural leaf, non-overlapping with Black & Mild's tipped pipe-blend ritual.","sourceLabel":"John Middleton Ref","sourceUrl":"https://www.johnmiddletonco.com/"},{"category":"external","benchmark":false,"title":"Game by Garcia y Vega & White Owl","creator":"Swedish Match (PMI)","format":"Natural-Leaf & Foil 2-Pack Cigarillos","craft":"Slow-burn natural wrapper foil pouches","views":"Legacy cigar arm acquired by PMI via Swedish Match","acclaim":"Non-core cash harvest inside PMI","takeaway":"Competes primarily against Swisher and Backwoods in untipped 2-packs.","sourceLabel":"Middleton Profile","sourceUrl":"https://www.altria.com/about-altria/our-companies/johnmiddleton"},{"category":"altria","benchmark":false,"title":"Prince Albert & Carter Hall Pipe Tobacco","creator":"John Middleton Co. (Altria)","format":"Tub & Pouch Loose Pipe Tobacco","craft":"Classic Burley & Cavendish pipe blends","views":"Heritage blending foundation for Black & Mild","acclaim":"Iconic century-old US pipe brands","takeaway":"Provides the curing and flavoring expertise powering Black & Mild.","sourceLabel":"John Middleton","sourceUrl":"https://www.johnmiddletonco.com/"}],"bars":{"title_zh":"2026 NACS 官方披露：奥驰亚五大运营子公司年关联美国便利店购物行程对比（百万次）","title_en":"NACS 2026 Verified: Annual US Convenience-Store Shopping Trips by Altria Operating Co. (Millions)","sub_zh":"数据严格核验自 2Firsts 现场拍摄奥驰亚 2026 NACS 展位官方披露看板（各子公司行程存在交叉不直接相加）","sub_en":"Strictly verified from Altria's official 2026 NACS Show booth display reported by 2Firsts (Oct 9, 2026)","badge_zh":"Black & Mild 独占 2.63亿次客流","badge_en":"Middleton Drives 263M Annual Trips","leg1_zh":"蓝色/绿色：John Middleton (Black & Mild) 与 PM USA 可燃双核客流 (百万次/年)","leg1_en":"Blue / Green: John Middleton & PM USA Annual C-Store Trips (M)","leg2_zh":"紫色/琥珀：口含烟与雾化子公司便利店年关联行程 (百万次/年)","leg2_en":"Purple / Amber: USSTC, Helix & NJOY Annual C-Store Trips (M)","max_x":1200,"ref_line":200,"items_zh":[{"label":"Philip Morris USA (Marlboro / Basic / 百乐门)","val":1100,"disp":"1,100M 次","sub":"11亿次年进店刚需","note":"全美便利店绝对第一流量支柱"},{"label":"John Middleton Co. (Black & Mild 独占 99.8%)","val":263,"disp":"263M 次","sub":"2.63亿次高频冲动购买","note":"高居奥驰亚第2大引流引擎，超越口含烟"},{"label":"U.S. Smokeless Tobacco Co. (Copenhagen / Skoal)","val":174,"disp":"174M 次","sub":"1.74亿次湿鼻烟刚需行程","note":"传统口含烟高粘性复购人群"},{"label":"Helix Innovations (on! & on! PLUS 尼古丁袋)","val":55,"disp":"55M 次","sub":"5,500万次且高速扩张中","note":"随 on! PLUS 铺货 12万店持续跃升"},{"label":"NJOY, LLC (NJOY DAILY 合规雾化电子烟)","val":7,"disp":"7M 次","sub":"700万次 (ACE 禁售期基数)","note":"仅凭 4 款 DAILY 一次性维持在架"}],"items_en":[{"label":"Philip Morris USA (Marlboro / Basic / Parliament)","val":1100,"disp":"1,100M","sub":"1.1B annual c-store trips","note":"#1 traffic driver in US convenience"},{"label":"John Middleton Co. (99.8% Black & Mild Cigars)","val":263,"disp":"263M","sub":"263M impulse & repeat trips","note":"#2 traffic engine across all Altria cos."},{"label":"U.S. Smokeless Tobacco Co. (Copenhagen / Skoal)","val":174,"disp":"174M","sub":"174M MST dipper trips","note":"High-ticket ~$7.78/can basket"},{"label":"Helix Innovations (on! & on! PLUS Pouches)","val":55,"disp":"55M","sub":"55M trips & compounding","note":"Accelerating with 120K-door on! PLUS"},{"label":"NJOY, LLC (NJOY DAILY Authorized E-Vapor)","val":7,"disp":"7M","sub":"7M trips (post-ACE ITC ban)","note":"Supported by 4 FDA-cleared DAILY SKUs"}]}},"ch4":{"eyebrow":"CHAPTER 04 · CIGAR UNIT ECONOMICS & MULTI-YEAR OCI SIMULATOR","h2_zh":"四、单支雪茄经济学与复利模拟：年销 18 亿支背后的无声现金机器","h2_en":"4. Cigar Unit Economics & Simulator: Compounding 1.8B+ Sticks Without MSA Drag","sub_zh":"销量每年 +1.5%–2.5% 自然微增 + 木嘴高端化升级 + 年度温和提价 = 稳健正斜率复利","sub_en":"+1.5%–2.5% organic stick growth + Wood-Tip mix shift + steady pricing = rising multi-year cash flow","badge_zh":"2007年 $2.2B 净收购价早已数倍回本","badge_en":"Multi-Fold Payback on 2007 $2.2B Deal","econ_cards":[{"label_zh":"ANNUAL STICK SCALE","label_en":"ANNUAL STICK SCALE","val_zh":"~1.81B 支/年","val_en":"~1.81B Sticks","desc_zh":"按 2026 前9月 1,362M 支（+2.0%）推算，全年有望突破 18.1 亿支历史高位。","desc_en":"1,362M sticks in 9M 2026 (+2.0% YoY) puts Black & Mild on track to exceed 1.81B sticks for full-year 2026."},{"label_zh":"MONO-BRAND FOCUS","label_en":"MONO-BRAND FOCUS","val_zh":"99.85% 集中度","val_en":"99.85% Focus","desc_zh":"9M'26 全部 1,364M 支雪茄中 1,362M 支来自 Black & Mild，极简 SKU 造就极致产线良率。","desc_en":"Accounts for 1,362M of Middleton's 1,364M 9M'26 cigars (99.85%), unlocking extraordinary single-brand factory efficiency."},{"label_zh":"NITROSAMINE EDGE","label_en":"NITROSAMINE EDGE","val_zh":"3.87 vs 6.54","val_en":"3.87 vs 6.54 μg/g","desc_zh":"NIH/PMC 实测烟斗丝雪茄平均 NNN 显著低于常规小雪茄（低约 41%），品控标准化程度极高。","desc_en":"NIH/PMC lab study measured 3.87 μg/g mean NNN in pipe-tobacco cigars vs. 6.54 μg/g in regular cigarillos."},{"label_zh":"EST. ANNUAL OCI","label_en":"EST. ANNUAL OCI","val_zh":"~$650M–$800M","val_en":"~$650M–$800M","desc_zh":"无卷烟 MSA 按支和解金负担，单支净营业利润估算约 $0.38–$0.45，全额并入可燃分部。","desc_en":"Estimated ~$0.38–$0.45 net OCI per stick contributes ~$650M–$800M/yr directly into Altria's Smokeable segment."}],"combo":{"title_zh":"Black & Mild 历年及年化出货量（亿支）vs 烟斗丝化学纯度/单支价值抬升轨迹","title_en":"Black & Mild Stick Volume Trajectory (100M Sticks) vs. Estimated Net Realization Index","sub_zh":"从 2007 并购时的 ~12 亿支稳步扩张至 2026 年化 ~18.15 亿支，量价齐升","sub_en":"Expanded from ~1.2B sticks at 2007 acquisition to ~1.82B annualized sticks in 2026 alongside Wood Tip mix gains","badge_zh":"量价同向正增长","badge_en":"Volume + Price Dual Growth","left_zh":"■ 左轴：年度/年化出货量 (亿支)","left_en":"■ Left Axis: Annual Cigar Volume (100M Sticks)","right_zh":"● 右轴：相对 2024 单支净实现价值指数","right_en":"● Right Axis: Net Realization Index (2024=100)","leg1_zh":"年度出货量 (左轴 · 亿支)","leg1_en":"Annual Volume (Left · 100M Sticks)","leg2_zh":"单支净实现指数 (右轴 · 2024=100)","leg2_en":"Unit Realization Index (Right · 2024=100)","line_badge_zh":"--- 100.0 2024价格基准线","line_badge_en":"--- 100.0 FY2024 Baseline","titles_zh":["2007并购基准","2024全年","2025全年","2026H1年化","2026前9月年化"],"titles_en":["2007 Deal Base","FY 2024","FY 2025","1H26 Run-Rate","9M26 Run-Rate"],"subs_zh":["并入奥驰亚起点","1,750M 支","1,783M (+1.9%)","906M×2 (+2.6%)","1,362M÷0.75 (+2.0%)"],"subs_en":["Acquisition yr","1,750M sticks","1,783M (+1.9%)","+2.6% YoY","+2.0% YoY"],"bars":[12.2,17.5,17.83,18.12,18.16],"line":[68.0,100.0,104.2,107.5,108.8],"max_bar":21.0,"min_line":60,"max_line":120,"ref_line":100,"u_bar":"00M","u_line":"idx","highlight_idx":4},"sim":{"title_zh":"Black & Mild 多年期出货复利与实木嘴（Wood Tip）升级价值模拟器","title_en":"Black & Mild Multi-Year Cigar OCI & Wood-Tip Upgrade Simulator","toggle_title_zh":"开启 Wood Tip 实木嘴结构升级 + Shorts 快享装扩圈 (+15% 净利增厚)","toggle_title_en":"Enable Wood-Tip Premium Mix Shift + Shorts Expansion (+15% OCI Lift)","toggle_sub_zh":"模拟实木嘴占比提升与每年温和提价对单支 OCI 的复利放大效应","toggle_sub_en":"Simulates margin-accretive trade-up into Wood Tip Jazz/Wine and steady annual pricing","s1_label_zh":"首年出货规模 (亿支 · 当前实绩≈18.1亿支)","s1_label_en":"Year-1 Cigar Shipments (100M Sticks · ~18.1 current)","s1_unit_zh":"亿支","s1_unit_en":"00M","s1_min":15.0,"s1_max":22.0,"s1_step":0.5,"s2_label_zh":"单支平均调整后 OCI 净利 (USD / 支)","s2_label_en":"Average Net Manufacturer OCI per Cigar (USD)","s2_unit_zh":"/支","s2_unit_en":"/st","s2_min":0.3,"s2_max":0.58,"s2_step":0.02,"s3_label_zh":"木嘴高毛利升级与国际免税增量 ($M / 年)","s3_label_en":"Annual Wood-Tip Mix & Specialty Lift ($M/yr)","s3_min":20,"s3_max":120,"s3_step":10,"roi_label_zh":"相对 2007 年 $2,200M 净并购成本累计回收倍数","roi_label_en":"Cumulative Payback Multiple vs. $2,200M Net Deal Cost","cost_base_m":2200,"mult":1.15,"vol_drift":1.018,"presets":{"p1":{"label_zh":"① 保守监管收紧情景 (部分州限制风味雪茄)","label_en":"① Conservative Flavor-Restriction Case","tag_zh":"16.5亿支 · 5年","tag_en":"1.65B · 5 Yrs","views":16.5,"v_per_view":0.38,"ancillary_m":30,"years":5,"transmedia":false},"p2":{"label_zh":"② 核心稳增基准情景 (18.2亿支 · +1.8%年均自然增长)","label_en":"② Base Growth Case (1.82B Sticks · +1.8%/yr)","tag_zh":"18.2亿支 · 5年","tag_en":"1.82B · 5 Yrs","views":18.2,"v_per_view":0.42,"ancillary_m":60,"years":5,"transmedia":true},"p3":{"label_zh":"③ 消费降级红利加速情景 (承接更多高价卷烟溢出)","label_en":"③ Bull Spillover Case (Strong Wood-Tip Upgrade)","tag_zh":"20.0亿支 · 7年","tag_en":"2.0B · 7 Yrs","views":20.0,"v_per_view":0.48,"ancillary_m":90,"years":7,"transmedia":true}}},"moat_pos_zh":"<strong>1. 全美可燃烟中稀缺的正增长资产：<\/strong>连续在 FY2025（+1.9%）与 9M 2026（+2.0%）交出正销量答卷。<br/><strong>2. 99.85% 单一超级品牌集约效应：<\/strong>宾州与里士满产线几乎零杂牌切换损耗，生产效率极高。","moat_pos_en":"<strong>1. Rare Growing Combustible Volume:<\/strong> Delivered +1.9% stick growth in FY25 and +2.0% in 9M 2026.<br/><strong>2. 99.85% Mono-Brand Manufacturing Scale:<\/strong> Near-zero line-changeover waste across King of Prussia and Richmond plants.","moat_risk_zh":"<strong>1. 联邦及地方风味大雪茄立法反复：<\/strong>尽管 Original 原味占比极高，若未来全面禁止 Jazz/Wine 等芳香延伸款仍可能造成短期扰动。<br/><strong>2. 州级雪茄从价税上调：<\/strong>部分财政赤字州试图提高其他烟草制品（OTP）从价税率。","moat_risk_en":"<strong>1. State & Federal Cigar Flavor Rules:<\/strong> Potential restrictions on Wine/Jazz aromatic SKUs require Original blend readiness.<br/><strong>2. State OTP Excise Tax Proposals:<\/strong> Periodic state pushes to raise ad-valorem cigar tax caps."},"ch5":{"eyebrow":"CHAPTER 05 · 170-YEAR PHILADELPHIA ROOTS TO ALTRIA GROWTH ENGINE","h2_zh":"五、170 年演进史与四大里程碑：从费城小烟铺到年销 18 亿支传奇","h2_en":"5. 170-Year Evolution & Key Milestones: From 1856 Tobacco Shop to 1.8B Sticks","sub_zh":"追溯 John Middleton 如何把烟斗丝装进带嘴雪茄，并在奥驰亚赋能下实现销量再增 50%","sub_en":"How a 19th-century pipe-tobacco blender created Black & Mild and scaled +50% under Altria ownership","badge_zh":"1856 创立 → 1980 B&M 诞生 → 2007 并购 → 2026 18亿支+","badge_en":"1856 Founded → 1980 Launch → 2007 Deal → 1.8B+ Sticks","acts":[{"title_zh":"第一阶段 · 费城烟斗丝世家积淀与 1980 年跨界发明 (1856–2006)","title_en":"Act I · 1856 Pipe-Tobacco Roots & 1980 Black & Mild Invention","badge_zh":"1996 成为公司头牌","badge_en":"Top Brand by 1996","desc_zh":"1856 年 John Middleton 在费城开设烟草店，1950 年代转型专注烟斗丝制造并迁至宾州 King of Prussia；1980 年创造性地将黑卡文迪什烟斗丝制成带嘴雪茄 Black & Mild <a class=\"cite-link\" href=\"https://www.johnmiddletonco.com/\" target=\"_blank\" rel=\"noopener noreferrer\">John Middleton History ↗<\/a>。","desc_en":"Founded in Philadelphia in 1856, Middleton pivoted to pipe-tobacco manufacturing in the 1950s and launched Black & Mild in 1980 <a class=\"cite-link\" href=\"https://www.johnmiddletonco.com/\" target=\"_blank\" rel=\"noopener noreferrer\">John Middleton History ↗<\/a>."},{"title_zh":"第二阶段 · 2007 年并入奥驰亚与全美渠道裂变 (2007–2020)","title_en":"Act II · 2007 Altria Acquisition & AGDC National Expansion","badge_zh":"拓展里士满双基地产能","badge_en":"Added Richmond Mfg","desc_zh":"2007 年奥驰亚收购 Middleton，依托 AGDC 将原本偏重东海岸与都市区的 Black & Mild 全面铺向全美 30 万便利店，并推出 Wood Tip、Jazz、Casino 等爆款延伸线 <a class=\"cite-link\" href=\"https://www.altria.com/about-altria/our-companies/johnmiddleton\" target=\"_blank\" rel=\"noopener noreferrer\">Altria Middleton ↗<\/a>。","desc_en":"Acquired by Altria in 2007, Black & Mild plugged into AGDC's national network, expanding manufacturing into Richmond, VA alongside King of Prussia, PA <a class=\"cite-link\" href=\"https://www.altria.com/about-altria/our-companies/johnmiddleton\" target=\"_blank\" rel=\"noopener noreferrer\">Altria Middleton ↗<\/a>."},{"title_zh":"第三阶段 · 高通胀周期逆势加速与 ~18 亿支巅峰 (2021–2026)","title_en":"Act III · Inflation-Era Acceleration Past 1.8B Sticks (2021–2026)","badge_zh":"9M'26 +2.0% 持续向上","badge_en":"+2.0% in 9M 2026","desc_zh":"在 $10 卷烟时代凭借单支 ~$1.39 高性价比与实木嘴品质感逆势吸纳成年烟民碎片化场景，2025 全年达 17.83 亿支、2026 前9月再增 2.0% 至 13.62 亿支 <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Q3'26 Table 3 ↗<\/a>。","desc_en":"Captured value-seeking adult smokers with ~$1.39 single-stick convenience, reaching 1,783M sticks in FY25 and growing +2.0% in 9M 2026 <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Q3'26 Table 3 ↗<\/a>."}],"battles":[{"tag_zh":"里程碑 01 · 工艺护城河","tag_en":"Case 01 · Blend Secret","sub_zh":"烟斗丝 vs 碎雪茄叶","sub_en":"Pipe Leaf Advantage","title_zh":"用烟斗丝彻底解决传统机制小雪茄辛辣锁喉痛点","title_en":"Eliminating Harshness via Steamed Black Cavendish","desc_zh":"让原本抗拒传统雪茄苦辣味的普通卷烟烟民也能顺畅接受，打开数千万跨界受众池 <a class=\"cite-link\" href=\"https://www.johnmiddletonco.com/\" target=\"_blank\" rel=\"noopener noreferrer\">John Middleton ↗<\/a>。","desc_en":"Sweet, mild pipe-tobacco filler made large cigars approachable to adult cigarette smokers <a class=\"cite-link\" href=\"https://www.johnmiddletonco.com/\" target=\"_blank\" rel=\"noopener noreferrer\">John Middleton ↗<\/a>."},{"tag_zh":"里程碑 02 · 产品升级","tag_en":"Case 02 · Wood Tip","sub_zh":"高毛利材质跃迁","sub_en":"Margin-Accretive Tip","title_zh":"Wood Tip 桦木嘴与 Jazz/Casino 文化命名破圈","title_en":"Wood Tip & Jazz/Casino Naming Fuel Premium Mix","desc_zh":"用音乐流派（Jazz/Blues）替代俗套水果名，既赋予成熟文化格调又推高单支终端售价 <a class=\"cite-link\" href=\"https://www.johnmiddletonco.com/\" target=\"_blank\" rel=\"noopener noreferrer\">Middleton Brands ↗<\/a>。","desc_en":"Evocative Jazz and Casino blends paired with real wood tips elevated brand cachet and unit margins <a class=\"cite-link\" href=\"https://www.johnmiddletonco.com/\" target=\"_blank\" rel=\"noopener noreferrer\">Middleton Brands ↗<\/a>."},{"tag_zh":"里程碑 03 · 2026Q2","tag_en":"Case 03 · Q2 2026","sub_zh":"单季破5亿支纪录","sub_en":"503M Quarterly Peak","title_zh":"2026Q2 单季出货 5.03 亿支（+5.2% YoY）","title_en":"Crossing 503M Sticks in a Single Quarter (+5.2% YoY)","desc_zh":"创下近年单季出货峰值，有力对冲可燃烟分部卷烟自然递减压力 <a class=\"cite-link\" href=\"https://www.sec.gov/Archives/edgar/data/764180/000076418026000093/exhibit991erq22026.htm\" target=\"_blank\" rel=\"noopener noreferrer\">Q2'26 EX-99.1 ↗<\/a>。","desc_en":"Delivered a standout 503M-stick second quarter (+5.2% YoY), cushioning cigarette stick declines <a class=\"cite-link\" href=\"https://www.sec.gov/Archives/edgar/data/764180/000076418026000093/exhibit991erq22026.htm\" target=\"_blank\" rel=\"noopener noreferrer\">Q2'26 EX-99.1 ↗<\/a>."},{"tag_zh":"里程碑 04 · 2026.10","tag_en":"Case 04 · NACS 2026","sub_zh":"便利店第2流量王","sub_en":"263M C-Store Trips","title_zh":"认证年驱动 2.63 亿次便利店行程超越口含烟全系","title_en":"Verified 263M Annual C-Store Trips Outpace USSTC","desc_zh":"高频单支购买使零售店主极度看重 Black & Mild 连带购物篮效应 <a class=\"cite-link\" href=\"https://www.2firsts.com/news/altria-showcases-ploom-marlboro-heated-tobacco-sticks-and-non-nicotine-energy-products-at-nacs-show-2026\" target=\"_blank\" rel=\"noopener noreferrer\">2Firsts NACS ↗<\/a>。","desc_en":"High-frequency single-stick purchases make Black & Mild indispensable to convenience retailers <a class=\"cite-link\" href=\"https://www.2firsts.com/news/altria-showcases-ploom-marlboro-heated-tobacco-sticks-and-non-nicotine-energy-products-at-nacs-show-2026\" target=\"_blank\" rel=\"noopener noreferrer\">2Firsts NACS ↗<\/a>."}],"laws":[{"zh":"在衰退大品类中寻找“低单次掏钱门槛 + 跨品类差异化感官”的子赛道，依然能跑出二十年长牛。","en":"Sub-segments combining low out-of-pocket ticket size with distinct sensory craft can grow for decades inside mature industries."},{"zh":"极致单品牌聚焦（99.85% 集中于 Black & Mild）胜过十个平庸副牌分散资源。","en":"Focusing 99.85% of subsidiary volume onto one unmistakable hero brand maximizes manufacturing and shelf ROI."},{"zh":"规避竞品沦为“廉价工具包”的陷阱，坚持带嘴纯品吸定位是守住高毛利的生命线。","en":"Owning the tipped cigar ritual insulates margins from commodity 2-for-$1 foil wrapper price wars."}]},"ch6":{"h2_zh":"六、“烟斗丝带嘴雪茄法则”单品护城河核查清单","h2_en":"6. 'Black & Mild Tipped Cigar Law' Moat Checklist","items_zh":[{"tag":"+1.5%~+2.5%/年","title":"1. 逆周期正销量测试：季度与年度出货支数是否持续保持正增长？","desc":"FY25 +1.9%、9M'26 +2.0%，核验其在可燃分部中的独特增量贡献。"},{"tag":"#1 带嘴垄断","title":"2. 带嘴细分绝对统治测试：在全美 Tipped Large Cigars 细分是否稳守第一？","desc":"防范 Swisher BLK 等跟风竞品分流塑嘴与实木嘴存量客群。"},{"tag":"Wood Tip 占比提升","title":"3. 内部材质升级测试：高毛利实木嘴（Wood Tip）与 Jazz/Casino 销量占比是否持续走高？","desc":"确保单支净实现收入增速高于出货支数增速。"},{"tag":"Original 压舱石","title":"4. 风味法规免疫测试：Original 原味塑嘴/木嘴在风味受限州能否承接 >70% 存量？","desc":"跟踪地方风味限制法令下的 SKU 留存转换率。"},{"tag":"263M 便利店行程","title":"5. 收银台黄金排面测试：单支保鲜铝箔装在便利店收银区在架率是否稳定？","desc":"守住 ~$1.39 冲动消费第一视觉触点。"},{"tag":"零 MSA 优势稳固","title":"6. 联邦与州雪茄税制测试：大雪茄联邦税封顶与州 OTP 税率是否保持相对卷烟优势？","desc":"监控各州预算案中针对机制大雪茄的税制变动。"}],"items_en":[{"tag":"+1.5%–2.5% Vol","title":"1. Positive Stick Growth Test: Are annual cigar shipments sustaining positive growth?","desc":"Verified +1.9% in FY25 and +2.0% in 9M 2026."},{"tag":"#1 Tipped Share","title":"2. Tipped Segment Dominance Test: Does Black & Mild maintain its #1 US tipped cigar lead?","desc":"Monitor competitive defense against pipe-tobacco imitators like Swisher BLK."},{"tag":"Wood Tip Mix Lift","title":"3. Material Trade-Up Test: Is higher-margin Wood Tip expanding as a % of total sticks?","desc":"Ensure revenue growth outpaces raw unit growth."},{"tag":"Original Blend Core","title":"4. Flavor-Rule Resilience Test: Do Original & Wood Tip Original retain smokers in restricted locales?","desc":"Track state/municipal cigar flavor ordinance impacts."},{"tag":"263M C-Store Trips","title":"5. Countertop Impulse Test: Are single-stick foil pouches locked onto checkout counters?","desc":"Preserve high-frequency convenience-store trip attachment."},{"tag":"Tax Cap Stability","title":"6. Cigar Excise Advantage Test: Does the federal per-cigar tax cap and MSA exemption hold?","desc":"Monitor state OTP tax legislation."}]},"sources":[{"label":"Altria Q3 & 9M 2026 Official Release (Table 3: Black & Mild 1,362M 9M Sticks +2.0%, Q3 456M +0.9%)","url":"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx"},{"label":"SEC Form 8-K Exhibit 99.1 — Altria FY2025 Results (Black & Mild 1,783M Sticks +1.9%, Q4 +4.2%)","url":"https://www.sec.gov/Archives/edgar/data/764180/000076418026000007/exhibit991erq42025.htm"},{"label":"SEC Form 8-K Exhibit 99.1 — Altria Q2 2026 Results (Q2 Black & Mild 503M Sticks +5.2% YoY)","url":"https://www.sec.gov/Archives/edgar/data/764180/000076418026000093/exhibit991erq22026.htm"},{"label":"John Middleton Co. Official Corporate & Brand Overview (~1.8B 2025 Sticks, #2 US Large Cigar)","url":"https://www.johnmiddletonco.com/"},{"label":"Altria Operating Companies — John Middleton Heritage (1856 Roots & 2007 Acquisition)","url":"https://www.altria.com/about-altria/our-companies/johnmiddleton"},{"label":"2Firsts NACS Show 2026 Report (263 Million Annual John Middleton Convenience-Store Trips)","url":"https://www.2firsts.com/news/altria-showcases-ploom-marlboro-heated-tobacco-sticks-and-non-nicotine-energy-products-at-nacs-show-2026"},{"label":"NIH / PMC Peer-Reviewed Study (2025): Lower Mean NNN Nitrosamines in Pipe-Tobacco Cigarillos","url":"https://pmc.ncbi.nlm.nih.gov/articles/PMC10922615/"}],"quickJumpZh":[{"sec":"sec-00","title":"00 单品定评与逆周期增长指标","sub":"FY25 17.83亿支(+1.9%) · 9M'26 +2.0% · 2.63亿客流"},{"sec":"sec-01","title":"01 芳香烟斗丝配方与木嘴/塑嘴工艺","sub":"黑卡文迪什发酵 · 低41% NNN · Wood Tip升级"},{"sec":"sec-02","title":"02 四大逆势长青支柱与雷达对比","sub":"独家室韵 · 带嘴纯品吸 · 免MSA和解金红利"},{"sec":"sec-03","title":"03 全美机制大雪茄核心竞品矩阵","sub":"对比 Swisher Sweets、Backwoods 与 Game"},{"sec":"sec-04","title":"04 免和解金优势与单支经济模拟器","sub":"年销18亿支复利与2007并购回报倍数推演"},{"sec":"sec-05","title":"05 1856 费城烟铺至奥驰亚收购史","sub":"从 Prince Albert 烟斗丝到全美带嘴雪茄霸主"},{"sec":"sec-06","title":"06 机制滤嘴大雪茄护城河核查清单","sub":"6项正销量、木嘴占比与税制核查"},{"sec":"sec-07","title":"07 官方站点、SEC 与科研信源索引","sub":"一手财报、官网与 NIH 化学论文直达"}],"quickJumpEn":[{"sec":"sec-00","title":"00 Product Verdict & Growth Scorecard","sub":"1,783M FY25 sticks (+1.9%) · +2.0% 9M'26 · 263M trips"},{"sec":"sec-01","title":"01 Aromatic Pipe-Tobacco & Tip Craft","sub":"Black Cavendish filler, birchwood tips & low NNN"},{"sec":"sec-02","title":"02 4 Counter-Cyclical Pillars & Radar","sub":"Sensory moat, ~$1.39 impulse ticket & MSA exemption"},{"sec":"sec-03","title":"03 US Machine-Made Cigar Matrix","sub":"Benchmarking Swisher Sweets, Backwoods & Game"},{"sec":"sec-04","title":"04 MSA-Exempt Unit Economics Simulator","sub":"1.8B+ stick compounding & 2007 M&A payback model"},{"sec":"sec-05","title":"05 1856 Heritage to Altria Growth Engine","sub":"Philadelphia pipe-shop origins to Q2'26 503M peak"},{"sec":"sec-06","title":"06 Tipped Cigar Moat Checklist","sub":"6-point volume, Wood Tip mix & tax verification"},{"sec":"sec-07","title":"07 Official, SEC & Scientific Sources","sub":"Direct links to SEC tables, Middleton & PMC study"}]},{"id":"copenhagen","idx_num":5,"idx_pad":"05","filename":"mo_prod_05_copenhagen.html","checkKey":"mui_mo_checks_copenhagen","monogram":"CP","short_zh":"Copenhagen 哥本哈根","short_en":"Copenhagen MST","pill_kpi":"FDA MRTP减害 · $7.78/罐","docTitleZh":"《Copenhagen 哥本哈根百年湿鼻烟》单品深度商业研报（USSTC · FDA MRTP）| 王安安数据中心","docTitleEn":"Copenhagen Moist Smokeless Tobacco & FDA MRTP Product Monograph (USSTC) | Research Hub","crumb_zh":"Copenhagen 哥本哈根百年旗舰湿鼻烟（USSTC · FDA MRTP 认证）","crumb_en":"Copenhagen Flagship Moist Smokeless Tobacco (USSTC · FDA MRTP)","chip1_zh":"1822 百年鼻祖 · FDA MRTP 授权","chip1_en":"Est. 1822 · FDA MRTP Authorized","chip2_zh":"$7.78/罐高溢价 · 口含 OCI率 66.8%","chip2_en":"$7.78/Can Avg · 66.8% Oral Margin","sidebar":{"badge":"USSTC · #1 PREMIUM MST & MRTP ICON","title_zh":"Copenhagen 深度研报","title_en":"Copenhagen Monograph","sub_zh":"美国现存最古老消费品牌之一 (1822)：斩获 FDA 肺癌风险降低 MRTP 官方授权 × $7.78/罐超高端定价 × 传统湿鼻烟 ~32.5% 绝对龙头","sub_en":"America's 1822 smokeless icon: FDA MRTP lung-cancer risk claim × $7.78/can retail price × ~32.5% of US MST","mini_kpis":[{"label_zh":"口含烟总市场份额 (Q3'26)","label_en":"Total Oral Share (Q3'26)","val_zh":"12.6% (MST内~32.5%)","val_en":"12.6% (~32.5% MST)"},{"label_zh":"2026前9月出货罐数","label_en":"9M 2026 Shipments","val_zh":"245.6M 罐","val_en":"245.6M Cans"},{"label_zh":"终端单罐平均零售价","label_en":"Avg Retail Can Price","val_zh":"$7.78 / 罐 (Q2'26)","val_en":"$7.78 / Can (Q2'26)"}]},"toc":[["单品定评与超高毛利成绩单","Product Verdict & Margin Scorecard"],["明火熏烤发酵工艺与 MRTP 授权","Fire-Cured Craft & FDA MRTP Claim"],["四大溢价支柱与五维护城河雷达","4 Premium Pillars & Oral Moat Radar"],["全美传统湿鼻烟与现代口含对比","US MST & Oral Nicotine Matrix"],["$7.78/罐单品经济学与产能整合模拟","$7.78/Can Economics & Consolidation Sim"],["204 年品牌史与无烟转型定位","204-Year History & Smoke-Free Bridge"],["高端湿鼻烟现金牛核查清单","Premium MST Cash-Cow Checklist"],["FDA 官方批文与 SEC 信源索引","FDA MRTP Order & SEC Sources"]],"hero":{"strip1_zh":"单品定评：美国口含烟草皇冠上的利润明珠，凭 $7.78/罐定价撑起奥驰亚口含分部高达 66.8%–67.9% 的恐怖营业利润率","strip1_en":"Verdict: Profit crown jewel of US oral tobacco, anchoring 66.8%–67.9% segment Adjusted OCI margins at $7.78/can","strip2_zh":"运营主体：U.S. Smokeless Tobacco Company (USSTC · 2009年并入奥驰亚 · 1.74亿次便利店年行程)","strip2_en":"Operating Co.: U.S. Smokeless Tobacco Co. (USSTC · Acquired 2009 · 174M Annual C-Store Trips)","strip3_zh":"数据基准：2026Q3 季报 & FDA MRTP 批文","strip3_en":"Baseline: Q3 2026 & FDA MRTP Order","overline_zh":"ORAL PROFIT CROWN 05 · 1822 创立 (204年历史) × FDA 认证降低肺癌风险 MRTP × FY25 出货 3.628亿罐 × 67.9% 分部 OCI 率","overline_en":"ORAL PROFIT CROWN 05 · Est. 1822 × FDA Lung-Cancer MRTP Claim × 362.8M FY25 Cans × 67.9% FY25 Oral Adj. OCI Margin","h1_zh":"Copenhagen 哥本哈根湿鼻烟深度剖析：<span class=\"gradient-accent\">现代纯白尼古丁袋狂飙至 61.2% 份额时代，204 岁老字号如何凭 $7.78/罐守住 67% 利润率？<\/span>","h1_en":"Copenhagen MST Deep Dive: <span class=\"gradient-accent\">How a 204-Year Fire-Cured Icon Commands $7.78/Can and FDA Modified-Risk Status Amid the Nicotine Pouch Wave<\/span>","lead_zh":"诞生于 <strong>1822 年<\/strong> 的 <strong>Copenhagen（哥本哈根）<\/strong> 是美国商业史上现存最古老的消费品商标之一，也是奥驰亚全资子公司 <strong>USSTC<\/strong> 的绝对利润支柱。2023 年 3 月 16 日，美国 FDA 正式授予 <strong>Copenhagen Classic Snuff<\/strong> 极其罕见的<strong>改良风险烟草制品（MRTP）<\/strong>上市许可，允许其合法向成年烟民宣称：<em>“IF YOU SMOKE, CONSIDER THIS: Switching completely to this product from cigarettes reduces risk of lung cancer.”<\/em> <a class=\"cite-link\" href=\"https://www.fda.gov/news-events/press-announcements/fda-authorizes-copenhagen-classic-snuff-be-marketed-modified-risk-tobacco-product\" target=\"_blank\" rel=\"noopener noreferrer\">FDA MRTP Official ↗<\/a>。尽管受现代纯白尼古丁袋（占口含烟大盘 61.2%）跨品类分流影响，Copenhagen 2026 前9月出货回落 10.5% 至 <strong>2.456 亿罐<\/strong>（2025 全年为 <strong>3.628 亿罐<\/strong>），但其在全美传统湿鼻烟（MST）细分市场内部仍独占约 <strong>32.5%<\/strong> 绝对头把交椅（占整个口含烟大盘 <strong>12.6%<\/strong>），并凭高达 <strong>$7.78/罐<\/strong> 的终端均价 <a class=\"cite-link\" href=\"https://tobaccoinsider.com/altria-q2-2026-results/\" target=\"_blank\" rel=\"noopener noreferrer\">Tobacco Insider Q2'26 ↗<\/a> 支撑口含烟分部在 2025 全年创下 <strong>$18.35 亿调整后 OCI（67.9% 利润率，9M'26 为 $13.39 亿 / 66.8%）<\/strong> <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Q3'26 Table 5 & 6 ↗<\/a>。","lead_en":"Founded in <strong>1822<\/strong>, <strong>Copenhagen<\/strong> is one of America's oldest active CPG brands and the profit engine of <strong>USSTC<\/strong>. On March 16, 2023, the FDA granted <strong>Copenhagen Classic Snuff<\/strong> a landmark 5-year <strong>Modified Risk Tobacco Product (MRTP)<\/strong> order authorizing the verbatim claim: <em>“IF YOU SMOKE, CONSIDER THIS: Switching completely to this product from cigarettes reduces risk of lung cancer.”<\/em> <a class=\"cite-link\" href=\"https://www.fda.gov/news-events/press-announcements/fda-authorizes-copenhagen-classic-snuff-be-marketed-modified-risk-tobacco-product\" target=\"_blank\" rel=\"noopener noreferrer\">FDA MRTP Official ↗<\/a>. While rapid nicotine pouch adoption (now 61.2% of oral tobacco) trimmed Copenhagen's 9M 2026 volume -10.5% to <strong>245.6M cans<\/strong> (FY2025: <strong>362.8M cans<\/strong>), Copenhagen commands <strong>~32.5% of traditional MST<\/strong> (<strong>12.6%<\/strong> of total US oral tobacco in Q3'26) at an average retail price of <strong>$7.78/can<\/strong> <a class=\"cite-link\" href=\"https://tobaccoinsider.com/altria-q2-2026-results/\" target=\"_blank\" rel=\"noopener noreferrer\">Tobacco Insider Q2'26 ↗<\/a>—underpinning <strong>67.9% (FY25) and 66.8% (9M'26)<\/strong> Oral Adjusted OCI margins <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Q3'26 Table 5 & 6 ↗<\/a>.","thesis_cards":[{"title_zh":"100% 美国本土暗火熏烤烟叶与蜡封纸底铁盖","title_en":"100% US Dark Fire-Cured Tobacco & Fiberboard Can","desc_zh":"肯塔基与田纳西州胡桃木/橡木暗火熏制（Dark Fire-Cured）长年发酵，搭配经典日期戳蜡封纤维纸盒金属盖，乡村蓝领与户外人群信仰级图腾。","desc_en":"100% US Kentucky/Tennessee dark fire-cured tobacco aged in iconic wax-sealed dated fiberboard cans—a cultural badge across rural Heartland trades."},{"title_zh":"FDA 认证 5 年期 MRTP 减害声称国家级背书","title_en":"FDA-Authorized Lung-Cancer Risk-Reduction Claim","desc_zh":"全美极少数通过 FDA 严苛科学评审获准宣传“完全替代卷烟可降低肺癌风险”的产品，打通传统烟民减害认知壁垒。","desc_en":"Holds the first FDA MRTP order (Mar 2023) authorizing Classic Snuff to claim complete switching from cigarettes reduces lung-cancer risk."},{"title_zh":"$7.78/罐超强提价力 + 2026 USSTC 工厂整合降本","title_en":"$7.78/Can Pricing Power + 2026 USSTC Plant Consolidation","desc_zh":"单罐提价完全对冲罐数下滑（Q3 口含不含税营收逆势微增 +0.3%），叠加 2026 年推进 USSTC 制造基地集约化整合锁定长期 >66% 利润率。","desc_en":"$7.78/can retail pricing plus 2026 USSTC plant consolidation offset pouch migration, holding Oral Adjusted OCI margins at 66.8%–67.9%."}],"kpis":[{"label_zh":"终端平均零售单价 (Q2'26)","label_en":"Avg Retail Price / Can","badge_zh":"口含烟最高溢价锚","badge_en":"Premium MST Price Leader","val_zh":"$7.78 / 罐","val_en":"$7.78 / Can","desc_zh":"显著高于行业尼古丁袋与价值型湿鼻烟促销均价，支撑极高单罐毛利 <a class=\"cite-link\" href=\"https://tobaccoinsider.com/altria-q2-2026-results/\" target=\"_blank\" rel=\"noopener noreferrer\">Tobacco Insider Q2'26 ↗<\/a>","desc_en":"Commands $7.78 average retail price per can (Q2'26), towering above discounted nicotine pouches and value snuff <a class=\"cite-link\" href=\"https://tobaccoinsider.com/altria-q2-2026-results/\" target=\"_blank\" rel=\"noopener noreferrer\">Tobacco Insider Q2'26 ↗<\/a>"},{"label_zh":"口含分部调整后 OCI 率","label_en":"Oral Adj. OCI Margin","badge_zh":"超越可燃分部!","badge_en":"Higher Than Smokeable!","val_zh":"66.8% / 67.9%","val_en":"66.8% / 67.9%","desc_zh":"FY2025 达 67.9%（$1,835M OCI），2026前9月达 66.8%（$1,339M OCI），全集团利润率最高板块 <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Q3'26 Table 5 ↗<\/a>","desc_en":"Oral Tobacco delivered 67.9% Adjusted OCI margin in FY25 ($1,835M) and 66.8% in 9M'26 ($1,339M)—Altria's highest-margin division <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Q3'26 Table 5 ↗<\/a>"},{"label_zh":"2025全年 / 2026前9月出货","label_en":"FY25 / 9M26 Cans Shipped","badge_zh":"占奥驰亚口含 47%","badge_en":"47% of MO Oral Cans","val_zh":"362.8M / 245.6M","val_en":"362.8M / 245.6M","desc_zh":"2026Q3 单季出货 79.8M 罐，以一己之力贡献奥驰亚口含总罐数（522.2M）近半壁江山 <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Q3'26 Table 6 ↗<\/a>","desc_en":"Shipped 362.8M cans in FY25 and 245.6M in 9M'26 (79.8M in Q3), nearly half of Altria's 522.2M total oral cans <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Q3'26 Table 6 ↗<\/a>"},{"label_zh":"口含总份额 / 传统MST内份额","label_en":"Total Oral / MST Share","badge_zh":"传统湿鼻烟 #1","badge_en":"#1 Traditional MST","val_zh":"12.6% / ~32.5%","val_en":"12.6% / ~32.5%","desc_zh":"Q3'26 尼古丁袋占口含大盘 61.2%（传统 MST 占 38.8%），折算哥本哈根在 MST 内部独占 ~32.5% <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Q3'26 Table 7 ↗<\/a>","desc_en":"Held 12.6% of total US oral tobacco in Q3'26; with pouches at 61.2% of oral, Copenhagen commands ~32.5% inside traditional MST <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Q3'26 Table 7 ↗<\/a>"}]},"ch1":{"eyebrow":"CHAPTER 01 · DARK FIRE-CURED CRAFT, CUT GEOMETRY & FDA MRTP","h2_zh":"一、暗火熏制发酵工艺与切丝矩阵：为什么死忠用户拒绝换成纯白合成袋？","h2_en":"1. Dark Fire-Cured Craft & Cut Matrix: Why Core Dippers Refuse Synthetic Pouches","sub_zh":"天然木火烟熏香气 × Fine Snuff / Long Cut / Packs 全规格切丝 × FDA 5年期 MRTP 科学背书","sub_en":"Hickory/oak dark-fired fermentation × Snuff, Long Cut & Packs × FDA 5-year MRTP scientific order","badge_zh":"FDA MRTP 有效期 5 年 · 2026 USSTC 产线集约整合","badge_en":"5-Yr FDA MRTP Order · 2026 USSTC Consolidation","hub_title_zh":"Copenhagen 百年工艺壁垒（重度真烟叶醇厚劲道 ↔ 无法被化学尼古丁盐模拟的木熏咸鲜口感）","hub_title_en":"Copenhagen Craft Core (Aged Dark-Fired Leaf Body ↔ Unreplicable Smoky-Savory Mouthfeel)","hub_sub_zh":"田纳西纳什维尔 / 肯塔基霍普金斯维尔产区核心暗火烟叶 · 2026 推进 USSTC 制造设施整合（9M 计提 $89M 整合转型投资）","hub_sub_en":"Kentucky/Tennessee Dark Fire-Cured leaf · 2026 USSTC Facilities Consolidation ($89M 9M'26 restructuring investment) streamlining unit costs","nodes":[{"tag_zh":"MRTP FLAGSHIP · 百年元祖细末","tag_en":"MRTP ICON · CLASSIC SNUFF","name_zh":"Copenhagen Classic Snuff (Fine Cut)","name_en":"Copenhagen Classic Snuff","desc_zh":"1822 传承极细砂状切末，释放尼古丁速度最快、咸香木熏味最纯正，2023.03 独获 FDA 肺癌减害 MRTP 授权。","desc_en":"1822-recipe fine-cut dark fire-cured snuff delivering rapid nicotine release and holding FDA's lung-cancer MRTP authorization."},{"tag_zh":"VOLUME CORE · 长切丝主力","tag_en":"VOLUME CORE · LONG CUT","name_zh":"Copenhagen Long Cut & Extra Long","name_en":"Long Cut Original & Natural","desc_zh":"1997 年推出的长切丝易于指尖捏取（Pinchability）且在唇齿间不易散开，是当前销量最大的核心规格。","desc_en":"1997 Long Cut innovation offering superior pinchability and lip pack retention—Copenhagen's largest volume contributor."},{"tag_zh":"FLAVORED PREMIUM · 风味延伸","tag_en":"FLAVORED MST · WINTERGREEN/MINT","name_zh":"Long Cut Wintergreen · Mint · Straight","name_en":"Wintergreen · Mint · Straight","desc_zh":"在真烟叶厚重基底上叠加美式冬青与甜润直调（Straight），正面压制雷诺旗下 Grizzly 同类风味。","desc_en":"Rich real-leaf Wintergreen, Mint, and sweet-smoky Straight styles competing head-to-head against Reynolds' Grizzly."},{"tag_zh":"MOIST POUCHES & PACKS · 便捷袋装","tag_en":"MOIST POUCHES & PACKS","name_zh":"Copenhagen Pouches & Soft Packs","name_en":"Copenhagen Pouches & Packs","desc_zh":"用高透柔韧无纺布包裹湿润真烟叶（Packs 规格更饱满贴合），为不喜散叶吐渣的用户提供干净体验。","desc_en":"Pre-portioned moist tobacco pouches and pillowy Packs for adult dippers seeking real-leaf flavor with tidy cleanup."},{"tag_zh":"SPIT-FREE BRIDGE · 无烟减害声称","tag_en":"FDA MRTP CLAIM ENGINE","name_zh":"合法直连 5,420万成年烟草用户","name_en":"Direct Smoker-Switch Messaging","desc_zh":"可在官网、直邮及门店合规物料中使用 FDA 批准的肺癌减害对比文案，精准转化高龄重度卷烟烟民。","desc_en":"Deploys FDA-authorized lung-cancer risk-reduction messaging across direct mail, digital, and POS to convert older heavy smokers."},{"tag_zh":"USSTC CONSOLIDATION · 降本增效","tag_en":"2026 PLANT CONSOLIDATION","name_zh":"USSTC 制造基地集约化升级","name_en":"USSTC Facilities Consolidation","desc_zh":"2026 年投资整合 USSTC 工厂布局（相应上调集团 CapEx 指引至 $375M–$450M），对冲销量回落、锁定长期高毛利。","desc_en":"2026 USSTC manufacturing footprint consolidation ($89M 9M charges) streamlines fixed overhead to lock in >66% long-term margins."}],"platform_bars":[{"title_zh":"按重量计征的极低联邦消费税红利（~$0.04/罐 vs 卷烟 $1.01/包）","title_en":"Weight-Based Federal Excise Tax Advantage (~$0.04/can vs. $1.01/pack)","sub_zh":"口含烟分部 2026Q3 净营收 $688M 中消费税仅占 $21M（税负率仅 3.05%！对比可燃烟高达 12.3%），绝大部分零售收入留在厂商手中。","sub_en":"Federal MST tax is weight-based (~$0.04/can): Q3'26 Oral excise tax was just $21M on $688M revenue (3.05% vs. 12.3% in Smokeable!)."},{"title_zh":"中西部、南部与户外农牧/建筑/军警圈层文化图腾","title_en":"Heartland, Ranching, Trades & Outdoorsman Cultural Lock-In","sub_zh":"牛仔裤后袋一圈“Copenhagen Ring”压痕是数十年乡村硬汉亚文化勋章，价格敏感度极低。","sub_en":"The iconic 'Copenhagen Ring' worn into denim back pockets anchors multi-generational loyalty across ranching, oilfield, and skilled trades."}],"principles":[{"title_zh":"1. 超低消费税负造就 67%+ 惊人营业利润率","title_en":"1. 3% Excise Tax Burden Fuels 67%+ Operating Margins","desc_zh":"奥驰亚 2026Q3 Schedule 2 & 5 显示：口含分部单季营收 $688M 仅缴消费税 <strong>$21M<\/strong>、FDA 费仅 <strong>$1M<\/strong>，且零卷烟 MSA 持续费用，使调整后 OCI 率常年高达 <strong>66.4%–69.2%<\/strong> <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Q3'26 Schedule 5 ↗<\/a>。","desc_en":"Altria Q3'26 Schedule 2 & 5 show Oral paid just <strong>$21M<\/strong> in excise taxes and <strong>$1M<\/strong> in FDA fees on $688M gross revenue with zero cigarette MSA drag, fueling <strong>66.4%–69.2%<\/strong> Adjusted OCI margins <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Q3'26 Schedule 5 ↗<\/a>."},{"title_zh":"2. FDA 科学评审背书（TPSAC 论证通过）","title_en":"2. Rigorous FDA MRTP Scientific Validation","desc_zh":"FDA 烟草制品中心（CTP）历时多年审查流行病学证据后确认：成年烟民若从卷烟<strong>完全切换<\/strong>至 Copenhagen Classic Snuff，确实可降低罹患肺癌风险（需履行年度上市后监测）<a class=\"cite-link\" href=\"https://www.fda.gov/news-events/press-announcements/fda-authorizes-copenhagen-classic-snuff-be-marketed-modified-risk-tobacco-product\" target=\"_blank\" rel=\"noopener noreferrer\">FDA Press Release ↗<\/a>。","desc_en":"After multi-year epidemiological review, FDA CTP authorized Copenhagen Classic Snuff to state complete switching from cigarettes reduces lung-cancer risk <a class=\"cite-link\" href=\"https://www.fda.gov/news-events/press-announcements/fda-authorizes-copenhagen-classic-snuff-be-marketed-modified-risk-tobacco-product\" target=\"_blank\" rel=\"noopener noreferrer\">FDA Press Release ↗<\/a>."},{"title_zh":"3. 提价能力完全抵消 -10% 罐数自然迁移","title_en":"3. $7.78/Can Pricing Offsets -10% Volume Shift to Pouches","desc_zh":"尽管部分轻度用户分流向 ZYN / on!，但留存重度用户高度忠诚，支撑 2026Q3 口含分部不含税净营收在总罐数 -4.3% 下依然逆势增长 <strong>+0.3%<\/strong> 至 $667M <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Q3'26 Table 5 ↗<\/a>。","desc_en":"$7.78/can list-price realization offset -10% can migration to pouches, lifting Q3'26 Oral revenue net of excise <strong>+0.3%<\/strong> YoY to $667M <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Q3'26 Table 5 ↗<\/a>."}],"alert_zh":"<strong>赛道坐标系拆解：<\/strong>不要被表面“口含大盘份额从 19.0% 降至 12.6%”误导——这是因为分母端尼古丁袋三年狂飙扩张了整个口含烟总池（2025 下半年全行业口含总销量激增 +14%，2026 中期再增 +5.5%）。在<strong>传统湿鼻烟（MST，占大盘 38.8%）<\/strong>内部，Copenhagen 依然稳坐超 <strong>32%<\/strong> 份额的绝对铁王座！","alert_en":"<strong>Denominator Context Matters:<\/strong> Copenhagen's shift from 19.0% (2024) to 12.6% (Q3'26) of total US oral tobacco is largely denominator expansion as nicotine pouches swelled total oral industry volume (+14% in 2H25, +5.5% in 2026). Inside <strong>traditional MST (38.8% of oral)<\/strong>, Copenhagen still commands <strong>~32.5%<\/strong> category leadership.","chart":{"tabA_zh":"视图A: 季度出货罐数与传统MST内统治份额","tabA_en":"View A: Quarterly Cans & Share Within MST","tabB_zh":"视图B: 口含烟分部不含税营收 vs 超高OCI利润率","tabB_en":"View B: Oral Segment Net Rev vs. Adj. OCI Margin","viewA":{"mode":"dual_bar_line","title_zh":"Copenhagen 季度报告出货量（百万罐）vs 在传统湿鼻烟（MST）内部推算占有率（%）","title_en":"Copenhagen Quarterly Shipments (M Cans) vs. Implied Share Within Traditional MST (%)","sub_zh":"单季出货稳定在 8,000万–8,800万罐区间，在传统湿鼻烟池内始终保持 ~32.5%–33.5% 头把交椅","sub_en":"Shipping ~80M–88M cans per quarter while maintaining ~32.5%–33.5% share inside the traditional MST pool","leg1_zh":"季度报告出货量 (左轴 · 百万罐)","leg1_en":"Quarterly Shipments (Left · M Cans)","leg2_zh":"传统 MST 细分内部占有率 (右轴 · %)","leg2_en":"Implied Share of Traditional MST (Right · %)","labels_zh":["2025Q3","2025Q4","2026Q1","2026Q2","2026Q3"],"labels_en":["Q3 2025","Q4 2025","Q1 2026","Q2 2026","Q3 2026"],"subs_zh":["口含总份额 14.6%","口含总份额 14.2%","80.4M 罐","均价 $7.78/罐","口含总份额 12.6%"],"subs_en":["14.6% total oral","14.2% total oral","80.4M cans","$7.78/can avg","12.6% total oral"],"s1":[88.8,88.4,80.4,85.4,79.8],"s2":[32.7,32.9,32.6,32.7,32.5],"max1":105,"max2":40,"u1":"M","u2":"%"},"viewB":{"mode":"grouped_bars","title_zh":"奥驰亚口含烟矩阵内部出货结构对比：Copenhagen 绝对支柱地位（百万罐）","title_en":"Altria Oral Tobacco Shipment Breakdown by Brand: FY2025 vs. 9M 2026 (Million Cans)","sub_zh":"Copenhagen 单一品牌罐数接近 Skoal、on! 与 Other（Red Seal/Husky）三者之和","sub_en":"Copenhagen alone ships nearly as many cans as Skoal, on!, and Red Seal/Husky combined","leg1_zh":"2025 全年出货罐数 (百万罐)","leg1_en":"FY 2025 Cans Shipped (M)","leg2_zh":"2026 前9月出货罐数 (百万罐)","leg2_en":"9M 2026 Cans Shipped (M)","labels_zh":["Copenhagen 哥本哈根","on! 现代尼古丁袋","Skoal 斯考尔","Other (Red Seal+Husky)"],"labels_en":["Copenhagen MST","on! Nicotine Pouches","Skoal MST","Other (Red Seal/Husky)"],"subs_zh":["$7.78/罐最高单价","9M同比 +7.7%","风味MST次主力","9M同比 +1.3%正增长"],"subs_en":["$7.78/can flagship","+7.7% YoY in 9M","Flavored MST #2","+1.3% YoY in 9M"],"s1":[362.8,177.8,127.9,63.9],"s2":[245.6,143.9,84.5,48.2],"max1":400,"u1":"M","u2":"M"}},"matrix_cards":[{"title_zh":"FDA MRTP 批文细则与 2028 五年续期时间窗","title_en":"FDA MRTP Mandate & 2028 5-Year Renewal Window","badge_zh":"2023.03–2028.03","badge_en":"5-Yr Statutory Term","body_zh":"根据 FDA 2023 年 3 月 16 日签发的风险修正令（Risk Modification Order），授权期为 <strong>5 年<\/strong>（至 2028 年 3 月），仅限宣称“完全从卷烟改用本品可降低肺癌风险”，不得延伸至口腔癌或其他全身疾病，且须每年提交消费者行为监测报告 <a class=\"cite-link\" href=\"https://www.fda.gov/news-events/press-announcements/fda-authorizes-copenhagen-classic-snuff-be-marketed-modified-risk-tobacco-product\" target=\"_blank\" rel=\"noopener noreferrer\">FDA MRTP Terms ↗<\/a>。","detail_zh":"目前全美获得 FDA MRTP 风险修正令的产品凤毛麟角（仅有瑞典火柴 General Snus 8款与 USSTC Copenhagen Classic Snuff 等极少数标杆），构成了极高的科学合规护城河。","body_en":"Issued March 16, 2023 for a five-year term, the FDA order strictly scopes the claim to lung-cancer risk reduction upon complete switching from cigarettes, requiring annual postmarket surveillance <a class=\"cite-link\" href=\"https://www.fda.gov/news-events/press-announcements/fda-authorizes-copenhagen-classic-snuff-be-marketed-modified-risk-tobacco-product\" target=\"_blank\" rel=\"noopener noreferrer\">FDA MRTP Terms ↗<\/a>.","detail_en":"Only a handful of products in FDA history (such as General Snus and Copenhagen Classic Snuff) have cleared the full risk-modification evidentiary bar."},{"title_zh":"2026 USSTC 制造基地整合（Facilities Consolidation）提振未来利润率","title_en":"2026 USSTC Manufacturing Consolidation Protects 67%+ Margins","badge_zh":"9M'26 投入 $89M","badge_en":"$89M 9M'26 Exit Charge","body_zh":"为匹配传统湿鼻烟向精益高毛利稳态过渡，奥驰亚于 2026 年果断推进 <strong>USSTC 工厂整合计划<\/strong>（前9月口含分部计提 $89M 一次性整合成本），压缩冗余固定制造开支 <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Q3'26 Table 5 ↗<\/a>。","detail_zh":"整合完成后，单罐制造转换成本将进一步下降，确保即使 MST 罐数每年自然递减 8%–10%，Copenhagen 依然能长期维持近 68% 的超高营业利润率。","body_en":"Altria recorded $89M in 9M 2026 oral exit and implementation charges to consolidate USSTC manufacturing footprints—structurally lowering fixed overhead per can <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Q3'26 Table 5 ↗<\/a>.","detail_en":"Streamlining legacy MST capacity locks in long-term ~67%–68% segment OCI margins."}]},"ch2":{"eyebrow":"CHAPTER 02 · FOUR ORAL CASH-COW PILLARS & 5-AXIS RADAR","h2_zh":"二、四大溢价支柱：Copenhagen 凭什么比万宝路利润率还要高？","h2_en":"2. Four Profit Pillars: Why Copenhagen Generates Higher Margins Than Cigarettes","badge_zh":"护城河评级：极宽 (204年信仰 · 3%极低消费税 · MRTP)","badge_en":"Moat Rating: Wide (204-Yr Icon · 3% Excise · MRTP)","pillars":[{"title_zh":"01 · 204 年美式硬汉图腾与 $7.78/罐超高端定价锚","title_en":"01 · 204-Year Heartland Heritage & $7.78/Can Price Leadership","badge_zh":"自1822从未间断","badge_en":"Continuous Since 1822","desc_zh":"两百余年代际口传心授，在农牧、油田、建筑、消防与退伍军人群体中具备宗教级粘性。","note_zh":"<strong>当前选中支柱解读（01 文化图腾溢价）：<\/strong>2026Q2 单罐终端均价达 <strong>$7.78<\/strong>，高出价值型湿鼻烟 $2.50–$3.50/罐，是整个口含烟赛道无可争议的价格天花板 <a class=\"cite-link\" href=\"https://tobaccoinsider.com/altria-q2-2026-results/\" target=\"_blank\" rel=\"noopener noreferrer\">Tobacco Insider ↗<\/a>。","note_en":"<strong>Selected Pillar (01 · Cultural Pricing Power):<\/strong> Averaging <strong>$7.78/can<\/strong> at retail in Q2 2026, Copenhagen commands a $2.50–$3.50 premium over value MST rivals <a class=\"cite-link\" href=\"https://tobaccoinsider.com/altria-q2-2026-results/\" target=\"_blank\" rel=\"noopener noreferrer\">Tobacco Insider ↗<\/a>.","desc_en":"204-year heritage commands $7.78/can pricing across farming, construction, oilfield, first-responder, and veteran cohorts."},{"title_zh":"02 · 仅 ~3% 消费税负 + 零卷烟 MSA 持续按支提成","title_en":"02 · ~3% Federal Excise Tax & Zero Cigarette MSA Drag","badge_zh":"66.8%–67.9% OCI率","badge_en":"66.8%–67.9% Adj. OCI","desc_zh":"联邦湿鼻烟按磅从量计税极轻，使绝大部分终端提价直接转化为 USSTC 营业利润。","note_zh":"<strong>当前选中支柱解读（02 极致税盾结构）：<\/strong>2025 全年口含烟净营收 $2,802M 中消费税仅 $98M（3.5%），直接造就了超越可燃分部（63.4%）的 <strong>67.9%<\/strong> 调整后 OCI 利润率 <a class=\"cite-link\" href=\"https://www.sec.gov/Archives/edgar/data/764180/000076418026000007/exhibit991erq42025.htm\" target=\"_blank\" rel=\"noopener noreferrer\">FY25 Table 5 ↗<\/a>。","note_en":"<strong>Selected Pillar (02 · Low Excise Structure):<\/strong> Out of $2,802M FY2025 oral net revenues, excise taxes were just $98M (3.5%), unlocking a <strong>67.9%<\/strong> Adjusted OCI margin <a class=\"cite-link\" href=\"https://www.sec.gov/Archives/edgar/data/764180/000076418026000007/exhibit991erq42025.htm\" target=\"_blank\" rel=\"noopener noreferrer\">FY25 Table 5 ↗<\/a>.","desc_en":"Ultra-low ~3% federal weight-based excise tax and zero cigarette MSA settlements let nearly every price hike dollar hit operating profit."},{"title_zh":"03 · 暗火熏制真烟叶感官厚度（纯白合成袋无法替代）","title_en":"03 · Dark Fire-Cured Tobacco Body Unmatched by White Pouches","badge_zh":"真叶发酵咸鲜感","badge_en":"Aged Tobacco Ritual","desc_zh":"纯白尼古丁袋只提供纯净尼古丁刺激，而重度老用户迷恋的是暗火烤制真烟叶的饱满咸香与生津感。","note_zh":"<strong>当前选中支柱解读（03 感官不可替代性）：<\/strong>轻度与跨界用户已基本完成向尼古丁袋迁移，留下来的 ~3.2亿罐/年核心用户是极难动摇的铁杆基本盘。","note_en":"<strong>Selected Pillar (03 · Authentic Leaf Mouthfeel):<\/strong> Casual dual-users have largely shifted to pouches, leaving a sticky ~320M-can/yr core of dedicated traditional dippers.","desc_en":"White pouches deliver clean nicotine, but core dippers crave the smoky, savory salivation of real dark fire-cured tobacco leaf."},{"title_zh":"04 · FDA MRTP 科学授权赋予合规“劝烟民改口含”特权","title_en":"04 · FDA MRTP Authorization Unlocks Legal Harm-Reduction Claims","badge_zh":"FDA 风险修正令","badge_en":"FDA MRTP Granted","desc_zh":"当绝大多数电子烟与尼古丁袋被严禁宣传“比香烟更安全”时，Classic Snuff 拥有法定减害声称豁免。","note_zh":"<strong>当前选中支柱解读（04 法定声称护城河）：<\/strong>耗时十余年、斥资数千万美元临床与人群模型研究换取的 MRTP 批文，是中小对手永远无法企及的监管高山 <a class=\"cite-link\" href=\"https://www.fda.gov/news-events/press-announcements/fda-authorizes-copenhagen-classic-snuff-be-marketed-modified-risk-tobacco-product\" target=\"_blank\" rel=\"noopener noreferrer\">FDA MRTP ↗<\/a>。","note_en":"<strong>Selected Pillar (04 · Regulatory Moat):<\/strong> Multi-year epidemiological evidence cleared FDA's highest statutory bar, permitting explicit lung-cancer risk-reduction marketing <a class=\"cite-link\" href=\"https://www.fda.gov/news-events/press-announcements/fda-authorizes-copenhagen-classic-snuff-be-marketed-modified-risk-tobacco-product\" target=\"_blank\" rel=\"noopener noreferrer\">FDA MRTP ↗<\/a>.","desc_en":"While e-vapor and white pouches are barred from unauthorized safety claims, Classic Snuff holds statutory FDA MRTP claim authority."}],"radar":{"title_zh":"美国传统湿鼻烟与高端无烟口含品牌五维雷达图（10分制）","title_en":"5-Axis US Smokeless & Oral Brand Moat Radar (10-Point Scale)","axes_zh":["单罐终端定价权","营业利润转化率","FDA减害科学背书","重度烟民感官粘性","跨品类抗分流力"],"axes_en":["Can Pricing Power","OCI Margin Rate","FDA MRTP Science","Sensory Stickiness","Pouch Insulation"],"s0_zh":"Copenhagen 哥本哈根 ($7.78/罐 · FDA MRTP)","s0_en":"Copenhagen ($7.78/Can · FDA MRTP)","s1_zh":"Grizzly 灰熊 (BAT/American Snuff 湿鼻烟老二)","s1_en":"Grizzly (BAT/American Snuff #2 MST)","s2_zh":"ZYN 尼古丁袋 (PMI/Swedish Match 现代袋霸主)","s2_en":"ZYN (PMI/Swedish Match Pouch Leader)","v0":[9.8,9.7,9.6,9.5,6.8],"v1":[7.9,8.6,6.0,8.8,6.4],"v2":[8.8,9.2,8.2,8.4,9.9]}},"ch3":{"eyebrow":"CHAPTER 03 · U.S. MOIST SMOKELESS & ORAL BENCHMARKING","h2_zh":"三、全美湿鼻烟（MST）与口含巨擘横向对比：传统皇者 vs 价值捕手 vs 现代白袋","h2_en":"3. US Smokeless & Oral Matrix: Premium MST King vs. Value Dip & White Pouches","peers_zh":[{"category":"altria","benchmark":true,"title":"研究标的：Copenhagen 哥本哈根","creator":"USSTC (奥驰亚全资)","format":"超高端传统湿鼻烟 (~$7.78/罐均价 · 1.2 oz)","craft":"100%美产暗火熏烤烟叶 · Snuff/Long Cut/Packs","views":"9M'26 245.6M 罐 · 口含份额 12.6% (MST内 ~32.5%)","acclaim":"Classic Snuff 获批 FDA MRTP · 66.8% 分部OCI率","takeaway":"全集团单品利润率天花板，靠强悍提价权把 -10% 罐数波动转化为稳态十亿美元级现金流。","sourceLabel":"Q3'26 / FDA MRTP","sourceUrl":"https://www.fda.gov/news-events/press-announcements/fda-authorizes-copenhagen-classic-snuff-be-marketed-modified-risk-tobacco-product"},{"category":"altria","benchmark":false,"title":"Skoal · Red Seal · Husky (内部湿鼻烟阶梯)","creator":"USSTC (奥驰亚全资)","format":"高端调味 MST (Skoal) + 1.5oz 大罐价值线 (Red Seal)","craft":"冬青/水果湿鼻烟 + Red Seal 加量 25% 大罐","views":"9M'26 Skoal 84.5M 罐 + Other 48.2M 罐 (+1.3%)","acclaim":"合计稳占 7.0% 口含总份额 (MST内 ~18%)","takeaway":"与哥本哈根合围全美超 50% 传统湿鼻烟市场，Red Seal/Husky 正增长承接降级需求。","sourceLabel":"Altria Q3'26","sourceUrl":"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx"},{"category":"external","benchmark":false,"title":"Grizzly & Cougar (外部头号湿鼻烟对手)","creator":"American Snuff Co. / 英美烟草 (BAT)","format":"次高端冬青主力 (Grizzly) + 深折副牌 (Cougar)","craft":"重度美式冬青风味湿鼻烟 + 新推尼古丁袋延伸","views":"全美第 2 大湿鼻烟家族 · Grizzly 提价后推 Cougar 防守","acclaim":"冬青细分强悍 · 无 FDA MRTP 风险修正批文","takeaway":"复制了 PM USA“主牌提价+副牌 Cougar 承接”策略，但在原味 Snuff 与高端溢价上不及哥本哈根。","sourceLabel":"Tobacco Insider","sourceUrl":"https://tobaccoinsider.com/altria-q2-2026-results/"},{"category":"external","benchmark":false,"title":"Longhorn & General Snus","creator":"Swedish Match (菲莫国际 PMI)","format":"深折湿鼻烟 (Longhorn) + 瑞典蒸汽灭菌 Snus","craft":"美式低价长切丝 + 哥德堡巴氏杀菌冷藏唇烟","views":"Longhorn 主打低价走量 · General 获 FDA MRTP 但极小众","acclaim":"General Snus 虽有 MRTP 但在美市占不足 0.5%","takeaway":"证明仅有 FDA MRTP 不够，唯有像哥本哈根兼具 200 年美式口味基盘与 MRTP 才能变现。","sourceLabel":"FDA MRTP Ref","sourceUrl":"https://www.fda.gov/news-events/press-announcements/fda-authorizes-copenhagen-classic-snuff-be-marketed-modified-risk-tobacco-product"},{"category":"external","benchmark":false,"title":"ZYN 纯白尼古丁袋 (跨品类头号分流源)","creator":"Swedish Match / 菲莫国际 (PMI)","format":"无烟叶现代干法口含袋 (15袋/罐 · 3mg/6mg)","craft":"医药级尼古丁酒石酸盐 + 微晶纤维素白袋","views":"2026 预计美国出货 ~7.5亿罐 · 独占尼古丁袋 ~2/3","acclaim":"2025.01 获批 20 款 FDA PMTA","takeaway":"无需吐唾液的便捷性分流了大量白领与年轻用户，迫使奥驰亚用 on! PLUS 展开全面反击。","sourceLabel":"Tobacco Tactics","sourceUrl":"https://www.tobaccotactics.org/article/nicotine-pouches/"}],"peers_en":[{"category":"altria","benchmark":true,"title":"Subject: Copenhagen Flagship MST","creator":"USSTC (Altria 100%)","format":"Super-Premium Moist Snuff (~$7.78/can · 1.2 oz)","craft":"100% US Dark Fire-Cured leaf · Snuff/Long Cut/Packs","views":"245.6M cans in 9M'26 · 12.6% oral share (~32.5% of MST)","acclaim":"FDA MRTP authorized (Classic Snuff) · 66.8% Oral OCI","takeaway":"Highest-margin cash cow in US oral tobacco; $7.78/can pricing offsets secular shift to white pouches.","sourceLabel":"Q3'26 / FDA MRTP","sourceUrl":"https://www.fda.gov/news-events/press-announcements/fda-authorizes-copenhagen-classic-snuff-be-marketed-modified-risk-tobacco-product"},{"category":"altria","benchmark":false,"title":"Skoal · Red Seal · Husky (USSTC Ladder)","creator":"USSTC (Altria 100%)","format":"Flavored Premium MST + 1.5oz Value Can (Red Seal)","craft":"Wintergreen/fruit cuts + 25%-larger Red Seal tub","views":"9M'26: Skoal 84.5M + Other 48.2M cans (+1.3% YoY)","acclaim":"7.0% combined Q3 oral share (~18% of MST)","takeaway":"Together with Copenhagen, gives USSTC >50% of all traditional moist smokeless tobacco in America.","sourceLabel":"Altria Q3'26","sourceUrl":"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx"},{"category":"external","benchmark":false,"title":"Grizzly & Cougar (#2 US MST Franchise)","creator":"American Snuff Co. / BAT","format":"Sub-Premium Wintergreen Leader + Deep-Value Cougar","craft":"Bold American wintergreen MST + value flanker","views":"#2 US MST manufacturer; Cougar growing in discount dip","acclaim":"Strong wintergreen loyalty · No FDA MRTP order","takeaway":"Fierce wintergreen rival, but trails Copenhagen's $7.78/can natural/snuff pricing power.","sourceLabel":"Tobacco Insider","sourceUrl":"https://tobaccoinsider.com/altria-q2-2026-results/"},{"category":"external","benchmark":false,"title":"Longhorn & General Snus","creator":"Swedish Match (PMI)","format":"Deep-Discount MST (Longhorn) + Pasteurized Snus","craft":"Budget American MST + chilled Swedish snus","views":"Longhorn competes at value floor; General <0.5% US share","acclaim":"General Snus holds FDA MRTP but tiny US footprint","takeaway":"Shows FDA MRTP only scales when paired with an entrenched American flavor profile like Copenhagen.","sourceLabel":"FDA MRTP Ref","sourceUrl":"https://www.fda.gov/news-events/press-announcements/fda-authorizes-copenhagen-classic-snuff-be-marketed-modified-risk-tobacco-product"},{"category":"external","benchmark":false,"title":"ZYN Nicotine Pouches (Cross-Category Rival)","creator":"Swedish Match / PMI","format":"Spit-Free Tobacco-Leaf-Free White Pouches (15ct)","craft":"Nicotine bitartrate salt + plant-fiber pouch","views":"Drove pouches to 61.2% of US oral tobacco in Q3'26","acclaim":"20 SKUs FDA PMTA authorized Jan 2025","takeaway":"Primary structural headwind to MST volume, answered by Altria's Helix on! and on! PLUS.","sourceLabel":"Tobacco Tactics","sourceUrl":"https://www.tobaccotactics.org/article/nicotine-pouches/"}],"bars":{"title_zh":"2026Q3 全美口含烟（Oral Tobacco）大盘零售份额结构拆解（Circana 罐数口径 %）","title_en":"Q3 2026 US Oral Tobacco Category Retail Share Breakdown (% of Total Cans Sold)","sub_zh":"核验自奥驰亚 2026Q3 Table 7：现代尼古丁袋已占 61.2%，而奥驰亚在传统 MST（38.8%）中独占超半壁江山（19.6%/38.8% = 50.5%）","sub_en":"Verified via Altria Q3 2026 Table 7: Pouches reached 61.2% of oral, while USSTC holds >50% of the 38.8% MST segment","badge_zh":"USSTC 垄断全美 50.5% 湿鼻烟","badge_en":"USSTC Owns 50.5% of Traditional MST","leg1_zh":"蓝色/绿色：Copenhagen 及奥驰亚旗下口含烟品牌份额 (%)","leg1_en":"Blue / Green: Copenhagen & Altria Oral Brands (% of Total Oral)","leg2_zh":"紫色/琥珀：现代尼古丁袋与传统湿鼻烟赛道总盘参照 (%)","leg2_en":"Purple / Amber: Category Macro Split (Pouches vs. Total MST %)","max_x":68,"ref_line":25,"items_zh":[{"label":"全美现代尼古丁袋赛道总占比 (Nicotine Pouches)","val":61.2,"disp":"61.2%","sub":"同比大增 +5.8pp","note":"包含 ZYN、on! / on! PLUS、Velo、Rogue 等"},{"label":"全美传统湿鼻烟赛道总占比 (Traditional MST)","val":38.8,"disp":"38.8%","sub":"100% - 61.2% 刚性基盘","note":"USSTC 三线合计揽下其中 19.6% (过半垄断!)"},{"label":"奥驰亚口含烟分部全系总份额 (Q3 2026)","val":27.9,"disp":"27.9%","sub":"9M'26 为 28.6%","note":"Copenhagen + Skoal + on! + Red Seal/Husky"},{"label":"Copenhagen 哥本哈根单一品牌口含总份额","val":12.6,"disp":"12.6%","sub":"折合 MST 内部 ~32.5%","note":"全美湿鼻烟第一高端品牌与现金牛"},{"label":"on! / on! PLUS 现代尼古丁袋口含总份额","val":8.3,"disp":"8.3%","sub":"同比 +0.1pp (袋内占 13.5%)","note":"Q3 出货 4,780万罐 (+13.3% YoY)"},{"label":"Skoal + Red Seal / Husky 湿鼻烟组合份额","val":7.0,"disp":"7.0%","sub":"Skoal 4.8% + Other 2.2%","note":"调味与 1.5oz 大罐价值防线"}],"items_en":[{"label":"Total US Nicotine Pouch Category (% of Oral)","val":61.2,"disp":"61.2%","sub":"+5.8pp YoY expansion","note":"ZYN, on!/on! PLUS, Velo, Rogue, etc."},{"label":"Total US Traditional MST Segment (% of Oral)","val":38.8,"disp":"38.8%","sub":"Core moist snuff dipper pool","note":"USSTC holds 19.6% / 38.8% = 50.5% of MST!"},{"label":"Total Altria Oral Tobacco Share (Q3 2026)","val":27.9,"disp":"27.9%","sub":"28.6% in 9M 2026","note":"Copenhagen + Skoal + on! + Other MST"},{"label":"Copenhagen Single-Brand Share of Total Oral","val":12.6,"disp":"12.6%","sub":"~32.5% of Traditional MST","note":"#1 premium MST brand at $7.78/can"},{"label":"on! / on! PLUS Share of Total Oral (Q3 2026)","val":8.3,"disp":"8.3%","sub":"+0.1pp YoY (13.5% of Pouches)","note":"47.8M Q3 cans (+13.3% YoY)"},{"label":"Skoal (4.8%) + Red Seal/Husky (2.2%) Share","val":7.0,"disp":"7.0%","sub":"~18.0% of Traditional MST","note":"Flavored & value MST ladder"}]}},"ch4":{"eyebrow":"CHAPTER 04 · $7.78/CAN UNIT ECONOMICS & CONSOLIDATION SIMULATOR","h2_zh":"四、单罐经济学与现金流模拟：3.3 亿罐哥本哈根如何贡献超 $12 亿净营业利润？","h2_en":"4. Can Economics & Simulator: How ~330M Cans Deliver >$1.2B Annual OCI","sub_zh":"拆解 $7.78 终端价 → ~$4.80+ 出厂净营收 → ~$3.50+ 单罐调整后 OCI 的惊人印钞效率","sub_en":"Deconstructing $7.78 retail → ~$4.80+ net manufacturer realization → ~$3.50+ Adjusted OCI per can","badge_zh":"FY25 口含分部调整后 OCI $1,835M (67.9%)","badge_en":"FY25 Oral Adj. OCI $1,835M (67.9%)","econ_cards":[{"label_zh":"RETAIL CAN PRICE","label_en":"RETAIL CAN PRICE","val_zh":"$7.78 / 罐","val_en":"$7.78 / Can","desc_zh":"Q2 2026 披露终端均价，每年两次目录提价轻松覆盖双位数罐数迁移。","desc_en":"Disclosed $7.78/can Q2 2026 average retail price enables semi-annual list hikes to neutralize double-digit can volume drift."},{"label_zh":"EXCISE TAX RATE","label_en":"EXCISE TAX RATE","val_zh":"仅 3.05%","val_en":"Only 3.05%","desc_zh":"Q3'26 口含分部 $688M 营收仅扣 $21M 消费税，对比卷烟税负轻若鸿毛。","desc_en":"Just $21M excise tax on $688M Q3'26 Oral gross revenue (3.05% tax burden), a fraction of cigarette taxation."},{"label_zh":"SEGMENT ADJ. OCI","label_en":"SEGMENT ADJ. OCI","val_zh":"$1,835M (FY25)","val_en":"$1,835M (FY25)","desc_zh":"9M'26 实现 $1,339M 调整后 OCI，其中哥本哈根一牌估算贡献约 68%–72% 利润池。","desc_en":"Oral generated $1,835M Adjusted OCI in FY25 and $1,339M in 9M'26, with Copenhagen contributing an estimated ~68%–72%."},{"label_zh":"PLANT CONSOLIDATION","label_en":"PLANT CONSOLIDATION","val_zh":"$89M 集约重整","val_en":"$89M 9M Invest","desc_zh":"2026 USSTC 制造基地合并压缩固定制造费，为 2027–2030 锁定 >67% 利润率。","desc_en":"$89M 9M'26 USSTC plant consolidation investment permanently lowers fixed conversion cost per can for 2027–2030."}],"combo":{"title_zh":"奥驰亚口含烟分部（Copenhagen 主导）不含税净营收（$M）vs 调整后 OCI 利润率（%）","title_en":"Altria Oral Segment (Led by Copenhagen) Revenue Net of Excise ($M) vs. Adj. OCI Margin (%)","sub_zh":"2024–2026前9月年化：即便投入 on! PLUS 全国铺货推广费，分部调整后利润率仍傲视全球快消达 66.8%–67.9%","sub_en":"Even while funding nationwide on! PLUS launch promos, Oral Adjusted OCI margins held an extraordinary 66.8%–67.9%","badge_zh":"利润率超越可燃烟分部","badge_en":"Out-Margins Smokeable Segment","left_zh":"■ 左轴：口含不含税净营收 ($ 百万美元)","left_en":"■ Left Axis: Oral Rev Net of Excise ($M)","right_zh":"● 右轴：口含调整后 OCI 利润率 (%)","right_en":"● Right Axis: Oral Adjusted OCI Margin (%)","leg1_zh":"不含税净营收 (左轴 · $M)","leg1_en":"Rev Net of Excise (Left · $M)","leg2_zh":"调整后 OCI 利润率 (右轴 · %)","leg2_en":"Adjusted OCI Margin (Right · %)","line_badge_zh":"--- 65.0% 顶级奢侈品级利润率线","line_badge_en":"--- 65.0% Ultra-Margin Line","titles_zh":["2024全年","2025全年","2025前9月","2026前9月","2026Q3年化"],"titles_en":["FY 2024","FY 2025","9M 2025","9M 2026","Q3'26 Run-Rate"],"subs_zh":["OCI $1,811M","OCI $1,835M (+1.3%)","OCI $1,395M","OCI $1,339M (推新品)","Q3净营收+0.3%"],"subs_en":["OCI $1,811M","OCI $1,835M (+1.3%)","OCI $1,395M","OCI $1,339M","Q3 Rev +0.3%"],"bars":[2671,2704,2022,2004,2668],"line":[67.8,67.9,69.0,66.8,66.4],"max_bar":3100,"min_line":60,"max_line":73,"ref_line":65,"u_bar":"M","u_line":"%","highlight_idx":3},"sim":{"title_zh":"Copenhagen 多年期单罐提价 vs 销量迁移 & 工厂整合净利模拟器","title_en":"Copenhagen Multi-Year Can Pricing & Plant Consolidation OCI Simulator","toggle_title_zh":"开启年度 +8% 净提价 + USSTC 工厂整合降本 (+15% 累计 OCI 抬升)","toggle_title_en":"Enable +8%/yr Net Price Realization + USSTC Plant Consolidation (+15% Lift)","toggle_sub_zh":"模拟单罐提价跑赢 -9% 罐数自然迁移，并计入 2027 起工厂整合节省的制造折旧","toggle_sub_en":"Simulates per-can price hikes offsetting ~9%/yr pouch migration plus post-2026 plant savings","s1_label_zh":"首年出货罐数 (百万罐 · 2026年化≈328M罐)","s1_label_en":"Year-1 Cans Shipped (Million Cans · ~328M run-rate)","s1_unit_zh":"M 罐","s1_unit_en":"M Cans","s1_min":240,"s1_max":390,"s1_step":10,"s2_label_zh":"出厂单罐调整后 OCI 净利 (USD / 罐)","s2_label_en":"Net Manufacturer Adjusted OCI per Can (USD)","s2_unit_zh":"/罐","s2_unit_en":"/can","s2_min":2.8,"s2_max":4.6,"s2_step":0.1,"s3_label_zh":"USSTC 产线集约降本与 MRTP 转化增量 ($M / 年)","s3_label_en":"Annual USSTC Consolidation Savings & MRTP Lift ($M/yr)","s3_min":25,"s3_max":140,"s3_step":5,"roi_label_zh":"相对 $110M USSTC 工厂整合一次性投入回报倍数","roi_label_en":"Payback Multiple vs. ~$110M USSTC Consolidation Cost","cost_base_m":110,"mult":1.15,"vol_drift":0.915,"presets":{"p1":{"label_zh":"① 保守加速分流情景 (尼古丁袋冲至 72% 挤压 MST)","label_en":"① Stress Pouch-Cannibalization Case","tag_zh":"290M罐 · 5年","tag_en":"290M · 5 Yrs","views":290,"v_per_view":3.3,"ancillary_m":40,"years":5,"transmedia":false},"p2":{"label_zh":"② 核心现金牛基准情景 (328M罐 · 提价+工厂整合对冲)","label_en":"② Base Cash-Cow Harvest Case (328M Cans)","tag_zh":"328M罐 · 5年","tag_en":"328M · 5 Yrs","views":328,"v_per_view":3.7,"ancillary_m":75,"years":5,"transmedia":true},"p3":{"label_zh":"③ MRTP 烟民转化与强定价情景 (单罐OCI破 $4.1)","label_en":"③ Bull Pricing + MRTP Smoker Switch Case","tag_zh":"345M罐 · 7年","tag_en":"345M · 7 Yrs","views":345,"v_per_view":4.1,"ancillary_m":105,"years":7,"transmedia":true}}},"moat_pos_zh":"<strong>1. 67%+ 营业利润率现金机器：<\/strong>低税负与 $7.78/罐定价使每一罐哥本哈根产生的营业利润堪比一包万宝路。<br/><strong>2. 传统湿鼻烟格局高度稳固：<\/strong>新进入者绝无可能再去建暗火烤烟发酵仓与申请传统鼻烟 PMTA/MRTP。","moat_pos_en":"<strong>1. ~67%+ Margin Fortress:<\/strong> Minimal federal excise taxes and $7.78/can retail pricing generate cigarette-like profit per can.<br/><strong>2. Zero New Entrants in Traditional MST:<\/strong> Multi-year leaf aging and FDA barriers preclude any new MST competitors.","moat_risk_zh":"<strong>1. 现代尼古丁袋长期代际替代：<\/strong>21–34 岁新晋口含用户绝大多数直接选择免吐唾液的纯白袋（ZYN / on! PLUS），导致 MST 每年约 -9% 至 -11% 罐数自然缩减。<br/><strong>2. 2028 年 MRTP 五年到期续审：<\/strong>需持续高质量完成 FDA 上市后人群监测以确保 2028 年顺利续期。","moat_risk_en":"<strong>1. Secular Migration to Spit-Free White Pouches:<\/strong> Younger adult nicotine users overwhelmingly favor ZYN and on! PLUS, driving ~9%–11% annual MST can declines.<br/><strong>2. March 2028 MRTP Renewal:<\/strong> Requires ongoing postmarket surveillance compliance."},"ch5":{"eyebrow":"CHAPTER 05 · 204-YEAR HISTORY & REGULATORY LANDMARKS","h2_zh":"五、204 年传奇演进史：从 1822 匹兹堡鼻烟坊到 FDA 官方认证减害标杆","h2_en":"5. 204-Year Evolution: From 1822 Pittsburgh Snuff Mill to FDA MRTP Icon","sub_zh":"横跨两个世纪的美国工业活化石，如何在奥驰亚手中焕发超高利润与科学减害第二春","sub_en":"Tracing George Weyman's 1822 recipe through Altria's 2009 UST buyout and 2023 FDA MRTP victory","badge_zh":"1822 诞生 → 2009 并入奥驰亚 → 2023 MRTP → 2026 产线集约","badge_en":"1822 Est. → 2009 UST Deal → 2023 MRTP → 2026 Consolidation","acts":[{"title_zh":"第一阶段 · 1822 年乔治·韦曼创牌与百年美式湿鼻烟定型 (1822–2008)","title_en":"Act I · George Weyman's 1822 Snuff & USSTC Dominance (1822–2008)","badge_zh":"204年配方一脉相承","badge_en":"204-Year Heritage","desc_zh":"1822 年 George Weyman 在匹兹堡调配出 Copenhagen 湿鼻烟，1997 年推出 Long Cut 长切丝实现客群大扩容，奠定全美无烟烟草霸主地位。","desc_en":"Created by George Weyman in 1822 and expanded via Copenhagen Long Cut in 1997, establishing undisputed US smokeless leadership."},{"title_zh":"第二阶段 · 2009 年奥驰亚 $117 亿并购 UST 与利润率跃升 (2009–2022)","title_en":"Act II · 2009 Altria $11.7B UST Acquisition & Margin Expansion (2009–2022)","badge_zh":"OCI 率推升至 >67%","badge_en":"Scaled to >67% OCI Margin","desc_zh":"2009 年初奥驰亚完成收购 UST（USSTC 母公司），用 AGDC 零售重装赋能哥本哈根冬青、薄荷及 Packs 延伸线，将口含分部 OCI 利润率一路拉升至近 70%。","desc_en":"Acquired by Altria in 2009, Copenhagen expanded into Wintergreen, Mint, and Packs via AGDC, driving segment OCI margins toward 70%."},{"title_zh":"第三阶段 · 2023 FDA MRTP 历史性获批与 2026 精益整合 (2023–2026)","title_en":"Act III · 2023 FDA MRTP Landmark & 2026 Plant Consolidation (2023–2026)","badge_zh":"$7.78/罐定价护城河","badge_en":"$7.78/Can + Lean Footprint","desc_zh":"2023 年 3 月斩获 FDA 肺癌风险降低 MRTP 授权；2026 年在单罐均价达 $7.78 的同时启动 USSTC 工厂集约整合，构建与 Helix 尼古丁袋互补的双轨利润池 <a class=\"cite-link\" href=\"https://www.fda.gov/news-events/press-announcements/fda-authorizes-copenhagen-classic-snuff-be-marketed-modified-risk-tobacco-product\" target=\"_blank\" rel=\"noopener noreferrer\">FDA MRTP ↗<\/a>。","desc_en":"Secured FDA lung-cancer MRTP authorization in March 2023 and launched 2026 USSTC plant consolidation to sustain ~67% margins <a class=\"cite-link\" href=\"https://www.fda.gov/news-events/press-announcements/fda-authorizes-copenhagen-classic-snuff-be-marketed-modified-risk-tobacco-product\" target=\"_blank\" rel=\"noopener noreferrer\">FDA MRTP ↗<\/a>."}],"battles":[{"tag_zh":"战役 01 · 2023-03-16","tag_en":"Case 01 · Mar 16, 2023","sub_zh":"FDA 最高科学认证","sub_en":"FDA MRTP Granted","title_zh":"历时多年攻克 FDA 改良风险（MRTP）肺癌减害批文","title_en":"Winning FDA's Lung-Cancer Modified Risk Order","desc_zh":"FDA 主任 Brian King 公开确认科学证据支持“成年烟民完全改用 Copenhagen Classic Snuff 可降低肺癌风险” <a class=\"cite-link\" href=\"https://www.fda.gov/news-events/press-announcements/fda-authorizes-copenhagen-classic-snuff-be-marketed-modified-risk-tobacco-product\" target=\"_blank\" rel=\"noopener noreferrer\">FDA Announcement ↗<\/a>。","desc_en":"FDA CTP confirmed epidemiological evidence that switching completely from cigarettes to Classic Snuff reduces lung-cancer risk <a class=\"cite-link\" href=\"https://www.fda.gov/news-events/press-announcements/fda-authorizes-copenhagen-classic-snuff-be-marketed-modified-risk-tobacco-product\" target=\"_blank\" rel=\"noopener noreferrer\">FDA Announcement ↗<\/a>."},{"tag_zh":"战役 02 · 2025–2026","tag_en":"Case 02 · 2025–2026","sub_zh":"以价补量教科书","sub_en":"Price-Over-Volume","title_zh":"$7.78/罐高单价对冲尼古丁袋跨品类分流","title_en":"$7.78/Can Realization Stabilizes Oral Segment Revenue","desc_zh":"在罐数同比 -10.1%（Q3'26）背景下，凭借强劲净提价助力口含不含税净营收实现 +0.3% 正增长 <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Q3'26 Table 5 ↗<\/a>。","desc_en":"Strong price realization kept Q3 2026 Oral revenue net of excise positive (+0.3%) despite -10.1% Copenhagen cans <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Q3'26 Table 5 ↗<\/a>."},{"tag_zh":"战役 03 · 2026Q2–Q3","tag_en":"Case 03 · 2026 Ops","sub_zh":"产能精益重塑","sub_en":"Footprint Optimization","title_zh":"果断推进 USSTC 制造基地整合锁死单位成本","title_en":"USSTC Facilities Consolidation Preempts Deleveraging","desc_zh":"前瞻性合并湿鼻烟产线（9M 计提 $89M 重整投入），防止未来罐数自然回落推高单罐固定折旧 <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Q3'26 Release ↗<\/a>。","desc_en":"Proactively consolidating USSTC plants ($89M 9M'26 restructuring) protects per-can manufacturing margins <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Q3'26 Release ↗<\/a>."},{"tag_zh":"战役 04 · 渠道绑定","tag_en":"Case 04 · Retail Lock","sub_zh":"1.74亿次便利店客流","sub_en":"174M C-Store Trips","title_zh":"以哥本哈根货架霸权为 on! PLUS 铺路开道","title_en":"Using USSTC Oral Shelf Authority to Scale on! PLUS","desc_zh":"USSTC 在全美口含烟背柜超 50% 的传统份额权重，直接帮助同门兄弟 on! PLUS 在半年内快速进驻 12 万家门店 <a class=\"cite-link\" href=\"https://www.sec.gov/Archives/edgar/data/764180/000076418026000093/exhibit991erq22026.htm\" target=\"_blank\" rel=\"noopener noreferrer\">Q2'26 EX-99.1 ↗<\/a>。","desc_en":"USSTC's >50% traditional MST authority accelerated sibling on! PLUS across 120,000 retail doors <a class=\"cite-link\" href=\"https://www.sec.gov/Archives/edgar/data/764180/000076418026000093/exhibit991erq22026.htm\" target=\"_blank\" rel=\"noopener noreferrer\">Q2'26 EX-99.1 ↗<\/a>."}],"laws":[{"zh":"当新形态（纯白尼古丁袋）冲击老形态时，传统龙头切忌降价肉搏，而应果断提价收割铁杆死忠并精简产线。","en":"When a new format disrupts a legacy category, the heritage leader must harvest price among sticky loyalists and consolidate plants rather than slash prices."},{"zh":"按重量计征的极低从量消费税（~3%）是美股口含烟能够跑出近 68% 营业利润率的制度基石。","en":"Weight-based federal smokeless excise (~3% of revenue) is the structural secret behind ~68% oral operating margins."},{"zh":"用哥本哈根的高额现金流全额输血 on! PLUS 的研发与渠道试饮，完成奥驰亚口含烟内部新老交接。","en":"Recycle Copenhagen's massive cash flow directly into on! PLUS customer acquisition to own both halves of oral tobacco."}]},"ch6":{"h2_zh":"六、“哥本哈根利润皇冠法则”高端湿鼻烟核查清单","h2_en":"6. 'Copenhagen Profit Crown Law' Premium MST Checklist","items_zh":[{"tag":"~32.5% MST份额","title":"1. 传统湿鼻烟内部王座测试：剔除尼古丁袋分母后，在 MST 池内份额是否稳超 32%？","desc":"2026Q3 实算 12.6% / 38.8% = 32.5%，确认并未输给 Grizzly 等传统对手。"},{"tag":"$7.78+ 单罐均价","title":"2. 提价传导弹性测试：每年两次目录提价能否覆盖 -9% 至 -11% 的罐数迁移？","desc":"核查每季口含烟分部不含税净营收是否维持在 ~$665M–$700M 稳态平台。"},{"tag":"≥ 66.0% 分部OCI率","title":"3. 超高营业利润率守卫测试：USSTC 工厂整合后口含调整后 OCI 率是否稳居 >66%？","desc":"验证 2026 年 $89M 产线整合在 2027–2028 年的单位降本兑现度。"},{"tag":"2028 MRTP 续期","title":"4. FDA MRTP 合规续展测试：上市后年度人群监测数据是否支持 2028.03 顺利续期？","desc":"确保未发生青少年误用上升或超范围营销警告信。"},{"tag":"零商誉减值风险","title":"5. 商标账面健康度测试：不同于曾减值的 Skoal，Copenhagen 商标净现值缓冲垫是否充裕？","desc":"高单价与 ~3.3亿罐体量提供极厚现金流安全垫。"},{"tag":"口含货架协同","title":"6. 渠道联合陈列测试：AGDC 是否持续利用哥本哈根排面拉动 on! PLUS 黄金位上架？","desc":"核验便利店口含烟展示柜（Oral Fixture）整体坪效。"}],"items_en":[{"tag":"~32.5% of MST","title":"1. Intra-MST Leadership Test: Does Copenhagen hold >32% share within traditional moist snuff?","desc":"Q3 2026 math: 12.6% oral share ÷ 38.8% MST mix = 32.5% segment leadership."},{"tag":"$7.78+ Retail Can","title":"2. Price-Over-Volume Test: Do semi-annual list hikes offset ~10% pouch migration?","desc":"Monitor quarterly Oral revenue net of excise (~$667M in Q3'26, +0.3% YoY)."},{"tag":"≥ 66% Adj. OCI","title":"3. Ultra-Margin Defense Test: Does USSTC plant consolidation sustain ≥66% Oral OCI margins?","desc":"Track fixed-cost savings following the 2026 facilities consolidation."},{"tag":"2028 MRTP Renewal","title":"4. FDA MRTP Renewal Test: Are annual postmarket surveillance filings on track for March 2028?","desc":"Ensure strict adherence to FDA's lung-cancer risk-modification order."},{"tag":"Zero Trademark Impairment","title":"5. Intangible Headroom Test: Does Copenhagen maintain wide fair-value cushion unlike Skoal?","desc":"~330M high-margin cans provide massive DCF coverage."},{"tag":"Oral Fixture Synergy","title":"6. Shelf Co-Merchandising Test: Is USSTC's backbar clout expanding on! PLUS facings?","desc":"Verify combined oral fixture productivity across convenience chains."}]},"sources":[{"label":"FDA Official News Release (Mar 16, 2023): FDA Authorizes Copenhagen Classic Snuff as a Modified Risk Tobacco Product","url":"https://www.fda.gov/news-events/press-announcements/fda-authorizes-copenhagen-classic-snuff-be-marketed-modified-risk-tobacco-product"},{"label":"Altria Q3 & 9M 2026 Official Release (Tables 5, 6 & 7: Copenhagen 245.6M 9M Cans, 12.6% Share, 66.8% Oral Margin)","url":"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx"},{"label":"SEC Form 8-K Exhibit 99.1 — Altria FY2025 Results (362.8M Copenhagen Cans, $1,835M Oral Adj. OCI, 67.9% Margin)","url":"https://www.sec.gov/Archives/edgar/data/764180/000076418026000007/exhibit991erq42025.htm"},{"label":"SEC Form 8-K Exhibit 99.1 — Altria Q2 2026 Results (USSTC Facilities Consolidation & 85.4M Q2 Cans)","url":"https://www.sec.gov/Archives/edgar/data/764180/000076418026000093/exhibit991erq22026.htm"},{"label":"Tobacco Insider: Altria Q2 2026 Oral Tobacco Analysis (Copenhagen $7.78/can Average Retail Price)","url":"https://tobaccoinsider.com/altria-q2-2026-results/"},{"label":"2Firsts NACS Show 2026 Report (174 Million Annual USSTC Convenience-Store Shopping Trips)","url":"https://www.2firsts.com/news/altria-showcases-ploom-marlboro-heated-tobacco-sticks-and-non-nicotine-energy-products-at-nacs-show-2026"}],"quickJumpZh":[{"sec":"sec-00","title":"00 单品定评与超高毛利成绩单","sub":"FDA MRTP减害 · $7.78/罐 · 66.8%–67.9%分部OCI率"},{"sec":"sec-01","title":"01 明火熏烤发酵工艺与 MRTP 授权","sub":"暗火烤烟切丝矩阵 · 3.05%超低消费税 · 工厂整合"},{"sec":"sec-02","title":"02 四大溢价支柱与五维护城河雷达","sub":"204年文化信仰 · 真烟叶感官 · 法定减害声称"},{"sec":"sec-03","title":"03 全美传统湿鼻烟与现代口含对比","sub":"对比 Grizzly、Cougar、General Snus 与 ZYN"},{"sec":"sec-04","title":"04 $7.78/罐单品经济学与产能整合模拟","sub":"单罐~$3.7净利推演与 USSTC 整合降本模型"},{"sec":"sec-05","title":"05 204 年品牌史与无烟转型定位","sub":"1822匹兹堡起源 → 2009并购 → 2023 MRTP里程碑"},{"sec":"sec-06","title":"06 高端湿鼻烟现金牛核查清单","sub":"6项MST内部份额、利润率与2028续期核查"},{"sec":"sec-07","title":"07 FDA 官方批文与 SEC 信源索引","sub":"FDA MRTP 原文与季报年报直达"}],"quickJumpEn":[{"sec":"sec-00","title":"00 Product Verdict & Margin Scorecard","sub":"FDA MRTP claim · $7.78/can · 66.8%–67.9% Oral OCI"},{"sec":"sec-01","title":"01 Fire-Cured Craft & FDA MRTP Claim","sub":"Dark-fired cuts, 3% excise burden & 2026 consolidation"},{"sec":"sec-02","title":"02 4 Premium Pillars & Oral Moat Radar","sub":"1822 heritage, leaf ritual & statutory MRTP edge"},{"sec":"sec-03","title":"03 US MST & Oral Nicotine Matrix","sub":"Copenhagen vs. Grizzly, Cougar, General Snus & ZYN"},{"sec":"sec-04","title":"04 $7.78/Can Economics & Consolidation Sim","sub":"Per-can OCI math & plant consolidation payback"},{"sec":"sec-05","title":"05 204-Year History & Smoke-Free Bridge","sub":"1822 snuff mill to 2023 FDA MRTP landmark"},{"sec":"sec-06","title":"06 Premium MST Cash-Cow Checklist","sub":"6-point intra-MST share and margin checklist"},{"sec":"sec-07","title":"07 FDA MRTP Order & SEC Sources","sub":"Direct links to FDA CTP and SEC filings"}]},{"id":"skoal_value_mst","idx_num":6,"idx_pad":"06","filename":"mo_prod_06_skoal_redseal_husky.html","checkKey":"mui_mo_checks_skoal_mst","monogram":"SK","short_zh":"Skoal·Red Seal·Husky","short_en":"Skoal · Red Seal · Husky","pill_kpi":"7.0%口含份额 · Other+1.3%","docTitleZh":"《Skoal · Red Seal · Husky 调味与价值湿鼻烟阶梯》深度商业研报（USSTC）| 王安安数据中心","docTitleEn":"Skoal, Red Seal & Husky Flavored and Value MST Ladder Monograph (USSTC) | Research Hub","crumb_zh":"Skoal · Red Seal · Husky 调味与大罐价值湿鼻烟矩阵（USSTC）","crumb_en":"Skoal · Red Seal · Husky Flavored & Value MST Matrix (USSTC)","chip1_zh":"9M'26 合计出货 1.327亿罐","chip1_en":"132.7M Combined 9M'26 Cans","chip2_zh":"Red Seal/Husky 逆势 +1.3% 增长","chip2_en":"Red Seal/Husky +1.3% in 9M'26","sidebar":{"badge":"USSTC · FLAVORED & VALUE MST LADDER","title_zh":"Skoal 与价值鼻烟研报","title_en":"Skoal & Value MST Monograph","sub_zh":"1934 现代冬青湿鼻烟鼻祖 Skoal (9M 8,450万罐) × 1.5oz 加量 25% 大罐王牌 Red Seal 与深折 Husky (9M 4,820万罐 +1.3%)","sub_en":"1934 wintergreen pioneer Skoal (84.5M 9M cans) × 25%-larger Red Seal 1.5oz tub & value Husky (48.2M cans, +1.3%)","mini_kpis":[{"label_zh":"Skoal 9M'26 出货 / 份额","label_en":"Skoal 9M Vol / Q3 Share","val_zh":"84.5M罐 / 4.8%","val_en":"84.5M / 4.8%"},{"label_zh":"Other(Red Seal/Husky) 9M","label_en":"Other MST 9M Vol","val_zh":"48.2M罐 (+1.3%)","val_en":"48.2M (+1.3%)"},{"label_zh":"合计占传统 MST 内部份额","label_en":"Combined Share of MST","val_zh":"~18.0% (护翼防线)","val_en":"~18.0% of MST"}]},"toc":[["单品定评与高低阶梯成绩单","Product Verdict & Tier Scorecard"],["调味鼻烟工艺与 1.5oz 大罐卡位","Flavored MST & 1.5oz Big-Can Craft"],["四大梯队防御支柱与五维雷达","4 Ladder Pillars & MST Radar"],["全美中端调味与价值湿鼻烟对比","US Flavored & Value MST Matrix"],["商标减值后轻装现金流推演模拟","Post-Impairment Cashflow Simulator"],["1934 冬青革命至双层价值防守史","1934 Wintergreen Pioneer to Value Shield"],["湿鼻烟价格阶梯护城河核查清单","MST Price-Ladder Moat Checklist"],["SEC 财报与行业核验信源索引","SEC Filings & Primary Sources"]],"hero":{"strip1_zh":"单品定评：USSTC 守护哥本哈根侧翼的“黄金盾牌”——Skoal 收割高毛利果味/冬青存量，Red Seal & Husky 以 +1.3% 正增长拦截价值降级","strip1_en":"Verdict: USSTC's essential flanker shield—Skoal harvests flavored premium margin while Red Seal & Husky grow +1.3% capturing value dippers","strip2_zh":"品牌梯队：Skoal (1934 高端风味) → Red Seal (1.5oz 加量 25% 价值罐) → Husky (深折防守)","strip2_en":"Brand Ladder: Skoal (Flavored Premium) → Red Seal (1.5oz +25% Big Can) → Husky (Deep Value)","strip3_zh":"数据基准：2026Q3 季报核验 (2026-10-29)","strip3_en":"Baseline: Q3 2026 Release (Oct 29, 2026)","overline_zh":"ORAL LADDER 06 · FY25 合计出货 1.918亿罐 × 9M'26 合计 1.327亿罐 × Other(Red Seal/Husky) 逆势增长 +1.3%","overline_en":"ORAL LADDER 06 · 191.8M Combined FY25 Cans × 132.7M 9M'26 Cans × +1.3% 9M Growth in Red Seal / Husky","h1_zh":"Skoal · Red Seal · Husky 湿鼻烟阶梯深度剖析：<span class=\"gradient-accent\">夹在 $7.78 哥本哈根与纯白尼古丁袋之间，三层梯度如何锁住年化 ~1.77 亿罐高净利底盘？<\/span>","h1_en":"Skoal · Red Seal · Husky Deep Dive: <span class=\"gradient-accent\">How USSTC's Three-Tier Flavored and 1.5oz Big-Can Ladder Retains ~177M Annualized Cans<\/span>","lead_zh":"如果说 Copenhagen 是美式原味湿鼻烟的皇冠，那么 <strong>Skoal（1934 年问世的全球首款冬青调味湿鼻烟与 1983 年首款袋装湿鼻烟 Bandits 开创者）<\/strong> 加上纳入财报“Other”口径的 <strong>Red Seal（红印）与 Husky（哈士奇）<\/strong>，则构成了 USSTC 不可或缺的风味与价格纵深防线。虽然果味/薄荷年轻客群加速迁往纯白尼古丁袋令 Skoal 2026 前9月出货同比回落 12.5% 至 <strong>8,450 万罐<\/strong>（2024 年公司曾审慎计提 Skoal 商标非现金减值以出清历史包袱）<a class=\"cite-link\" href=\"https://www.sec.gov/Archives/edgar/data/764180/000076418026000007/exhibit991erq42025.htm\" target=\"_blank\" rel=\"noopener noreferrer\">FY25 EX-99.1 p.5 ↗<\/a>，但主打<strong>“1.5 盎司每罐多装 25%”的 Red Seal 与深折尖刀 Husky<\/strong> 在高通胀周期大放异彩：2025Q4 出货逆势增长 <strong>+2.5%<\/strong>、2026H1 增长 <strong>+2.9%<\/strong>、2026 前9月累计增长 <strong>+1.3%<\/strong> 达 <strong>4,820 万罐<\/strong>，稳稳守住 <strong>2.2%<\/strong> 口含大盘份额（与 Skoal 的 <strong>4.8%<\/strong> 合计占传统湿鼻烟池约 <strong>18.0%<\/strong>）<a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Altria Q3'26 Table 6 & 7 ↗<\/a>。","lead_en":"Complementing Copenhagen in USSTC's portfolio are <strong>Skoal<\/strong> (pioneer of wintergreen MST in 1934 and portioned MST Bandits pouches in 1983) and value duo <strong>Red Seal and Husky<\/strong> ('Other' oral reporting line). While migration of flavored dippers into white pouches reduced Skoal's 9M 2026 shipments -12.5% to <strong>84.5M cans<\/strong> (following FY2024's non-cash Skoal trademark write-down) <a class=\"cite-link\" href=\"https://www.sec.gov/Archives/edgar/data/764180/000076418026000007/exhibit991erq42025.htm\" target=\"_blank\" rel=\"noopener noreferrer\">FY25 EX-99.1 p.5 ↗<\/a>, <strong>Red Seal (25%-larger 1.5oz big can) and deep-value Husky<\/strong> achieved counter-cyclical volume growth: <strong>+2.5% in Q4 2025, +2.9% in 1H 2026, and +1.3% in 9M 2026 (48.2M cans)<\/strong>, holding a rock-steady <strong>2.2%<\/strong> oral share alongside Skoal's <strong>4.8%<\/strong> (~18.0% of traditional MST) <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Altria Q3'26 Table 6 & 7 ↗<\/a>.","thesis_cards":[{"title_zh":"Skoal 独占水果/浆果/桃子湿鼻烟利基高毛利池","title_en":"Skoal's Monopoly in Fruit/Berry/Peach & Bandits MST","desc_zh":"Peach、Apple、Cherry、Citrus、Berry 等独特果香发酵真烟叶配方在 FDA 2009 基准日（Grandfathered/SE）保护下几乎没有同级新竞品。","desc_en":"Skoal's Peach, Apple, Cherry, Citrus, and Berry real-leaf MST SKUs enjoy 2009 grandfather/SE protection with virtually zero newly authorized rivals."},{"title_zh":"Red Seal “1.5 oz 加量 25% 大罐”错位性价比绝杀","title_en":"Red Seal's 1.5 oz (+25% Larger Can) Value Proposition","desc_zh":"全美标准湿鼻烟均为 1.2 oz/罐，Red Seal 独创 1.5 oz 加大塑料罐（每 4 罐等于竞品 5 罐烟叶量），对重度老用户具备极强算账吸引力。","desc_en":"Red Seal's unique 1.5 oz oversized can (+25% more tobacco than standard 1.2 oz cans: 4 cans = 5 rival cans) wins value-conscious heavy dippers."},{"title_zh":"Husky 镇守 ~$3.50–$4.20 地板价正面拦截 Cougar / Longhorn","title_en":"Husky Anchors Deep-Value MST Against Cougar & Longhorn","desc_zh":"类似卷烟端 Basic 的角色，Husky 在价格战州精准阻击雷诺旗下 Cougar 与瑞典火柴 Longhorn，避免哥本哈根被动降价。","desc_en":"Husky defends deep-value MST price floors against Reynolds' Cougar and Swedish Match's Longhorn without discounting flagship Copenhagen."}],"kpis":[{"label_zh":"三品牌 2025全年合计罐数","label_en":"Combined FY25 Volume","badge_zh":"Skoal 127.9M + Other 63.9M","badge_en":"26.2% of MO Oral Cans","val_zh":"191.8M 罐","val_en":"191.8M Cans","desc_zh":"接近 2 亿罐年体量，比大多数独立烟草上市公司全系产品规模还要庞大 <a class=\"cite-link\" href=\"https://www.sec.gov/Archives/edgar/data/764180/000076418026000007/exhibit991erq42025.htm\" target=\"_blank\" rel=\"noopener noreferrer\">FY25 Table 6 ↗<\/a>","desc_en":"Combined Skoal (127.9M) + Other (63.9M) shipped 191.8M cans in FY2025—larger than most standalone tobacco companies <a class=\"cite-link\" href=\"https://www.sec.gov/Archives/edgar/data/764180/000076418026000007/exhibit991erq42025.htm\" target=\"_blank\" rel=\"noopener noreferrer\">FY25 Table 6 ↗<\/a>"},{"label_zh":"Other(Red Seal/Husky) 增速","label_en":"Other MST 9M'26 Growth","badge_zh":"传统鼻烟罕见正增长!","badge_en":"Counter-Trend MST Gain!","val_zh":"+1.3% (48.2M)","val_en":"+1.3% (48.2M)","desc_zh":"2026H1 同比 +2.9%（32.3M 罐），前9月累计 48.2M 罐（vs 47.6M），逆行业下行正增长 <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Q3'26 Table 6 ↗<\/a>","desc_en":"Other MST (Red Seal + Husky) grew +2.9% in 1H'26 (32.3M cans) and +1.3% in 9M'26 (48.2M vs. 47.6M), bucking MST category declines <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Q3'26 Table 6 ↗<\/a>"},{"label_zh":"合计口含大盘零售份额 (Q3)","label_en":"Combined Q3 Oral Share","badge_zh":"传统MST内占 ~18%","badge_en":"~18% of Traditional MST","val_zh":"7.0%","val_en":"7.0%","desc_zh":"Skoal 4.8% + Other 2.2%，与哥本哈根（12.6%）合筑 USSTC 50.5% 传统湿鼻烟半壁江山 <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Q3'26 Table 7 ↗<\/a>","desc_en":"Skoal (4.8%) + Other (2.2%) hold 7.0% total oral share; paired with Copenhagen (12.6%), USSTC commands >50% of US traditional MST <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Q3'26 Table 7 ↗<\/a>"},{"label_zh":"Red Seal 单罐差异化净重","label_en":"Red Seal Can Net Weight","badge_zh":"比标准罐多装 25%","badge_en":"+25% More Leaf / Can","val_zh":"1.50 oz / 罐","val_en":"1.50 oz / Can","desc_zh":"对比行业标准 1.20 oz 铁盖罐，以物理容量优势在不打烂单罐标价前提下让渡实惠 <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Table 6 Note ↗<\/a>","desc_en":"Red Seal packs 1.50 oz net weight vs. 1.20 oz industry cans—delivering 25% extra leaf value without slashing shelf ticket prices <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Table 6 Note ↗<\/a>"}]},"ch1":{"eyebrow":"CHAPTER 01 · THREE-TIER MST PORTFOLIO & VOLUME-VALUE MECHANICS","h2_zh":"一、三层阶梯架构解析：Skoal 守溢价、Red Seal 拼容量、Husky 堵底盘","h2_en":"1. Three-Tier MST Architecture: Skoal Flavor Craft, Red Seal 1.5oz Capacity & Husky Floor","sub_zh":"FDA SE 实质等同存量风味准入壁垒 × 1.5oz 大容量包装心理学 × 共享 USSTC 整合产线","sub_en":"Grandfathered/SE fruit-flavor moat × 1.5oz big-can value math × shared USSTC fermentation plants","badge_zh":"全谱系覆盖 $3.80–$7.50 价格带","badge_en":"Covers Full $3.80–$7.50 MST Spectrum","hub_title_zh":"USSTC 侧翼三级阶梯（向下拦截消费降级 ↔ 向上拱卫哥本哈根 $7.78 超高价盘）","hub_title_en":"USSTC Three-Step MST Ladder (Capturing Down-Traders ↔ Insulating $7.78 Copenhagen)","hub_sub_zh":"复用 USSTC 暗火烤烟采购与 2026 整合后的现代化灌装工厂 · 零新增研发负担纯收割现金流","hub_sub_en":"Leverages USSTC's consolidated leaf procurement and canning lines with zero incremental R&D drag","nodes":[{"tag_zh":"CLASSIC FLAVORED · 冬青薄荷主线","tag_en":"SKOAL CLASSIC · WINTERGREEN/MINT","name_zh":"Skoal Classic Long Cut & Fine Cut","name_en":"Skoal Classic Wintergreen / Mint","desc_zh":"1934 年开创冬青湿鼻烟先河，定价紧贴哥本哈根（~$6.80–$7.50/罐），贡献极高单罐毛利。","desc_en":"Pioneered wintergreen moist snuff in 1934; priced just below Copenhagen (~$6.80–$7.50/can) to harvest rich unit margins."},{"tag_zh":"FRUIT BLENDS · 独占果香矩阵","tag_en":"SKOAL FRUIT · GRANDFATHERED","name_zh":"Peach · Apple · Cherry · Citrus · Berry","name_en":"Skoal Peach / Apple / Berry / Citrus","desc_zh":"受 2009 烟草控制法保护的存量果味湿鼻烟 SKU，新品牌几乎无法再获批果味 MST PMTA。","desc_en":"Pre-2009 grandfathered fruit-blend MST SKUs protected by insurmountable FDA PMTA barriers against new flavored leaf entrants."},{"tag_zh":"PORTION PIONEER · 袋装鼻烟始祖","tag_en":"SKOAL BANDITS & POUCHES","name_zh":"Skoal Pouches & Bandits (1983首创)","name_en":"Skoal Moist Pouches & X-TRA","desc_zh":"早在纯白尼古丁袋诞生前四十年即普及定袋口含习惯，X-TRA 系列提供更高劲道满足感。","desc_en":"Introduced pre-portioned Bandits pouches decades before modern white pouches, plus higher-kick Skoal X-TRA variants."},{"tag_zh":"BIG CAN VALUE · 加量 25% 奇兵","tag_en":"RED SEAL · 1.5 OZ (+25% MORE)","name_zh":"Red Seal Long Cut / Fine Cut (1.5 oz)","name_en":"Red Seal 1.5 oz Big Can","desc_zh":"奥驰亚财报附注特别说明“不同包装容量按 1 罐折算”的核心主角——每罐比 1.2oz 多出整整 1/4 烟丝。","desc_en":"Altria earnings footnotes specifically highlight non-standard can weights—Red Seal delivers 25% more moist snuff per can."},{"tag_zh":"DEEP DISCOUNT MST · 底线肉搏","tag_en":"HUSKY · DEEP-VALUE SHIELD","name_zh":"Husky Fine Cut / Long Cut / Mint","name_en":"Husky Value Moist Snuff","desc_zh":"正面迎战 American Snuff 旗下爆发的 Cougar 与瑞典火柴 Longhorn，守住便利店底层排面。","desc_en":"Directly intercepts fast-growing deep-discount Cougar (Reynolds) and Longhorn (PMI/Swedish Match) on lower c-store racks."},{"tag_zh":"CLEAN BALANCE SHEET · 减值出清","tag_en":"2024 IMPAIRMENT RESET","name_zh":"FY2024 Skoal 商标账面出清完毕","name_en":"FY2024 Non-Cash Trademark Reset","desc_zh":"2024 年已完成 Skoal 商标非现金减值重估（含在 $422M 项下），2025–2026 轻装上阵零减值包袱。","desc_en":"FY2024 absorbed a non-cash Skoal trademark write-down (within $422M special items), leaving 2025–2026 balance sheets clean."}],"platform_bars":[{"title_zh":"2009 基准日（Pre-2007 Grandfathered / SE）法规冻结红利","title_en":"FDA Substantial Equivalence (SE) Flavor Barrier","sub_zh":"FDA 对新申请果味烟草制品审查极严，而 Skoal 数十年前即上市的 Peach/Apple/Berry 享有合法存量护城河。","sub_en":"Strict FDA barriers against new flavored tobacco protect Skoal's decades-old Peach, Apple, Berry, and Citrus MST shelf franchise."},{"title_zh":"通胀期“大罐划算学”助推 Other 口径连续三季跑赢大盘","title_en":"Inflationary 'Ounce-for-Dollar' Math Propels Red Seal & Husky","sub_zh":"重度日均消耗 1 罐的用户换成 1.5oz Red Seal 相当于立省 20%+ 单位克重支出，驱动 9M'26 +1.3% 逆势增长。","sub_en":"Can-a-day dippers save >20% per ounce switching to 1.5 oz Red Seal, fueling +1.3% 9M'26 shipment growth in Altria's Other bucket."}],"principles":[{"title_zh":"1. Skoal 放弃低效冲量、彻底转向高单价利润收割","title_en":"1. Skoal Prioritizes Margin Harvest Over Chasing Pouch Switchers","desc_zh":"面对轻度果味用户自然流向 on! / ZYN，USSTC 不在 Skoal 上浪费无谓折扣补贴，而是跟随哥本哈根同步提价，最大化存量 1.1亿+ 年化罐数的现金回报 <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Q3'26 Table 6 ↗<\/a>。","desc_en":"Rather than wasting margin on promos to chase light users migrating to pouches, USSTC raises Skoal list prices alongside Copenhagen to harvest >110M annualized cans <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Q3'26 Table 6 ↗<\/a>."},{"title_zh":"2. Red Seal + Husky 精准复刻卷烟 Basic 侧翼奇迹","title_en":"2. Red Seal & Husky Mirror Basic's Counter-Cyclical Playbook","desc_zh":"当全美传统 MST 行业整体萎缩 ~8%–10% 时，奥驰亚 Other 口径（Red Seal + Husky）在 2025Q4（<strong>+2.5%<\/strong>）、2026H1（<strong>+2.9%<\/strong>）与 2026前9月（<strong>+1.3%<\/strong>）实现罕见正增长 <a class=\"cite-link\" href=\"https://www.sec.gov/Archives/edgar/data/764180/000076418026000093/exhibit991erq22026.htm\" target=\"_blank\" rel=\"noopener noreferrer\">Q2 & Q3 Table 6 ↗<\/a>。","desc_en":"While US traditional MST shrinks ~8%–10%/yr, Altria's Other bucket (Red Seal + Husky) posted positive growth in Q4'25 (<strong>+2.5%<\/strong>), 1H'26 (<strong>+2.9%<\/strong>), and 9M'26 (<strong>+1.3%<\/strong>) <a class=\"cite-link\" href=\"https://www.sec.gov/Archives/edgar/data/764180/000076418026000093/exhibit991erq22026.htm\" target=\"_blank\" rel=\"noopener noreferrer\">Q2 & Q3 Table 6 ↗<\/a>."},{"title_zh":"3. 2024 商标减值出清后财务报表更加干净透明","title_en":"3. Clean Post-2024 Balance Sheet After Non-Cash Skoal Write-Down","desc_zh":"FY2024 财报已一次性消化 Skoal 无形资产非现金减值（驱动 FY2025 口含报告 OCI 同比跳增 <strong>+26.2%<\/strong> 至 $1,828M），消除了后续商誉爆雷隐患 <a class=\"cite-link\" href=\"https://www.sec.gov/Archives/edgar/data/764180/000076418026000007/exhibit991erq42025.htm\" target=\"_blank\" rel=\"noopener noreferrer\">FY25 Table 5 ↗<\/a>。","desc_en":"Completing Skoal's non-cash trademark reset in FY2024 drove FY2025 reported Oral OCI up <strong>+26.2%<\/strong> to $1,828M and removed future impairment overhang <a class=\"cite-link\" href=\"https://www.sec.gov/Archives/edgar/data/764180/000076418026000007/exhibit991erq42025.htm\" target=\"_blank\" rel=\"noopener noreferrer\">FY25 Table 5 ↗<\/a>."}],"alert_zh":"<strong>结构分化看点：<\/strong>仔细对比奥驰亚 Table 6 可以看到极清晰的内部轮动——2026 前9月高端 Skoal 同比 -12.5%（84.5M 罐），而价值型 Other（Red Seal + Husky）逆势 <strong>+1.3%（48.2M 罐）<\/strong>；两者一收割溢价、一承接降级，共同拱卫 USSTC 在全美口含烟分部 <strong>66.8%<\/strong> 的超高调整后利润率。","alert_en":"<strong> clear Internal Portfolio Rotation:<\/strong> While premium Skoal stepped down -12.5% in 9M 2026 (84.5M cans) amid pouch migration, value tier Other (Red Seal + Husky) grew <strong>+1.3% YoY to 48.2M cans<\/strong>—keeping value-conscious dippers inside USSTC's high-margin oral ecosystem.","chart":{"tabA_zh":"视图A: Red Seal/Husky 逆势正增长轨迹","tabA_en":"View A: Red Seal/Husky Positive Growth","tabB_zh":"视图B: Skoal vs Other 季度罐数对比","tabB_en":"View B: Skoal vs. Value MST Quarterly Cans","viewA":{"mode":"dual_bar_line","title_zh":"USSTC 价值湿鼻烟（Other: Red Seal + Husky）季度出货（百万罐）vs 同比增速（%）","title_en":"USSTC Value MST ('Other': Red Seal & Husky) Quarterly Cans (M) vs. YoY Change (%)","sub_zh":"连续在 2025Q4 (+2.5%) 与 2026Q2 (+3.0%) 实现逆周期正增长，9M 累计 +1.3%","sub_en":"Delivered positive YoY volume growth in Q4 2025 (+2.5%), 1H 2026 (+2.9%), and 9M 2026 (+1.3%)","leg1_zh":"Other(Red Seal/Husky) 季度出货 (左轴 · M罐)","leg1_en":"Value MST Quarterly Cans (Left · M)","leg2_zh":"同比销量变动率 (右轴 · %)","leg2_en":"YoY Volume Change (Right · %)","labels_zh":["2024Q4","2025Q4","2026Q1","2026Q2","2026Q3"],"labels_en":["Q4 2024","Q4 2025","Q1 2026","Q2 2026","Q3 2026"],"subs_zh":["份额 2.6%","16.3M (+2.5%)","15.4M (+2.7%)","16.9M (+3.0%)","15.9M (稳守2.2%份额)"],"subs_en":["2.6% share","+2.5% YoY","+2.7% YoY","+3.0% YoY","2.2% oral share"],"s1":[15.9,16.3,15.4,16.9,15.9],"s2":[-2.0,2.5,2.7,3.0,-1.9],"max1":20,"max2":6.0,"u1":"M","u2":"%"},"viewB":{"mode":"grouped_bars","title_zh":"Skoal 高端调味线 vs Red Seal/Husky 价值线阶段出货罐数对比（百万罐）","title_en":"Skoal Flavored Premium vs. Red Seal/Husky Value Tier Shipments (Million Cans)","sub_zh":"Skoal 依然贡献逾三分之二体量与高单价毛利，价值线比重稳步上升提供防流失托底","sub_en":"Skoal provides >63% of combined flanker volume at premium pricing while Red Seal/Husky expands at the value base","leg1_zh":"Skoal 报告出货量 (百万罐)","leg1_en":"Skoal Shipments (M Cans)","leg2_zh":"Other: Red Seal + Husky (百万罐)","leg2_en":"Red Seal + Husky Shipments (M Cans)","labels_zh":["2024全年","2025全年","2026H1","2026前9月"],"labels_en":["FY 2024","FY 2025","1H 2026","9M 2026"],"subs_zh":["合计 212.9M 罐","合计 191.8M 罐","合计 89.7M 罐","合计 132.7M 罐"],"subs_en":["212.9M total","191.8M total","89.7M total","132.7M total"],"s1":[147.0,127.9,57.4,84.5],"s2":[65.9,63.9,32.3,48.2],"max1":165,"u1":"M","u2":"M"}},"matrix_cards":[{"title_zh":"Red Seal 1.5 盎司大罐：包装工程学如何化解价格战？","title_en":"Red Seal's 1.5 oz Packaging Math Avoids Sticker-Price Erosion","badge_zh":"4罐顶5罐容量","badge_en":"4 Cans = 5 Standard","body_zh":"奥驰亚财报在口含烟销量表附注中专门指出：不同包装规格按罐统计未必等量——这正是指向 <strong>Red Seal 标志性的 1.5 oz 加大罐<\/strong>（比 1.2 oz 行业标准重 25%）<a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Q3'26 Table 6 Note ↗<\/a>。","detail_zh":"与其直接把单罐标价砍到 $3 毁掉便利店客单价，Red Seal 用 ~$5.20–$5.80 的中端标价提供 1.5 oz 超大容量，既保住了零售商单笔毛利额，又让老烟民算清“每盎司单价极低”而死心塌地复购。","body_en":"Instead of slashing shelf price tags to $3, Red Seal packs <strong>1.50 oz (+25% more moist snuff than a standard 1.20 oz can)<\/strong> at a mid-tier price—preserving retailer dollar margin while giving heavy users superior cost-per-ounce <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Q3'26 Table 6 Note ↗<\/a>.","detail_en":"Four cans of Red Seal equal five standard cans by weight, creating powerful repeat habit among budget-conscious daily dippers."},{"title_zh":"1983 Skoal Bandits：现代口含烟袋（Pouches）真正的工业鼻祖","title_en":"1983 Skoal Bandits: The True Ancestor of Modern Pouching","badge_zh":"40余年定袋技术","badge_en":"40+ Yr Pouch Heritage","body_zh":"早在 ZYN 席卷美国前三十余年，USSTC 便于 1983 年推出全美首款独立无纺布小袋口含烟 <strong>Skoal Bandits<\/strong>，教育了整整两代美国消费者“上唇/下唇含袋不吐渣”的使用习惯。","detail_zh":"今天 Skoal Pouches 与 X-TRA Pouches 依然在偏爱真烟叶风味但追求干净便捷的中老年客群中贡献极其稳健的高毛利复购。","body_en":"Three decades before white nicotine pouches, USSTC's 1983 launch of <strong>Skoal Bandits<\/strong> pioneered portioned fleece pouches in America, laying the behavioral foundation for today's oral category.","detail_en":"Skoal Pouches still retain loyalists who want tidy portioning without giving up real fermented tobacco flavor."}]},"ch2":{"eyebrow":"CHAPTER 02 · FOUR LADDER PILLARS & 5-AXIS MST RADAR","h2_zh":"二、四大护翼支柱：Skoal · Red Seal · Husky 如何协同锁定 >50% 湿鼻烟江山？","h2_en":"2. Four Flanker Pillars: Locking Down >50% of Traditional US Moist Snuff","badge_zh":"战略角色：现金牛收割 + 容量/地板价双层护城河","badge_en":"Role: Margin Harvest + 1.5oz / Deep-Value Defense","pillars":[{"title_zh":"01 · Skoal 存量果香与冬青配方享有 FDA 准入冻结红利","title_en":"01 · Skoal's Grandfathered Fruit & Wintergreen SKU Moat","badge_zh":"Peach/Apple/Berry独占","badge_en":"Grandfathered Flavors","desc_zh":"受 2009 烟草控制法保护的丰富果味湿鼻烟线，无任何新进入者能够获批仿制。","note_zh":"<strong>当前选中支柱解读（01 法规冻结壁垒）：<\/strong>在尼古丁袋目前仅有薄荷/冬青/烟草获批 FDA PMTA 的背景下，偏爱 Peach（蜜桃）或 Berry（浆果）合法口含烟的成年消费者在正规渠道唯有选择 Skoal。","note_en":"<strong>Selected Pillar (01 · Grandfathered Flavor Exclusivity):<\/strong> Because FDA has authorized zero fruit-flavored nicotine pouches to date, Skoal Peach, Apple, Cherry, and Berry own a legally protected flavor niche.","desc_en":"Protected under the 2009 Tobacco Control Act baseline, Skoal's fruit-flavored moist snuff lineup faces zero new FDA-authorized clones."},{"title_zh":"02 · Red Seal 1.5oz 大容量差异化避开同质化低价泥潭","title_en":"02 · Red Seal's 1.5 oz Big-Can Format Differentiates Value","badge_zh":"9M'26 +1.3% 增长主力","badge_en":"+25% Can Capacity","desc_zh":"唯一全国性 1.5oz 加量湿鼻烟品牌，用克重性价比赢得重度蓝领口碑。","note_zh":"<strong>当前选中支柱解读（02 大罐差异化）：<\/strong>竞品 Cougar 与 Longhorn 均局限于 1.2oz 标准罐拼低价，Red Seal 独辟蹊径用大罐尺寸建立视觉与触感记忆点。","note_en":"<strong>Selected Pillar (02 · 1.5 oz Differentiation):<\/strong> While Cougar and Longhorn fight on 1.2 oz price tags, Red Seal wins heavy dippers on ounces-per-dollar.","desc_en":"America's only national 1.5 oz big-can moist snuff brand wins blue-collar loyalty through transparent per-ounce value."},{"title_zh":"03 · Husky 精准对位狙击 BAT Cougar 与 PMI Longhorn","title_en":"03 · Husky Seals the Entry-Price Floor for USSTC","badge_zh":"稳守 2.2% Other 份额","badge_en":"2.2% Steady Share","desc_zh":"在深折湿鼻烟抬头地区提供 USSTC 原厂品质地板价选择，截留集团内部流转。","note_zh":"<strong>当前选中支柱解读（03 底线防守）：<\/strong>近年雷诺力推低价牌 Cougar 承接 Grizzly 流失客，USSTC 同步激活 Husky + Red Seal 组合拳，使 Other 份额在 2026Q2 与 Q3 连续稳守 2.2%。","note_en":"<strong>Selected Pillar (03 · Deep-Value Counter):<\/strong> Directly neutralizes BAT's Cougar and Swedish Match's Longhorn at the bottom of the MST rack.","desc_en":"Seals the deep-value moist snuff floor in price-war states using USSTC leaf quality and existing field reps."},{"title_zh":"04 · 零商誉包袱 + 共用 USSTC 3% 超低消费税底盘","title_en":"04 · De-Risked Balance Sheet & 66.8% Segment Margin Base","badge_zh":"2024 减值已出清","badge_en":"Clean Asset Base","desc_zh":"2024 年完成 Skoal 账面商标减值重估后，全部现金流纯净计入高利润口含分部。","note_zh":"<strong>当前选中支柱解读（04 纯净现金转化）：<\/strong>年化约 1.77 亿罐（Skoal ~1.13亿 + Other ~0.64亿）持续为奥驰亚贡献约 $4.5亿–$5.5亿级稳定调整后 OCI。","note_en":"<strong>Selected Pillar (04 · High-Margin Cash Generation):<\/strong> ~177M annualized cans contribute ~$450M–$550M in steady Adjusted OCI atop USSTC's shared factories.","desc_en":"Post-2024 trademark reset ensures 100% of cash generation flows cleanly into Altria's 66.8%-margin Oral segment."}],"radar":{"title_zh":"美国中端调味与价值型湿鼻烟五维竞争力雷达图（10分制）","title_en":"5-Axis Flavored & Value MST Competitive Radar (10-Point Scale)","axes_zh":["风味矩阵宽度","每盎司容量性价比","终端渠道覆盖","单罐利润率","抗降级截留效率"],"axes_en":["Flavor Breadth","Ounce-Value Math","Retail Reach","Unit Margin","Value Retention"],"s0_zh":"Skoal + Red Seal + Husky 组合 (USSTC)","s0_en":"Skoal + Red Seal + Husky Trio (USSTC)","s1_zh":"Grizzly + Cougar 组合 (BAT / American Snuff)","s1_en":"Grizzly + Cougar Duo (BAT / American Snuff)","s2_zh":"Longhorn + Timber Wolf (PMI / Swedish Match)","s2_en":"Longhorn + Timber Wolf (Swedish Match)","v0":[9.7,9.5,9.4,8.8,8.9],"v1":[8.4,8.6,9.3,8.5,9.2],"v2":[7.5,8.8,7.6,7.2,8.4]}},"ch3":{"eyebrow":"CHAPTER 03 · FLAVORED & VALUE MST PEER BENCHMARKING","h2_zh":"三、全美调味与价值型湿鼻烟横向对比：果香溢价 vs 大罐实惠 vs 深折肉搏","h2_en":"3. US Flavored & Value MST Matrix: Skoal, Red Seal & Husky vs. Rivals","peers_zh":[{"category":"altria","benchmark":true,"title":"研究标的：Skoal 高端调味湿鼻烟","creator":"USSTC (奥驰亚全资)","format":"高端风味切丝与湿袋 (~$6.80–$7.50/罐 · 1.2 oz)","craft":"冬青/薄荷 + 独有 Peach/Apple/Cherry/Berry 真叶发酵","views":"FY25 127.9M 罐 · 9M'26 84.5M 罐 · 口含份额 4.8%","acclaim":"1934 冬青与 1983 袋装鼻祖 · 存量果味合规壁垒","takeaway":"虽受白袋分流但绝不打折自毁身价，专注收割高支付意愿果味与冬青老用户。","sourceLabel":"Altria Q3'26","sourceUrl":"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx"},{"category":"altria","benchmark":true,"title":"研究标的：Red Seal & Husky (Other 价值双星)","creator":"USSTC (奥驰亚全资)","format":"1.5oz 加量价值罐 (Red Seal) + 深折罐 (Husky)","craft":"+25% 大容量塑料保鲜罐 · 美式烤烟冬青/原味","views":"FY25 63.9M 罐 · 9M'26 48.2M 罐 (+1.3% 逆势增长!)","acclaim":"连续多季实现传统湿鼻烟正增长 · 稳占 2.2% 口含份额","takeaway":"Red Seal 用容量错位竞争，Husky 镇守地板价，完美堵住 USSTC 底部漏洞。","sourceLabel":"Q3'26 Table 6","sourceUrl":"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx"},{"category":"external","benchmark":false,"title":"Cougar 美洲狮 (近年增速最猛深折鼻烟)","creator":"American Snuff Co. / 英美烟草 (BAT)","format":"深折湿鼻烟 (~$3.80–$4.50/罐 · 1.2 oz)","craft":"承接 Grizzly 连续提价溢出的冬青深折替代品","views":"近年深折 MST 头号黑马，但严重分流自家主牌 Grizzly","acclaim":"价格杀伤力强 · 内部蚕食明显","takeaway":"倒逼 USSTC 强化 Husky 铺货与 Red Seal 1.5oz 推广的头号低价对手。","sourceLabel":"Tobacco Insider","sourceUrl":"https://tobaccoinsider.com/altria-q2-2026-results/"},{"category":"external","benchmark":false,"title":"Stoker's 斯托克大桶装湿鼻烟","creator":"Turning Point Brands (NYSE: TPB)","format":"12 oz 巨型十罐桶装 (Tubs) + 1.2 oz 低价罐","craft":"超长粗切丝 (Extra Long Cut) · 重度乡村蓝领经济装","views":"TPB 核心利润支柱 · 在独立烟店与乡村渠道稳步扩份额","acclaim":"大桶装极致克重性价比","takeaway":"与 Red Seal 1.5oz 同吃“容量性价比”红利，但便利店连锁覆盖率不及 AGDC。","sourceLabel":"Tobacco Insider","sourceUrl":"https://tobaccoinsider.com/altria-q2-2026-results/"},{"category":"external","benchmark":false,"title":"Longhorn & Kayak (传统第四梯队地板烟)","creator":"Swedish Match (PMI) / Swisher","format":"超低价地板湿鼻烟 (~$3.00–$3.99/罐)","craft":"基础发酵烟叶 · 低渠道费用","views":"长尾低收入市场存量竞争","acclaim":"口感醇厚度弱于 USSTC 暗火烤烟","takeaway":"在 Husky 下探与 Red Seal 容量降维打击下扩张受限。","sourceLabel":"Altria Q3'26","sourceUrl":"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx"}],"peers_en":[{"category":"altria","benchmark":true,"title":"Subject: Skoal Flavored Premium MST","creator":"USSTC (Altria 100%)","format":"Premium Flavored Cuts & Pouches (~$6.80–$7.50/can)","craft":"Wintergreen/Mint + Grandfathered Peach/Apple/Berry","views":"127.9M FY25 cans · 84.5M 9M'26 cans · 4.8% oral share","acclaim":"1934 wintergreen & 1983 pouch pioneer · Protected fruit SKUs","takeaway":"Harvests premium pricing across sticky fruit and wintergreen adult dippers without chasing low-margin promos.","sourceLabel":"Altria Q3'26","sourceUrl":"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx"},{"category":"altria","benchmark":true,"title":"Subject: Red Seal (1.5oz) & Husky Value Duo","creator":"USSTC (Altria 100%)","format":"1.5oz Big-Can Value + Deep-Discount MST","craft":"25%-larger 1.50 oz tub (Red Seal) + budget Husky cuts","views":"63.9M FY25 cans · 48.2M 9M'26 cans (+1.3% YoY growth!)","acclaim":"Growing MST volume against secular decline · 2.2% share","takeaway":"Red Seal wins on ounces-per-dollar while Husky blocks deep-discount defection.","sourceLabel":"Q3'26 Table 6","sourceUrl":"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx"},{"category":"external","benchmark":false,"title":"Cougar (Deep-Discount MST Challenger)","creator":"American Snuff Co. / BAT","format":"Deep-Value 1.2oz MST (~$3.80–$4.50/can)","craft":"Budget wintergreen flanker beneath Grizzly","views":"Fast-growing value dip, partially cannibalizing Grizzly","acclaim":"Aggressive value pricing","takeaway":"Primary discount rival countered by USSTC's Husky and 1.5oz Red Seal.","sourceLabel":"Tobacco Insider","sourceUrl":"https://tobaccoinsider.com/altria-q2-2026-results/"},{"category":"external","benchmark":false,"title":"Stoker's Moist Snuff (12oz Tubs & Cans)","creator":"Turning Point Brands (NYSE: TPB)","format":"12oz 10-Can Value Tubs & Budget Cans","craft":"Signature Extra-Long Cut · Rural tobacco-outlet focus","views":"Steady share gainer in bulk value MST","acclaim":"Strong bulk value loyalty","takeaway":"Validates bulk-ounce value math, though smaller c-store reach than AGDC.","sourceLabel":"Tobacco Insider","sourceUrl":"https://tobaccoinsider.com/altria-q2-2026-results/"},{"category":"external","benchmark":false,"title":"Longhorn & Kayak","creator":"Swedish Match (PMI) / Swisher","format":"Tier-4 Floor-Priced MST (~$3.00–$3.99/can)","craft":"Entry-level value blends","views":"Niche low-price regional presence","acclaim":"Capped by Husky & Cougar competition","takeaway":"Contained at the low end of the rack.","sourceLabel":"Altria Q3'26","sourceUrl":"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx"}],"bars":{"title_zh":"全美湿鼻烟单罐容量与终端价格阶梯对比：USSTC 四级无死角矩阵（USD / 罐）","title_en":"US Moist Smokeless Price & Capacity Ladder: USSTC's 4-Tier Architecture ($ / Can)","sub_zh":"展示 USSTC 如何从 $7.78 哥本哈根一路向下覆盖至 ~$3.90 Husky，且在中间嵌入 1.5oz 大容量 Red Seal","sub_en":"From $7.78 Copenhagen down to ~$3.90 Husky, bridged by Red Seal's 25%-larger 1.5oz format","badge_zh":"覆盖全部湿鼻烟价格带","badge_en":"Full-Spectrum MST Coverage","leg1_zh":"蓝色/绿色：USSTC 四级湿鼻烟价格矩阵 (USD/罐)","leg1_en":"Blue / Green: USSTC 4-Tier MST Price Ladder ($/Can)","leg2_zh":"紫色/琥珀：外部次高端与深折竞品对标价位 (虚线 = $5.00 价值分界线)","leg2_en":"Purple / Amber: External MST Rivals (Dashed = $5.00 Value Line)","max_x":9.0,"ref_line":5.0,"items_zh":[{"label":"Copenhagen 哥本哈根旗舰线 (1.2 oz · USSTC)","val":7.78,"disp":"$7.78","sub":"Q2'26 核验终端均价","note":"超高端绝对锚点与 FDA MRTP 标杆"},{"label":"Skoal 经典与果味高端线 (1.2 oz · USSTC)","val":7.15,"disp":"~$7.15","sub":"4.8% 口含大盘份额","note":"独占存量 Peach/Berry 果香溢价"},{"label":"Grizzly 灰熊冬青主力 (1.2 oz · BAT/雷诺)","val":6.45,"disp":"~$6.45","sub":"外部头号中高端对手","note":"连续提价后部分客流滑向 Cougar"},{"label":"Red Seal 加量 25% 大罐线 (1.5 oz · USSTC)","val":5.5,"disp":"~$5.50","sub":"折合标准 1.2oz 仅 ~$4.40!","note":"驱动 Other 口径 9M'26 +1.3% 逆势增长"},{"label":"Cougar 美洲狮深折线 (1.2 oz · BAT/雷诺)","val":4.15,"disp":"~$4.15","sub":"深折赛道主要对手","note":"标准 1.2oz 低价冲击波"},{"label":"Husky 哈士奇深折护卫线 (1.2 oz · USSTC)","val":3.95,"disp":"~$3.95","sub":"与 Red Seal 合占 2.2% 份额","note":"USSTC 底层价格防火墙"}],"items_en":[{"label":"Copenhagen Flagship MST (1.2 oz · USSTC)","val":7.78,"disp":"$7.78","sub":"Verified Q2'26 avg price","note":"Super-premium anchor & FDA MRTP"},{"label":"Skoal Flavored Premium MST (1.2 oz · USSTC)","val":7.15,"disp":"~$7.15","sub":"4.8% Q3 total oral share","note":"Grandfathered fruit & wintergreen"},{"label":"Grizzly Mainstream MST (1.2 oz · BAT)","val":6.45,"disp":"~$6.45","sub":"#1 external MST rival","note":"Up-tiered pricing over recent years"},{"label":"Red Seal +25% Big Can (1.5 oz · USSTC)","val":5.5,"disp":"~$5.50","sub":"Equals ~$4.40 per 1.2oz!","note":"Powers +1.3% 9M'26 'Other' growth"},{"label":"Cougar Deep-Value MST (1.2 oz · BAT)","val":4.15,"disp":"~$4.15","sub":"Fast-growing value dip","note":"Standard 1.2oz budget rival"},{"label":"Husky Deep-Value Flanker (1.2 oz · USSTC)","val":3.95,"disp":"~$3.95","sub":"2.2% share with Red Seal","note":"USSTC entry-price firewall"}]}},"ch4":{"eyebrow":"CHAPTER 04 · BLENDED LADDER ECONOMICS & OCI SIMULATOR","h2_zh":"四、阶梯组合经济学与模拟：年销 ~1.77 亿罐侧翼群的自由现金流价值","h2_en":"4. Ladder Economics & Simulator: Cash-Flow Contribution from ~177M Annualized Cans","sub_zh":"Skoal 提供 ~$3.30+/罐高净利，Red Seal/Husky 提供稳健正增长与工厂产能吸收","sub_en":"Skoal delivers ~$3.30+/can OCI while growing Red Seal/Husky cans absorb USSTC plant overhead","badge_zh":"FY24 减值出清后零无形资产包袱","badge_en":"De-Risked Post-2024 Write-Down","econ_cards":[{"label_zh":"COMBINED 9M CANS","label_en":"COMBINED 9M CANS","val_zh":"132.7M 罐","val_en":"132.7M Cans","desc_zh":"Skoal 84.5M + Other 48.2M，占奥驰亚口含烟前9月总罐数（522.2M）的 25.4%。","desc_en":"Skoal (84.5M) + Other (48.2M) totaled 132.7M cans in 9M 2026—25.4% of Altria's 522.2M total oral volume."},{"label_zh":"VALUE MIX RATIO","label_en":"VALUE MIX RATIO","val_zh":"36.3% 价值占比","val_en":"36.3% Value Mix","desc_zh":"Other 在侧翼包中的比重由 2024 年的 31.0% 升至 9M'26 的 36.3%，平滑总量斜率。","desc_en":"Value-tier Red Seal/Husky rose from 31.0% (FY24) to 36.3% (9M'26) of this flanker portfolio, smoothing total volume slope."},{"label_zh":"BLENDED CAN OCI","label_en":"BLENDED CAN OCI","val_zh":"~$2.75 / 罐","val_en":"~$2.75 / Can","desc_zh":"Skoal 高单价与 Red Seal/Husky 价值带加权后，依然享有极低的 ~3% 消费税红利。","desc_en":"Blending premium Skoal with value Red Seal/Husky still captures Oral's ~3% ultra-low federal excise tax structure."},{"label_zh":"ANNUALIZED OCI","label_en":"ANNUALIZED OCI","val_zh":"~$485M / 年","val_en":"~$485M / Yr","desc_zh":"估算每年为奥驰亚口含烟分部稳定贡献近 5 亿美元级调整后营业利润。","desc_en":"Generates an estimated ~$485M in annualized Adjusted OCI for Altria's Oral Tobacco segment on minimal CapEx."}],"combo":{"title_zh":"Skoal + Other 合计出货罐数（百万罐）vs 价值线（Red Seal/Husky）内部占比抬升（%）","title_en":"Combined Skoal + Value MST Shipments (M Cans) vs. Value-Tier Mix Share (%)","sub_zh":"Red Seal 与 Husky 逆势扩量使侧翼总盘衰减率远缓于单一 Skoal，稳住 USSTC 产线负荷","sub_en":"Growing Red Seal/Husky cans cushion Skoal attrition, keeping USSTC fermentation & canning utilization healthy","badge_zh":"内部高低自动对冲","badge_en":"Self-Balancing MST Mix","left_zh":"■ 左轴：三品牌合计出货 (百万罐)","left_en":"■ Left Axis: Combined Cans (M)","right_zh":"● 右轴：Red Seal/Husky 占侧翼比重 (%)","right_en":"● Right Axis: Value Tier % of Flanker Cans","leg1_zh":"合计出货罐数 (左轴 · M罐)","leg1_en":"Combined Cans (Left · M)","leg2_zh":"价值线内部占比 (右轴 · %)","leg2_en":"Red Seal/Husky Mix (Right · %)","line_badge_zh":"--- 35.0% 容量防守均衡线","line_badge_en":"--- 35.0% Balanced Flanker Line","titles_zh":["2024全年","2025全年","2025前9月","2026前9月","2026全年预估年化"],"titles_en":["FY 2024","FY 2025","9M 2025","9M 2026","FY26 Run-Rate"],"subs_zh":["147.0M + 65.9M","127.9M + 63.9M","96.6M + 47.6M","84.5M + 48.2M","~113M + ~64.5M"],"subs_en":["147.0M + 65.9M","127.9M + 63.9M","96.6M + 47.6M","84.5M + 48.2M","~113M + ~64.5M"],"bars":[212.9,191.8,144.2,132.7,177.0],"line":[31.0,33.3,33.0,36.3,36.4],"max_bar":240,"min_line":25,"max_line":42,"ref_line":35,"u_bar":"M","u_line":"%","highlight_idx":3},"sim":{"title_zh":"Skoal · Red Seal · Husky 侧翼组合多年期净现金流模拟器","title_en":"Skoal, Red Seal & Husky Multi-Year Flanker OCI Simulator","toggle_title_zh":"开启 Skoal 提价收割 + Red Seal 1.5oz 扩铺与工厂合并降本 (+14% 净利增厚)","toggle_title_en":"Enable Skoal Price Harvest + Red Seal Expansion & Plant Savings (+14% Lift)","toggle_sub_zh":"模拟 Skoal 高单价提价与 Red Seal 正增长共同稳定多年期现金流","toggle_sub_en":"Models Skoal price realization paired with positive Red Seal/Husky volume retention","s1_label_zh":"首年三品牌合计出货罐数 (百万罐 · 当前年化≈177M)","s1_label_en":"Year-1 Combined Cans (Million Cans · ~177M current)","s1_unit_zh":"M 罐","s1_unit_en":"M Cans","s1_min":130,"s1_max":210,"s1_step":5,"s2_label_zh":"三品牌加权单罐调整后 OCI (USD / 罐)","s2_label_en":"Blended Adjusted OCI per Can (USD)","s2_unit_zh":"/罐","s2_unit_en":"/can","s2_min":2.1,"s2_max":3.5,"s2_step":0.1,"s3_label_zh":"USSTC 产线分摊节省与哥本哈根价盘保护价值 ($M / 年)","s3_label_en":"Annual Overhead Absorption & Price-Shield Value ($M/yr)","s3_min":20,"s3_max":90,"s3_step":5,"roi_label_zh":"相对年均 $45M 侧翼渠道陈列支持费回报倍数","roi_label_en":"Payback Multiple vs. $45M Annual Trade Support","cost_base_m":45,"mult":1.14,"vol_drift":0.935,"presets":{"p1":{"label_zh":"① 保守收缩情景 (Skoal 果味客群加速转投白袋)","label_en":"① Faster Pouch-Shift Stress Case","tag_zh":"155M罐 · 5年","tag_en":"155M · 5 Yrs","views":155,"v_per_view":2.5,"ancillary_m":30,"years":5,"transmedia":false},"p2":{"label_zh":"② 当前稳健基准情景 (177M罐 · Red Seal正增长托底)","label_en":"② Base Balanced Ladder Case (177M Cans)","tag_zh":"177M罐 · 5年","tag_en":"177M · 5 Yrs","views":177,"v_per_view":2.8,"ancillary_m":50,"years":5,"transmedia":true},"p3":{"label_zh":"③ 蓝领价值消费强化情景 (Red Seal 1.5oz 大举抢夺竞品)","label_en":"③ Bull Value-Dip Capture Case","tag_zh":"190M罐 · 7年","tag_en":"190M · 7 Yrs","views":190,"v_per_view":3.0,"ancillary_m":70,"years":7,"transmedia":true}}},"moat_pos_zh":"<strong>1. 进退自如的三层漏斗：<\/strong>上用 Skoal 守住 ~$7 果香高地，中用 Red Seal 1.5oz 大罐吸纳重度精明买家，下用 Husky 锁死地板。<br/><strong>2. Other 口径重返正增长：<\/strong>9M'26 +1.3% 实证了价值型湿鼻烟的逆周期韧性。","moat_pos_en":"<strong>1. Complete Three-Step Funnel:<\/strong> Skoal harvests ~$7 flavored loyalty, Red Seal wins ounces-per-dollar, and Husky guards the entry floor.<br/><strong>2. Proven Positive Volume in 'Other':<\/strong> +1.3% 9M 2026 growth offsets premium attrition.","moat_risk_zh":"<strong>1. Skoal 长期受纯白果味/薄荷袋挤压：<\/strong>若未来 FDA 批准果味纯白尼古丁袋（如 on! PLUS 蓝莓薄荷/芒果菠萝），Skoal 存量果味客群将进一步向集团内部 on! PLUS 迁移。<br/><strong>2. 州级风味口含禁令：<\/strong>加州等个别州同样限制调味湿鼻烟销售。","moat_risk_en":"<strong>1. Ongoing Skoal-to-Pouch Migration:<\/strong> New fruit-mint nicotine pouches (including Helix's own on! PLUS extensions) naturally draw younger flavored users.<br/><strong>2. State Flavor Bans:<\/strong> State-level flavored tobacco bans impact Skoal fruit/mint SKUs."},"ch5":{"eyebrow":"CHAPTER 05 · 92-YEAR FLAVOR & VALUE MST TIMELINE","h2_zh":"五、演进脉络与四大关键节点：从 1934 首创冬青鼻烟到三梯队协同防线","h2_en":"5. Evolution & Key Milestones: From 1934 Wintergreen Breakthrough to Value Defense","sub_zh":"复盘 Skoal 如何开创风味与袋装先河，以及 Red Seal/Husky 如何在 2025–2026 扛起抗降级大旗","sub_en":"Tracing 92 years of flavored smokeless innovation and 2025–2026 value-tier resilience","badge_zh":"1934 Skoal → 1983 Bandits → 2024 账面重估 → 2026 Other正增长","badge_en":"1934 Skoal → 1983 Bandits → 2024 Reset → 2026 Value Gain","acts":[{"title_zh":"第一阶段 · 1934 冬青革命与 1983 Bandits 袋装开创 (1934–2008)","title_en":"Act I · 1934 Wintergreen & 1983 Bandits Pouch Innovations","badge_zh":"风味与定袋双鼻祖","badge_en":"Category Pioneer","desc_zh":"1934 年推出 Skoal Wintergreen 打破原味鼻烟一统天下局面；1983 年推出 Skoal Bandits 奠定现代小袋口含形态。","desc_en":"Skoal introduced wintergreen moist snuff in 1934 and portioned Bandits pouches in 1983, expanding oral tobacco's addressable market."},{"title_zh":"第二阶段 · 并入奥驰亚扩充 X-TRA 与 Red Seal 1.5oz 全国化 (2009–2023)","title_en":"Act II · Altria Integration & Red Seal 1.5oz National Scaling (2009–2023)","badge_zh":"建立完整四级价格梯队","badge_en":"4-Tier USSTC Rack","desc_zh":"2009 年随 UST 并入奥驰亚，整合哥本哈根、Skoal、Red Seal 与 Husky 四级便利店陈列架，最大化单店坪效。","desc_en":"Joined Altria in 2009, uniting Copenhagen, Skoal, Red Seal, and Husky onto AGDC's national oral tobacco fixtures."},{"title_zh":"第三阶段 · 2024 审慎减值出清与 2025–2026 价值双星逆势突围 (2024–2026)","title_en":"Act III · 2024 Accounting Reset & 2025–2026 Value MST Growth","badge_zh":"Other 9M'26 +1.3%","badge_en":"+1.3% 9M'26 Value Growth","desc_zh":"2024 年果断完成 Skoal 商标非现金减值重估，同时发力 Red Seal 1.5oz 与 Husky，在 2025Q4 至 2026 前9月实现 Other 口径逆势正增长 <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Q3'26 Table 6 ↗<\/a>。","desc_en":"Reset Skoal's book value in FY2024 while driving Red Seal and Husky to +1.3% 9M 2026 volume growth <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Q3'26 Table 6 ↗<\/a>."}],"battles":[{"tag_zh":"节点 01 · 容量破局","tag_en":"Case 01 · 1.5oz Math","sub_zh":"+25% 差异化罐体","sub_en":"25% Larger Can","title_zh":"Red Seal 用 1.5oz 规格跳出 1.2oz 低价死循环","title_en":"Red Seal's 1.5 oz Tub Redefines Value MST","desc_zh":"在保持体面单罐零售价的同时让渡每盎司实惠，深得南部与中西部重度用户青睐 <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Table 6 Note ↗<\/a>。","desc_en":"Delivers 25% more leaf per can, winning heavy rural dippers without $3 price tags <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Table 6 Note ↗<\/a>."},{"tag_zh":"节点 02 · 2024全年","tag_en":"Case 02 · FY2024","sub_zh":"资产负债表净化","sub_en":"Trademark Reset","title_zh":"非现金减值重估 Skoal 商标消除未来业绩噪音","title_en":"Non-Cash Skoal Trademark Write-Down Clears Overhang","desc_zh":"顺应尼古丁袋时代客观评估 Skoal 终值，丝毫不影响其每年上亿美元真实自由现金流产出 <a class=\"cite-link\" href=\"https://www.sec.gov/Archives/edgar/data/764180/000076418026000007/exhibit991erq42025.htm\" target=\"_blank\" rel=\"noopener noreferrer\">FY25 EX-99.1 ↗<\/a>。","desc_en":"Adjusted carrying value for secular pouch trends with zero impact on cash generation <a class=\"cite-link\" href=\"https://www.sec.gov/Archives/edgar/data/764180/000076418026000007/exhibit991erq42025.htm\" target=\"_blank\" rel=\"noopener noreferrer\">FY25 EX-99.1 ↗<\/a>."},{"tag_zh":"节点 03 · 2026H1","tag_en":"Case 03 · 1H 2026","sub_zh":"阻击雷诺 Cougar","sub_en":"Countering Cougar","title_zh":"Other 口径上半年逆势增长 +2.9% 稳守 2.2% 份额","title_en":"1H 2026 +2.9% Growth Defends 2.2% Value Share","desc_zh":"成功遏制竞品深折线对 USSTC 传统鼻烟大盘的侵蚀 <a class=\"cite-link\" href=\"https://www.sec.gov/Archives/edgar/data/764180/000076418026000093/exhibit991erq22026.htm\" target=\"_blank\" rel=\"noopener noreferrer\">Q2'26 Table 6 ↗<\/a>。","desc_en":"Neutralized aggressive value-tier promotions from rival Cougar <a class=\"cite-link\" href=\"https://www.sec.gov/Archives/edgar/data/764180/000076418026000093/exhibit991erq22026.htm\" target=\"_blank\" rel=\"noopener noreferrer\">Q2'26 Table 6 ↗<\/a>."},{"tag_zh":"节点 04 · 内部接力","tag_en":"Case 04 · Ecosystem","sub_zh":"USSTC → Helix 承接","sub_en":"Skoal → on! PLUS","title_zh":"on! PLUS 新推果香薄荷承接 Skoal 年轻化迁徙","title_en":"on! PLUS Blueberry Mint & Mango Pineapple Retain Switchers","desc_zh":"2026Q3–Q4 Helix 推出蓝莓薄荷、芒果菠萝与西瓜薄荷，在集团内无缝承接原 Skoal 果味偏好者 <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Q3'26 Smoke-Free ↗<\/a>。","desc_en":"Helix's new fruit-mint on! PLUS extensions capture flavor seekers migrating from MST <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Q3'26 Smoke-Free ↗<\/a>."}],"laws":[{"zh":"包装容量创新（1.5oz 大罐）比直接降价更能兼顾渠道商单笔利润与消费者获得感。","en":"Bonus-ounce packaging (1.5 oz) defends retailer dollar margin far better than raw sticker-price cuts."},{"zh":"对处于代际迁移中的老牌风味产品（Skoal），最优解是“零补贴提价收割现金 + 自家新物种（on! PLUS）承接流失”。","en":"Harvest mature flavored MST for cash while catching outgoing switchers with next-gen internal pouches."},{"zh":"只要哥本哈根 + Skoal + Red Seal/Husky 合守传统 MST 超 50% 份额，USSTC 就是便利店口含柜台永远的庄家。","en":"Holding >50% of traditional MST guarantees USSTC category captaincy on retail oral fixtures."}]},"ch6":{"h2_zh":"六、“湿鼻烟三级护翼法则”组合核查清单","h2_en":"6. 'Three-Tier MST Flanker Law' Checklist","items_zh":[{"tag":"Other 正增长","title":"1. 价值线逆周期增幅测试：Red Seal + Husky 罐数是否保持同比持平或正增长？","desc":"9M'26 +1.3%（48.2M 罐），验证通胀期大罐与地板价双星截留力。"},{"tag":"≥ 50% 合计MST份额","title":"2. USSTC 传统鼻烟总控盘测试：哥本哈根+Skoal+Other 合计占 MST 是否稳超 50%？","desc":"Q3'26 实算 (12.6%+4.8%+2.2%)/38.8% = 50.5%，守住绝对半壁江山。"},{"tag":"Skoal 单罐高净价","title":"3. Skoal 提价纪律测试：是否在罐数自然回落中严格克制无效促销、保持 ~$7+ 价盘？","desc":"确保每一罐 Skoal 贡献接近哥本哈根级别的 ~67% 营业利润率。"},{"tag":"1.5oz 克重折算","title":"4. Red Seal 克重性价比测试：相对竞品 1.2oz 罐的每盎司单价优势是否维持在 15%–20%？","desc":"守住重度日常消费者心智中的“划算之王”定位。"},{"tag":"on! PLUS 内部承接","title":"5. 跨品类内部留存测试：离开 Skoal 的风味用户是否更高比例转入 on! / on! PLUS？","desc":"跟踪蓝莓薄荷、芒果菠萝等新风味对集团口含总份额（27.9%）的托底作用。"},{"tag":"产线合并协同","title":"6. 制造固定费摊销测试：1.77亿罐年化侧翼量是否有效支撑 USSTC 合并后工厂高稼动率？","desc":"保障整个口含烟分部成本曲线最优。"}],"items_en":[{"tag":"Other +1.3% YoY","title":"1. Value-Tier Growth Test: Are Red Seal & Husky sustaining flat-to-positive can shipments?","desc":"Verified +1.3% YoY in 9M 2026 (48.2M cans)."},{"tag":">50% Total MST","title":"2. USSTC Category Majority Test: Do Copenhagen + Skoal + Other hold >50% of US MST?","desc":"Q3 2026: 19.6% / 38.8% = 50.5% of traditional moist snuff."},{"tag":"Skoal Price Discipline","title":"3. Skoal Margin Harvest Test: Is Skoal passing through list hikes without wasteful promo chasing?","desc":"Maximize cash extraction from sticky fruit/wintergreen cohorts."},{"tag":"1.5oz Ounce Edge","title":"4. Red Seal Cost-Per-Ounce Test: Does the 1.5oz tub maintain a 15%–20% per-ounce savings edge?","desc":"Preserve Red Seal's unique value proposition vs. 1.2oz rivals."},{"tag":"on! PLUS Capture","title":"5. Internal Flavor Bridge Test: Are outgoing Skoal dippers captured by new on! PLUS fruit-mints?","desc":"Monitor total Altria oral share stability (27.9% in Q3'26)."},{"tag":"Plant Utilization","title":"6. Factory Absorption Test: Do ~177M flanker cans optimize consolidated USSTC plant utilization?","desc":"Support >66% segment Adjusted OCI margins."}]},"sources":[{"label":"Altria Q3 & 9M 2026 Official Release (Tables 6 & 7: Skoal 84.5M Cans / 4.8% Share; Other 48.2M Cans +1.3% / 2.2% Share)","url":"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx"},{"label":"SEC Form 8-K Exhibit 99.1 — Altria FY2025 Results (Skoal 127.9M Cans, Other 63.9M Cans, FY24 Skoal Impairment Context)","url":"https://www.sec.gov/Archives/edgar/data/764180/000076418026000007/exhibit991erq42025.htm"},{"label":"SEC Form 8-K Exhibit 99.1 — Altria Q2 & 1H 2026 Results (1H Other Oral +2.9% to 32.3M Cans)","url":"https://www.sec.gov/Archives/edgar/data/764180/000076418026000093/exhibit991erq22026.htm"},{"label":"Tobacco Insider: US Oral Tobacco & Value MST Competitive Dynamics (2026)","url":"https://tobaccoinsider.com/altria-q2-2026-results/"}],"quickJumpZh":[{"sec":"sec-00","title":"00 单品定评与高低阶梯成绩单","sub":"9M合计1.327亿罐 · Red Seal/Husky +1.3%正增长"},{"sec":"sec-01","title":"01 调味鼻烟工艺与 1.5oz 大罐卡位","sub":"Skoal存量果香壁垒 · Red Seal加量25% · Husky地板价"},{"sec":"sec-02","title":"02 四大梯队防御支柱与五维雷达","sub":"合围全美50.5%传统湿鼻烟 · 2024减值已出清"},{"sec":"sec-03","title":"03 全美中端调味与价值湿鼻烟对比","sub":"对比 Cougar、Grizzly、Stoker's 与 Longhorn"},{"sec":"sec-04","title":"04 商标减值后轻装现金流推演模拟","sub":"年化~1.77亿罐与 ~$4.85亿 OCI 贡献模拟"},{"sec":"sec-05","title":"05 1934 冬青革命至双层价值防守史","sub":"Skoal Bandits 袋装鼻祖到当代三级阶梯"},{"sec":"sec-06","title":"06 湿鼻烟价格阶梯护城河核查清单","sub":"6项容量性价比与内部流转核验"},{"sec":"sec-07","title":"07 SEC 财报与行业核验信源索引","sub":"一手财报表格直达"}],"quickJumpEn":[{"sec":"sec-00","title":"00 Product Verdict & Tier Scorecard","sub":"132.7M 9M cans · +1.3% growth in Red Seal/Husky"},{"sec":"sec-01","title":"01 Flavored MST & 1.5oz Big-Can Craft","sub":"Grandfathered Skoal fruit SKUs & +25% Red Seal tub"},{"sec":"sec-02","title":"02 4 Ladder Pillars & MST Radar","sub":"Securing 50.5% of US MST & clean post-2024 asset base"},{"sec":"sec-03","title":"03 US Flavored & Value MST Matrix","sub":"Benchmarking Cougar, Grizzly, Stoker's & Longhorn"},{"sec":"sec-04","title":"04 Post-Impairment Cashflow Simulator","sub":"~177M annualized cans & ~$485M OCI model"},{"sec":"sec-05","title":"05 1934 Wintergreen Pioneer to Value Shield","sub":"From Skoal Bandits to modern value defense"},{"sec":"sec-06","title":"06 MST Price-Ladder Moat Checklist","sub":"6-point ounce-value and MST majority checklist"},{"sec":"sec-07","title":"07 SEC Filings & Primary Sources","sub":"Verified Altria oral shipment & share tables"}]},{"id":"on_classic","idx_num":7,"idx_pad":"07","filename":"mo_prod_07_on_nicotine_pouches.html","checkKey":"mui_mo_checks_on_classic","monogram":"ON","short_zh":"on! 纯白迷你尼古丁袋","short_en":"on! Classic Pouches","pill_kpi":"Q3+13.3% · 1.78亿罐/年","docTitleZh":"《on! 现代纯白干法迷你尼古丁袋》单品深度商业研报（Helix Innovations）| 王安安数据中心","docTitleEn":"on! Dry Mini Oral Nicotine Pouches Product Monograph (Helix Innovations) | Research Hub","crumb_zh":"on! 现代纯白干法迷你尼古丁袋（Helix Innovations LLC）","crumb_en":"on! Modern Dry Mini Nicotine Pouches (Helix Innovations LLC)","chip1_zh":"全美尼古丁袋稳居 Top 2/3 · 13.5%袋内份额","chip1_en":"13.5% US Pouch Share · 8.3% Total Oral","chip2_zh":"Q3'26 出货 4,780万罐 (+13.3%)","chip2_en":"47.8M Q3'26 Cans (+13.3% YoY)","sidebar":{"badge":"HELIX INNOVATIONS · 20-CT MINI POUCH ENGINE","title_zh":"on! 经典尼古丁袋研报","title_en":"on! Classic Monograph","sub_zh":"奥驰亚仅用 ~$2.5亿白菜价并购孵化的十亿美元级无烟主力：20袋/盒方形便携仓 × 1.5mg–8mg 五档精细浓度 × 2025出货 1.778亿罐","sub_en":"Altria's high-ROI ~$250M acquisition: 20-pouch rectangular pocket box × 5 nicotine strengths (1.5–8mg) × 177.8M FY25 cans","mini_kpis":[{"label_zh":"2025全年 / 9M'26 出货量","label_en":"FY25 / 9M26 Shipments","val_zh":"177.8M / 143.9M罐","val_en":"177.8M / 143.9M"},{"label_zh":"2026Q3 单季出货增速","label_en":"Q3 2026 Can Growth","val_zh":"47.8M (+13.3%)","val_en":"47.8M (+13.3%)"},{"label_zh":"口含总份额 / 尼古丁袋内份额","label_en":"Oral / Pouch Share","val_zh":"8.3% / 13.5%","val_en":"8.3% / 13.5%"}]},"toc":[["单品定评与无烟增长核心面板","Product Verdict & Growth Scorecard"],["干法微晶配方、20袋方盒与五档梯度","Dry Micro-Pouch & 20ct Box Engineering"],["四大差异化支柱与尼古丁袋雷达","4 Differentiation Pillars & Pouch Radar"],["全美现代尼古丁袋四大巨头对比","US Nicotine Pouch Peer Matrix"],["~$2.5亿并购神作与单罐盈利模拟","~$250M Deal ROI & Unit Simulator"],["2019 控股 Helix 至近 2 亿罐跃迁史","2019 Helix Buyout to ~200M-Can Scale"],["现代干法尼古丁袋护城河核查清单","Dry Mini Pouch Moat Checklist"],["SEC 财报与行业监测信源索引","SEC Filings & Market Sources"]],"hero":{"strip1_zh":"单品定评：奥驰亚无烟化转型最成功的商业化基本盘——仅花 ~$2.5 亿并购成本，年化已迈向 ~1.95 亿罐规模并实现丰厚正向盈利","strip1_en":"Verdict: Altria's highest-ROI smoke-free acquisition—bought for ~$250M and scaled toward ~195M annualized cans with profitable unit economics","strip2_zh":"运营主体：Helix Innovations LLC (2019收购80% · 2021全资控股 · 年关联 5,500万次便利店行程)","strip2_en":"Operating Co.: Helix Innovations LLC (80% in 2019 · 100% by 2021 · 55M Annual C-Store Trips)","strip3_zh":"数据基准：2026Q3 季报核验 (2026-10-29)","strip3_en":"Baseline: Q3 2026 Release (Oct 29, 2026)","overline_zh":"SMOKE-FREE WORKHORSE 07 · FY25 出货 1.778亿罐 (+10.9%) × Q3'26 出货 4,780万罐 (+13.3%) × 20袋/盒五档阶梯","overline_en":"SMOKE-FREE WORKHORSE 07 · 177.8M FY25 Cans (+10.9%) × 47.8M Q3'26 Cans (+13.3%) × 20-Pouch 5-Strength Ladder","h1_zh":"on! 现代纯白迷你尼古丁袋深度剖析：<span class=\"gradient-accent\">面对 ZYN 霸权与 Velo 补贴狂潮，20 袋方盒微袋如何守住全美第 2 大口含袋阵地并加速冲向 2 亿罐？<\/span>","h1_en":"on! Classic Nicotine Pouches Deep Dive: <span class=\"gradient-accent\">How Helix Scaled a ~$250M Micro-Pouch Acquisition Past 177.8M Annual Cans and +13.3% Q3 Growth<\/span>","lead_zh":"当全美现代纯白尼古丁袋（Oral Nicotine Pouches）占口含烟大盘比重于 2026Q3 历史性冲上 <strong>61.2%<\/strong>（同比猛增 +5.8pp）时，奥驰亚旗下 <strong>Helix Innovations LLC<\/strong> 运营的 <strong>on!<\/strong> 系列（含经典干法迷你袋与新锐 on! PLUS 合并披露口径）交出了强劲扩张答卷：2025 全年出货同比增长 <strong>+10.9%<\/strong> 突破 <strong>1.778 亿罐<\/strong>，2026 年前 9 个月再增 <strong>+7.7%<\/strong> 达 <strong>1.439 亿罐<\/strong>，其中 2026Q3 单季出货大涨 <strong>+13.3%<\/strong> 至 <strong>4,780 万罐<\/strong>，稳占全美整个口含烟大盘 <strong>8.3%<\/strong>（同比 +0.1pp）、占全美尼古丁袋赛道 <strong>13.5%<\/strong> 稳居行业第二梯队领头羊 <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Altria Q3'26 Table 6 & 7 ↗<\/a>。经典款 <strong>on!<\/strong> 凭借无烟叶医药级尼古丁微晶干法工艺、<strong>每盒 20 袋（比 ZYN 经典 15 袋多出 33% 袋数）<\/strong>的扁平长方口袋盒（内置废袋回收暗格）以及全行业最细密的 <strong>1.5mg / 2mg / 3.5mg / 4mg / 8mg<\/strong> 浓度阶梯，成为白领隐蔽使用与渐进减量人群的首选。","lead_en":"As oral nicotine pouches surged to <strong>61.2%<\/strong> of the entire US oral tobacco category in Q3 2026 (+5.8pp YoY), <strong>Helix Innovations' on!<\/strong> franchise grew FY2025 shipments <strong>+10.9% to 177.8M cans<\/strong> and expanded another <strong>+7.7% in 9M 2026 to 143.9M cans<\/strong>—accelerating to <strong>+13.3% YoY (47.8M cans)<\/strong> in Q3 2026 for an <strong>8.3%<\/strong> share of total US oral tobacco and <strong>13.5%<\/strong> share of US nicotine pouches <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Altria Q3'26 Table 6 & 7 ↗<\/a>. Acquired for only ~$250M total in 2019–2021 <a class=\"cite-link\" href=\"https://www.altria.com/about-altria/our-companies/helix-innovations\" target=\"_blank\" rel=\"noopener noreferrer\">Helix Profile ↗<\/a>, classic <strong>on!<\/strong> differentiates against 15-count round-can ZYN via an ultra-discreet dry mini format, a pocket-flat <strong>20-pouch rectangular box<\/strong> (+33% more pouches per can) with front/back disposal catch, and a 5-step nicotine strength ladder (<strong>1.5mg to 8mg<\/strong>).","thesis_cards":[{"title_zh":"20 袋装扁平名片方盒（西装裤袋“零圆圈凸起”）","title_en":"20-Pouch Rectangular Pocket Box (+33% Count vs. ZYN)","desc_zh":"打破百年鼻烟圆罐定式，采用轻薄长方翻盖盒并自带废袋收纳背面仓，每罐 20 袋单袋性价比显著优于 15 袋装 ZYN。","desc_en":"Breaks round-tin convention with a slim rectangular flip-box housing a rear used-pouch catch lid and 20 pouches (+33% more per can than 15-ct ZYN)."},{"title_zh":"1.5mg → 8mg 五档微梯度覆盖“入门到老烟枪”全链路","title_en":"Granular 5-Step Strength Ladder (1.5 / 2 / 3.5 / 4 / 8mg)","desc_zh":"竞品通常仅设 3mg 与 6mg 两档；on! 独有的 1.5mg/2mg 低敏档吸引轻度女性与减量烟民，8mg 高劲档满足重度替代诉求。","desc_en":"5-step nicotine ladder (1.5 / 2 / 3.5 / 4 / 8mg) bookends ZYN's 3mg/6mg setup—capturing micro-dose tapering users and 8mg heavy switchers."},{"title_zh":"干法微晶速释工艺与 ~$2.5 亿超高并购资本效率","title_en":"Dry Micro-Pouch Chemistry & Phenomenal M&A ROI","desc_zh":"对比 PMI 斥资 $160 亿买瑞典火柴（ZYN），奥驰亚仅用约 $2.5 亿买下 on! 并在里士满自建自动化高速产线，早已迈过盈亏平衡成为净现金贡献者。","desc_en":"Acquired by Altria for ~$250M total (vs. PMI's $16B for Swedish Match/ZYN) and automated in Richmond to generate high-ROIC organic cash flow."}],"kpis":[{"label_zh":"2026Q3 单季出货量及增速","label_en":"Q3 2026 Cans & YoY Growth","badge_zh":"较 Q2 增速大幅提速","badge_en":"Re-Accelerated in Q3","val_zh":"47.8M (+13.3%)","val_en":"47.8M (+13.3%)","desc_zh":"较 2025Q3 的 42.2M 罐净增 560 万罐；2026 前9月累计达 143.9M 罐（+7.7%）<a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Q3'26 Table 6 ↗<\/a>","desc_en":"Shipped 47.8M cans in Q3 2026 (+13.3% YoY vs. 42.2M) and 143.9M cans across 9M 2026 (+7.7% YoY) <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Q3'26 Table 6 ↗<\/a>"},{"label_zh":"2025 全年报告出货罐数","label_en":"FY 2025 Total Cans","badge_zh":"折合 >35.5亿小袋!","badge_en":">3.55B Pouches!","val_zh":"177.8M (+10.9%)","val_en":"177.8M (+10.9%)","desc_zh":"较 2024 年 160.3M 罐净增 1,750 万罐，按 20 袋/罐折算全年售出超 35.5 亿枚小袋 <a class=\"cite-link\" href=\"https://www.sec.gov/Archives/edgar/data/764180/000076418026000007/exhibit991erq42025.htm\" target=\"_blank\" rel=\"noopener noreferrer\">FY25 Table 6 ↗<\/a>","desc_en":"Reached 177.8M cans in FY2025 (+10.9% vs. 160.3M in FY24)—exceeding 3.55 billion individual nicotine pouches sold <a class=\"cite-link\" href=\"https://www.sec.gov/Archives/edgar/data/764180/000076418026000007/exhibit991erq42025.htm\" target=\"_blank\" rel=\"noopener noreferrer\">FY25 Table 6 ↗<\/a>"},{"label_zh":"全美尼古丁袋赛道内部份额","label_en":"Share of US Pouch Category","badge_zh":"全美稳居前二/前三","badge_en":"Top-2/3 US Pouch Brand","val_zh":"13.5% (Q3'26)","val_en":"13.5% (Q3'26)","desc_zh":"9M'26 平均袋内份额 13.8%，占整个美国口含烟总市场 8.3%（已超越百年 Skoal 的 4.8%！）<a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Q3'26 Table 7 ↗<\/a>","desc_en":"Captured 13.5% of the US nicotine pouch category in Q3'26 (13.8% 9M) and 8.3% of total US oral tobacco (surpassing Skoal's 4.8%!) <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Q3'26 Table 7 ↗<\/a>"},{"label_zh":"每盒小袋容量规格优势","label_en":"Pouches Per Can Count","badge_zh":"较 ZYN 多装 33%","badge_en":"+33% vs. 15ct ZYN","val_zh":"20 袋 / 盒","val_en":"20 Pouches / Can","desc_zh":"经典方盒标配 20 枚迷你干袋（对比 ZYN 经典圆盒仅 15 枚），单枚使用成本更具竞争力 <a class=\"cite-link\" href=\"https://www.takeroon.com/blog/nicotine-pouch-brands-complete-guide\" target=\"_blank\" rel=\"noopener noreferrer\">US Pouch Guide ↗<\/a>","desc_en":"Packs 20 dry micro-pouches per rectangular box vs. 15 pouches in standard US ZYN cans, lowering cost per pouch <a class=\"cite-link\" href=\"https://www.takeroon.com/blog/nicotine-pouch-brands-complete-guide\" target=\"_blank\" rel=\"noopener noreferrer\">US Pouch Guide ↗<\/a>"}]},"ch1":{"eyebrow":"CHAPTER 01 · DRY MINI POUCH CHEMISTRY, ERGONOMICS & SKU MATRIX","h2_zh":"一、产品工程与形态解剖：一盒火柴盒大小的 20 袋微仓如何俘获办公室白领？","h2_en":"1. Micro-Pouch Engineering: Inside the 20-Count Pocket Box and 5-Strength Matrix","sub_zh":"100% 去烟叶纤维素基底 × 唾液触发瞬时释香 × 社交完全隐形（上唇零鼓包、免吐唾液、零烟味）","sub_en":"100% tobacco-leaf-free cellulose matrix × saliva-activated release × invisible upper-lip fit","badge_zh":"弗吉尼亚州里士满自建自动化高速袋装中心","badge_en":"Automated Richmond Pouch Manufacturing","hub_title_zh":"on! 经典干法迷你体系（极致轻薄隐蔽性 ↔ 精细尼古丁梯度控制）","hub_title_en":"on! Classic Dry Mini Architecture (Maximum Discretion ↔ Precision Nicotine Dosing)","hub_sub_zh":"与传统 1.2oz 大圆铁罐湿鼻烟彻底切割 · 打开飞机客舱、写字楼会议室、医院与无烟公共场所全天候增量场景","hub_sub_en":"Unlocks indoor offices, flights, and smoke-free venues where combustible cigarettes and spit-cup MST cannot go","nodes":[{"tag_zh":"MICRO DRY FORMAT · 极小干袋","tag_en":"DRY MINI POUCH","name_zh":"超迷你纯白无染色微袋","name_en":"Ultra-Compact Stain-Free Mini","desc_zh":"体积小于主流湿袋与传统唇烟袋，贴合牙龈上唇外部完全看不出痕迹，不黄牙、无需冷藏、保质期长。","desc_en":"Discreet, stain-free, spit-free dry cellulose micro-pouch invisible under the lip with long ambient shelf stability."},{"tag_zh":"20-CT POCKET BOX · 双仓方盒","tag_en":"20-CT DUAL-CHAMBER BOX","name_zh":"正面取新袋 + 背面存废袋","name_en":"Front Dispenser + Rear Catch Lid","desc_zh":"精巧注塑方盒背面设有翻盖废袋暂存格，完美解决室内无垃圾桶时的礼仪痛点。","desc_en":"Injection-molded rectangular flip-top box integrates a hidden rear compartment for hygienic used-pouch disposal."},{"tag_zh":"7 FLAVOR PROFILES · 七大风味","tag_en":"7 CORE FLAVORS","name_zh":"Mint · Wintergreen · Cinnamon · Coffee · Citrus · Berry · Original","name_en":"Mint / Wintergreen / Coffee / Cinnamon / Citrus","desc_zh":"除主流薄荷冬青外，Coffee（浓郁咖啡）与 Cinnamon（辛香肉桂）拥有极高早晨通勤与办公伴侣复购率。","desc_en":"Alongside Mint and Wintergreen, Coffee and Cinnamon SKUs enjoy sticky morning-commute and desk-worker repeat rates."},{"tag_zh":"LOW-DOSE ENTRY · 轻度与减量档","tag_en":"1.5mg & 2mg ENTRY TIERS","name_zh":"1.5mg & 2mg 超低尼古丁梯度","name_en":"1.5mg & 2mg Step-Down Tiers","desc_zh":"全美主流货架罕见的 <2mg 微剂量规格，深受希望逐步降低尼古丁依赖的成年烟民青睐。","desc_en":"Rare sub-2mg micro-strength options favored by light poly-nicotine adults and step-down smokers."},{"tag_zh":"CORE & HIGH · 主力与重度档","tag_en":"3.5mg, 4mg & 8mg CORE/HIGH","name_zh":"3.5mg / 4mg 主力与 8mg 强劲档","name_en":"3.5mg / 4mg Core & 8mg Strong","desc_zh":"8mg 高浓度档比 ZYN 美版上限（6mg）高出 33% 尼古丁含量，精准留住从卷烟或湿鼻烟转来的老烟枪。","desc_en":"Top 8mg tier delivers 33% more nicotine per pouch than US ZYN's 6mg ceiling, retaining heavy cigarette/snuff switchers."},{"tag_zh":"RGM PRICING · 促销收敛提毛利","tag_en":"RGM PRICE REALIZATION","name_zh":"从 $1.99 早期获客迈向 ~$4.50+ 净价收获","name_en":"Graduating from $1.99 Trial to Profit Harvest","desc_zh":"摆脱 2021–2023 早期重度买赠期，随品牌复购成型稳步拉升单罐净实现价。","desc_en":"Graduated from early $1.99 trial promos into disciplined multi-can pricing that accretes directly to Oral segment margins."}],"platform_bars":[{"title_zh":"出货量早已历史性反超百年老二 Skoal（143.9M vs 84.5M 罐）","title_en":"Surpassed Century-Old Skoal as Altria's #2 Oral Brand by Volume","sub_zh":"2026前9月 on! 出货 143.9M 罐，已是 Skoal（84.5M 罐）的 1.70 倍，成为奥驰亚口含烟名副其实的第二增长极。","sub_en":"At 143.9M cans in 9M 2026, on! is now 1.70x larger by can volume than century-old Skoal (84.5M)—Altria's #2 oral brand."},{"title_zh":"与 on! PLUS 构成“干法迷你 20袋 + 湿润大袋 NICOSILK”双剑合璧","title_en":"Complementary Pairing with Next-Gen Moist Large-Pouch on! PLUS","sub_zh":"经典 on! 锁定喜爱小巧干爽与 8mg/Coffee 的熟客，on! PLUS 进攻偏爱饱满柔软湿感的高溢价人群。","sub_en":"Segments the shelf cleanly: Classic on! serves discreet dry 20-ct/8mg/Coffee fans while on! PLUS attacks plush moist round-can buyers."}],"principles":[{"title_zh":"1. 罐数口径严重低估了 on! 的真实“小袋份额（Pouch Share）”","title_en":"1. Can-Based Share Understates True 'Per-Pouch' Consumption Share","desc_zh":"Circana 按销售罐数统计 on! 占尼古丁袋 <strong>13.5%<\/strong>，但由于 ZYN 每罐仅 15 袋、Velo Plus 早期部分规格 14–20 袋，而经典 on! 每盒装满 <strong>20 袋<\/strong>，若按实际消耗小袋枚数计算，on! 真实消费份额高出约 2–3 个百分点 <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Table 7 Note ↗<\/a>！","desc_en":"Circana tracks can share (<strong>13.5%<\/strong>), but because Classic on! holds <strong>20 pouches/can<\/strong> vs. ZYN's 15 pouches, on!'s true per-pouch consumption share is ~2–3pp higher <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Table 7 Note ↗<\/a>."},{"title_zh":"2. 摆脱促销战泥潭：容忍短期袋内份额微调换取盈利大跃升","title_en":"2. Disciplined Promo Restraint vs. BAT Velo's Deep Discounting","desc_zh":"面对英美烟草（BAT）为推 Velo Plus 大洒低价补贴，Helix 拒绝陷入无底线 $1.99 价格战，在稳住总口含份额 <strong>8.3%<\/strong>（同比 +0.1pp）的同时保持口含分部 66.8% 高利润率 <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Q3'26 Oral ↗<\/a>。","desc_en":"While BAT leaned on steep promos to launch Velo Plus, Helix avoided value-destroying $1.99 price wars—holding <strong>8.3%<\/strong> total oral share (+0.1pp YoY) at a 66.8% segment margin <a class=\"cite-link\" href=\"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx\" target=\"_blank\" rel=\"noopener noreferrer\">Q3'26 Oral ↗<\/a>."},{"title_zh":"3. 5,500 万次便利店年关联行程构建强复购飞轮","title_en":"3. 55 Million Annual Convenience-Store Trips & Rising","desc_zh":"2026 NACS 披露 Helix 已独立驱动每年 <strong>5,500 万次<\/strong> 便利店进店行程，为后续新风味上架打下坚实动销底座 <a class=\"cite-link\" href=\"https://www.2firsts.com/news/altria-showcases-ploom-marlboro-heated-tobacco-sticks-and-non-nicotine-energy-products-at-nacs-show-2026\" target=\"_blank\" rel=\"noopener noreferrer\">2Firsts NACS ↗<\/a>。","desc_en":"NACS 2026 disclosures confirm Helix already generates <strong>55 million annual convenience-store trips<\/strong>, anchoring velocities for new line extensions <a class=\"cite-link\" href=\"https://www.2firsts.com/news/altria-showcases-ploom-marlboro-heated-tobacco-sticks-and-non-nicotine-energy-products-at-nacs-show-2026\" target=\"_blank\" rel=\"noopener noreferrer\">2Firsts NACS ↗<\/a>."}],"alert_zh":"<strong>并购性价比封神之战：<\/strong>同样切入美国现代尼古丁袋赛道，菲莫国际（PMI）在 2022 年花了约 <strong>$160 亿美元<\/strong> 收购瑞典火柴才拿下 ZYN；而奥驰亚在 2019–2021 年分两步收购 on! 全部股权总计仅花费约 <strong>$2.5 亿美元<\/strong>（不到 PMI 出价的 1.6%！），如今每年稳定出货近 <strong>1.9 亿罐<\/strong> <a class=\"cite-link\" href=\"https://www.altria.com/about-altria/our-companies/helix-innovations\" target=\"_blank\" rel=\"noopener noreferrer\">Altria Helix ↗<\/a>。","alert_en":"<strong>Unmatched Capital Efficiency:<\/strong> Whereas PMI paid <strong>~$16 billion<\/strong> for Swedish Match (ZYN) in 2022, Altria acquired 100% of <strong>on!<\/strong> across 2019–2021 for roughly <strong>~$250 million<\/strong> (<1.6% of PMI's outlay) and scaled it into a ~190M-can/year profit generator <a class=\"cite-link\" href=\"https://www.altria.com/about-altria/our-companies/helix-innovations\" target=\"_blank\" rel=\"noopener noreferrer\">Altria Helix ↗<\/a>.","chart":{"tabA_zh":"视图A: 季度出货罐数与尼古丁袋渗透率跃升","tabA_en":"View A: Quarterly Cans & Category Expansion","tabB_zh":"视图B: 全美主流尼古丁袋每盒袋数与最高浓度对比","tabB_en":"View B: Pouches/Can & Max Strength Comparison","viewA":{"mode":"dual_bar_line","title_zh":"on! 系列报告出货量（百万罐）vs 尼古丁袋占全美口含烟大盘比重（%）","title_en":"on! Franchise Shipments (M Cans) vs. Nicotine Pouch Share of Total US Oral (%)","sub_zh":"伴随尼古丁袋占口含大盘从 46.5% 跃升至 61.2%，on! 单季出货稳站 4,600万–5,000万罐高位平台","sub_en":"As pouches climbed from 46.5% (Q4'24) to 61.2% (Q3'26) of US oral tobacco, on! re-accelerated +13.3% YoY in Q3","leg1_zh":"on! 单季报告出货罐数 (左轴 · M罐)","leg1_en":"on! Quarterly Cans Shipped (Left · M)","leg2_zh":"尼古丁袋占全美口含烟总盘比 (右轴 · %)","leg2_en":"Pouch Category % of US Oral (Right · %)","labels_zh":["2024Q4","2025Q3","2025Q4","2026Q2","2026Q3"],"labels_en":["Q4 2024","Q3 2025","Q4 2025","Q2 2026","Q3 2026"],"subs_zh":["43.9M 罐","42.2M 罐","44.2M 罐","49.9M 峰值","47.8M (+13.3% YoY)"],"subs_en":["43.9M cans","42.2M cans","44.2M cans","49.9M peak","47.8M (+13.3% YoY)"],"s1":[43.9,42.2,44.2,49.9,47.8],"s2":[46.5,55.4,56.9,59.9,61.2],"max1":60,"max2":70,"u1":"M","u2":"%"},"viewB":{"mode":"grouped_bars","title_zh":"on! 年度/阶段累计出货罐数对比：2024 vs 2025 及 2025前9月 vs 2026前9月（百万罐）","title_en":"on! Cumulative Shipment Growth: Prior vs. Current Period (Million Cans)","sub_zh":"连续保持高个位数至双位数罐数扩张，2026 全年有望历史性冲击 ~1.92亿–1.95亿罐","sub_en":"Consistent volume expansion putting FY2026 on pace for ~192M–195M total cans","leg1_zh":"当期出货罐数 (百万罐)","leg1_en":"Current Period Cans (M)","leg2_zh":"上年同期出货罐数 (百万罐)","leg2_en":"Prior Period Cans (M)","labels_zh":["2025全年 vs 2024","2026Q1 vs 2025Q1","2026Q3 vs 2025Q3","2026前9月 vs 2025前9月"],"labels_en":["FY25 vs FY24","Q1'26 vs Q1'25","Q3'26 vs Q3'25","9M'26 vs 9M'25"],"subs_zh":["+10.9% (+17.5M)","+17.6% 强劲开局","+13.3% (+5.6M)","+7.7% (+10.3M)"],"subs_en":["+10.9% (+17.5M)","+17.6% Q1 surge","+13.3% (+5.6M)","+7.7% (+10.3M)"],"s1":[177.8,46.2,47.8,143.9],"s2":[160.3,39.3,42.2,133.6],"max1":200,"u1":"M","u2":"M"}},"matrix_cards":[{"title_zh":"干法微袋（on!）与湿润大袋（on! PLUS）为何必须双线并存？","title_en":"Why Dry Mini (on!) and Moist Soft-Feel (on! PLUS) Co-Exist","badge_zh":"双细分互补不互搏","badge_en":"Complementary Formats","body_zh":"美国尼古丁袋消费者明显分化为两大阵营：<strong>白领/轻度/原卷烟客群<\/strong>偏爱像口香糖颗粒般干爽无感的小微袋（ZYN 与经典 on! 阵营）；而<strong>原湿鼻烟（Dipper）与欧洲唇烟客群<\/strong>则嫌小干袋太薄，偏爱饱满湿润柔软的大袋（Velo Plus、Rogue 与 on! PLUS 阵营）。","detail_zh":"过去 Helix 只有干法小微袋一条腿走路，如今保留经典 on! 稳守干袋基本盘，再用 on! PLUS 切入湿润大袋增量池，彻底补齐了产品矩阵短板。","body_en":"US pouch users split between office switchers preferring discreet dry mini pouches (ZYN & classic on!) and traditional oral users craving plush, moisture-rich larger pouches (Rogue, Velo Plus & on! PLUS).","detail_en":"Running both classic on! and on! PLUS lets Helix attack 100% of consumer mouthfeel preferences."},{"title_zh":"经典款 on! 的 FDA PMTA 审查长跑与合规在售状态","title_en":"Classic on! FDA PMTA Review Status & Enforcement Discretion","badge_zh":"2020.05 已递交 PMTA","badge_en":"Pending FDA PMTA","body_zh":"Helix 早在 2020 年 5 月即向 FDA 递交了经典款 on! 全系 35 款 SKU 的上市前申请（PMTA），目前处于 FDA 科学审查阶段并合法在美全渠道销售；而兄弟线 on! PLUS 已率先于 2025.12 走通试点快速获批通道 <a class=\"cite-link\" href=\"https://www.fda.gov/tobacco-products/ctp-newsroom/fda-authorizes-6-nicotine-pouch-products-completing-review-record-time\" target=\"_blank\" rel=\"noopener noreferrer\">FDA Pouch List ↗<\/a>。","detail_zh":"on! PLUS 在创纪录时间内获批，印证了 Helix 毒理与无致癌亚硝胺（HPHCs）申报材料的高水准，为经典款后续过审奠定了积极先例。","body_en":"Helix filed PMTAs for classic on! SKUs in May 2020 (currently marketed under FDA review), while sibling on! PLUS cleared FDA's expedited pilot program in Dec 2025 <a class=\"cite-link\" href=\"https://www.fda.gov/tobacco-products/ctp-newsroom/fda-authorizes-6-nicotine-pouch-products-completing-review-record-time\" target=\"_blank\" rel=\"noopener noreferrer\">FDA Pouch List ↗<\/a>.","detail_en":"Helix's scientific dossier quality proven on on! PLUS bodes well for classic on! regulatory durability."}]},"ch2":{"eyebrow":"CHAPTER 02 · FOUR MICRO-POUCH PILLARS & 5-AXIS POUCH RADAR","h2_zh":"二、四大差异化支柱：on! 如何在 ZYN 的阴影下长成年销近 2 亿罐巨头？","h2_en":"2. Four Product Pillars: Scaling Past ~190M Cans Against ZYN","badge_zh":"护城河定性：形态差异化 + 30万店AGDC分销杠杆","badge_en":"Moat Rating: Form-Factor Edge + AGDC 300K-Door Reach","pillars":[{"title_zh":"01 · 20 袋装扁平方盒（单盒袋数 +33% 实惠 + 西装袋隐形）","title_en":"01 · 20-Count Rectangular Pocket Pack (+33% Pouches vs. ZYN)","badge_zh":"20袋 vs ZYN 15袋","badge_en":"20ct vs. ZYN 15ct","desc_zh":"不鼓包名片盒造型 + 背面废袋暗仓，每买 3 盒经典 on! 等于买 4 罐 ZYN 的袋数。","note_zh":"<strong>当前选中支柱解读（01 20袋方盒）：<\/strong>高频日均使用 8–10 袋的消费者一罐 ZYN 仅够用一天半，而一盒 20 袋装 on! 稳够两天，形成了极强的日用算账粘性 <a class=\"cite-link\" href=\"https://www.takeroon.com/blog/nicotine-pouch-brands-complete-guide\" target=\"_blank\" rel=\"noopener noreferrer\">Pouch Guide ↗<\/a>。","note_en":"<strong>Selected Pillar (01 · 20-Pouch Value & Pocket Fit):<\/strong> Heavy daily users get two full days out of a 20-count on! pocket box versus 1.5 days from a 15-count ZYN can <a class=\"cite-link\" href=\"https://www.takeroon.com/blog/nicotine-pouch-brands-complete-guide\" target=\"_blank\" rel=\"noopener noreferrer\">Pouch Guide ↗<\/a>.","desc_en":"Slim no-bulge pocket box + rear catch lid; buying 3 cans of 20-count Classic on! equals the pouch count of 4 ZYN cans."},{"title_zh":"02 · 全行业最宽 1.5mg–8mg 五档精准剂量阶梯","title_en":"02 · Industry-Widest 1.5mg to 8mg Strength Spectrum","badge_zh":"独有 2mg & 8mg 档","badge_en":"5 Strength Steps","desc_zh":"上下两端通吃 ZYN（仅 3mg/6mg）未能满足的微剂量入门客与 8mg 重度老烟枪。","note_zh":"<strong>当前选中支柱解读（02 浓度两端卡位）：<\/strong>8mg 高劲道版本是吸引每日一包以上红万烟民无痛过渡的杀手锏，而 2mg 版本则牢牢锁住轻度白领。","note_en":"<strong>Selected Pillar (02 · 2mg & 8mg Bookends):<\/strong> Captures light users intimidated by 3mg and heavy pack-a-day smokers needing >6mg satisfaction.","desc_en":"Spans 1.5mg/2mg micro-doses up to 8mg high-kick pouches—bookending ZYN's narrow 3mg & 6mg US lineup."},{"title_zh":"03 · AGDC 现成 30 万零售门头与万宝路数字私域导流","title_en":"03 · AGDC 300K-Store Distribution & Marlboro Cross-Promo","badge_zh":"极低获客边际成本","badge_en":"First-Party Smoker Funnel","desc_zh":"直接向数百万实名认证 21+ 万宝路与哥本哈根数据库会员精准推送试享券。","note_zh":"<strong>当前选中支柱解读（03 私域精准转化）：<\/strong>在大众广告严受限条件下，奥驰亚庞大的存量烟民私域库是全美成本最低的无烟产品获客金矿。","note_en":"<strong>Selected Pillar (03 · First-Party Smoker Database):<\/strong> Altria converts verified 21+ combustible smokers directly into Helix buyers at low customer-acquisition cost.","desc_en":"Cross-markets directly to millions of age-verified 21+ smokers inside PM USA's Marlboro digital database."},{"title_zh":"04 · 里士满本土自动化制造免疫关税与跨国断货冲击","title_en":"04 · Domestic Richmond Manufacturing Avoids Import Bottlenecks","badge_zh":"2024 ZYN缺货受益者","badge_en":"100% US Supply Resilience","desc_zh":"2024 年 ZYN 曾因肯塔基单厂产能瓶颈全美大面积断货，Helix 凭充裕本土产能在架率稳居前列。","note_zh":"<strong>当前选中支柱解读（04 本土供应链韧性）：<\/strong>里士满制造基地不仅保障美国本土不断货，更为单罐制造成本持续下探提供规模杠杆。","note_en":"<strong>Selected Pillar (04 · Domestic Supply Chain):<\/strong> Automated Richmond lines avoided the 2024 canister shortages that hit ZYN, capturing trial among out-of-stock shoppers.","desc_en":"Automated Richmond manufacturing avoided the 2024 single-plant Kentucky supply shortages that plagued ZYN."}],"radar":{"title_zh":"美国现代尼古丁袋核心品牌五维竞争力雷达图（10分制）","title_en":"5-Axis US Nicotine Pouch Brand Radar (10-Point Scale)","axes_zh":["单盒袋数性价比","浓度与风味宽度","口袋隐蔽便携度","品牌心智统治力","FDA已获批覆盖度"],"axes_en":["Count Value (20ct)","Strength Breadth","Pocket Discretion","Brand Mindshare","FDA MGO Coverage"],"s0_zh":"on! 经典干法微袋 (Helix · 20袋 · 5档浓度)","s0_en":"on! Classic (Helix · 20ct · 1.5–8mg)","s1_zh":"ZYN 经典圆盒 (PMI · 15袋 · 行业绝对霸主)","s1_en":"ZYN (PMI · 15ct · Category Juggernaut)","s2_zh":"Velo / Rogue (BAT / Swisher 湿袋追赶者)","s2_en":"Velo / Rogue (BAT / Swisher Challengers)","v0":[9.6,9.5,9.8,7.8,7.6],"v1":[7.2,7.4,8.2,9.9,9.8],"v2":[9.2,8.8,7.5,7.4,6.2]}},"ch3":{"eyebrow":"CHAPTER 03 · U.S. NICOTINE POUCH CATEGORY BENCHMARKING","h2_zh":"三、全美现代尼古丁袋四大阵营横向对比：70 亿美元高速赛道的排位战","h2_en":"3. US Nicotine Pouch Matrix: Benchmarking ZYN, on!, Velo & Rogue","peers_zh":[{"category":"altria","benchmark":true,"title":"研究标的：on! 经典干法迷你尼古丁袋","creator":"Helix Innovations LLC (奥驰亚全资)","format":"20袋扁平长方口袋盒 · 干法微袋","craft":"1.5mg / 2mg / 3.5mg / 4mg / 8mg × 7种风味","views":"FY25 177.8M 罐 (+10.9%) · Q3'26 47.8M 罐 (+13.3%)","acclaim":"口含总份额 8.3% / 袋内 13.5% · 5,500万次年客流","takeaway":"20袋容量 + 8mg高劲道 + 咖啡/肉桂特色风味，稳坐全美干法微袋第二把交椅。","sourceLabel":"Altria Q3'26","sourceUrl":"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx"},{"category":"altria","benchmark":false,"title":"on! PLUS 下一代柔感湿润大袋","creator":"Helix Innovations LLC (奥驰亚全资)","format":"儿童安全圆罐 + 废袋盖 · NICOSILK™ 柔感湿袋","craft":"6mg / 9mg (FDA已批6款) + 12mg & 蓝莓/芒果新风味","views":"2026Q2 已铺货全美 120,000 家门店","acclaim":"2025.12 首批走通 FDA 试点神速获批!","takeaway":"补齐经典 on! 偏小偏干短板，正面抢食 ZYN 高端客与 Rogue/Velo 湿袋客群。","sourceLabel":"FDA / Altria","sourceUrl":"https://www.fda.gov/tobacco-products/ctp-newsroom/fda-authorizes-6-nicotine-pouch-products-completing-review-record-time"},{"category":"external","benchmark":false,"title":"ZYN 尼古丁袋 (全美现象级霸主)","creator":"Swedish Match / 菲莫国际 (PMI)","format":"15袋经典圆罐 · 干法标准袋 (3mg & 6mg)","craft":"极简医药级尼古丁盐 · Cool Mint / Wintergreen 等 10 风味","views":"独占全美尼古丁袋 ~65%+ 份额 · 2026 预计 ~7.5亿罐","acclaim":"2025.01 独揽首批 20 款 FDA PMTA 授权","takeaway":"文化破圈先发优势极强，但每罐仅 15 袋且最高仅 6mg，给 8mg/9mg/12mg 留出突破口。","sourceLabel":"Tobacco Tactics","sourceUrl":"https://www.tobaccotactics.org/article/nicotine-pouches/"},{"category":"external","benchmark":false,"title":"Velo & Velo Plus (重金补贴追赶者)","creator":"R.J. Reynolds / 英美烟草 (BAT)","format":"圆罐湿润合成尼古丁袋 (20袋装 Velo Plus)","craft":"收购欧洲 Grizzly/Lyft 配方改良湿感大袋 · 多果味重补贴","views":"凭激进促销在 2025–2026 快速抢占袋内份额","acclaim":"促销折让极重 · 全球与 PMI 各占约 1/3 份额","takeaway":"导致 2025–2026 美国尼古丁袋货架促销战白热化，短期分流了部分价格敏感型 on! 份额。","sourceLabel":"Tobacco Tactics","sourceUrl":"https://www.tobaccotactics.org/article/nicotine-pouches/"},{"category":"external","benchmark":false,"title":"Rogue 罗格 & ZONE","creator":"Swisher International / Imperial Brands","format":"20袋铁盖大圆罐 · 大号湿润果味袋","craft":"Mango / Honey Lemon / Wintergreen 甜润大袋","views":"Tobacco Insider 披露与 ZYN、on! 同列全美前四阵营","acclaim":"果味受欢迎但尚无 FDA PMTA 正式授权令","takeaway":"未来若 FDA 严格清退未获批果味袋，已握有 FDA 批文的 Helix 与 ZYN 将直接收编其货架。","sourceLabel":"GMI / Insider","sourceUrl":"https://www.gminsights.com/industry-analysis/nicotine-pouches-market"}],"peers_en":[{"category":"altria","benchmark":true,"title":"Subject: on! Classic Dry Mini Pouches","creator":"Helix Innovations LLC (Altria 100%)","format":"20-Pouch Rectangular Pocket Box · Dry Mini","craft":"1.5 / 2 / 3.5 / 4 / 8mg across 7 flavors","views":"177.8M FY25 cans (+10.9%) · 47.8M Q3'26 cans (+13.3%)","acclaim":"8.3% US oral share / 13.5% pouch share · 55M trips","takeaway":"20-count value, 8mg top strength, and pocket-flat box anchor #2 dry-pouch status.","sourceLabel":"Altria Q3'26","sourceUrl":"https://investor.altria.com/press-releases/news-details/2026/Altria-Reports-2026-Third-Quarter-and-Nine-Months-Results-Announces-Expanded-Share-Repurchase-Program-Raises-2026-Full-Year-Earnings-Guidance/default.aspx"},{"category":"altria","benchmark":false,"title":"on! PLUS Soft-Feel Moist Pouches","creator":"Helix Innovations LLC (Altria 100%)","format":"Child-Resistant Round Can · NICOSILK™ Soft Pouch","craft":"6mg & 9mg (6 FDA-authorized SKUs) + 12mg & fruit-mints","views":"Expanded to 120,000 US stores in Q2 2026","acclaim":"First product cleared under FDA's Dec 2025 Pilot!","takeaway":"Closes the plush moist-pouch gap against Velo Plus and Rogue while out-dosing 6mg ZYN.","sourceLabel":"FDA / Altria","sourceUrl":"https://www.fda.gov/tobacco-products/ctp-newsroom/fda-authorizes-6-nicotine-pouch-products-completing-review-record-time"},{"category":"external","benchmark":false,"title":"ZYN (#1 US Nicotine Pouch Juggernaut)","creator":"Swedish Match / PMI","format":"15-Pouch Round Can · Dry Standard (3mg & 6mg)","craft":"Nicotine bitartrate salt · 10 flavors","views":"~2/3 of US pouch market · ~750M est. 2026 US cans","acclaim":"20 SKUs FDA PMTA authorized Jan 2025","takeaway":"Unmatched cultural mindshare, but 15ct count and 6mg ceiling leave room for Helix.","sourceLabel":"Tobacco Tactics","sourceUrl":"https://www.tobaccotactics.org/article/nicotine-pouches/"},{"category":"external","benchmark":false,"title":"Velo & Velo Plus","creator":"R.J. Reynolds / BAT","format":"20-Pouch Moist Synthetic Round Can","craft":"Plush moisture-rich pouches backed by heavy promo discounting","views":"Aggressive 2025–2026 share gains via deep retail promos","acclaim":"Co-leads global pouches (~1/3 ex-US with BAT)","takeaway":"Heavy promotional spending pressured category margins, testing Helix's pricing discipline.","sourceLabel":"Tobacco Tactics","sourceUrl":"https://www.tobaccotactics.org/article/nicotine-pouches/"},{"category":"external","benchmark":false,"title":"Rogue & ZONE","creator":"Swisher International / Imperial Brands","format":"20-Pouch Tin-Lid Can · Large Sweet Pouches","craft":"Mango, Honey Lemon & Wintergreen moist pouches","views":"Top-4 US visibility alongside ZYN, on! & Velo","acclaim":"Zero FDA PMTA granted orders as of Oct 2026","takeaway":"Exposed to future FDA enforcement compared with Helix's authorized on! PLUS portfolio.","sourceLabel":"GMI / Insider","sourceUrl":"https://www.gminsights.com/industry-analysis/nicotine-pouches-market"}],"bars":{"title_zh":"on! 在奥驰亚口含烟内部地位跃迁：占集团口含总出货罐数比重逐年攀升（%）","title_en":"on! Franchise Expansion as % of Total Altria Oral Tobacco Cans Shipped (%)","sub_zh":"核验自奥驰亚 Table 6：on! 占集团口含总罐数比例已从 2024 年的 20.7% 跃升至 2026Q3 的 28.0%","sub_en":"Verified via Altria Table 6: on! surged from 20.7% of Altria's oral cans in FY24 to 28.0% in Q3 2026","badge_zh":"Q3'26 已占集团口含罐数 28.0%","badge_en":"28.0% of Altria Oral Cans in Q3'26","leg1_zh":"蓝色/绿色：on! 占奥驰亚口含烟分部总出货罐数比例 (%)","leg1_en":"Blue / Green: on! % of Total Altria Oral Cans Shipped (%)","leg2_zh":"紫色/琥珀：全美尼古丁袋占整个美国口含烟大盘比重参照 (%)","leg2_en":"Purple / Amber: Industry Pouch % of US Oral Benchmark (%)","max_x":65,"ref_line":25,"items_zh":[{"label":"全美尼古丁袋占美国口含烟大盘比重 (Q3 2026)","val":61.2,"disp":"61.2%","sub":"2024 全年为 43.3%","note":"两年半狂飙 +17.9 个百分点，彻底主导口含赛道"},{"label":"on! 占奥驰亚口含烟总出货比重 (2026Q3: 47.8M/170.6M)","val":28.0,"disp":"28.0%","sub":"创单季内部占比新高","note":"接近集团每卖出 3.5 罐口含烟就有 1 罐是 on!"},{"label":"on! 占奥驰亚口含烟总出货比重 (2026前9月: 143.9M/522.2M)","val":27.6,"disp":"27.6%","sub":"较 2025前9月 (24.2%) +3.4pp","note":"内部无烟新旧动能加速切换"},{"label":"on! 占奥驰亚口含烟总出货比重 (2025全年: 177.8M/732.4M)","val":24.3,"disp":"24.3%","sub":"全年净增 1,750万罐","note":"稳超 Skoal 成为集团第二大口含单品"},{"label":"on! 占奥驰亚口含烟总出货比重 (2024全年: 160.3M/774.7M)","val":20.7,"disp":"20.7%","sub":"历史起点参照","note":"两年内内部权重提升逾 7.3 个百分点"},{"label":"on! 占全美尼古丁袋赛道内部零售份额 (Q3 2026)","val":13.5,"disp":"13.5%","sub":"9M'26 平均为 13.8%","note":"按20袋折算实际消耗枚数占比约 ~16%"}],"items_en":[{"label":"Industry Nicotine Pouches % of US Oral (Q3 2026)","val":61.2,"disp":"61.2%","sub":"Up from 43.3% in FY2024","note":"+17.9pp shift in under three years"},{"label":"on! % of Altria Oral Cans (Q3'26: 47.8M / 170.6M)","val":28.0,"disp":"28.0%","sub":"Record internal mix share","note":"Nearly 3 in 10 Altria oral cans are on!"},{"label":"on! % of Altria Oral Cans (9M'26: 143.9M / 522.2M)","val":27.6,"disp":"27.6%","sub":"+3.4pp vs. 9M 2025 (24.2%)","note":"Steady internal portfolio transformation"},{"label":"on! % of Altria Oral Cans (FY25: 177.8M / 732.4M)","val":24.3,"disp":"24.3%","sub":"+17.5M net cans added","note":"1.39x larger than Skoal in FY25"},{"label":"on! % of Altria Oral Cans (FY24: 160.3M / 774.7M)","val":20.7,"disp":"20.7%","sub":"FY2024 baseline","note":"+7.3pp internal mix expansion since 2024"},{"label":"on! Retail Share Within US Pouch Category (Q3'26)","val":13.5,"disp":"13.5%","sub":"13.8% across 9M 2026","note":"~16% adjusted for 20-pouch count"}]}},"ch4":{"eyebrow":"CHAPTER 04 · POUCH UNIT ECONOMICS & ~$250M M&A PAYBACK SIMULATOR","h2_zh":"四、单盒经济学与回报模拟：~$2.5 亿买下的 on! 创造了多少倍资本神话？","h2_en":"4. Pouch Unit Economics & Simulator: Compounding a ~$250M Buyout Into a Billion-Dollar Franchise","sub_zh":"去烟叶合成/提取基料成本极低 + 里士满高速自动化袋装 + 零农田发酵周期 = 成熟期毛利率直逼 70%","sub_en":"Zero multi-year tobacco leaf aging + high-speed automated pouching + minimal excise = ~65%–70% mature margin potential","badge_zh":"Q3'26 同比提速至 +13.3%","badge_en":"Q3'26 Accelerated to +13.3% YoY","econ_cards":[{"label_zh":"ACQUISITION COST","label_en":"ACQUISITION COST","val_zh":"~$250M 总价","val_en":"~$250M Total","desc_zh":"2019 买 80% + 2020/2021 买剩余 20%，对比 JUUL ($12.8B) 与 NJOY ($2.75B) 堪称神级捡漏。","desc_en":"~$250M total investment (80% in 2019 + 20% in 2020–2021)—an extraordinary capital-efficiency win vs. $12.8B JUUL or $2.75B NJOY."},{"label_zh":"9M'26 RUN-RATE","label_en":"9M'26 RUN-RATE","val_zh":"~192M 罐/年","val_en":"~192M Cans/Yr","desc_zh":"前9月 143.9M 罐折合年化超 1.9 亿罐（约 38 亿枚尼古丁小袋）。","desc_en":"143.9M 9M'26 cans annualize to ~192M cans/yr (~3.84 billion individual nicotine pouches)."},{"label_zh":"RAW MATERIAL COST","label_en":"RAW MATERIAL COST","val_zh":"< $0.45 / 盒","val_en":"< $0.45 / Can","desc_zh":"微晶纤维素+食品香精+尼古丁盐+PP塑料方盒，全自动制造成本远低于三年陈化真烟叶。","desc_en":"Pharmaceutical-grade nicotine salt + microcrystalline cellulose + PP box cost <$0.45/can vs. multi-year aged tobacco leaf."},{"label_zh":"EXCISE TAX ADVANTAGE","label_en":"EXCISE TAX ADVANTAGE","val_zh":"多州极低税负","val_en":"Low Excise Drag","desc_zh":"无烟叶纯尼古丁袋在联邦与多个州税负极轻，随促销补贴回收净利率弹性极大。","desc_en":"Tobacco-leaf-free formulation enjoys minimal federal/state excise burden, unlocking steep margin expansion as promos normalize."}],"combo":{"title_zh":"on! 年度及年化出货罐数（百万罐）vs 终端净价回收爬坡指数（2022=100）","title_en":"on! Annualized Cans Shipped (M) vs. Net Price Realization Index (2022=100)","sub_zh":"告别早期重度买赠获客阶段后，实现出货量接近 2 亿罐与单盒净实现价同步双升","sub_en":"Graduated from early $1.99 trial promos into ~192M annualized cans with rising per-can net realization","badge_zh":"量价齐升黄金期","badge_en":"Volume + Realization Compounding","left_zh":"■ 左轴：年度/年化出货罐数 (百万罐)","left_en":"■ Left Axis: Annual Cans Shipped (M)","right_