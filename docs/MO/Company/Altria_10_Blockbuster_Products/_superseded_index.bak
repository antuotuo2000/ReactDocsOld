    function highlightMatch(text, query) {
      var safe = escapeHtml(text);
      if (!query) return safe;
      var escapedQ = query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
      var re = new RegExp('(' + escapedQ + ')', 'gi');
      return safe.replace(re, '<mark class="hl">$1</mark>');
    }

    function syncHeaderAndSidebarForIp(ip) {
      var en = isEn();
      var monoEl = document.getElementById('appbarMonogram');
      if (monoEl) monoEl.textContent = ip.monogram;

      var crumbEl = document.getElementById('appbarCrumbCurrent');
      if (crumbEl) {
        crumbEl.setAttribute('data-i18n-zh', ip.crumb_zh);
        crumbEl.setAttribute('data-i18n-en', ip.crumb_en);
        crumbEl.textContent = en ? ip.crumb_en : ip.crumb_zh;
      }

      var b1 = document.getElementById('appbarBadgePlatform');
      if (b1) {
        b1.setAttribute('data-i18n-zh', ip.chip1_zh);
        b1.setAttribute('data-i18n-en', ip.chip1_en);
        b1.textContent = en ? ip.chip1_en : ip.chip1_zh;
      }

      var b2 = document.getElementById('appbarBadgeStatus');
      if (b2) {
        b2.setAttribute('data-i18n-zh', ip.chip2_zh);
        b2.setAttribute('data-i18n-en', ip.chip2_en);
        b2.textContent = en ? ip.chip2_en : ip.chip2_zh;
      }

      var sbTag = document.getElementById('sideBrandTag');
      if (sbTag) sbTag.textContent = ip.sidebar.badge;

      var sbTitle = document.getElementById('sideCardTitle');
      if (sbTitle) {
        sbTitle.setAttribute('data-i18n-zh', ip.sidebar.title_zh);
        sbTitle.setAttribute('data-i18n-en', ip.sidebar.title_en);
        sbTitle.textContent = en ? ip.sidebar.title_en : ip.sidebar.title_zh;
      }

      var sbSub = document.getElementById('sideCardSub');
      if (sbSub) {
        sbSub.setAttribute('data-i18n-zh', ip.sidebar.sub_zh);
        sbSub.setAttribute('data-i18n-en', ip.sidebar.sub_en);
        sbSub.textContent = en ? ip.sidebar.sub_en : ip.sidebar.sub_zh;
      }

      var mkWrap = document.getElementById('sideMiniKpis');
      if (mkWrap) {
        mkWrap.innerHTML = ip.sidebar.mini_kpis.map(function (mk) {
          return '<div class="sidebar-mini-row">' +
            '<span class="sidebar-mini-label" data-i18n-zh="' + escapeHtml(mk.label_zh) + '" data-i18n-en="' + escapeHtml(mk.label_en) + '">' + escapeHtml(en ? mk.label_en : mk.label_zh) + '</span>' +
            '<span class="sidebar-mini-val mono" data-i18n-zh="' + escapeHtml(mk.val_zh) + '" data-i18n-en="' + escapeHtml(mk.val_en) + '">' + escapeHtml(en ? mk.val_en : mk.val_zh) + '</span>' +
            '</div>';
        }).join('');
      }

      for (var t = 0; t < ip.toc.length; t++) {
        var tl = document.getElementById('tocLbl' + t);
        if (tl) {
          tl.setAttribute('data-i18n-zh', ip.toc[t][0]);
          tl.setAttribute('data-i18n-en', ip.toc[t][1]);
          tl.textContent = en ? ip.toc[t][1] : ip.toc[t][0];
        }
      }

      var pillBtns = document.querySelectorAll('[data-switch-ip]');
      for (var pb = 0; pb < pillBtns.length; pb++) {
        var pid = pillBtns[pb].getAttribute('data-switch-ip');
        var isAct = pid === ip.id;
        pillBtns[pb].classList.toggle('active', isAct);
        pillBtns[pb].setAttribute('aria-pressed', isAct ? 'true' : 'false');
      }
      for (var m = 0; m < ALL_IPS.length; m++) {
        var it = ALL_IPS[m];
        var pn = document.querySelector('[data-pill-name="' + it.id + '"]');
        var pm = document.querySelector('[data-pill-meta="' + it.id + '"]');
        if (pn) pn.textContent = it.idx_pad + '. ' + (en ? it.short_en : it.short_zh);
        if (pm) pm.textContent = it.pill_kpi + ' · ' + (en ? it.short_zh : it.short_en);
      }
      var openLink = document.getElementById('openStandalonePageLink');
      if (openLink && openLink.tagName === 'A') {
        openLink.setAttribute('href', './' + ip.filename);
      }
      var openTxt = document.getElementById('openStandalonePageText');
      if (openTxt) {
        var lblZh = '打开《' + ip.short_zh + '》独立专页 ↗';
        var lblEn = 'Open ' + ip.short_en + ' Page ↗';
        openTxt.setAttribute('data-i18n-zh', lblZh);
        openTxt.setAttribute('data-i18n-en', lblEn);
        openTxt.textContent = en ? lblEn : lblZh;
      }
    }

    function syncCh1HeaderText() {
      var vCfg = curIp().ch1.chart[state.ch1View];
      var en = isEn();
      var tEl = document.getElementById('ch1ChartTitle');
      var sEl = document.getElementById('ch1ChartSub');
      var l1El = document.getElementById('ch1Leg1');
      var l2El = document.getElementById('ch1Leg2');
      var metaEl = document.getElementById('ch1AxisMeta');
      if (!tEl || !vCfg) return;
      tEl.textContent = en ? vCfg.title_en : vCfg.title_zh;
      sEl.textContent = en ? vCfg.sub_en : vCfg.sub_zh;
      var l1 = en ? vCfg.leg1_en : vCfg.leg1_zh;
      var l2 = en ? vCfg.leg2_en : vCfg.leg2_zh;
      if (l1El) l1El.textContent = l1;
      if (l2El) l2El.textContent = l2;
      var sym2 = vCfg.mode === 'dual_bar_line' ? '● ' : '■ ';
      if (metaEl) {
        metaEl.innerHTML =
          '<span style="color:var(--chart-c1);">■ ' + escapeHtml(l1) + '</span>' +
          '<span style="color:var(--chart-c2);">' + sym2 + escapeHtml(l2) + '</span>';
      }
    }

    function syncCollapseButtonsText() {
      var btns = document.querySelectorAll('[data-collapse-target]');
      for (var i = 0; i < btns.length; i++) {
        var panel = document.getElementById(btns[i].getAttribute('data-collapse-target'));
        var isOpen = panel && panel.classList.contains('open');
        if (isEn()) {
          btns[i].innerHTML = isOpen ? '<span>Hide Micro-Mechanics</span> <span>⌃</span>' : '<span>Show Micro-Mechanics</span> <span>⌄</span>';
        } else {
          btns[i].innerHTML = isOpen ? '<span>收起微观机制拆解</span> <span>⌃</span>' : '<span>展开微观机制拆解</span> <span>⌄</span>';
        }
      }
    }

    function renderPeerTable() {
      var tbody = document.getElementById('peerTableBody');
      var badge = document.getElementById('peerCountBadge');
      if (!tbody || !badge) return;
      var ip = curIp();
      var activeRows = isEn() ? ip.ch3.peers_en : ip.ch3.peers_zh;
      var q = state.peerQuery.trim().toLowerCase();
      var filtered = activeRows.filter(function (row, idx) {
        var catOk = state.peerFilter === 'all' || row.category === state.peerFilter;
        if (!catOk) return false;
        if (!q) return true;
        var rZh = ip.ch3.peers_zh[idx] || row;
        var rEn = ip.ch3.peers_en[idx] || row;
        var hay = (rZh.title + ' ' + rZh.creator + ' ' + rZh.format + ' ' + rZh.craft + ' ' + rZh.views + ' ' + rZh.acclaim + ' ' + rZh.takeaway + ' ' +
                   rEn.title + ' ' + rEn.creator + ' ' + rEn.format + ' ' + rEn.craft + ' ' + rEn.takeaway).toLowerCase();
        return hay.indexOf(q) !== -1;
      });

      badge.textContent = isEn()
        ? ('Showing ' + filtered.length + ' / ' + activeRows.length + ' Benchmarks')
        : ('显示 ' + filtered.length + ' / ' + activeRows.length + ' 款标杆单品');

      if (!filtered.length) {
        tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;padding:28px;">' +
          (isEn() ? 'No matching products found. Try another keyword or reset filters.' : '未找到匹配的标杆单品记录，请尝试其他关键词或重置筛选条件。') +
          '</td></tr>';
        return;
      }

      var rawQ = state.peerQuery.trim();
      tbody.innerHTML = filtered.map(function (r) {
        return '<tr class="' + (r.benchmark ? 'benchmark-row' : '') + '">' +
          '<td><strong style="color:var(--text-primary);display:block;">' + highlightMatch(r.title, rawQ) + '</strong><span style="font-size:0.76rem;color:var(--text-muted);">' + highlightMatch(r.creator, rawQ) + '</span></td>' +
          '<td>' + highlightMatch(r.format, rawQ) + '</td>' +
          '<td>' + highlightMatch(r.craft, rawQ) + '</td>' +
          '<td class="mono" style="font-size:0.79rem;">' + highlightMatch(r.views, rawQ) + '</td>' +
          '<td class="mono" style="font-size:0.79rem;color:var(--mui-primary-lighter);font-weight:700;">' + highlightMatch(r.acclaim, rawQ) + '</td>' +
          '<td>' + highlightMatch(r.takeaway, rawQ) + ' <a class="cite-link" href="' + escapeHtml(r.sourceUrl) + '" target="_blank" rel="noopener noreferrer">' + escapeHtml(r.sourceLabel) + ' ↗</a></td>' +
          '</tr>';
      }).join('');
    }

    function computeLifecycleSeries() {
      var ip = curIp();
      var sc = ip.ch4.sim;
      var baseVol = state.sim.views;
      var unitOci = state.sim.v_per_view;
      var ancillaryAnnualM = state.sim.ancillary_m;
      var yrs = state.sim.years;
      var drift = sc.vol_drift || 0.96;
      var mult = state.sim.transmedia ? (sc.mult || 1.16) : 1.0;
      var volScale = (sc.s1_unit_zh && sc.s1_unit_zh.indexOf('亿') === 0) ? 100.0 : 1.0;

      var cumStreamM = [0];
      var cumTotalM = [0];
      for (var y = 1; y <= yrs; y++) {
        var yrVolM = baseVol * volScale * Math.pow(drift, y - 1);
        var yrBaseOciM = yrVolM * unitOci;
        var rgmPriceFactor = state.sim.transmedia ? Math.pow(1.045, y - 1) : 1.0;
        var yrRgmOciM = yrBaseOciM * rgmPriceFactor * (y >= 2 && state.sim.transmedia ? 1.04 : 1.0);
        var yrAncM = ancillaryAnnualM * (state.sim.transmedia ? mult : 0.45) * Math.pow(1.02, Math.max(0, y - 1));
        cumStreamM.push(cumStreamM[y - 1] + yrBaseOciM);
        cumTotalM.push(cumTotalM[y - 1] + yrRgmOciM + yrAncM);
      }
      return {
        yrs: yrs,
        cumStreamM: cumStreamM,
        cumTotalM: cumTotalM,
        streamTotalM: cumStreamM[yrs],
        ancTotalM: Math.max(0, cumTotalM[yrs] - cumStreamM[yrs]),
        grandTotalM: cumTotalM[yrs]
      };
    }

    function fmtMoneyM(valM) {
      if (valM >= 1000) return '$' + (valM / 1000).toFixed(2) + 'B';
      return '$' + Math.round(valM).toLocaleString() + 'M';
    }

    function updateSimulatorUI() {
      var ip = curIp();
      var sc = ip.ch4.sim;
      var res = computeLifecycleSeries();
      var costM = Math.max(1, sc.cost_base_m);
      var roi = res.grandTotalM / costM;
      var ancPct = res.grandTotalM > 0 ? Math.round((res.ancTotalM / res.grandTotalM) * 100) : 0;

      var pLbl = document.getElementById('simPrincipalLabel');
      var cLbl = document.getElementById('simCagrLabel');
      var lLbl = document.getElementById('simLiveArpuLabel');
      var yLbl = document.getElementById('simYearsLabel');
      if (pLbl) pLbl.textContent = state.sim.views + ' ' + (isEn() ? (sc.s1_unit_en || 'M') : (sc.s1_unit_zh || 'M'));
      if (cLbl) cLbl.textContent = '$' + Number(state.sim.v_per_view).toFixed(2) + (isEn() ? (sc.s2_unit_en || '/u') : (sc.s2_unit_zh || '/件'));
      if (lLbl) lLbl.textContent = '$' + state.sim.ancillary_m + (isEn() ? 'M / yr' : 'M / 年');
      if (yLbl) yLbl.textContent = state.sim.years + (isEn() ? ' yrs' : ' 年');

      var eVal = document.getElementById('simEndingVal');
      var mVal = document.getElementById('simMoicVal');
      var nVal = document.getElementById('simNetGainVal');
      var midVal = document.getElementById('simMidVal');
      if (eVal) eVal.textContent = fmtMoneyM(res.grandTotalM);
      if (mVal) mVal.textContent = roi.toFixed(2) + 'x · ' + (isEn() ? ('Lift ' + ancPct + '%') : ('增厚占 ' + ancPct + '%'));
      if (nVal) nVal.textContent = fmtMoneyM(res.streamTotalM);
      if (midVal) midVal.textContent = fmtMoneyM(res.ancTotalM);

      var pBtns = document.querySelectorAll('[data-preset]');
      for (var i = 0; i < pBtns.length; i++) {
        pBtns[i].classList.toggle('active', pBtns[i].getAttribute('data-preset') === state.sim.preset);
      }
      drawSimChart();
    }

    function renderChecklist() {
      var container = document.getElementById('checklistContainer');
      var chip = document.getElementById('checklistScoreChip');
      var bar = document.getElementById('checklistProgressBar');
      if (!container || !chip || !bar) return;
      var ip = curIp();
      var items = isEn() ? ip.ch6.items_en : ip.ch6.items_zh;
      var doneCount = state.checks.filter(Boolean).length;
      var pct = Math.round((doneCount / items.length) * 100);
      chip.textContent = isEn()
        ? ('Verified ' + doneCount + ' / ' + items.length + ' (' + pct + '%)')
        : ('已核查 ' + doneCount + ' / ' + items.length + ' 项 (' + pct + '%)');
      bar.style.width = pct + '%';

      container.innerHTML = items.map(function (item, idx) {
        var isChecked = !!state.checks[idx];
        return '<label class="check-card ' + (isChecked ? 'checked' : '') + '" data-check-idx="' + idx + '">' +
          '<input type="checkbox" data-check-input="' + idx + '" ' + (isChecked ? 'checked' : '') + ' />' +
          '<div style="flex:1;">' +
            '<div style="display:flex;flex-wrap:wrap;justify-content:space-between;gap:6px;margin-bottom:4px;">' +
              '<span class="check-title">' + escapeHtml(item.title) + '</span>' +
              '<span class="mui-chip mono">' + escapeHtml(item.tag) + '</span>' +
            '</div>' +
            '<p class="check-desc">' + escapeHtml(item.desc) + '</p>' +
          '</div>' +
          '</label>';
      }).join('');
    }

    var hitRegions = { chartCh1: [], chartRadar: [], chartBars: [], chartEps: [], chartSim: [] };
    var hoverState = { chartCh1: -1, chartRadar: -1, chartBars: -1, chartEps: -1, chartSim: -1 };

    function getPalette() {
      var cs = getComputedStyle(document.documentElement);
      var isDark = state.theme === 'dark';
      return {
        isDark: isDark,
        grid: cs.getPropertyValue('--chart-grid').trim() || (isDark ? 'rgba(148,163,184,0.14)' : 'rgba(100,116,139,0.16)'),
        tick: cs.getPropertyValue('--chart-tick').trim() || '#94A3B8',
        text: cs.getPropertyValue('--text-primary').trim() || '#0F172A',
        pillBg: isDark ? 'rgba(15, 23, 42, 0.94)' : 'rgba(255, 255, 255, 0.96)',
        pillBorder: isDark ? 'rgba(56, 189, 248, 0.34)' : 'rgba(0, 115, 230, 0.26)',
        trackBg: isDark ? 'rgba(148, 163, 184, 0.12)' : 'rgba(15, 23, 42, 0.06)',
        hoverBand: isDark ? 'rgba(56, 189, 248, 0.08)' : 'rgba(0, 115, 230, 0.05)',
        c1: cs.getPropertyValue('--chart-c1').trim() || '#0073E6',
        c2: cs.getPropertyValue('--chart-c2').trim() || '#16A34A',
        c3: cs.getPropertyValue('--chart-c3').trim() || '#D97706',
        c4: cs.getPropertyValue('--chart-c4').trim() || '#7C3AED'
      };
    }

    function prepareCanvas(id) {
      var canvas = document.getElementById(id);
      if (!canvas || !canvas.parentElement) return null;
      var rect = canvas.parentElement.getBoundingClientRect();
      var w = Math.max(240, Math.floor(rect.width));
      var h = Math.max(170, Math.floor(rect.height));
      var dpr = Math.min(window.devicePixelRatio || 1, 2.5);
      canvas.style.width = w + 'px';
      canvas.style.height = h + 'px';
      var tw = Math.floor(w * dpr), th = Math.floor(h * dpr);
      if (canvas.width !== tw) canvas.width = tw;
      if (canvas.height !== th) canvas.height = th;
      var ctx = canvas.getContext('2d');
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, w, h);
      return { ctx: ctx, w: w, h: h };
    }

    function roundRectPath(ctx, x, y, w, h, r) {
      if (w <= 0 || h <= 0) return;
      var rad = Math.min(r, w / 2, h / 2);
      ctx.beginPath();
      ctx.moveTo(x + rad, y);
      ctx.lineTo(x + w - rad, y);
      ctx.quadraticCurveTo(x + w, y, x + w, y + rad);
      ctx.lineTo(x + w, y + h - rad);
      ctx.quadraticCurveTo(x + w, y + h, x + w - rad, y + h);
      ctx.lineTo(x + rad, y + h);
      ctx.quadraticCurveTo(x, y + h, x, y + h - rad);
      ctx.lineTo(x, y + rad);
      ctx.quadraticCurveTo(x, y, x + rad, y);
      ctx.closePath();
    }

    function topRoundedBar(ctx, x, y, w, h, r) {
      if (w <= 0 || h <= 0) return;
      var rad = Math.min(r, w / 2, h);
      ctx.beginPath();
      ctx.moveTo(x, y + h);
      ctx.lineTo(x, y + rad);
      ctx.quadraticCurveTo(x, y, x + rad, y);
      ctx.lineTo(x + w - rad, y);
      ctx.quadraticCurveTo(x + w, y, x + w, y + rad);
      ctx.lineTo(x + w, y + h);
      ctx.closePath();
    }

    function drawValueBadge(ctx, text, cx, cy, fgColor, pal) {
      ctx.save();
      ctx.font = '700 11px "IBM Plex Mono", system-ui, sans-serif';
      var tw = ctx.measureText(text).width + 10;
      var th = 18;
      ctx.fillStyle = pal.pillBg;
      roundRectPath(ctx, cx - tw / 2, cy - th / 2, tw, th, 5);
      ctx.fill();
      ctx.strokeStyle = pal.pillBorder;
      ctx.lineWidth = 1;
      ctx.stroke();
      ctx.fillStyle = fgColor;
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText(text, cx, cy + 0.5);
      ctx.restore();
    }

    function drawSmoothLine(ctx, pts) {
      if (!pts.length) return;
      ctx.beginPath();
      ctx.moveTo(pts[0].x, pts[0].y);
      for (var i = 0; i < pts.length - 1; i++) {
        var xc = (pts[i].x + pts[i + 1].x) / 2;
        ctx.bezierCurveTo(xc, pts[i].y, xc, pts[i + 1].y, pts[i + 1].x, pts[i + 1].y);
      }
    }

    function drawCh1Chart() {
      var env = prepareCanvas('chartCh1');
      if (!env) return;
      var ctx = env.ctx, w = env.w, h = env.h, pal = getPalette();
      hitRegions.chartCh1 = [];
      var vCfg = curIp().ch1.chart[state.ch1View];
      var en = isEn();
      var labels = en ? vCfg.labels_en : vCfg.labels_zh;
      var subs = en ? vCfg.subs_en : vCfg.subs_zh;
      var s1 = vCfg.s1, s2 = vCfg.s2;
      var u1 = vCfg.u1 || '', u2 = vCfg.u2 || '';

      if (vCfg.mode === 'dual_bar_line') {
        var pad = { top: 28, right: 54, bottom: 44, left: 52 };
        var pw = w - pad.left - pad.right, ph = h - pad.top - pad.bottom;
        var max1 = vCfg.max1, max2 = vCfg.max2;
        for (var g = 0; g <= 4; g++) {
          var r = g / 4, gy = pad.top + ph - r * ph;
          ctx.strokeStyle = pal.grid; ctx.lineWidth = 1;
          ctx.beginPath(); ctx.moveTo(pad.left, gy); ctx.lineTo(pad.left + pw, gy); ctx.stroke();
          ctx.font = '11px "IBM Plex Mono", sans-serif'; ctx.textBaseline = 'middle';
          ctx.fillStyle = pal.tick; ctx.textAlign = 'right';
          ctx.fillText(Math.round(max1 * r) + u1, pad.left - 8, gy);
          ctx.fillStyle = pal.c2; ctx.textAlign = 'left';
          ctx.fillText((max2 <= 20 ? (max2 * r).toFixed(1) : Math.round(max2 * r)) + u2, pad.left + pw + 8, gy);
        }
        var step = pw / labels.length;
        var barW = Math.min(62, Math.max(26, step * 0.36));
        var pts = [];
        for (var i = 0; i < labels.length; i++) {
          var cx = pad.left + step * (i + 0.5);
          if (hoverState.chartCh1 === i) {
            ctx.fillStyle = pal.hoverBand;
            roundRectPath(ctx, pad.left + step * i + 6, pad.top, step - 12, ph, 8); ctx.fill();
          }
          if (state.ch1Series.s1) {
            var bh = (s1[i] / max1) * ph, bx = cx - barW / 2, by = pad.top + ph - bh;
            var grad = ctx.createLinearGradient(0, by, 0, pad.top + ph);
            grad.addColorStop(0, '#38BDF8'); grad.addColorStop(1, '#0073E6');
            ctx.fillStyle = grad; topRoundedBar(ctx, bx, by, barW, bh, 6); ctx.fill();
            ctx.fillStyle = '#FFFFFF'; ctx.font = '700 10.5px "IBM Plex Mono", sans-serif';
            ctx.textAlign = 'center'; ctx.textBaseline = 'alphabetic';
            if (bh > 22) ctx.fillText(s1[i] + u1, cx, by + 16);
            else drawValueBadge(ctx, s1[i] + u1, cx, by - 11, pal.c1, pal);
          }
          pts.push({ x: cx, y: pad.top + ph - (s2[i] / max2) * ph, val: s2[i] });
          ctx.fillStyle = pal.text;
          ctx.font = '700 ' + (w < 480 ? '10.5px' : '11.5px') + ' system-ui, sans-serif';
          ctx.textAlign = 'center'; ctx.textBaseline = 'alphabetic';
          ctx.fillText(labels[i], cx, pad.top + ph + 20);
          ctx.fillStyle = pal.tick; ctx.font = '10px system-ui, sans-serif';
          ctx.fillText(subs[i], cx, pad.top + ph + 35);

          hitRegions.chartCh1.push({
            idx: i, x: pad.left + step * i, y: pad.top, w: step, h: ph + 38,
            html: '<strong>' + escapeHtml(labels[i]) + ' (' + escapeHtml(subs[i]) + ')</strong><br/>' +
                  '• ' + escapeHtml(en ? vCfg.leg1_en : vCfg.leg1_zh) + ': <strong>' + s1[i] + u1 + '</strong><br/>' +
                  '• ' + escapeHtml(en ? vCfg.leg2_en : vCfg.leg2_zh) + ': <strong>' + s2[i] + u2 + '</strong>'
          });
        }
        if (state.ch1Series.s2) {
          ctx.save(); drawSmoothLine(ctx, pts); ctx.strokeStyle = pal.c2; ctx.lineWidth = 2.8; ctx.stroke(); ctx.restore();
          for (var n = 0; n < pts.length; n++) {
            ctx.fillStyle = pal.pillBg; ctx.beginPath(); ctx.arc(pts[n].x, pts[n].y, 6, 0, Math.PI * 2); ctx.fill();
            ctx.fillStyle = pal.c2; ctx.beginPath(); ctx.arc(pts[n].x, pts[n].y, 4.2, 0, Math.PI * 2); ctx.fill();
            drawValueBadge(ctx, pts[n].val + u2, pts[n].x, Math.max(12, pts[n].y - 15), pal.c2, pal);
          }
        }
      } else {
        var padB = { top: 28, right: 24, bottom: 44, left: 52 };
        var pwB = w - padB.left - padB.right, phB = h - padB.top - padB.bottom;
        var maxV = vCfg.max1;
        for (var j = 0; j <= 4; j++) {
          var v = (maxV / 4) * j, yG = padB.top + phB - (j / 4) * phB;
          ctx.strokeStyle = pal.grid; ctx.lineWidth = 1;
          ctx.beginPath(); ctx.moveTo(padB.left, yG); ctx.lineTo(padB.left + pwB, yG); ctx.stroke();
          ctx.fillStyle = pal.tick; ctx.font = '11px "IBM Plex Mono", sans-serif';
          ctx.textAlign = 'right'; ctx.textBaseline = 'middle';
          ctx.fillText(Math.round(v) + u1, padB.left - 8, yG);
        }
        var stepB = pwB / labels.length;
        var bW = Math.min(52, Math.max(22, stepB * 0.26));
        for (var k = 0; k < labels.length; k++) {
          var centerX = padB.left + stepB * (k + 0.5);
          if (hoverState.chartCh1 === k) {
            ctx.fillStyle = pal.hoverBand;
            roundRectPath(ctx, padB.left + stepB * k + 6, padB.top, stepB - 12, phB, 8); ctx.fill();
          }
          if (state.ch1Series.s1) {
            var h1 = (s1[k] / maxV) * phB;
            var x1 = state.ch1Series.s2 ? (centerX - bW - 4) : (centerX - bW / 2);
            var y1 = padB.top + phB - h1;
            var g1 = ctx.createLinearGradient(0, y1, 0, padB.top + phB);
            g1.addColorStop(0, '#38BDF8'); g1.addColorStop(1, '#0073E6');
            ctx.fillStyle = g1; topRoundedBar(ctx, x1, y1, bW, h1, 6); ctx.fill();
            drawValueBadge(ctx, s1[k] + u1, x1 + bW / 2, Math.max(12, y1 - 12), pal.c1, pal);
          }
          if (state.ch1Series.s2) {
            var h2 = (s2[k] / maxV) * phB;
            var x2 = state.ch1Series.s1 ? (centerX + 4) : (centerX - bW / 2);
            var y2 = padB.top + phB - h2;
            var g2 = ctx.createLinearGradient(0, y2, 0, padB.top + phB);
            g2.addColorStop(0, '#34D399'); g2.addColorStop(1, '#16A34A');
            ctx.fillStyle = g2; topRoundedBar(ctx, x2, y2, bW, h2, 6); ctx.fill();
            drawValueBadge(ctx, s2[k] + u2, x2 + bW / 2, Math.max(12, y2 - 12), pal.c2, pal);
          }
          ctx.fillStyle = pal.text;
          ctx.font = '700 ' + (w < 480 ? '10.5px' : '11.5px') + ' system-ui, sans-serif';
          ctx.textAlign = 'center'; ctx.textBaseline = 'alphabetic';
          ctx.fillText(labels[k], centerX, padB.top + phB + 20);
          ctx.fillStyle = pal.tick; ctx.font = '10px system-ui, sans-serif';
          ctx.fillText(subs[k], centerX, padB.top + phB + 35);

          hitRegions.chartCh1.push({
            idx: k, x: padB.left + stepB * k, y: padB.top, w: stepB, h: phB + 38,
            html: '<strong>' + escapeHtml(labels[k]) + '</strong><br/>' +
                  '• ' + escapeHtml(en ? vCfg.leg1_en : vCfg.leg1_zh) + ': <strong>' + s1[k] + u1 + '</strong><br/>' +
                  '• ' + escapeHtml(en ? vCfg.leg2_en : vCfg.leg2_zh) + ': <strong>' + s2[k] + u2 + '</strong>'
          });
        }
      }
    }

    function drawRadarChart() {
      var env = prepareCanvas('chartRadar');
      if (!env) return;
      var ctx = env.ctx, w = env.w, h = env.h, pal = getPalette();
      hitRegions.chartRadar = [];
      var rCfg = curIp().ch2.radar;
      var axes = isEn() ? rCfg.axes_en : rCfg.axes_zh;
      var pillarAxisMap = [0, 1, 2, 4];
      var highlightedAxis = hoverState.chartRadar >= 0 ? hoverState.chartRadar : pillarAxisMap[state.activePillar];

      var series = [
        { key: 's0', name: isEn() ? rCfg.s0_en : rCfg.s0_zh, color: pal.c1, fill: 'rgba(0, 115, 230, 0.22)', vals: rCfg.v0 },
        { key: 's1', name: isEn() ? rCfg.s1_en : rCfg.s1_zh, color: pal.c2, fill: 'rgba(22, 163, 74, 0.15)', vals: rCfg.v1 },
        { key: 's2', name: isEn() ? rCfg.s2_en : rCfg.s2_zh, color: pal.c3, fill: 'rgba(217, 119, 6, 0.13)', vals: rCfg.v2 }
      ];

      var cx = w / 2, cy = h / 2 + 8;
      var sidePad = w < 420 ? 88 : 106;
      var radius = Math.max(60, Math.min((w - sidePad * 2) / 2, h * 0.35));
      var total = axes.length;

      for (var ring = 2; ring <= 10; ring += 2) {
        var r = (ring / 10) * radius;
        ctx.strokeStyle = pal.grid; ctx.lineWidth = ring === 10 ? 1.3 : 1;
        ctx.beginPath();
        for (var i = 0; i < total; i++) {
          var ang = -Math.PI / 2 + (i * 2 * Math.PI) / total;
          var px = cx + Math.cos(ang) * r, py = cy + Math.sin(ang) * r;
          if (i === 0) ctx.moveTo(px, py); else ctx.lineTo(px, py);
        }
        ctx.closePath(); ctx.stroke();
        ctx.fillStyle = pal.tick; ctx.font = '600 9.5px "IBM Plex Mono", sans-serif';
        ctx.textAlign = 'left'; ctx.textBaseline = 'middle';
        ctx.fillText(String(ring), cx + 4, cy - r);
      }

      for (var a = 0; a < total; a++) {
        var angle = -Math.PI / 2 + (a * 2 * Math.PI) / total;
        var ax = cx + Math.cos(angle) * radius, ay = cy + Math.sin(angle) * radius;
        var isHi = a === highlightedAxis;
        ctx.strokeStyle = isHi ? pal.c1 : pal.grid; ctx.lineWidth = isHi ? 1.8 : 1;
        ctx.beginPath(); ctx.moveTo(cx, cy); ctx.lineTo(ax, ay); ctx.stroke();

        var lx = cx + Math.cos(angle) * (radius + 14), ly = cy + Math.sin(angle) * (radius + 15);
        ctx.fillStyle = isHi ? pal.c1 : pal.text;
        ctx.font = (isHi ? '800 ' : '600 ') + (w < 420 ? '10.5px' : '11.5px') + ' system-ui, sans-serif';
        ctx.textBaseline = 'middle';
        if (Math.abs(Math.cos(angle)) < 0.2) ctx.textAlign = 'center';
        else if (Math.cos(angle) > 0) ctx.textAlign = 'left';
        else ctx.textAlign = 'right';
        ctx.fillText(axes[a], lx, ly);

        hitRegions.chartRadar.push({
          idx: a,
          x: Math.min(ax, lx) - 36, y: Math.min(ay, ly) - 22, w: 72 + Math.abs(lx - ax), h: 44,
          html: '<strong>' + escapeHtml(axes[a]) + (isEn() ? ' (10-Pt Scale)' : ' (10分制评估)') + '</strong><br/>' +
                '• ' + escapeHtml(series[0].name) + ': <strong>' + series[0].vals[a].toFixed(1) + '</strong><br/>' +
                '• ' + escapeHtml(series[1].name) + ': <strong>' + series[1].vals[a].toFixed(1) + '</strong><br/>' +
                '• ' + escapeHtml(series[2].name) + ': <strong>' + series[2].vals[a].toFixed(1) + '</strong>'
        });
      }

      for (var s = 0; s < series.length; s++) {
        var item = series[s];
        if (!state.radarSeries[item.key]) continue;
        ctx.beginPath();
        for (var idx = 0; idx < total; idx++) {
          var theta = -Math.PI / 2 + (idx * 2 * Math.PI) / total;
          var dist = (item.vals[idx] / 10) * radius;
          var vx = cx + Math.cos(theta) * dist, vy = cy + Math.sin(theta) * dist;
          if (idx === 0) ctx.moveTo(vx, vy); else ctx.lineTo(vx, vy);
        }
        ctx.closePath();
        ctx.fillStyle = item.fill; ctx.fill();
        ctx.strokeStyle = item.color; ctx.lineWidth = 2.4; ctx.stroke();

        for (var pIdx = 0; pIdx < total; pIdx++) {
          var pTheta = -Math.PI / 2 + (pIdx * 2 * Math.PI) / total;
          var pDist = (item.vals[pIdx] / 10) * radius;
          var pX = cx + Math.cos(pTheta) * pDist, pY = cy + Math.sin(pTheta) * pDist;
          ctx.fillStyle = pal.pillBg; ctx.beginPath(); ctx.arc(pX, pY, 5.2, 0, Math.PI * 2); ctx.fill();
          ctx.fillStyle = item.color; ctx.beginPath(); ctx.arc(pX, pY, 3.6, 0, Math.PI * 2); ctx.fill();
        }
      }
    }

    function drawHorizontalBars() {
      var env = prepareCanvas('chartBars');
      if (!env) return;
      var ctx = env.ctx, w = env.w, h = env.h, pal = getPalette();
      hitRegions.chartBars = [];
      var bCfg = curIp().ch3.bars;
      var items = isEn() ? bCfg.items_en : bCfg.items_zh;
      var maxX = bCfg.max_x || 100;
      var colors = [
        ['#34D399', '#16A34A'], ['#38BDF8', '#0073E6'], ['#60A5FA', '#2563EB'],
        ['#FBBF24', '#D97706'], ['#A78BFA', '#7C3AED'], ['#38BDF8', '#0284C7']
      ];

      var pad = { top: 10, right: 18, bottom: 26, left: 18 };
      var pw = w - pad.left - pad.right, ph = h - pad.top - pad.bottom;

      for (var g = 0; g <= 5; g++) {
        var xVal = Math.round((maxX / 5) * g);
        var gx = pad.left + (g / 5) * pw;
        ctx.strokeStyle = pal.grid; ctx.lineWidth = 1;
        ctx.beginPath(); ctx.moveTo(gx, pad.top); ctx.lineTo(gx, pad.top + ph); ctx.stroke();
        ctx.fillStyle = pal.tick; ctx.font = '10.5px "IBM Plex Mono", sans-serif';
        ctx.textAlign = g === 0 ? 'left' : (g === 5 ? 'right' : 'center');
        ctx.textBaseline = 'alphabetic';
        ctx.fillText(String(xVal), gx, pad.top + ph + 18);
      }

      var rowH = ph / items.length;
      if (bCfg.ref_line) {
        var tx = pad.left + (bCfg.ref_line / maxX) * pw;
        ctx.save(); ctx.setLineDash([4, 4]); ctx.strokeStyle = pal.c3; ctx.lineWidth = 1.5;
        ctx.beginPath(); ctx.moveTo(tx, pad.top + 4); ctx.lineTo(tx, pad.top + ph - 4); ctx.stroke(); ctx.restore();
      }

      for (var i = 0; i < items.length; i++) {
        var rowTop = pad.top + rowH * i;
        var cPair = colors[i % colors.length];
        if (hoverState.chartBars === i) {
          ctx.fillStyle = pal.hoverBand;
          roundRectPath(ctx, pad.left - 6, rowTop + 2, pw + 12, rowH - 4, 8); ctx.fill();
        }
        var labelY = rowTop + Math.max(15, rowH * 0.34);
        var barY = rowTop + Math.max(22, rowH * 0.50);
        var barH = Math.min(15, Math.max(11, rowH * 0.26));
        var bw = Math.max(8, Math.min(pw, (items[i].val / maxX) * pw));

        ctx.fillStyle = pal.text;
        ctx.font = '600 ' + (w < 460 ? '11px' : '12px') + ' system-ui, sans-serif';
        ctx.textAlign = 'left'; ctx.textBaseline = 'alphabetic';
        ctx.fillText(items[i].label, pad.left, labelY);

        var valStr = items[i].disp || (items[i].val.toFixed(1) + (items[i].unit || ''));
        ctx.font = '800 12.5px "IBM Plex Mono", sans-serif';
        ctx.fillStyle = pal.isDark ? cPair[0] : cPair[1];
        ctx.textAlign = 'right';
        ctx.fillText(valStr, pad.left + pw, labelY);

        if (w >= 580 && items[i].sub) {
          var valW = ctx.measureText(valStr).width + 10;
          ctx.font = '500 11px "IBM Plex Mono", system-ui, sans-serif';
          ctx.fillStyle = pal.tick;
          ctx.fillText(items[i].sub, pad.left + pw - valW, labelY);
        }

        ctx.fillStyle = pal.trackBg;
        roundRectPath(ctx, pad.left, barY, pw, barH, barH / 2); ctx.fill();
        var barGrad = ctx.createLinearGradient(pad.left, 0, pad.left + bw, 0);
        barGrad.addColorStop(0, cPair[0]); barGrad.addColorStop(1, cPair[1]);
        ctx.fillStyle = barGrad;
        roundRectPath(ctx, pad.left, barY, bw, barH, barH / 2); ctx.fill();

        hitRegions.chartBars.push({
          idx: i, x: pad.left, y: rowTop, w: pw, h: rowH,
          html: '<strong>' + escapeHtml(items[i].label) + ': ' + escapeHtml(valStr) + '</strong><br/>' +
                '• ' + escapeHtml(items[i].sub || '') + '<br/>• ' + escapeHtml(items[i].note || '')
        });
      }
    }

    function drawEpsComboChart() {
      var env = prepareCanvas('chartEps');
      if (!env) return;
      var ctx = env.ctx, w = env.w, h = env.h, pal = getPalette();
      hitRegions.chartEps = [];
      var cCfg = curIp().ch4.combo;
      var en = isEn();
      var titles = en ? cCfg.titles_en : cCfg.titles_zh;
      var subs = en ? cCfg.subs_en : cCfg.subs_zh;
      var bars = cCfg.bars, line = cCfg.line;
      var uB = cCfg.u_bar || 'M', uL = cCfg.u_line || '%';

      var pad = { top: 26, right: 52, bottom: 44, left: 50 };
      var pw = w - pad.left - pad.right, ph = h - pad.top - pad.bottom;
      var minB = 0, maxB = cCfg.max_bar;
      var minL = cCfg.min_line || 0, maxL = cCfg.max_line;

      for (var g = 0; g <= 4; g++) {
        var ratio = g / 4, gy = pad.top + ph - ratio * ph;
        ctx.strokeStyle = pal.grid; ctx.lineWidth = 1;
        ctx.beginPath(); ctx.moveTo(pad.left, gy); ctx.lineTo(pad.left + pw, gy); ctx.stroke();
        var bTick = minB + ratio * (maxB - minB);
        var lTick = minL + ratio * (maxL - minL);
        ctx.font = '11px "IBM Plex Mono", sans-serif'; ctx.textBaseline = 'middle';
        ctx.fillStyle = pal.tick; ctx.textAlign = 'right';
        ctx.fillText(Math.round(bTick) + uB, pad.left - 7, gy);
        ctx.fillStyle = pal.c2; ctx.textAlign = 'left';
        ctx.fillText((maxL - minL <= 20 ? lTick.toFixed(1) : Math.round(lTick)) + uL, pad.left + pw + 7, gy);
      }

      if (cCfg.ref_line) {
        var targetY = pad.top + ph - ((cCfg.ref_line - minL) / (maxL - minL)) * ph;
        ctx.save(); ctx.setLineDash([5, 5]); ctx.strokeStyle = pal.c3; ctx.lineWidth = 1.5;
        ctx.beginPath(); ctx.moveTo(pad.left, targetY); ctx.lineTo(pad.left + pw, targetY); ctx.stroke(); ctx.restore();
      }

      var step = pw / titles.length;
      var barW = Math.min(48, Math.max(24, step * 0.42));
      var linePts = [];

      for (var i = 0; i < titles.length; i++) {
        var cx = pad.left + step * (i + 0.5);
        if (hoverState.chartEps === i) {
          ctx.fillStyle = pal.hoverBand;
          roundRectPath(ctx, pad.left + step * i + 4, pad.top, step - 8, ph, 6); ctx.fill();
        }
        if (state.epsSeries.rev) {
          var bh = ((bars[i] - minB) / (maxB - minB)) * ph;
          var bx = cx - barW / 2, by = pad.top + ph - bh;
          var eGrad = ctx.createLinearGradient(0, by, 0, pad.top + ph);
          if (i === cCfg.highlight_idx) { eGrad.addColorStop(0, '#38BDF8'); eGrad.addColorStop(1, '#0073E6'); }
          else { eGrad.addColorStop(0, '#3399FF'); eGrad.addColorStop(1, '#0059B2'); }
          ctx.fillStyle = eGrad; topRoundedBar(ctx, bx, by, barW, bh, 6); ctx.fill();
          ctx.fillStyle = '#FFFFFF'; ctx.font = '700 10.5px "IBM Plex Mono", sans-serif';
          ctx.textAlign = 'center'; ctx.textBaseline = 'alphabetic';
          if (bh > 22) ctx.fillText(bars[i] + uB, cx, by + 16);
          else drawValueBadge(ctx, bars[i] + uB, cx, by - 11, pal.c1, pal);
        }

        var oy = pad.top + ph - ((line[i] - minL) / (maxL - minL)) * ph;
        linePts.push({ x: cx, y: oy, val: line[i] });

        ctx.fillStyle = pal.text;
        ctx.font = '700 ' + (w < 460 ? '10px' : '11.5px') + ' system-ui, sans-serif';
        ctx.textAlign = 'center'; ctx.textBaseline = 'alphabetic';
        ctx.fillText(titles[i], cx, pad.top + ph + 19);
        ctx.fillStyle = pal.tick; ctx.font = '10px system-ui, sans-serif';
        ctx.fillText(subs[i], cx, pad.top + ph + 33);

        hitRegions.chartEps.push({
          idx: i, x: pad.left + step * i, y: pad.top, w: step, h: ph + 36,
          html: '<strong>' + escapeHtml(titles[i]) + ' ' + escapeHtml(subs[i]) + '</strong><br/>' +
                '• ' + escapeHtml(en ? cCfg.leg1_en : cCfg.leg1_zh) + ': <strong>' + bars[i] + uB + '</strong><br/>' +
                '• ' + escapeHtml(en ? cCfg.leg2_en : cCfg.leg2_zh) + ': <strong>' + line[i] + uL + '</strong>'
        });
      }

      if (state.epsSeries.oci) {
        ctx.save(); drawSmoothLine(ctx, linePts); ctx.strokeStyle = pal.c2; ctx.lineWidth = 2.8; ctx.stroke(); ctx.restore();
        for (var m = 0; m < linePts.length; m++) {
          ctx.fillStyle = pal.pillBg; ctx.beginPath(); ctx.arc(linePts[m].x, linePts[m].y, 6, 0, Math.PI * 2); ctx.fill();
          ctx.fillStyle = pal.c2; ctx.beginPath(); ctx.arc(linePts[m].x, linePts[m].y, 4.2, 0, Math.PI * 2); ctx.fill();
          drawValueBadge(ctx, linePts[m].val + uL, linePts[m].x, Math.max(12, linePts[m].y - 15), pal.c2, pal);
        }
      }
    }

    function drawSimChart() {
      var env = prepareCanvas('chartSim');
      if (!env) return;
      var ctx = env.ctx, w = env.w, h = env.h, pal = getPalette();
      hitRegions.chartSim = [];

      var simRes = computeLifecycleSeries();
      var yrs = simRes.yrs;
      var totalS = simRes.cumTotalM;
      var baseS = simRes.cumStreamM;

      var maxVal = Math.max(totalS[yrs], 50) * 1.12;
      var pad = { top: 20, right: 20, bottom: 28, left: 60 };
      var pw = w - pad.left - pad.right, ph = h - pad.top - pad.bottom;

      for (var g = 0; g <= 3; g++) {
        var v = (maxVal / 3) * g, gy = pad.top + ph - (g / 3) * ph;
        ctx.strokeStyle = pal.grid; ctx.lineWidth = 1;
        ctx.beginPath(); ctx.moveTo(pad.left, gy); ctx.lineTo(pad.left + pw, gy); ctx.stroke();
        ctx.fillStyle = pal.tick; ctx.font = '10.5px "IBM Plex Mono", sans-serif';
        ctx.textAlign = 'right'; ctx.textBaseline = 'middle';
        ctx.fillText(fmtMoneyM(v), pad.left - 7, gy);
      }

      var stepX = pw / yrs;
      ctx.save(); ctx.setLineDash([4, 4]); ctx.strokeStyle = pal.tick; ctx.lineWidth = 1.7;
      ctx.beginPath();
      for (var i = 0; i <= yrs; i++) {
        var px = pad.left + (i / yrs) * pw, py = pad.top + ph - (baseS[i] / maxVal) * ph;
        if (i === 0) ctx.moveTo(px, py); else ctx.lineTo(px, py);
      }
      ctx.stroke(); ctx.restore();

      ctx.beginPath();
      for (var j = 0; j <= yrs; j++) {
        var tx = pad.left + (j / yrs) * pw, ty = pad.top + ph - (totalS[j] / maxVal) * ph;
        if (j === 0) ctx.moveTo(tx, ty); else ctx.lineTo(tx, ty);
        var diff = Math.max(0, totalS[j] - baseS[j]);
        hitRegions.chartSim.push({
          idx: j, x: tx - Math.max(6, stepX * 0.5), y: pad.top, w: Math.max(12, stepX), h: ph + 24,
          html: isEn()
            ? ('<strong>Year ' + j + ' Cumulative Product OCI</strong><br/>' +
               '• Total Cumulative Value: <strong>' + fmtMoneyM(totalS[j]) + '</strong><br/>' +
               '• Volume-Only Baseline: ' + fmtMoneyM(baseS[j]) + '<br/>' +
               '• RGM Pricing &amp; Strategic Lift: <strong style="color:#16A34A;">+' + fmtMoneyM(diff) + '</strong>')
            : ('<strong>第 ' + j + ' 年累计单品现金流对比</strong><br/>' +
               '• 综合累计 OCI 总价值：<strong>' + fmtMoneyM(totalS[j]) + '</strong><br/>' +
               '• 单纯销量自然演进基准：' + fmtMoneyM(baseS[j]) + '<br/>' +
               '• RGM 提价与协同增量：<strong style="color:#16A34A;">+' + fmtMoneyM(diff) + '</strong>')
        });
      }
      ctx.strokeStyle = pal.c1; ctx.lineWidth = 2.8; ctx.stroke();
      ctx.lineTo(pad.left + pw, pad.top + ph); ctx.lineTo(pad.left, pad.top + ph); ctx.closePath();
      var grad = ctx.createLinearGradient(0, pad.top, 0, pad.top + ph);
      grad.addColorStop(0, 'rgba(0, 115, 230, 0.28)'); grad.addColorStop(1, 'rgba(0, 115, 230, 0.01)');
      ctx.fillStyle = grad; ctx.fill();

      var midYr = Math.max(1, Math.floor(yrs / 2));
      if (hoverState.chartSim >= 0 && hoverState.chartSim <= yrs) {
        var hi = hoverState.chartSim;
        var hx = pad.left + (hi / yrs) * pw;
        var hy1 = pad.top + ph - (totalS[hi] / maxVal) * ph;
        var hy2 = pad.top + ph - (baseS[hi] / maxVal) * ph;
        ctx.save(); ctx.setLineDash([3, 3]); ctx.strokeStyle = pal.c1; ctx.lineWidth = 1.2;
        ctx.beginPath(); ctx.moveTo(hx, pad.top); ctx.lineTo(hx, pad.top + ph); ctx.stroke(); ctx.restore();
        ctx.fillStyle = pal.tick; ctx.beginPath(); ctx.arc(hx, hy2, 4, 0, Math.PI * 2); ctx.fill();
        ctx.fillStyle = pal.c1; ctx.beginPath(); ctx.arc(hx, hy1, 5.5, 0, Math.PI * 2); ctx.fill();
      }

      var keyYears = [0, 1, midYr, yrs];
      for (var ky = 0; ky < keyYears.length; ky++) {
        var yrIdx = keyYears[ky];
        var kx = pad.left + (yrIdx / yrs) * pw, kyY = pad.top + ph - (totalS[yrIdx] / maxVal) * ph;
        ctx.fillStyle = pal.pillBg; ctx.beginPath(); ctx.arc(kx, kyY, 5, 0, Math.PI * 2); ctx.fill();
        ctx.fillStyle = pal.c1; ctx.beginPath(); ctx.arc(kx, kyY, 3.5, 0, Math.PI * 2); ctx.fill();
      }

      var endX = pad.left + pw, endY = pad.top + ph - (totalS[yrs] / maxVal) * ph;
      drawValueBadge(ctx, fmtMoneyM(totalS[yrs]), Math.min(w - 42, endX - 24), Math.max(pad.top + 12, endY - 14), pal.c1, pal);

      ctx.fillStyle = pal.tick; ctx.font = '10.5px "IBM Plex Mono", sans-serif'; ctx.textBaseline = 'alphabetic';
      ctx.textAlign = 'left'; ctx.fillText(isEn() ? 'Year 0' : '测算起点', pad.left, pad.top + ph + 19);
      ctx.textAlign = 'center'; ctx.fillText((isEn() ? ('Year ' + midYr) : ('第 ' + midYr + ' 年')) + ' (' + fmtMoneyM(totalS[midYr]) + ')', pad.left + (midYr / yrs) * pw, pad.top + ph + 19);
      ctx.textAlign = 'right'; ctx.fillText(isEn() ? ('Year ' + yrs) : ('第 ' + yrs + ' 年'), pad.left + pw, pad.top + ph + 19);
    }

    var redrawMap = {
      chartCh1: drawCh1Chart, chartRadar: drawRadarChart, chartBars: drawHorizontalBars,
      chartEps: drawEpsComboChart, chartSim: drawSimChart
    };
    function renderAllCharts() {
      drawCh1Chart(); drawRadarChart(); drawHorizontalBars(); drawEpsComboChart(); drawSimChart();
    }

    function wireCanvasTooltip(canvasId) {
      var canvas = document.getElementById(canvasId);
      var tip = document.getElementById('chartTooltip');
      if (!canvas || !tip) return;
      function handlePointer(clientX, clientY) {
        var rect = canvas.getBoundingClientRect();
        var mx = clientX - rect.left, my = clientY - rect.top;
        var regions = hitRegions[canvasId] || [];
        var found = null;
        for (var i = 0; i < regions.length; i++) {
          var r = regions[i];
          if (mx >= r.x && mx <= r.x + r.w && my >= r.y && my <= r.y + r.h) { found = r; break; }
        }
        var nextIdx = found && typeof found.idx === 'number' ? found.idx : -1;
        if (hoverState[canvasId] !== nextIdx) {
          hoverState[canvasId] = nextIdx;
          if (redrawMap[canvasId]) redrawMap[canvasId]();
        }
        if (found) {
          tip.innerHTML = found.html;
          tip.style.display = 'block';
          var tipW = tip.offsetWidth || 255, tipH = tip.offsetHeight || 72;
          var leftPos = clientX + 14;
          if (leftPos + tipW > window.innerWidth - 12) leftPos = Math.max(12, clientX - tipW - 14);
          var topPos = Math.max(12, Math.min(window.innerHeight - tipH - 12, clientY - 18));
          tip.style.left = leftPos + 'px'; tip.style.top = topPos + 'px';
        } else {
          tip.style.display = 'none';
        }
      }
      canvas.addEventListener('mousemove', function (e) { handlePointer(e.clientX, e.clientY); });
      canvas.addEventListener('touchstart', function (e) {
        if (e.touches && e.touches[0]) handlePointer(e.touches[0].clientX, e.touches[0].clientY);
      }, { passive: true });
      canvas.addEventListener('mouseleave', function () {
        if (hoverState[canvasId] !== -1) { hoverState[canvasId] = -1; if (redrawMap[canvasId]) redrawMap[canvasId](); }
        tip.style.display = 'none';
      });
    }

    function wireAllCanvases() {
      wireCanvasTooltip('chartCh1');
      wireCanvasTooltip('chartRadar');
      wireCanvasTooltip('chartBars');
      wireCanvasTooltip('chartEps');
      wireCanvasTooltip('chartSim');
    }

    var secObserver = null;
    function observeSections() {
      var tocLinks = document.querySelectorAll('#tocNavList .mui-nav-link');
      if (secObserver) secObserver.disconnect();
      if ('IntersectionObserver' in window) {
        secObserver = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              var id = entry.target.id;
              for (var i = 0; i < tocLinks.length; i++) {
                tocLinks[i].classList.toggle('active', tocLinks[i].getAttribute('data-sec') === id);
              }
            }
          });
        }, { rootMargin: '-18% 0px -68% 0px', threshold: 0.02 });
        for (var s = 0; s <= 7; s++) {
          var secNode = document.getElementById('sec-0' + s);
          if (secNode) secObserver.observe(secNode);
        }
      }
    }

    function applyLanguage(lang, silent) {
      state.lang = lang === 'en' ? 'en' : 'zh';
      var en = isEn();
      var ip = curIp();
      var rMap = getRichMap(ip);
      document.documentElement.setAttribute('lang', en ? 'en' : 'zh-CN');
      document.documentElement.setAttribute('data-lang', state.lang);

      if (isExportedSingle()) {
        document.title = en ? ip.docTitleEn : ip.docTitleZh;
      } else {
        document.title = en
          ? ('Altria (MO) 10 Blockbuster Products Deep-Dive Hub (' + ip.short_en + ') | Research Hub')
          : ('奥驰亚 Altria (MO) 10 大爆款产品深度研报中枢（当前：' + ip.short_zh + '）| 王安安数据中心');
      }

      var zhBtn = document.getElementById('langZhBtn');
      var enBtn = document.getElementById('langEnBtn');
      if (zhBtn && enBtn) {
        zhBtn.classList.toggle('active', !en);
        enBtn.classList.toggle('active', en);
        zhBtn.setAttribute('aria-pressed', !en ? 'true' : 'false');
        enBtn.setAttribute('aria-pressed', en ? 'true' : 'false');
      }

      syncHeaderAndSidebarForIp(ip);

      var txtNodes = document.querySelectorAll('[data-i18n-zh][data-i18n-en]');
      for (var i = 0; i < txtNodes.length; i++) {
        txtNodes[i].textContent = en ? txtNodes[i].getAttribute('data-i18n-en') : txtNodes[i].getAttribute('data-i18n-zh');
      }

      var richNodes = document.querySelectorAll('[data-i18n-rich]');
      for (var r = 0; r < richNodes.length; r++) {
        var key = richNodes[r].getAttribute('data-i18n-rich');
        var entry = rMap[key];
        if (entry) richNodes[r].innerHTML = en ? entry.en : entry.zh;
      }

      var phNodes = document.querySelectorAll('[data-ph-zh][data-ph-en]');
      for (var p = 0; p < phNodes.length; p++) {
        phNodes[p].setAttribute('placeholder', en ? phNodes[p].getAttribute('data-ph-en') : phNodes[p].getAttribute('data-ph-zh'));
      }
      var tiNodes = document.querySelectorAll('[data-title-zh][data-title-en]');
      for (var t = 0; t < tiNodes.length; t++) {
        tiNodes[t].setAttribute('title', en ? tiNodes[t].getAttribute('data-title-en') : tiNodes[t].getAttribute('data-title-zh'));
      }
      var arNodes = document.querySelectorAll('[data-aria-zh][data-aria-en]');
      for (var a = 0; a < arNodes.length; a++) {
        arNodes[a].setAttribute('aria-label', en ? arNodes[a].getAttribute('data-aria-en') : arNodes[a].getAttribute('data-aria-zh'));
      }

      var notesArr = en ? ip.ch2.pillars.map(function(p){return p.note_en;}) : ip.ch2.pillars.map(function(p){return p.note_zh;});
      var pNoteEl = document.getElementById('pillarFocusNote');
      if (pNoteEl) pNoteEl.innerHTML = '<div>' + notesArr[state.activePillar] + '</div>';

      syncCh1HeaderText();
      syncCollapseButtonsText();
      renderPeerTable();
      renderChecklist();
      updateSimulatorUI();
      renderAllCharts();
      safeSetStorage(STORAGE_LANG_KEY, state.lang);

      if (!silent) {
        showToast(en ? 'Switched to English Product Monograph' : '已切换至中文单品深度研报视图');
      }
    }

    function applyTheme(theme, silent) {
      state.theme = theme === 'dark' ? 'dark' : 'light';
      document.documentElement.setAttribute('data-theme', state.theme);
      var abIconEl = document.getElementById('appbarThemeIcon');
      if (abIconEl) {
        abIconEl.innerHTML = (state.theme === 'dark')
          ? '<svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><path d="M12 7c-2.76 0-5 2.24-5 5s2.24 5 5 5 5-2.24 5-5-2.24-5-5-5zM2 13h2c.55 0 1-.45 1-1s-.45-1-1-1H2c-.55 0-1 .45-1 1s.45 1 1 1zm18 0h2c.55 0 1-.45 1-1s-.45-1-1-1h-2c-.55 0-1 .45-1 1s.45 1 1 1zM11 2v2c0 .55.45 1 1 1s1-.45 1-1V2c0-.55-.45-1-1-1s-1 .45-1 1zm0 18v2c0 .55.45 1 1 1s1-.45 1-1v-2c0-.55-.45-1-1-1s-1 .45-1 1z"/></svg>'
          : '<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 3a9 9 0 1 0 9 9c0-.46-.04-.92-.1-1.36a5.389 5.389 0 0 1-4.4 2.26 5.403 5.403 0 0 1-3.14-9.8c-.44-.06-.9-.1-1.36-.1z"/></svg>';
      }
      var sDark = document.getElementById('sideThemeDarkBtn');
      var sLight = document.getElementById('sideThemeLightBtn');
      if (sDark) sDark.classList.toggle('active', state.theme === 'dark');
      if (sLight) sLight.classList.toggle('active', state.theme === 'light');
      safeSetStorage(STORAGE_THEME_KEY, state.theme);
      safeSetStorage(STORAGE_PORTAL_THEME_KEY, state.theme);
      renderAllCharts();
      if (!silent) {
        showToast(state.theme === 'dark'
          ? (isEn() ? 'Switched to Deep-Space Dark Mode' : '已切换至深空暗色高对比模式')
          : (isEn() ? 'Switched to Crisp Daylight Mode' : '已切换至清晰浅色白昼阅读模式'));
      }
    }

    function applyDensity(density, silent) {
      state.density = density === 'compact' ? 'compact' : 'comfortable';
      document.documentElement.setAttribute('data-density', state.density);
      var cBtn = document.getElementById('densityComfortBtn');
      var kBtn = document.getElementById('densityCompactBtn');
      if (cBtn) cBtn.classList.toggle('active', state.density === 'comfortable');
      if (kBtn) kBtn.classList.toggle('active', state.density === 'compact');
      safeSetStorage(STORAGE_DENSITY_KEY, state.density);
      setTimeout(renderAllCharts, 40);
      if (!silent) {
        showToast(state.density === 'compact'
          ? (isEn() ? 'Switched to Compact Density View' : '已切换至高信息密度紧凑视图')
          : (isEn() ? 'Switched to Comfortable Reading Layout' : '已切换至舒适留白阅读排版'));
      }
    }

    function toggleSidebar() {
      if (window.innerWidth <= 1120) {
        document.body.classList.toggle('drawer-open');
      } else {
        var isCol = document.documentElement.getAttribute('data-sidebar-collapsed') === '1' || document.body.classList.contains('sidebar-collapsed');
        var nextCol = !isCol;
        document.body.classList.toggle('sidebar-collapsed', nextCol);
        if (nextCol) document.documentElement.setAttribute('data-sidebar-collapsed', '1');
        else document.documentElement.removeAttribute('data-sidebar-collapsed');
        safeSetStorage(STORAGE_SIDEBAR_KEY, nextCol ? '1' : '0');
        setTimeout(renderAllCharts, 60);
      }
    }
    function closeMobileDrawer() { document.body.classList.remove('drawer-open'); }

    function switchIp(nextId, silent) {
      if (!IP_MAP[nextId]) return;
      state.ipId = nextId;
      var ip = curIp();
      state.ch1View = 'viewA';
      state.ch1Series = { s1: true, s2: true };
      state.activePillar = 0;
      state.radarSeries = { s0: true, s1: true, s2: true };
      state.peerFilter = 'all';
      state.peerQuery = '';
      state.epsSeries = { rev: true, oci: true };
      hoverState = { chartCh1: -1, chartRadar: -1, chartBars: -1, chartEps: -1, chartSim: -1 };
      var tip = document.getElementById('chartTooltip');
      if (tip) tip.style.display = 'none';

      var p2 = ip.ch4.sim.presets.p2;
      state.sim = {
        views: p2.views,
        v_per_view: p2.v_per_view,
        ancillary_m: p2.ancillary_m,
        years: p2.years,
        transmedia: p2.transmedia,
        preset: 'p2'
      };
      state.checks = loadChecksForIp(ip);

      var host = document.getElementById('ipSectionsHost');
      if (host) host.innerHTML = buildSectionsHtmlForIp(ip);

      wireAllCanvases();
      observeSections();
      applyLanguage(state.lang, true);

      if (!isExportedSingle()) {
        try { history.replaceState(null, '', '#ip=' + nextId); } catch (e) {}
      }
      closeMobileDrawer();
      if (!silent) {
        showToast(isEn()
          ? ('Switched to [' + ip.idx_pad + '] ' + ip.short_en + ' Monograph')
          : ('已切换至 [' + ip.idx_pad + '] ' + ip.short_zh + ' 单品专论'));
      }
    }

    function stepIp(delta) {
      var curIdx = 0;
      for (var i = 0; i < ALL_IPS.length; i++) {
        if (ALL_IPS[i].id === state.ipId) { curIdx = i; break; }
      }
      var nextIdx = (curIdx + delta + ALL_IPS.length) % ALL_IPS.length;
      switchIp(ALL_IPS[nextIdx].id, false);
    }

    function exportActiveIpHtml() {
      var ip = curIp();
      var cloneRoot = document.documentElement.cloneNode(true);
      var banner = cloneRoot.querySelector('#ipHubSwitcher');
      if (banner && banner.parentNode) banner.parentNode.removeChild(banner);
      var tip = cloneRoot.querySelector('#chartTooltip');
      if (tip) tip.style.display = 'none';
      var snack = cloneRoot.querySelector('#muiSnackbar');
      if (snack) snack.classList.remove('show');
      var titleEl = cloneRoot.querySelector('title');
      if (titleEl) titleEl.textContent = isEn() ? ip.docTitleEn : ip.docTitleZh;
      var doctype = '<!DOCTYPE html>' + String.fromCharCode(10);
      var htmlContent = doctype + cloneRoot.outerHTML;
      var blob = new Blob([htmlContent], { type: 'text/html;charset=utf-8' });
      var url = URL.createObjectURL(blob);
      var link = document.createElement('a');
      link.href = url;
      link.download = ip.filename;
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
      setTimeout(function () { URL.revokeObjectURL(url); }, 1500);
      showToast(isEn() ? ('Exported standalone monograph: ' + ip.filename) : ('已导出独立单品研报：' + ip.filename));
    }

    function buildQuickJumpItems() {
      var ip = curIp();
      var en = isEn();
      var baseItems = (en ? ip.quickJumpEn : ip.quickJumpZh).map(function (it) {
        return { type: 'sec', id: it.sec, title: it.title, sub: it.sub };
      });
      if (!isExportedSingle() && ALL_IPS.length > 1) {
        var ipItems = [];
        for (var i = 0; i < ALL_IPS.length; i++) {
          var item = ALL_IPS[i];
          ipItems.push({
            type: 'ip',
            id: item.id,
            title: en
              ? ('[Switch Product ' + item.idx_pad + '] ' + item.short_en)
              : ('[切换单品 ' + item.idx_pad + '] ' + item.short_zh + ' (' + item.short_en + ')'),
            sub: en ? (item.chip1_en + ' · ' + item.chip2_en) : (item.chip1_zh + ' · ' + item.chip2_zh)
          });
        }
        return ipItems.concat(baseItems);
      }
      return baseItems;
    }

    function init() {
      var rawTheme = safeGetStorage(STORAGE_THEME_KEY) || safeGetStorage(STORAGE_PORTAL_THEME_KEY);
      var savedTheme = rawTheme ? String(rawTheme).replace(/^"|"$/g, '') : '';
      if (savedTheme === 'light' || savedTheme === 'dark') state.theme = savedTheme;

      var rawDensity = safeGetStorage(STORAGE_DENSITY_KEY);
      if (rawDensity === 'compact' || rawDensity === 'comfortable') state.density = rawDensity;

      var rawLang = safeGetStorage(STORAGE_LANG_KEY);
      var savedLang = rawLang ? String(rawLang).replace(/^"|"$/g, '') : '';
      if (savedLang === 'zh' || savedLang === 'en') state.lang = savedLang;

      var initialIp = state.ipId;
      if (!isExportedSingle() && window.location.hash) {
        var m = window.location.hash.match(/ip=([a-z0-9_]+)/i);
        if (m && IP_MAP[m[1].toLowerCase()]) {
          initialIp = m[1].toLowerCase();
        }
      }

      window.addEventListener('storage', function (ev) {
        if ((ev.key === STORAGE_THEME_KEY || ev.key === STORAGE_PORTAL_THEME_KEY) && ev.newValue) {
          var nt = String(ev.newValue).replace(/^"|"$/g, '');
          if ((nt === 'light' || nt === 'dark') && nt !== state.theme) applyTheme(nt, true);
        } else if (ev.key === STORAGE_DENSITY_KEY && ev.newValue) {
          var nd = String(ev.newValue).replace(/^"|"$/g, '');
          if ((nd === 'compact' || nd === 'comfortable') && nd !== state.density) applyDensity(nd, true);
        } else if (ev.key === STORAGE_LANG_KEY && ev.newValue) {
          var nl = String(ev.newValue).replace(/^"|"$/g, '');
          if ((nl === 'zh' || nl === 'en') && nl !== state.lang) applyLanguage(nl, true);
        }
      });

      state.checks = loadChecksForIp(curIp());
      wireAllCanvases();
      observeSections();
      applyTheme(state.theme, true);
      applyDensity(state.density, true);
      if (initialIp !== state.ipId) {
        switchIp(initialIp, true);
      } else {
        applyLanguage(state.lang, true);
      }

      document.getElementById('langZhBtn').addEventListener('click', function () { applyLanguage('zh', false); });
      document.getElementById('langEnBtn').addEventListener('click', function () { applyLanguage('en', false); });
      document.getElementById('appbarThemeBtn').addEventListener('click', function () {
        applyTheme(state.theme === 'dark' ? 'light' : 'dark', false);
      });
      var dcBtn = document.getElementById('densityComfortBtn');
      var dkBtn = document.getElementById('densityCompactBtn');
      if (dcBtn) dcBtn.addEventListener('click', function () { applyDensity('comfortable', false); });
      if (dkBtn) dkBtn.addEventListener('click', function () { applyDensity('compact', false); });

      document.getElementById('sidebarToggleBtn').addEventListener('click', toggleSidebar);
      document.getElementById('drawerBackdrop').addEventListener('click', closeMobileDrawer);
      document.getElementById('sideThemeLightBtn').addEventListener('click', function () { applyTheme('light', false); });
      document.getElementById('sideThemeDarkBtn').addEventListener('click', function () { applyTheme('dark', false); });
      document.getElementById('sideExportBtn').addEventListener('click', exportActiveIpHtml);
      document.getElementById('sidePrintBtn').addEventListener('click', function () { window.print(); });

      var prevBtn = document.getElementById('prevIpBtn');
      var nextBtn = document.getElementById('nextIpBtn');
      var expSingle = document.getElementById('hubExportSingleBtn');
      if (prevBtn) prevBtn.addEventListener('click', function () { stepIp(-1); });
      if (nextBtn) nextBtn.addEventListener('click', function () { stepIp(1); });
      if (expSingle) expSingle.addEventListener('click', exportActiveIpHtml);



      var tocLinks = document.querySelectorAll('#tocNavList .mui-nav-link');
      for (var t = 0; t < tocLinks.length; t++) tocLinks[t].addEventListener('click', closeMobileDrawer);

      document.addEventListener('click', function (e) {
        var ipBtn = e.target.closest('[data-switch-ip]');
        if (ipBtn) {
          var targetIp = ipBtn.getAttribute('data-switch-ip');
          if (targetIp && targetIp !== state.ipId) switchIp(targetIp, false);
          return;
        }

        var ch1Btn = e.target.closest('[data-ch1-view]');
        if (ch1Btn) {
          state.ch1View = ch1Btn.getAttribute('data-ch1-view');
          var tA = document.getElementById('ch1TabA');
          var tB = document.getElementById('ch1TabB');
          if (tA) tA.classList.toggle('active', state.ch1View === 'viewA');
          if (tB) tB.classList.toggle('active', state.ch1View === 'viewB');
          syncCh1HeaderText();
          drawCh1Chart();
          return;
        }

        var ch1Ser = e.target.closest('[data-ch1-series]');
        if (ch1Ser) {
          var sk = ch1Ser.getAttribute('data-ch1-series');
          state.ch1Series[sk] = !state.ch1Series[sk];
          if (!state.ch1Series.s1 && !state.ch1Series.s2) state.ch1Series[sk] = true;
          ch1Ser.classList.toggle('muted', !state.ch1Series[sk]);
          drawCh1Chart();
          return;
        }

        var colBtn = e.target.closest('[data-collapse-target]');
        if (colBtn) {
          var panel = document.getElementById(colBtn.getAttribute('data-collapse-target'));
          if (panel) panel.classList.toggle('open');
          syncCollapseButtonsText();
          return;
        }

        var pilCard = e.target.closest('[data-pillar]');
        if (pilCard) {
          var idx = parseInt(pilCard.getAttribute('data-pillar'), 10) || 0;
          state.activePillar = idx;
          var allPils = document.querySelectorAll('[data-pillar]');
          for (var k = 0; k < allPils.length; k++) allPils[k].classList.toggle('active', k === idx);
          var pNote = document.getElementById('pillarFocusNote');
          var ipNow = curIp();
          if (pNote) pNote.innerHTML = '<div>' + (isEn() ? ipNow.ch2.pillars.map(function(p){return p.note_en;}) : ipNow.ch2.pillars.map(function(p){return p.note_zh;}))[idx] + '</div>';
          drawRadarChart();
          return;
        }

        var radPill = e.target.closest('[data-radar-key]');
        if (radPill) {
          var rKey = radPill.getAttribute('data-radar-key');
          state.radarSeries[rKey] = !state.radarSeries[rKey];
          if (!state.radarSeries.s0 && !state.radarSeries.s1 && !state.radarSeries.s2) state.radarSeries[rKey] = true;
          radPill.classList.toggle('muted', !state.radarSeries[rKey]);
          drawRadarChart();
          return;
        }

        var pfBtn = e.target.closest('[data-peer-filter]');
        if (pfBtn) {
          state.peerFilter = pfBtn.getAttribute('data-peer-filter');
          var allPf = document.querySelectorAll('[data-peer-filter]');
          for (var x = 0; x < allPf.length; x++) allPf[x].classList.toggle('active', allPf[x] === pfBtn);
          renderPeerTable();
          return;
        }

        var epsBtn = e.target.closest('[data-eps-series]');
        if (epsBtn) {
          var ek = epsBtn.getAttribute('data-eps-series');
          state.epsSeries[ek] = !state.epsSeries[ek];
          if (!state.epsSeries.rev && !state.epsSeries.oci) state.epsSeries[ek] = true;
          epsBtn.classList.toggle('muted', !state.epsSeries[ek]);
          drawEpsComboChart();
          return;
        }

        var prBtn = e.target.closest('[data-preset]');
        if (prBtn) {
          var pKey = prBtn.getAttribute('data-preset');
          var cfg = curIp().ch4.sim.presets[pKey];
          if (!cfg) return;
          state.sim.views = cfg.views;
          state.sim.v_per_view = cfg.v_per_view;
          state.sim.ancillary_m = cfg.ancillary_m;
          state.sim.years = cfg.years;
          state.sim.transmedia = cfg.transmedia;
          state.sim.preset = pKey;
          var uS = document.getElementById('simPrincipalSlider');
          var aS = document.getElementById('simCagrSlider');
          var lS = document.getElementById('simLiveArpuSlider');
          var yS = document.getElementById('simYearsSlider');
          var dT = document.getElementById('simDripToggle');
          if (uS) uS.value = String(cfg.views);
          if (aS) aS.value = String(cfg.v_per_view);
          if (lS) lS.value = String(cfg.ancillary_m);
          if (yS) yS.value = String(cfg.years);
          if (dT) dT.checked = cfg.transmedia;
          updateSimulatorUI();
          return;
        }

        if (e.target.closest('#checkAllBtn')) {
          state.checks = [true, true, true, true, true, true];
          safeSetStorage(curIp().checkKey, JSON.stringify(state.checks));
          renderChecklist();
          showToast(isEn() ? 'Checked all 6 product moat criteria' : '已勾选全部 6 项单品护城河核查指标');
          return;
        }

        if (e.target.closest('#resetCheckBtn')) {
          state.checks = [true, true, true, true, false, false];
          safeSetStorage(curIp().checkKey, JSON.stringify(state.checks));
          renderChecklist();
          showToast(isEn() ? 'Checklist reset to baseline (67%)' : '核查清单已恢复默认基准状态 (67%)');
          return;
        }
      });

      document.addEventListener('input', function (e) {
        if (e.target && e.target.id === 'peerSearchInput') {
          state.peerQuery = e.target.value;
          renderPeerTable();
        } else if (e.target && e.target.id === 'simPrincipalSlider') {
          state.sim.views = parseFloat(e.target.value) || 10;
          state.sim.preset = '';
          updateSimulatorUI();
        } else if (e.target && e.target.id === 'simCagrSlider') {
          state.sim.v_per_view = parseFloat(e.target.value) || 0.4;
          state.sim.preset = '';
          updateSimulatorUI();
        } else if (e.target && e.target.id === 'simLiveArpuSlider') {
          state.sim.ancillary_m = parseFloat(e.target.value) || 0;
          state.sim.preset = '';
          updateSimulatorUI();
        } else if (e.target && e.target.id === 'simYearsSlider') {
          state.sim.years = parseInt(e.target.value, 10) || 5;
          state.sim.preset = '';
          updateSimulatorUI();
        }
      });

      document.addEventListener('change', function (e) {
        if (e.target && e.target.id === 'simDripToggle') {
          state.sim.transmedia = !!e.target.checked;
          updateSimulatorUI();
          return;
        }
        var chk = e.target.closest ? e.target.closest('[data-check-input]') : null;
        if (chk) {
          var cIdx = parseInt(chk.getAttribute('data-check-input'), 10);
          state.checks[cIdx] = !!chk.checked;
          safeSetStorage(curIp().checkKey, JSON.stringify(state.checks));
          renderChecklist();
        }
      });

      var jumpInput = document.getElementById('quickJumpInput');
      var jumpPop = document.getElementById('quickJumpPopover');
      function renderJumpList(q) {
        var kw = (q || '').trim().toLowerCase();
        var items = buildQuickJumpItems().filter(function (it) {
          return !kw || (it.title + ' ' + it.sub + ' ' + it.id).toLowerCase().indexOf(kw) !== -1;
        });
        if (!items.length) {
          jumpPop.innerHTML = '<div style="padding:10px;font-size:0.78rem;color:var(--text-muted);">' + (isEn() ? 'No matching section or product' : '未匹配到对应章节或单品') + '</div>';
        } else {
          jumpPop.innerHTML = items.map(function (item) {
            return '<button type="button" class="quick-jump-item" data-jump-type="' + item.type + '" data-jump-id="' + item.id + '">' +
              '<span class="quick-jump-item-title">' + escapeHtml(item.title) + '</span>' +
              '<span class="quick-jump-item-sub">' + escapeHtml(item.sub) + '</span></button>';
          }).join('');
        }
        jumpPop.classList.add('open');
      }
      jumpInput.addEventListener('focus', function () { renderJumpList(jumpInput.value); });
      jumpInput.addEventListener('input', function () { renderJumpList(jumpInput.value); });
      jumpPop.addEventListener('click', function (e) {
        var btn = e.target.closest('[data-jump-id]');
        if (!btn) return;
        var jType = btn.getAttribute('data-jump-type');
        var jId = btn.getAttribute('data-jump-id');
        if (jType === 'ip') {
          switchIp(jId, false);
        } else {
          var secEl = document.getElementById(jId);
          if (secEl) secEl.scrollIntoView({ behavior: 'smooth' });
        }
        jumpPop.classList.remove('open');
      });
      document.addEventListener('click', function (e) {
        if (!e.target.closest('.quick-search-wrap')) jumpPop.classList.remove('open');
      });
      document.addEventListener('keydown', function (e) {
        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
          e.preventDefault();
          jumpInput.focus();
        } else if (e.key === 'Escape') {
          jumpPop.classList.remove('open');
          closeMobileDrawer();
        } else if (!isExportedSingle() && !e.target.matches('input, textarea')) {
          if (e.key === '[') stepIp(-1);
          else if (e.key === ']') stepIp(1);
        }
      });

      function updateScrollProgress() {
        var docEl = document.documentElement;
        var scrollTop = window.scrollY || docEl.scrollTop || 0;
        var maxScroll = Math.max(1, docEl.scrollHeight - window.innerHeight);
        document.getElementById('readingProgressBar').style.width = Math.min(100, Math.max(0, (scrollTop / maxScroll) * 100)) + '%';
      }
      window.addEventListener('scroll', updateScrollProgress, { passive: true });
      updateScrollProgress();

      var resizeTimer = null;
      function scheduleRedraw() {
        if (resizeTimer) clearTimeout(resizeTimer);
        resizeTimer = setTimeout(renderAllCharts, 60);
      }
      window.addEventListener('resize', scheduleRedraw);
      if ('ResizeObserver' in window) {
        var mainEl = document.querySelector('.main-content');
        if (mainEl) {
          var ro = new ResizeObserver(scheduleRedraw);
          ro.observe(mainEl);
        }
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
  </script>
</body>
</html>
