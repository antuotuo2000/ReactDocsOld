  <style>

 /* ==========================================================================
 MUI Official Branding Design System (https://mui.com/)
 Dark Obsidian (#090D16) + Sapphire Glow (#0073E6 / #3399FF) + Crisp Light
 Zero External Blocking CDN · Instant Offline & Canvas Rendering
 ========================================================================== */
 html[data-theme="dark"] {
 color-scheme: dark;
 --bg-canvas: #090D16;
 --bg-canvas-elevated: #0C1320;
 --bg-paper: rgba(15, 25, 36, 0.82);
 --bg-paper-solid: #0F1924;
 --bg-subtle: rgba(19, 35, 55, 0.62);
 --bg-hover: rgba(51, 153, 255, 0.08);
 --bg-active: rgba(0, 115, 230, 0.16);
 --bg-appbar: rgba(9, 13, 22, 0.78);
 --bg-code: rgba(12, 20, 32, 0.92);

 --border-subtle: rgba(51, 153, 255, 0.14);
 --border-default: rgba(148, 163, 184, 0.16);
 --border-strong: rgba(51, 153, 255, 0.42);
 --divider: rgba(148, 163, 184, 0.12);

 --text-primary: #F3F6F9;
 --text-secondary: #B2BAC2;
 --text-muted: #7E8C9A;
 --text-inverse: #090D16;

 --mui-primary-main: #0073E6;
 --mui-primary-light: #3399FF;
 --mui-primary-lighter: #66B2FF;
 --mui-primary-bg: rgba(0, 115, 230, 0.15);
 --mui-primary-border: rgba(51, 153, 255, 0.35);

 --mui-success-main: #1AA251;
 --mui-success-text: #66BB6A;
 --mui-success-bg: rgba(26, 162, 81, 0.14);
 --mui-success-border: rgba(102, 187, 106, 0.34);

 --mui-warning-main: #DEA500;
 --mui-warning-text: #FFB74D;
 --mui-warning-bg: rgba(255, 183, 77, 0.14);
 --mui-warning-border: rgba(255, 183, 77, 0.34);

 --mui-error-main: #EB0014;
 --mui-error-text: #FF6B6B;
 --mui-error-bg: rgba(235, 0, 20, 0.14);
 --mui-error-border: rgba(255, 107, 107, 0.34);

 --mui-violet-text: #A78BFA;
 --mui-violet-bg: rgba(139, 92, 246, 0.14);
 --mui-violet-border: rgba(167, 139, 250, 0.32);

 --hero-glow: radial-gradient(ellipse 86% 44% at 50% -8%, rgba(0, 115, 230, 0.24), rgba(9, 13, 22, 0) 70%);
 --blueprint-grid: linear-gradient(rgba(51, 153, 255, 0.065) 1px, transparent 1px),
 linear-gradient(90deg, rgba(51, 153, 255, 0.065) 1px, transparent 1px);
 --shadow-card: inset 0 1px 0 rgba(255, 255, 255, 0.05), 0 8px 26px rgba(0, 0, 0, 0.30);
 --shadow-popover: 0 16px 40px rgba(0, 0, 0, 0.55), 0 0 0 1px rgba(51, 153, 255, 0.22);

 --chart-grid: rgba(148, 163, 184, 0.13);
 --chart-tick: #94A3B8;
 --chart-c1: #3399FF;
 --chart-c2: #22C55E;
 --chart-c3: #FFB74D;
 --chart-c4: #A78BFA;
 }

 :root,
 html[data-theme="light"] {
 color-scheme: light;
 --bg-canvas: #F8FAFC;
 --bg-canvas-elevated: #F1F5F9;
 --bg-paper: rgba(255, 255, 255, 0.94);
 --bg-paper-solid: #FFFFFF;
 --bg-subtle: #F1F5F9;
 --bg-hover: rgba(0, 115, 230, 0.06);
 --bg-active: rgba(0, 115, 230, 0.11);
 --bg-appbar: rgba(255, 255, 255, 0.84);
 --bg-code: #F1F5F9;

 --border-subtle: #E2E8F0;
 --border-default: #CBD5E1;
 --border-strong: #0073E6;
 --divider: #E2E8F0;

 --text-primary: #0F1924;
 --text-secondary: #334155;
 --text-muted: #5B6B7C;
 --text-inverse: #FFFFFF;

 --mui-primary-main: #0073E6;
 --mui-primary-light: #0059B2;
 --mui-primary-lighter: #0059B2;
 --mui-primary-bg: rgba(0, 115, 230, 0.09);
 --mui-primary-border: rgba(0, 115, 230, 0.28);

 --mui-success-main: #15803D;
 --mui-success-text: #15803D;
 --mui-success-bg: rgba(21, 128, 61, 0.09);
 --mui-success-border: rgba(21, 128, 61, 0.26);

 --mui-warning-main: #B45309;
 --mui-warning-text: #B45309;
 --mui-warning-bg: rgba(180, 83, 9, 0.09);
 --mui-warning-border: rgba(180, 83, 9, 0.26);

 --mui-error-main: #C62828;
 --mui-error-text: #C62828;
 --mui-error-bg: rgba(198, 40, 40, 0.08);
 --mui-error-border: rgba(198, 40, 40, 0.26);

 --mui-violet-text: #6D28D9;
 --mui-violet-bg: rgba(109, 40, 217, 0.08);
 --mui-violet-border: rgba(109, 40, 217, 0.25);

 --hero-glow: radial-gradient(ellipse 86% 44% at 50% -8%, rgba(0, 115, 230, 0.10), rgba(248, 250, 252, 0) 70%);
 --blueprint-grid: linear-gradient(rgba(0, 115, 230, 0.05) 1px, transparent 1px),
 linear-gradient(90deg, rgba(0, 115, 230, 0.05) 1px, transparent 1px);
 --shadow-card: 0 1px 3px rgba(15, 25, 36, 0.04), 0 6px 20px rgba(15, 25, 36, 0.04);
 --shadow-popover: 0 14px 34px rgba(15, 25, 36, 0.14), 0 0 0 1px #CBD5E1;

 --chart-grid: rgba(100, 116, 139, 0.16);
 --chart-tick: #475569;
 --chart-c1: #0073E6;
 --chart-c2: #16A34A;
 --chart-c3: #D97706;
 --chart-c4: #7C3AED;
 }

 * {
 box-sizing: border-box;
 margin: 0;
 padding: 0;
 }

 html {
 scroll-behavior: smooth;
 font-size: 16px;
 -webkit-text-size-adjust: 100%;
 overflow-x: hidden;
 max-width: 100%;
 }

 body {
 font-family: "Plus Jakarta Sans", "Inter", -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "Noto Sans SC", system-ui, sans-serif;
 background-color: var(--bg-canvas);
 background-image: var(--hero-glow);
 background-attachment: fixed;
 color: var(--text-primary);
 line-height: 1.65;
 overflow-x: hidden;
 max-width: 100%;
 min-height: 100vh;
 }

 .mono {
 font-family: "IBM Plex Mono", "SFMono-Regular", ui-monospace, Menlo, Monaco, Consolas, monospace;
 font-variant-numeric: tabular-nums;
 }

 a {
 color: var(--mui-primary-lighter);
 text-decoration: none;
 transition: color 0.16s ease, background-color 0.16s ease, border-color 0.16s ease;
 }

 a:hover {
 text-decoration: underline;
 }

 /* Inline Citation Chip (MUI Link Pill) */
 .cite-link {
 display: inline-flex;
 align-items: center;
 gap: 3px;
 font-size: 0.76rem;
 font-weight: 600;
 line-height: 1.3;
 padding: 1px 7px;
 margin: 0 2px;
 border-radius: 6px;
 background: var(--mui-primary-bg);
 border: 1px solid var(--mui-primary-border);
 color: var(--mui-primary-lighter);
 white-space: nowrap;
 vertical-align: baseline;
 text-decoration: none !important;
 max-width: 100%;
 }

 .cite-link:hover {
 background: var(--bg-active);
 border-color: var(--mui-primary-light);
 transform: translateY(-0.5px);
 }

 /* Top Reading Progress Bar */
 #readingProgressBar {
 position: fixed;
 top: 0;
 left: 0;
 height: 3px;
 width: 0%;
 background: linear-gradient(90deg, #0073E6 0%, #3399FF 60%, #22C55E 100%);
 z-index: 1300;
 transition: width 0.08s linear;
 }

 /* Sticky Frosted Glass MUI AppBar */
 .mui-appbar {
 position: sticky;
 top: 0;
 z-index: 1100;
 height: 60px;
 background: var(--bg-appbar);
 backdrop-filter: blur(16px);
 -webkit-backdrop-filter: blur(16px);
 border-bottom: 1px solid var(--border-subtle);
 }

 .mui-appbar-inner {
 max-width: 1560px;
 height: 100%;
 margin: 0 auto;
 padding: 0 20px;
 display: flex;
 align-items: center;
 justify-content: space-between;
 gap: 12px;
 }

 .appbar-left {
 display: flex;
 align-items: center;
 gap: 10px;
 min-width: 0;
 }

 .mui-icon-btn {
 display: inline-flex;
 align-items: center;
 justify-content: center;
 width: 36px;
 height: 36px;
 border-radius: 10px;
 border: 1px solid var(--border-subtle);
 background: var(--bg-paper);
 color: var(--text-primary);
 cursor: pointer;
 transition: all 0.16s ease;
 flex-shrink: 0;
 }

 .mui-icon-btn:hover {
 border-color: var(--border-strong);
 background: var(--bg-hover);
 }

 .brand-monogram {
 width: 34px;
 height: 34px;
 border-radius: 9px;
 background: linear-gradient(135deg, #0073E6 0%, #004C99 100%);
 box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.28), 0 4px 12px rgba(0, 115, 230, 0.32);
 color: #FFFFFF;
 font-weight: 800;
 font-size: 0.84rem;
 letter-spacing: 0.03em;
 display: inline-flex;
 align-items: center;
 justify-content: center;
 flex-shrink: 0;
 }

 .breadcrumbs {
 display: flex;
 align-items: center;
 gap: 6px;
 font-size: 0.85rem;
 color: var(--text-secondary);
 white-space: nowrap;
 overflow: hidden;
 text-overflow: ellipsis;
 }

 .breadcrumbs .crumb-link {
 display: inline-flex;
 align-items: center;
 gap: 5px;
 padding: 3px 8px;
 border-radius: 7px;
 color: var(--text-secondary);
 font-weight: 600;
 transition: all 0.15s ease;
 }

 .breadcrumbs .crumb-link:hover {
 color: var(--mui-primary-lighter);
 background: var(--bg-hover);
 text-decoration: none;
 }

 .breadcrumbs .crumb-current {
 color: var(--text-primary);
 font-weight: 700;
 overflow: hidden;
 text-overflow: ellipsis;
 }

 .appbar-right {
 display: flex;
 align-items: center;
 gap: 8px;
 flex-shrink: 0;
 }

 /* Quick Jump Search Input in AppBar (MUI Ctrl+K trigger style) */
 .quick-search-wrap {
 position: relative;
 width: 220px;
 }

 .quick-search-input {
 width: 100%;
 height: 34px;
 padding: 0 44px 0 32px;
 border-radius: 10px;
 border: 1px solid var(--border-subtle);
 background: var(--bg-paper);
 color: var(--text-primary);
 font-size: 0.8rem;
 outline: none;
 transition: all 0.16s ease;
 }

 .quick-search-input:focus {
 border-color: var(--mui-primary-light);
 box-shadow: 0 0 0 3px var(--mui-primary-bg);
 }

 .quick-search-icon {
 position: absolute;
 left: 10px;
 top: 50%;
 transform: translateY(-50%);
 color: var(--text-muted);
 pointer-events: none;
 display: flex;
 }

 .quick-search-kbd {
 position: absolute;
 right: 7px;
 top: 50%;
 transform: translateY(-50%);
 font-size: 0.68rem;
 font-weight: 700;
 padding: 1px 5px;
 border-radius: 5px;
 border: 1px solid var(--border-default);
 background: var(--bg-subtle);
 color: var(--text-muted);
 pointer-events: none;
 }

 .quick-jump-popover {
 position: absolute;
 top: 40px;
 right: 0;
 width: 320px;
 max-height: 340px;
 overflow-y: auto;
 border-radius: 12px;
 background: var(--bg-paper-solid);
 box-shadow: var(--shadow-popover);
 padding: 6px;
 display: none;
 z-index: 1250;
 }

 .quick-jump-popover.open {
 display: block;
 }

 .quick-jump-item {
 display: flex;
 flex-direction: column;
 gap: 2px;
 width: 100%;
 text-align: left;
 padding: 8px 10px;
 border: none;
 border-radius: 8px;
 background: transparent;
 color: var(--text-primary);
 cursor: pointer;
 font-family: inherit;
 }

 .quick-jump-item:hover {
 background: var(--bg-hover);
 }

 .quick-jump-item-title {
 font-size: 0.82rem;
 font-weight: 700;
 color: var(--mui-primary-lighter);
 }

 .quick-jump-item-sub {
 font-size: 0.74rem;
 color: var(--text-secondary);
 }

 /* MUI Segmented Control */
 .mui-segmented {
 display: inline-flex;
 align-items: center;
 padding: 3px;
 border-radius: 10px;
 background: var(--bg-subtle);
 border: 1px solid var(--border-subtle);
 gap: 2px;
 }

 .mui-seg-btn {
 border: none;
 background: transparent;
 color: var(--text-secondary);
 font-family: inherit;
 font-size: 0.78rem;
 font-weight: 600;
 padding: 5px 10px;
 border-radius: 7px;
 cursor: pointer;
 display: inline-flex;
 align-items: center;
 gap: 5px;
 transition: all 0.16s ease;
 white-space: nowrap;
 }

 .mui-seg-btn:hover {
 color: var(--text-primary);
 }

 .mui-seg-btn.active {
 background: var(--bg-paper-solid);
 color: var(--mui-primary-lighter);
 box-shadow: 0 1px 3px rgba(15, 25, 36, 0.12), 0 0 0 1px var(--border-subtle);
 }

 /* MUI Buttons */
 .mui-btn {
 display: inline-flex;
 align-items: center;
 justify-content: center;
 gap: 6px;
 height: 34px;
 padding: 0 12px;
 border-radius: 10px;
 font-family: inherit;
 font-size: 0.8rem;
 font-weight: 600;
 cursor: pointer;
 transition: all 0.16s ease;
 white-space: nowrap;
 border: 1px solid var(--border-subtle);
 background: var(--bg-paper);
 color: var(--text-primary);
 }

 .mui-btn:hover {
 border-color: var(--border-strong);
 background: var(--bg-hover);
 }

 .mui-btn-primary {
 background: linear-gradient(180deg, #1985F1 0%, #0073E6 100%);
 border-color: #0073E6;
 color: #FFFFFF;
 box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.22), 0 3px 10px rgba(0, 115, 230, 0.28);
 }

 .mui-btn-primary:hover {
 background: linear-gradient(180deg, #3399FF 0%, #0066CC 100%);
 border-color: #3399FF;
 color: #FFFFFF;
 }

 /* MUI Chips */
 .mui-chip {
 display: inline-flex;
 align-items: center;
 gap: 5px;
 height: 24px;
 padding: 0 9px;
 border-radius: 999px;
 font-size: 0.74rem;
 font-weight: 700;
 letter-spacing: 0.01em;
 border: 1px solid var(--border-subtle);
 background: var(--bg-subtle);
 color: var(--text-secondary);
 white-space: nowrap;
 max-width: 100%;
 }

 .mui-chip-primary {
 background: var(--mui-primary-bg);
 border-color: var(--mui-primary-border);
 color: var(--mui-primary-lighter);
 }

 .mui-chip-success {
 background: var(--mui-success-bg);
 border-color: var(--mui-success-border);
 color: var(--mui-success-text);
 }

 .mui-chip-warning {
 background: var(--mui-warning-bg);
 border-color: var(--mui-warning-border);
 color: var(--mui-warning-text);
 }

 .mui-chip-error {
 background: var(--mui-error-bg);
 border-color: var(--mui-error-border);
 color: var(--mui-error-text);
 }

 .mui-chip-violet {
 background: var(--mui-violet-bg);
 border-color: var(--mui-violet-border);
 color: var(--mui-violet-text);
 }

 /* Main Centered MUI Docs Layout Shell */
 .layout-shell {
 max-width: 1560px;
 margin: 0 auto;
 display: grid;
 grid-template-columns: 280px minmax(0, 1fr);
 gap: 28px;
 padding: 24px 20px 72px;
 align-items: start;
 }

 body.sidebar-collapsed .layout-shell {
 grid-template-columns: minmax(0, 1fr);
 max-width: 1280px;
 }

 body.sidebar-collapsed .mui-sidebar {
 display: none;
 }

 /* Left Persistent MUI Docs Sidebar / Mobile Drawer */
 .mui-sidebar {
 position: sticky;
 top: 78px;
 max-height: calc(100vh - 96px);
 overflow-y: auto;
 display: flex;
 flex-direction: column;
 gap: 14px;
 padding-right: 4px;
 }

 .mui-sidebar::-webkit-scrollbar {
 width: 5px;
 }

 .mui-sidebar::-webkit-scrollbar-thumb {
 background: var(--border-default);
 border-radius: 999px;
 }

 .sidebar-card {
 background: var(--bg-paper);
 border: 1px solid var(--border-subtle);
 border-radius: 14px;
 padding: 16px;
 box-shadow: var(--shadow-card);
 }

 .sidebar-brand-top {
 display: flex;
 align-items: center;
 justify-content: space-between;
 gap: 8px;
 margin-bottom: 8px;
 }

 .sidebar-title {
 font-size: 1rem;
 font-weight: 800;
 color: var(--text-primary);
 letter-spacing: -0.01em;
 }

 .sidebar-subtitle {
 font-size: 0.78rem;
 color: var(--text-secondary);
 line-height: 1.5;
 margin-top: 4px;
 }

 .sidebar-mini-kpis {
 display: flex;
 flex-direction: column;
 gap: 8px;
 margin-top: 12px;
 padding-top: 12px;
 border-top: 1px solid var(--divider);
 }

 .sidebar-mini-row {
 display: flex;
 align-items: center;
 justify-content: space-between;
 gap: 8px;
 font-size: 0.76rem;
 }

 .sidebar-mini-label {
 color: var(--text-muted);
 }

 .sidebar-mini-val {
 font-weight: 700;
 color: var(--text-primary);
 white-space: nowrap;
 }

 .nav-section-label {
 font-size: 0.7rem;
 font-weight: 800;
 text-transform: uppercase;
 letter-spacing: 0.08em;
 color: var(--text-muted);
 margin-bottom: 8px;
 padding-left: 8px;
 }

 .mui-nav-list {
 list-style: none;
 display: flex;
 flex-direction: column;
 gap: 3px;
 }

 .mui-nav-link {
 display: flex;
 align-items: center;
 gap: 9px;
 padding: 8px 10px 8px 12px;
 border-radius: 9px;
 font-size: 0.82rem;
 font-weight: 600;
 color: var(--text-secondary);
 position: relative;
 text-decoration: none !important;
 transition: all 0.15s ease;
 }

 .mui-nav-link::before {
 content: "";
 position: absolute;
 left: 0;
 top: 6px;
 bottom: 6px;
 width: 3px;
 border-radius: 999px;
 background: transparent;
 transition: background 0.15s ease;
 }

 .mui-nav-link:hover {
 background: var(--bg-hover);
 color: var(--text-primary);
 }

 .mui-nav-link.active {
 background: var(--mui-primary-bg);
 color: var(--mui-primary-lighter);
 font-weight: 700;
 }

 .mui-nav-link.active::before {
 background: var(--mui-primary-light);
 }

 .nav-idx {
 font-size: 0.72rem;
 font-weight: 700;
 padding: 1px 6px;
 border-radius: 5px;
 background: var(--bg-subtle);
 color: var(--text-muted);
 }

 .mui-nav-link.active .nav-idx {
 background: rgba(0, 115, 230, 0.24);
 color: var(--mui-primary-lighter);
 }

 .nav-divider {
 height: 1px;
 background: var(--divider);
 margin: 12px 0;
 }

 .mui-ext-nav-link {
 display: flex;
 align-items: center;
 justify-content: space-between;
 gap: 8px;
 padding: 7px 10px;
 border-radius: 9px;
 font-size: 0.81rem;
 font-weight: 600;
 color: var(--text-secondary);
 text-decoration: none !important;
 transition: all 0.15s ease;
 }

 .mui-ext-nav-link:hover {
 background: var(--bg-hover);
 color: var(--mui-primary-lighter);
 }

 .mui-ext-nav-left {
 display: flex;
 align-items: center;
 gap: 9px;
 min-width: 0;
 }

 .mui-ext-nav-icon {
 width: 24px;
 height: 24px;
 border-radius: 6px;
 background: var(--mui-primary-bg);
 border: 1px solid var(--mui-primary-border);
 color: var(--mui-primary-lighter);
 display: inline-flex;
 align-items: center;
 justify-content: center;
 flex-shrink: 0;
 }

 .mui-ext-nav-arrow {
 font-size: 0.74rem;
 color: var(--text-muted);
 flex-shrink: 0;
 transition: transform 0.15s ease, color 0.15s ease;
 }

 .mui-ext-nav-link:hover .mui-ext-nav-arrow {
 color: var(--mui-primary-lighter);
 transform: translate(1px, -1px);
 }

 .sidebar-actions {
 display: flex;
 flex-direction: column;
 gap: 8px;
 padding: 13px 14px;
 }

 .side-theme-group {
 display: grid;
 grid-template-columns: 1fr 1fr;
 padding: 3px;
 border-radius: 9px;
 background: var(--bg-subtle);
 border: 1px solid var(--border-subtle);
 gap: 3px;
 }

 .side-theme-opt {
 height: 28px;
 border: none;
 border-radius: 6px;
 background: transparent;
 color: var(--text-secondary);
 font-family: inherit;
 font-size: 0.77rem;
 font-weight: 600;
 display: inline-flex;
 align-items: center;
 justify-content: center;
 gap: 5px;
 cursor: pointer;
 transition: all 0.15s ease;
 }

 .side-theme-opt:hover {
 color: var(--text-primary);
 }

 .side-theme-opt.active {
 background: var(--bg-paper-solid);
 color: var(--mui-primary-lighter);
 box-shadow: 0 1px 3px rgba(15, 25, 36, 0.10), 0 0 0 1px var(--border-subtle);
 }

 .side-tool-grid {
 display: grid;
 grid-template-columns: 1fr 1fr;
 gap: 8px;
 }

 .mui-tool-btn {
 display: inline-flex;
 align-items: center;
 justify-content: center;
 gap: 5px;
 height: 32px;
 padding: 0 8px;
 border-radius: 8px;
 border: 1px solid var(--border-subtle);
 background: var(--bg-paper-solid);
 color: var(--text-secondary);
 font-family: inherit;
 font-size: 0.77rem;
 font-weight: 600;
 cursor: pointer;
 white-space: nowrap;
 transition: all 0.15s ease;
 }

 .mui-tool-btn:hover {
 color: var(--mui-primary-lighter);
 border-color: var(--mui-primary-border);
 background: var(--bg-hover);
 }

 .drawer-backdrop {
 display: none;
 position: fixed;
 inset: 0;
 background: rgba(3, 7, 18, 0.64);
 backdrop-filter: blur(4px);
 z-index: 1180;
 }

 /* Main Content Stack */
 .main-content {
 display: flex;
 flex-direction: column;
 gap: 28px;
 min-width: 0;
 }

 /* MUI Paper Card Base */
 .mui-paper, .section-block, .chart-card, .arch-blueprint, .mui-alert,
 .sim-controls, .sim-output-panel, .matrix-card, .feature-card, .kpi-card {
 min-width: 0;
 max-width: 100%;
 }

 .mui-paper {
 background: var(--bg-paper);
 border: 1px solid var(--border-subtle);
 border-radius: 14px;
 box-shadow: var(--shadow-card);
 transition: border-color 0.18s ease, box-shadow 0.18s ease, transform 0.18s ease;
 }

 .mui-card-interactive:hover {
 border-color: var(--border-strong);
 }

 /* Hero Blueprint Showcase Card */
 .hero-card {
 position: relative;
 overflow: hidden;
 padding: 28px;
 background-image: var(--blueprint-grid);
 background-size: 28px 28px;
 }

 .hero-card::after {
 content: "";
 position: absolute;
 top: -90px;
 right: -90px;
 width: 320px;
 height: 320px;
 border-radius: 50%;
 background: radial-gradient(circle, rgba(0, 115, 230, 0.22) 0%, transparent 70%);
 pointer-events: none;
 }

 .status-strip {
 display: flex;
 flex-wrap: wrap;
 gap: 8px;
 margin-bottom: 16px;
 }

 .hero-overline {
 display: inline-flex;
 align-items: center;
 gap: 8px;
 font-size: 0.76rem;
 font-weight: 800;
 letter-spacing: 0.04em;
 color: var(--mui-primary-lighter);
 margin-bottom: 10px;
 }

 .hero-h1 {
 font-size: clamp(1.5rem, 2.5vw, 2.15rem);
 font-weight: 800;
 line-height: 1.28;
 letter-spacing: -0.02em;
 color: var(--text-primary);
 margin-bottom: 16px;
 overflow-wrap: anywhere;
 }

 .hero-h1 .gradient-accent {
 background: linear-gradient(90deg, #0059B2 0%, #0073E6 60%, #15803D 100%);
 -webkit-background-clip: text;
 -webkit-text-fill-color: transparent;
 }

 html[data-theme="dark"] .hero-h1 .gradient-accent {
 background: linear-gradient(90deg, #3399FF 0%, #66B2FF 55%, #66BB6A 100%);
 -webkit-background-clip: text;
 -webkit-text-fill-color: transparent;
 }

 .lead-prose {
 font-size: 0.96rem;
 color: var(--text-secondary);
 line-height: 1.78;
 margin-bottom: 22px;
 overflow-wrap: anywhere;
 }

 .lead-prose strong {
 color: var(--text-primary);
 font-weight: 700;
 }

 /* Grid Helpers */
 .grid-3 {
 display: grid;
 grid-template-columns: repeat(3, minmax(0, 1fr));
 gap: 16px;
 }

 .grid-4 {
 display: grid;
 grid-template-columns: repeat(4, minmax(0, 1fr));
 gap: 14px;
 }

 .grid-2 {
 display: grid;
 grid-template-columns: repeat(2, minmax(0, 1fr));
 gap: 16px;
 }

 .grid-radar {
 display: grid;
 grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
 gap: 18px;
 align-items: stretch;
 }

 /* Feature & KPI Cards */
 .feature-card {
 padding: 18px;
 background: var(--bg-canvas-elevated);
 border: 1px solid var(--border-subtle);
 border-radius: 12px;
 display: flex;
 flex-direction: column;
 gap: 8px;
 transition: border-color 0.16s ease, transform 0.16s ease;
 }

 .feature-card:hover {
 border-color: var(--border-strong);
 transform: translateY(-1px);
 }

 .mui-avatar-icon {
 width: 38px;
 height: 38px;
 border-radius: 10px;
 display: inline-flex;
 align-items: center;
 justify-content: center;
 background: var(--mui-primary-bg);
 border: 1px solid var(--mui-primary-border);
 color: var(--mui-primary-lighter);
 flex-shrink: 0;
 }

 .feature-card h3 {
 font-size: 0.95rem;
 font-weight: 700;
 color: var(--text-primary);
 }

 .feature-card p {
 font-size: 0.84rem;
 color: var(--text-secondary);
 line-height: 1.6;
 }

 .kpi-card {
 padding: 18px;
 display: flex;
 flex-direction: column;
 gap: 6px;
 position: relative;
 overflow: hidden;
 }

 .kpi-top {
 display: flex;
 align-items: center;
 justify-content: space-between;
 gap: 8px;
 }

 .kpi-label {
 font-size: 0.78rem;
 font-weight: 700;
 color: var(--text-muted);
 }

 .kpi-value {
 font-size: 1.72rem;
 font-weight: 800;
 letter-spacing: -0.02em;
 color: var(--text-primary);
 line-height: 1.2;
 margin: 2px 0;
 }

 .kpi-desc {
 font-size: 0.79rem;
 color: var(--text-secondary);
 line-height: 1.52;
 }

 /* Section Header Pattern */
 .section-block {
 scroll-margin-top: 76px;
 padding: 26px;
 }

 .sec-header {
 display: flex;
 flex-wrap: wrap;
 align-items: flex-start;
 justify-content: space-between;
 gap: 12px;
 margin-bottom: 20px;
 padding-bottom: 16px;
 border-bottom: 1px solid var(--divider);
 }

 .sec-eyebrow {
 display: inline-flex;
 align-items: center;
 gap: 8px;
 font-size: 0.74rem;
 font-weight: 800;
 letter-spacing: 0.06em;
 text-transform: uppercase;
 color: var(--mui-primary-lighter);
 margin-bottom: 6px;
 }

 .sec-h2 {
 font-size: clamp(1.22rem, 1.9vw, 1.48rem);
 font-weight: 800;
 color: var(--text-primary);
 letter-spacing: -0.015em;
 line-height: 1.35;
 overflow-wrap: anywhere;
 }

 .sec-sub {
 font-size: 0.86rem;
 color: var(--text-secondary);
 margin-top: 4px;
 }

 /* MUI Outlined Alert */
 .mui-alert {
 display: flex;
 align-items: flex-start;
 gap: 12px;
 padding: 14px 16px;
 border-radius: 12px;
 border: 1px solid var(--mui-primary-border);
 background: var(--mui-primary-bg);
 font-size: 0.85rem;
 color: var(--text-primary);
 }

 .mui-alert-success {
 border-color: var(--mui-success-border);
 background: var(--mui-success-bg);
 }

 .mui-alert-warning {
 border-color: var(--mui-warning-border);
 background: var(--mui-warning-bg);
 }

 /* Product Architecture Blueprint Diagram */
 .arch-blueprint {
 padding: 18px;
 border-radius: 12px;
 border: 1px solid var(--border-subtle);
 background: var(--bg-canvas-elevated);
 background-image: var(--blueprint-grid);
 background-size: 24px 24px;
 margin-bottom: 18px;
 }

 .arch-hub {
 text-align: center;
 padding: 12px 16px;
 border-radius: 10px;
 background: linear-gradient(90deg, rgba(0, 115, 230, 0.20), rgba(51, 153, 255, 0.10), rgba(0, 115, 230, 0.20));
 border: 1px solid var(--mui-primary-border);
 margin-bottom: 12px;
 }

 .arch-hub-title {
 font-size: 0.9rem;
 font-weight: 800;
 color: var(--text-primary);
 }

 .arch-hub-sub {
 font-size: 0.76rem;
 color: var(--text-secondary);
 margin-top: 2px;
 }

 .arch-nodes {
 display: grid;
 grid-template-columns: repeat(3, minmax(0, 1fr));
 gap: 10px;
 margin-bottom: 12px;
 }

 .arch-node {
 padding: 11px 12px;
 border-radius: 10px;
 background: var(--bg-paper);
 border: 1px solid var(--border-subtle);
 }

 .arch-node-tag {
 font-size: 0.68rem;
 font-weight: 800;
 color: var(--mui-primary-lighter);
 text-transform: uppercase;
 letter-spacing: 0.04em;
 }

 .arch-node-name {
 font-size: 0.84rem;
 font-weight: 700;
 color: var(--text-primary);
 margin: 2px 0;
 }

 .arch-node-desc {
 font-size: 0.74rem;
 color: var(--text-secondary);
 line-height: 1.45;
 }

 .arch-platform-bar {
 display: grid;
 grid-template-columns: repeat(2, minmax(0, 1fr));
 gap: 10px;
 }

 .arch-platform {
 padding: 10px 14px;
 border-radius: 10px;
 background: var(--mui-success-bg);
 border: 1px solid var(--mui-success-border);
 display: flex;
 flex-direction: column;
 gap: 2px;
 }

 .arch-platform strong {
 font-size: 0.82rem;
 color: var(--mui-success-text);
 }

 .arch-platform span {
 font-size: 0.75rem;
 color: var(--text-secondary);
 }

 /* Expandable Matrix Card (MUI Card + Collapse) */
 .matrix-card {
 padding: 18px;
 border-radius: 12px;
 background: var(--bg-canvas-elevated);
 border: 1px solid var(--border-subtle);
 display: flex;
 flex-direction: column;
 gap: 10px;
 transition: border-color 0.16s ease;
 }

 .matrix-card:hover {
 border-color: var(--border-strong);
 }

 .matrix-card-head {
 display: flex;
 align-items: flex-start;
 justify-content: space-between;
 gap: 10px;
 }

 .matrix-card-title {
 font-size: 0.95rem;
 font-weight: 700;
 color: var(--text-primary);
 line-height: 1.4;
 }

 .matrix-card-body {
 font-size: 0.84rem;
 color: var(--text-secondary);
 line-height: 1.65;
 overflow-wrap: anywhere;
 }

 .collapse-toggle {
 align-self: flex-start;
 border: none;
 background: transparent;
 color: var(--mui-primary-lighter);
 font-family: inherit;
 font-size: 0.78rem;
 font-weight: 700;
 cursor: pointer;
 display: inline-flex;
 align-items: center;
 gap: 4px;
 padding: 4px 0;
 }

 .collapse-panel {
 display: none;
 padding-top: 10px;
 border-top: 1px dashed var(--divider);
 font-size: 0.8rem;
 color: var(--text-secondary);
 line-height: 1.6;
 }

 .collapse-panel.open {
 display: block;
 }

 /* Chart Showcase Container */
 .chart-card {
 padding: 18px;
 border-radius: 12px;
 background: var(--bg-canvas-elevated);
 border: 1px solid var(--border-subtle);
 }

 .chart-toolbar {
 display: flex;
 flex-wrap: wrap;
 align-items: center;
 justify-content: space-between;
 gap: 12px;
 margin-bottom: 14px;
 }

 .chart-title {
 font-size: 0.94rem;
 font-weight: 700;
 color: var(--text-primary);
 }

 .chart-caption {
 font-size: 0.77rem;
 color: var(--text-muted);
 margin-top: 2px;
 }

 .canvas-stage {
 position: relative;
 width: 100%;
 height: 326px;
 overflow: hidden;
 }

 .canvas-stage-tall {
 position: relative;
 width: 100%;
 height: 356px;
 overflow: hidden;
 }

 .canvas-stage-bars {
 position: relative;
 width: 100%;
 height: 392px;
 overflow: hidden;
 }

 .canvas-stage-sim {
 position: relative;
 width: 100%;
 height: 232px;
 overflow: hidden;
 }

 .canvas-stage canvas,
 .canvas-stage-tall canvas,
 .canvas-stage-bars canvas,
 .canvas-stage-sim canvas {
 width: 100% !important;
 height: 100% !important;
 display: block;
 }

 .chart-axis-meta {
 display: flex;
 align-items: center;
 justify-content: space-between;
 gap: 8px;
 font-size: 0.73rem;
 font-weight: 700;
 color: var(--text-muted);
 margin-bottom: 6px;
 padding: 0 4px;
 }

 .chart-legend {
 display: flex;
 flex-wrap: wrap;
 gap: 10px;
 margin-top: 12px;
 align-items: center;
 }

 .legend-pill {
 display: inline-flex;
 align-items: center;
 gap: 6px;
 font-size: 0.76rem;
 font-weight: 600;
 color: var(--text-secondary);
 padding: 4px 10px;
 border-radius: 999px;
 border: 1px solid var(--border-subtle);
 background: var(--bg-paper);
 cursor: pointer;
 font-family: inherit;
 transition: all 0.15s ease;
 }

 .legend-pill.muted {
 opacity: 0.42;
 }

 .legend-dot {
 width: 9px;
 height: 9px;
 border-radius: 50%;
 flex-shrink: 0;
 }

 /* Product Pillar Selectable Accordion Cards */
 .pillar-stack {
 display: flex;
 flex-direction: column;
 gap: 10px;
 }

 .pillar-card {
 width: 100%;
 text-align: left;
 padding: 15px 16px;
 border-radius: 12px;
 border: 1px solid var(--border-subtle);
 background: var(--bg-canvas-elevated);
 color: var(--text-primary);
 cursor: pointer;
 font-family: inherit;
 transition: all 0.16s ease;
 }

 .pillar-card:hover {
 border-color: var(--border-strong);
 }

 .pillar-card.active {
 border-color: var(--mui-primary-light);
 background: var(--mui-primary-bg);
 box-shadow: inset 3px 0 0 var(--mui-primary-light);
 }

 .pillar-head {
 display: flex;
 align-items: center;
 justify-content: space-between;
 gap: 8px;
 margin-bottom: 6px;
 }

 .pillar-title {
 font-size: 0.92rem;
 font-weight: 700;
 color: var(--text-primary);
 }

 .pillar-desc {
 font-size: 0.83rem;
 color: var(--text-secondary);
 line-height: 1.6;
 overflow-wrap: anywhere;
 }

 /* MUI X DataGrid Inspired Comparison Table */
 .datagrid-toolbar {
 display: flex;
 flex-wrap: wrap;
 align-items: center;
 justify-content: space-between;
 gap: 12px;
 margin-bottom: 14px;
 }

 .mui-input-outlined {
 height: 36px;
 min-width: 260px;
 flex: 1;
 max-width: 380px;
 padding: 0 12px;
 border-radius: 10px;
 border: 1px solid var(--border-subtle);
 background: var(--bg-canvas-elevated);
 color: var(--text-primary);
 font-family: inherit;
 font-size: 0.83rem;
 outline: none;
 transition: border-color 0.16s ease, box-shadow 0.16s ease;
 }

 .mui-input-outlined:focus {
 border-color: var(--mui-primary-light);
 box-shadow: 0 0 0 3px var(--mui-primary-bg);
 }

 .table-wrap {
 width: 100%;
 overflow-x: auto;
 border-radius: 12px;
 border: 1px solid var(--border-subtle);
 background: var(--bg-canvas-elevated);
 }

 .mui-table {
 width: 100%;
 border-collapse: collapse;
 min-width: 880px;
 font-size: 0.83rem;
 }

 .mui-table th {
 text-align: left;
 padding: 12px 14px;
 font-size: 0.75rem;
 font-weight: 800;
 text-transform: uppercase;
 letter-spacing: 0.04em;
 color: var(--text-muted);
 background: var(--bg-subtle);
 border-bottom: 1px solid var(--border-subtle);
 white-space: nowrap;
 }

 .mui-table td {
 padding: 14px;
 border-bottom: 1px solid var(--divider);
 color: var(--text-secondary);
 vertical-align: top;
 line-height: 1.58;
 }

 .mui-table tr:last-child td {
 border-bottom: none;
 }

 .mui-table tbody tr:hover td {
 background: var(--bg-hover);
 }

 .mui-table tr.benchmark-row td {
 background: rgba(0, 115, 230, 0.06);
 }

 mark.hl {
 background: rgba(255, 183, 77, 0.28);
 color: var(--text-primary);
 padding: 0 2px;
 border-radius: 3px;
 }

 /* Lifecycle Monetization Simulator Showcase */
 .simulator-grid {
 display: grid;
 grid-template-columns: minmax(0, 1fr) minmax(0, 1.12fr);
 gap: 18px;
 margin-top: 18px;
 }

 .sim-controls {
 padding: 18px;
 border-radius: 12px;
 border: 1px solid var(--border-subtle);
 background: var(--bg-canvas-elevated);
 display: flex;
 flex-direction: column;
 gap: 14px;
 }

 .preset-stack {
 display: flex;
 flex-direction: column;
 gap: 6px;
 }

 .preset-btn {
 width: 100%;
 text-align: left;
 padding: 9px 12px;
 border-radius: 9px;
 border: 1px solid var(--border-subtle);
 background: var(--bg-paper);
 color: var(--text-secondary);
 font-family: inherit;
 font-size: 0.8rem;
 font-weight: 600;
 cursor: pointer;
 display: flex;
 align-items: center;
 justify-content: space-between;
 gap: 8px;
 transition: all 0.15s ease;
 }

 .preset-btn:hover {
 border-color: var(--border-strong);
 color: var(--text-primary);
 }

 .preset-btn.active {
 border-color: var(--mui-primary-light);
 background: var(--mui-primary-bg);
 color: var(--mui-primary-lighter);
 font-weight: 700;
 }

 .slider-group {
 display: flex;
 flex-direction: column;
 gap: 5px;
 }

 .slider-head {
 display: flex;
 justify-content: space-between;
 font-size: 0.8rem;
 color: var(--text-secondary);
 font-weight: 600;
 }

 .slider-val {
 color: var(--mui-primary-lighter);
 font-weight: 800;
 }

 input[type="range"].mui-slider {
 -webkit-appearance: none;
 appearance: none;
 width: 100%;
 height: 6px;
 border-radius: 999px;
 background: var(--border-default);
 outline: none;
 cursor: pointer;
 }

 input[type="range"].mui-slider::-webkit-slider-thumb {
 -webkit-appearance: none;
 appearance: none;
 width: 18px;
 height: 18px;
 border-radius: 50%;
 background: #0073E6;
 border: 2px solid #FFFFFF;
 box-shadow: 0 2px 6px rgba(0, 115, 230, 0.45);
 transition: transform 0.12s ease;
 }

 input[type="range"].mui-slider::-webkit-slider-thumb:hover {
 transform: scale(1.12);
 }

 /* MUI Switch */
 .mui-switch-row {
 display: flex;
 align-items: center;
 justify-content: space-between;
 gap: 10px;
 padding: 10px 12px;
 border-radius: 10px;
 border: 1px solid var(--mui-success-border);
 background: var(--mui-success-bg);
 cursor: pointer;
 }

 .mui-switch-row input {
 width: 18px;
 height: 18px;
 accent-color: #0073E6;
 cursor: pointer;
 }

 .sim-output-panel {
 padding: 18px;
 border-radius: 12px;
 border: 1px solid var(--border-subtle);
 background: var(--bg-canvas-elevated);
 display: flex;
 flex-direction: column;
 gap: 14px;
 }

 .sim-readouts {
 display: grid;
 grid-template-columns: repeat(2, minmax(0, 1fr));
 gap: 10px;
 }

 .sim-stat-box {
 padding: 12px 14px;
 border-radius: 10px;
 background: var(--bg-paper);
 border: 1px solid var(--border-subtle);
 }

 .sim-stat-label {
 font-size: 0.73rem;
 color: var(--text-muted);
 font-weight: 700;
 }

 .sim-stat-num {
 font-size: 1.32rem;
 font-weight: 800;
 color: var(--text-primary);
 margin-top: 2px;
 }

 /* MUI Timeline (3 Production Acts) */
 .mui-timeline {
 display: flex;
 flex-direction: column;
 gap: 14px;
 position: relative;
 padding-left: 24px;
 margin-bottom: 20px;
 }

 .mui-timeline::before {
 content: "";
 position: absolute;
 left: 7px;
 top: 10px;
 bottom: 10px;
 width: 2px;
 background: linear-gradient(180deg, #0073E6 0%, #3399FF 55%, #22C55E 100%);
 }

 .timeline-step {
 position: relative;
 padding: 16px 18px;
 border-radius: 12px;
 background: var(--bg-canvas-elevated);
 border: 1px solid var(--border-subtle);
 }

 .timeline-dot {
 position: absolute;
 left: -23px;
 top: 20px;
 width: 14px;
 height: 14px;
 border-radius: 50%;
 background: var(--mui-primary-main);
 border: 3px solid var(--bg-canvas);
 box-shadow: 0 0 0 2px var(--mui-primary-light);
 }

 /* Interactive Checklist + MUI LinearProgress */
 .progress-track {
 width: 100%;
 height: 8px;
 border-radius: 999px;
 background: var(--bg-subtle);
 overflow: hidden;
 border: 1px solid var(--border-subtle);
 margin: 10px 0 16px;
 }

 .progress-fill {
 height: 100%;
 width: 50%;
 border-radius: 999px;
 background: linear-gradient(90deg, #0073E6 0%, #3399FF 60%, #22C55E 100%);
 transition: width 0.24s cubic-bezier(0.4, 0, 0.2, 1);
 }

 .checklist-grid {
 display: grid;
 grid-template-columns: repeat(2, minmax(0, 1fr));
 gap: 12px;
 }

 .check-card {
 display: flex;
 align-items: flex-start;
 gap: 12px;
 padding: 14px 16px;
 border-radius: 12px;
 border: 1px solid var(--border-subtle);
 background: var(--bg-canvas-elevated);
 cursor: pointer;
 transition: all 0.15s ease;
 }

 .check-card:hover {
 border-color: var(--border-strong);
 }

 .check-card.checked {
 border-color: var(--mui-primary-border);
 background: var(--mui-primary-bg);
 }

 .check-card input[type="checkbox"] {
 width: 18px;
 height: 18px;
 margin-top: 2px;
 accent-color: #0073E6;
 cursor: pointer;
 flex-shrink: 0;
 }

 .check-title {
 font-size: 0.88rem;
 font-weight: 700;
 color: var(--text-primary);
 margin-bottom: 4px;
 }

 .check-desc {
 font-size: 0.79rem;
 color: var(--text-secondary);
 line-height: 1.55;
 }

 /* Floating Chart Tooltip & MUI Snackbar Toast */
 #chartTooltip {
 position: fixed;
 pointer-events: none;
 z-index: 1400;
 padding: 10px 13px;
 border-radius: 10px;
 background: var(--bg-paper-solid);
 border: 1px solid var(--border-strong);
 color: var(--text-primary);
 font-size: 0.77rem;
 line-height: 1.55;
 box-shadow: var(--shadow-popover);
 backdrop-filter: blur(12px);
 -webkit-backdrop-filter: blur(12px);
 display: none;
 max-width: 295px;
 }

 #muiSnackbar {
 position: fixed;
 bottom: 22px;
 right: 22px;
 z-index: 1500;
 padding: 11px 16px;
 border-radius: 10px;
 background: var(--bg-paper-solid);
 color: var(--text-primary);
 border: 1px solid var(--border-strong);
 box-shadow: var(--shadow-popover);
 font-size: 0.82rem;
 font-weight: 600;
 opacity: 0;
 transform: translateY(12px);
 pointer-events: none;
 transition: opacity 0.2s ease, transform 0.2s ease;
 }

 #muiSnackbar.show {
 opacity: 1;
 transform: translateY(0);
 }

 /* Footer Sources Grid */
 .sources-list {
 display: grid;
 grid-template-columns: repeat(2, minmax(0, 1fr));
 gap: 8px 18px;
 list-style: none;
 margin-top: 12px;
 font-size: 0.79rem;
 }

 .sources-list li {
 display: flex;
 align-items: baseline;
 gap: 7px;
 color: var(--text-secondary);
 word-break: break-word;
 overflow-wrap: anywhere;
 }

 /* MUI AppBar Top-Right Language Segmented Switch (中文 | EN) */
 .mui-lang-switch {
 display: inline-flex;
 align-items: center;
 height: 34px;
 padding: 2px;
 border-radius: 10px;
 border: 1px solid var(--border-subtle);
 background: var(--bg-subtle);
 gap: 2px;
 flex-shrink: 0;
 }

 .mui-lang-btn {
 height: 28px;
 padding: 0 10px;
 border: none;
 border-radius: 7px;
 background: transparent;
 color: var(--text-secondary);
 font-size: 0.76rem;
 font-weight: 700;
 letter-spacing: 0.01em;
 cursor: pointer;
 display: inline-flex;
 align-items: center;
 justify-content: center;
 transition: all 0.15s ease;
 white-space: nowrap;
 }

 .mui-lang-btn:hover {
 color: var(--text-primary);
 }

 .mui-lang-btn.active {
 background: var(--bg-paper);
 color: var(--mui-primary-lighter);
 box-shadow: 0 1px 3px rgba(15, 25, 36, 0.12);
 }

 .mui-theme-icon-btn {
 width: 34px;
 height: 34px;
 border-radius: 10px;
 border: 1px solid var(--border-subtle);
 background: var(--bg-paper);
 color: var(--text-secondary);
 display: inline-flex;
 align-items: center;
 justify-content: center;
 cursor: pointer;
 flex-shrink: 0;
 transition: all 0.15s ease;
 }

 .mui-theme-icon-btn:hover {
 background: var(--bg-subtle);
 border-color: var(--mui-primary-lighter);
 color: var(--mui-primary-lighter);
 }

 /* Responsive Breakpoints */
 @media (max-width: 1120px) {
 .layout-shell {
 grid-template-columns: minmax(0, 1fr);
 }

 .mui-sidebar {
 position: fixed;
 top: 0;
 left: 0;
 bottom: 0;
 width: 300px;
 max-height: 100vh;
 background: var(--bg-paper-solid);
 border-right: 1px solid var(--border-subtle);
 padding: 18px 14px;
 z-index: 1200;
 transform: translateX(-104%);
 transition: transform 0.24s cubic-bezier(0.4, 0, 0.2, 1);
 display: flex !important;
 }

 body.drawer-open .mui-sidebar {
 transform: translateX(0);
 }

 body.drawer-open .drawer-backdrop {
 display: block;
 }

 .grid-4 {
 grid-template-columns: repeat(2, minmax(0, 1fr));
 }

 .arch-nodes {
 grid-template-columns: repeat(2, minmax(0, 1fr));
 }

 .grid-radar,
 .simulator-grid {
 grid-template-columns: minmax(0, 1fr);
 }
 }

 @media (max-width: 760px) {
 .quick-search-wrap,
 .hide-sm {
 display: none;
 }

 .layout-shell {
 padding: 16px 12px 56px;
 gap: 18px;
 }

 .hero-card,
 .section-block {
 padding: 18px;
 }

 .grid-3,
 .grid-2,
 .grid-4,
 .arch-nodes,
 .arch-platform-bar,
 .checklist-grid,
 .sources-list,
 .sim-readouts {
 grid-template-columns: minmax(0, 1fr);
 }

 .mui-chip {
 height: auto;
 min-height: 24px;
 padding: 4px 10px;
 white-space: normal;
 line-height: 1.35;
 word-break: break-word;
 }

 .cite-link {
 white-space: normal;
 word-break: break-word;
 }

 .mui-segmented {
 flex-wrap: wrap;
 max-width: 100%;
 }

 .mui-seg-btn {
 white-space: normal;
 text-align: left;
 line-height: 1.3;
 }

 .mui-input-outlined {
 min-width: 0;
 width: 100%;
 max-width: 100%;
 }
 }

 @media print {
 body {
 background: #FFFFFF !important;
 color: #0F1924 !important;
 }
 .mui-appbar,
 .mui-sidebar,
 #readingProgressBar,
 #muiSnackbar,
 #chartTooltip {
 display: none !important;
 }
 .layout-shell {
 grid-template-columns: 1fr !important;
 padding: 0 !important;
 }
 .mui-paper {
 box-shadow: none !important;
 border: 1px solid #CBD5E1 !important;
 break-inside: avoid;
 }
 }
 

    /* === MUI High-Clarity Precision Overrides (mui_clarity_theme_v1 & mui_clarity_density_v1) === */
    :root,
    html[data-theme="light"] {
      color-scheme: light;
      --bg-canvas: #F3F6FA;
      --bg-canvas-elevated: #F8FAFC;
      --bg-paper: #FFFFFF;
      --bg-paper-solid: #FFFFFF;
      --bg-subtle: #EEF3F8;
      --bg-hover: rgba(0, 115, 230, 0.06);
      --bg-active: rgba(0, 115, 230, 0.11);
      --bg-appbar: rgba(255, 255, 255, 0.93);
      --border-subtle: #E2E8F0;
      --border-default: #CBD5E1;
      --border-strong: #0073E6;
      --divider: #E9EEF5;
      --text-primary: #0F172A;
      --text-secondary: #334155;
      --text-muted: #5B6B7C;
      --mui-primary-main: #0073E6;
      --mui-primary-light: #0059B2;
      --mui-primary-lighter: #0059B2;
      --mui-primary-bg: #EFF6FF;
      --mui-primary-border: #BFDBFE;
      --mui-success-main: #15803D;
      --mui-success-text: #15803D;
      --mui-success-bg: #F0FDF4;
      --mui-success-border: #BBF7D0;
      --mui-warning-main: #B45309;
      --mui-warning-text: #B45309;
      --mui-warning-bg: #FFFBEB;
      --mui-warning-border: #FDE68A;
      --mui-error-main: #BE123C;
      --mui-error-text: #BE123C;
      --mui-error-bg: #FFF1F2;
      --mui-error-border: #FECDD3;
      --mui-violet-text: #6D28D9;
      --mui-violet-bg: #F5F3FF;
      --mui-violet-border: #DDD6FE;
      --hero-glow: radial-gradient(ellipse 82% 360px at 50% -90px, rgba(0, 115, 230, 0.08), transparent 74%);
      --blueprint-grid: none;
      --shadow-card: 0 1px 3px rgba(15, 23, 42, 0.05), 0 8px 24px -6px rgba(15, 23, 42, 0.05);
      --shadow-popover: 0 16px 36px rgba(15, 23, 42, 0.14), 0 0 0 1px #CBD5E1;
      --chart-grid: rgba(100, 116, 139, 0.16);
      --chart-tick: #475569;
      --chart-c1: #0073E6;
      --chart-c2: #16A34A;
      --chart-c3: #D97706;
      --chart-c4: #7C3AED;
    }

    html[data-theme="dark"] {
      color-scheme: dark;
      --bg-canvas: #080E1A;
      --bg-canvas-elevated: #131F35;
      --bg-paper: #0F172A;
      --bg-paper-solid: #0F172A;
      --bg-subtle: #182640;
      --bg-hover: rgba(56, 189, 248, 0.09);
      --bg-active: rgba(56, 189, 248, 0.16);
      --bg-appbar: rgba(8, 14, 26, 0.91);
      --border-subtle: rgba(148, 163, 184, 0.18);
      --border-default: rgba(148, 163, 184, 0.28);
      --border-strong: #38BDF8;
      --divider: rgba(148, 163, 184, 0.14);
      --text-primary: #F8FAFC;
      --text-secondary: #CBD5E1;
      --text-muted: #94A3B8;
      --mui-primary-main: #0284C7;
      --mui-primary-light: #38BDF8;
      --mui-primary-lighter: #38BDF8;
      --mui-primary-bg: rgba(56, 189, 248, 0.13);
      --mui-primary-border: rgba(56, 189, 248, 0.34);
      --mui-success-main: #10B981;
      --mui-success-text: #34D399;
      --mui-success-bg: rgba(52, 211, 153, 0.13);
      --mui-success-border: rgba(52, 211, 153, 0.32);
      --mui-warning-main: #F59E0B;
      --mui-warning-text: #FBBF24;
      --mui-warning-bg: rgba(251, 191, 36, 0.13);
      --mui-warning-border: rgba(251, 191, 36, 0.32);
      --mui-error-main: #F43F5E;
      --mui-error-text: #FB7185;
      --mui-error-bg: rgba(251, 113, 133, 0.13);
      --mui-error-border: rgba(251, 113, 133, 0.32);
      --mui-violet-text: #C084FC;
      --mui-violet-bg: rgba(192, 132, 242, 0.14);
      --mui-violet-border: rgba(192, 132, 242, 0.34);
      --hero-glow: radial-gradient(ellipse 84% 380px at 50% -100px, rgba(0, 115, 230, 0.20), transparent 76%);
      --blueprint-grid: none;
      --shadow-card: 0 4px 20px rgba(0, 0, 0, 0.38), inset 0 1px 0 rgba(255, 255, 255, 0.04);
      --shadow-popover: 0 20px 44px rgba(0, 0, 0, 0.65), 0 0 0 1px rgba(56, 189, 248, 0.30);
      --chart-grid: rgba(148, 163, 184, 0.14);
      --chart-tick: #94A3B8;
      --chart-c1: #38BDF8;
      --chart-c2: #34D399;
      --chart-c3: #FBBF24;
      --chart-c4: #C084FC;
    }

    /* Zero Reading Noise on Prose & Blueprint Cards */
    .hero-card, .arch-blueprint, .ip-hub-banner {
      background-image: none !important;
      background-color: var(--bg-paper-solid) !important;
    }
    .arch-blueprint {
      background-color: var(--bg-canvas-elevated) !important;
    }
    .hero-card::after {
      opacity: 0.45;
    }

    /* Density Mode Support (Comfortable vs. Compact) */
    html[data-density="compact"] .section-block {
      padding: 18px 20px;
    }
    html[data-density="compact"] .main-content,
    html[data-density="compact"] #ipSectionsHost {
      gap: 18px;
    }
    html[data-density="compact"] .lead-prose {
      font-size: 0.91rem;
      line-height: 1.66;
      margin-bottom: 16px;
    }
    html[data-density="compact"] .feature-card,
    html[data-density="compact"] .kpi-card,
    html[data-density="compact"] .matrix-card {
      padding: 14px;
    }
    .mui-density-switch {
      display: inline-flex;
      align-items: center;
      padding: 2px;
      border-radius: 9px;
      border: 1px solid var(--border-subtle);
      background: var(--bg-subtle);
      height: 36px;
      gap: 2px;
    }
    .mui-density-btn {
      border: none;
      background: transparent;
      color: var(--text-secondary);
      font-family: inherit;
      font-size: 0.74rem;
      font-weight: 700;
      height: 30px;
      padding: 0 9px;
      border-radius: 7px;
      cursor: pointer;
      white-space: nowrap;
      transition: all 0.15s ease;
    }
    .mui-density-btn.active {
      background: var(--bg-paper-solid);
      color: var(--mui-primary-lighter);
      box-shadow: 0 1px 2px rgba(15, 23, 42, 0.08);
    }
    @media (max-width: 960px) {
      .hide-md { display: none !important; }
    }
    /* Adjust pill grid for 10 products (5x2 on wide desktop) */
    .ip-pill-grid {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
    @media (max-width: 1320px) {
      .ip-pill-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    }
    @media (max-width: 760px) {
      .ip-pill-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }
    
  </style>
</head>
<body>
  <div id="readingProgressBar"></div>
  <div id="drawerBackdrop" class="drawer-backdrop"></div>
  <div id="chartTooltip"></div>
  <div id="muiSnackbar" role="status" aria-live="polite"></div>

  <!-- Sticky MUI High-Clarity Frosted AppBar -->
  <header class="mui-appbar">
    <div class="mui-appbar-inner">
      <div class="appbar-left">
        <button type="button" id="sidebarToggleBtn" class="mui-icon-btn" aria-label="切换目录侧边栏" title="展开/收起章节目录" data-aria-zh="切换目录侧边栏" data-aria-en="Toggle Chapter Sidebar" data-title-zh="展开/收起章节目录" data-title-en="Toggle Chapter Sidebar">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h10"/></svg>
        </button>
        <span id="appbarMonogram" class="brand-monogram mono">MB</span>
        <nav class="breadcrumbs" aria-label="面包屑导航" data-aria-zh="面包屑导航" data-aria-en="Breadcrumb Navigation">
          <a class="crumb-link hide-sm" href="../../../../index.html">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" style="color:var(--mui-primary-main);"><path d="M2 5.2L9.5 9.5v8.3L2 13.5V5.2zm20 0L14.5 9.5v8.3L22 13.5V5.2zM12 2L4.6 6.2 12 10.4l7.4-4.2L12 2z"/></svg>
            <span data-i18n-zh="数据中心" data-i18n-en="Research Hub">数据中心</span>
          </a>
          <span class="hide-sm" style="opacity:0.45;">/</span>
          <span id="appbarCrumbCurrent" class="crumb-current" data-i18n-zh="Marlboro 万宝路美国本土旗舰系列（PM USA）" data-i18n-en="Marlboro U.S. Flagship Franchise (PM USA)">Marlboro 万宝路美国本土旗舰系列（PM USA）</span>
        </nav>
        <span id="appbarBadgePlatform" class="mui-chip mui-chip-primary mono hide-sm" data-i18n-zh="全美卷烟 #1 · 39.5% 份额" data-i18n-en="#1 US Cigarette · 39.5% Share">全美卷烟 #1 · 39.5% 份额</span>
        <span id="appbarBadgeStatus" class="mui-chip mui-chip-success mono hide-md" data-i18n-zh="高端烟统治力 60.0% · 64.8% OCI率" data-i18n-en="60.0% Premium Share · 64.8% OCI">高端烟统治力 60.0% · 64.8% OCI率</span>
      </div>

      <div class="appbar-right">
        <div class="quick-search-wrap">
          <span class="quick-search-icon">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
          </span>
          <input type="search" id="quickJumpInput" class="quick-search-input" placeholder="检索章节或切换单品…" aria-label="快速跳转章节或单品" data-ph-zh="检索章节或切换单品…" data-ph-en="Jump to section or product…" data-aria-zh="快速跳转章节或单品" data-aria-en="Quick jump to chapter or product" autocomplete="off" />
          <span class="quick-search-kbd mono">⌘K</span>
          <div id="quickJumpPopover" class="quick-jump-popover"></div>
        </div>
        <div class="mui-density-switch hide-md" role="group" aria-label="阅读排版密度切换" data-aria-zh="阅读排版密度切换" data-aria-en="Reading Density Switch">
          <button type="button" id="densityComfortBtn" class="mui-density-btn active" data-i18n-zh="舒适排版" data-i18n-en="Relaxed">舒适排版</button>
          <button type="button" id="densityCompactBtn" class="mui-density-btn" data-i18n-zh="紧凑视图" data-i18n-en="Compact">紧凑视图</button>
        </div>
        <div id="langSwitchGroup" class="mui-lang-switch" role="group" aria-label="语言切换" data-aria-zh="语言切换" data-aria-en="Language Switcher">
          <button type="button" id="langZhBtn" class="mui-lang-btn active" data-lang="zh" aria-pressed="true">中文</button>
          <button type="button" id="langEnBtn" class="mui-lang-btn" data-lang="en" aria-pressed="false">EN</button>
        </div>
        <button type="button" id="appbarThemeBtn" class="mui-theme-icon-btn" aria-label="切换清晰浅色或深空暗色主题" title="切换 ☀ 清晰浅色 / 🌙 深空暗色" data-aria-zh="切换清晰浅色或深空暗色主题" data-aria-en="Toggle Crisp Light / Deep-Space Dark theme" data-title-zh="切换 ☀ 清晰浅色 / 🌙 深空暗色" data-title-en="Toggle Crisp Light / Deep-Space Dark">
          <span id="appbarThemeIcon" style="display:inline-flex;align-items:center;"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 3a9 9 0 1 0 9 9c0-.46-.04-.92-.1-1.36a5.389 5.389 0 0 1-4.4 2.26 5.403 5.403 0 0 1-3.14-9.8c-.44-.06-.9-.1-1.36-.1z"/></svg></span>
        </button>
      </div>
    </div>
  </header>

  <!-- Main Centered Shell -->
  <div class="layout-shell">
    <!-- Left MUI Documentation Navigation Sidebar -->
    <aside id="muiSidebar" class="mui-sidebar" aria-label="单品章节目录与站点导航" data-aria-zh="单品章节目录与站点导航" data-aria-en="Monograph Chapters &amp; Site Navigation">
      <div class="sidebar-card">
        <div class="sidebar-brand-top">
          <span id="sideBrandTag" class="mui-chip mui-chip-primary mono">PM USA · #1 US CIGARETTE ENGINE</span>
