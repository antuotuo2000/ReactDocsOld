  <script>
    (function () {
      try {
        var rawT = window.localStorage.getItem('mui_clarity_theme_v1') || window.localStorage.getItem('mui_portal_theme_v4');
        var t = rawT ? String(rawT).replace(/^"|"$/g, '') : 'light';
        document.documentElement.setAttribute('data-theme', t === 'dark' ? 'dark' : 'light');
        var d = window.localStorage.getItem('mui_clarity_density_v1');
        if (d === 'compact') document.documentElement.setAttribute('data-density', 'compact');
        if (window.localStorage.getItem('mui_portal_sidebar_collapsed_v1') === '1') {
          document.documentElement.setAttribute('data-sidebar-collapsed', '1');
        }
      } catch (e) {}
    })();
  </script>
